/**
 * @file dp_source_top.veryl
 * @brief DisplayPort 1.2 Source IP top-level skeleton (Phase A).
 *        Currently only the AUX CH + HPD subsystem is wired up;
 *        main link / video pipeline are added in later phases.
 */

pub module dp_source_top #(
    param CLOCK_HZ:           u32 = 32'd100_000_000,
    param MANCHESTER_CLOCK_HZ: u32 = 32'd1_000_000,
    param PRECHARGE_CYCLES:   u32 = 32'd16,
    param BUFFER_SIZE:        u32 = 256,
    param DEBUG_OUT:          logic<1> = 1'b0,
    param PROCESSOR_ID:       u32 = 32'h01234567,
    param PROCESSOR_ROM_SIZE: u32 = 8192,
    param PROCESSOR_RAM_SIZE: u32 = 8192,
    param PROCESSOR_ROM_FILE: string = "",       // Hex file loaded into the firmware ROM (BlockRAM init)
    param SR_PERIOD:          u32 = 512,
) (
    i_clk:  input clock_posedge,
    i_rstn: input reset_sync_low,

    // AUX CH (DP 1.2 §3.4)
    aux_ch_in:         input  logic,
    aux_ch_out:        output logic,
    aux_ch_out_enable: output logic,

    // Hot Plug Detect (DP 1.2 §3.3)
    hpd_in: input logic,

    // CPU GPIO output (used for DONE signaling in TB)
    cpu_io_out: output logic<32>,

    // Firmware loader / serial console
    saxis_serial_in_tvalid:  input  logic,
    saxis_serial_in_tready:  output logic,
    saxis_serial_in_tdata:   input  logic<8>,
    maxis_serial_out_tvalid: output logic,
    maxis_serial_out_tready: input  logic,
    maxis_serial_out_tdata:  output logic<8>,

    // Main-link lane 0 serial output (Phase C: 1 lane only)
    o_lane0_bit:       output logic,
    o_lane0_bit_valid: output logic,

    // AXI-Stream pixel input (Phase D, 24bpp RGB)
    s_axis_video_tvalid: input  logic,
    s_axis_video_tready: output logic,
    s_axis_video_tdata:  input  logic<24>,
) {
    // Wires from aux_ch_subsystem to main_link_tx
    var ml_pattern_select: logic<2>;
    var ml_enable:         logic;
    var ml_rd_reset:       logic;
    var ml_lane_count:     logic<3>;
    var ml_lane0_drive:    logic<8>;
    let _unused_lane0_drive: logic<8> = ml_lane0_drive; // informational only

    var v_enable:    logic;
    var v_htotal:    logic<16>;
    var v_vtotal:    logic<16>;
    var v_hstart:    logic<16>;
    var v_vstart:    logic<16>;
    var v_hwidth:    logic<16>;
    var v_vheight:   logic<16>;
    var v_hsw_hsp:   logic<16>;
    var v_vsw_vsp:   logic<16>;
    var v_mvid:      logic<24>;
    var v_nvid:      logic<24>;
    var v_misc:      logic<16>;
    var v_tu_active: logic<7>;

    inst aux_subsystem: aux_ch_subsystem #(
        CLOCK_HZ,
        MANCHESTER_CLOCK_HZ,
        PRECHARGE_CYCLES,
        BUFFER_SIZE,
        DEBUG_OUT,
        PROCESSOR_ID,
        PROCESSOR_ROM_SIZE,
        PROCESSOR_RAM_SIZE,
        PROCESSOR_ROM_FILE,
    ) (
        i_clk                   : i_clk,
        i_rstn                  : i_rstn,

        aux_ch_in               : aux_ch_in,
        aux_ch_out              : aux_ch_out,
        aux_ch_out_enable       : aux_ch_out_enable,

        hpd_in                  : hpd_in,

        cpu_io_out              : cpu_io_out,

        saxis_serial_in_tvalid  : saxis_serial_in_tvalid,
        saxis_serial_in_tready  : saxis_serial_in_tready,
        saxis_serial_in_tdata   : saxis_serial_in_tdata,

        maxis_serial_out_tvalid : maxis_serial_out_tvalid,
        maxis_serial_out_tready : maxis_serial_out_tready,
        maxis_serial_out_tdata  : maxis_serial_out_tdata,

        main_link_pattern_select: ml_pattern_select,
        main_link_enable        : ml_enable,
        main_link_rd_reset      : ml_rd_reset,
        main_link_lane_count    : ml_lane_count,
        main_link_lane0_drive   : ml_lane0_drive,

        video_enable            : v_enable,
        video_htotal            : v_htotal,
        video_vtotal            : v_vtotal,
        video_hstart            : v_hstart,
        video_vstart            : v_vstart,
        video_hwidth            : v_hwidth,
        video_vheight           : v_vheight,
        video_hsw_hsp           : v_hsw_hsp,
        video_vsw_vsp           : v_vsw_vsp,
        video_mvid              : v_mvid,
        video_nvid              : v_nvid,
        video_misc              : v_misc,
        video_tu_active         : v_tu_active,
    );

    inst main_link: main_link_tx #(
        SR_PERIOD: SR_PERIOD,
    ) (
        i_clk            : i_clk,
        i_rstn           : i_rstn,
        i_pattern_select : ml_pattern_select,
        i_enable         : ml_enable,
        i_rd_reset       : ml_rd_reset,
        i_lane_count     : ml_lane_count,
        i_video_enable   : v_enable,
        i_htotal         : v_htotal,
        i_vtotal         : v_vtotal,
        i_hstart         : v_hstart,
        i_vstart         : v_vstart,
        i_hwidth         : v_hwidth,
        i_vheight        : v_vheight,
        i_hsw_hsp        : v_hsw_hsp,
        i_vsw_vsp        : v_vsw_vsp,
        i_mvid           : v_mvid,
        i_nvid           : v_nvid,
        i_misc           : v_misc,
        i_tu_active      : v_tu_active,
        s_axis_tvalid    : s_axis_video_tvalid,
        s_axis_tready    : s_axis_video_tready,
        s_axis_tdata     : s_axis_video_tdata,
        o_lane0_bit      : o_lane0_bit,
        o_lane0_bit_valid: o_lane0_bit_valid,
    );
}
