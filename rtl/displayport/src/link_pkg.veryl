/**
 * @file link_pkg.veryl
 * @brief Shared types and K-code constants for the DP main link layer.
 *
 * The DP 1.2 control symbols of interest, per §3.5.1.1 Table 3-15 (the
 * authoritative control-symbol-to-K-code mapping; Tab 2-1 only lists the
 * framing sequences):
 *   BS  Blanking Start         K28.5 (0xBC)
 *   BE  Blanking End           K27.7 (0xFB)
 *   SR  Scrambler Reset        K28.0 (0x1C)
 *   FS  Fill Start             K30.7 (0xFE)
 *   FE  Fill End               K23.7 (0xF7)
 *   SS  Secondary-data Start   K28.2 (0x5C)
 *   SE  Secondary-data End     K29.7 (0xFD)
 *
 * Note: K28.4 and K28.7 are RESERVED in Table 3-15 and must not be
 * transmitted; K28.1 (CPBS/CP) and K28.3 (CPSR/BF) are content-
 * protection symbols, out of scope here.
 */

pub package link_pkg {
    enum SymbolKind: logic<3> {
        DATA = 0,
        BS   = 1,
        BE   = 2,
        SR   = 3,
        FS   = 4,
        FE   = 5,
        SS   = 6,
        SE   = 7,
    }

    const K_BS: logic<8> = 8'hBC; // K28.5
    const K_BE: logic<8> = 8'hFB; // K27.7
    const K_SR: logic<8> = 8'h1C; // K28.0
    const K_FS: logic<8> = 8'hFE; // K30.7
    const K_FE: logic<8> = 8'hF7; // K23.7
    const K_SS: logic<8> = 8'h5C; // K28.2
    const K_SE: logic<8> = 8'hFD; // K29.7
}
