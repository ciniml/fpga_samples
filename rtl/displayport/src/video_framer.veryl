/**
 * @file video_framer.veryl
 * @brief Top-level DP main-link video framer for a 1-lane / 24bpp / sync
 *        video pipeline (DP 1.2 §2.2). Wraps msa_generator and tu_packer
 *        and emits the proper byte sequence per line:
 *
 *          bytes 0..bs_len-1     : BS group. Default framing: single BS
 *                                  (K28.5). Enhanced framing (§2.2.1.2):
 *                                  BS BF BF BS (BF = K28.3); every
 *                                  SR_PERIOD-th group becomes SR / SR BF
 *                                  BF SR
 *          next 12 bytes         : (VB-ID, Mvid7:0, Maud7:0) x 4 — the
 *                                  header must be transported four times
 *                                  regardless of lane count (Fig 2-11/12)
 *          next 39 bytes (vblank): MSA (39 symbols from msa_generator),
 *                                  sent once per frame on line 1 only
 *                                  (right after the VSync leading edge;
 *                                  §2.2.4 requires one MSA per frame).
 *                                  Other vblank lines carry 0x00 stuffing
 *                                  in these slots.
 *          byte hblank_bytes-1   : BE (K27.7)        -- active lines only
 *          bytes hblank_bytes..  : TU pixel bytes    -- active lines only
 *          all other bytes       : 0x00 stuffing
 *
 *        Constraints: hblank_bytes >= bs_len + 13 (BS group + 4x3 header
 *        + BE) and bytes_per_line >= bs_len + 51 (header + MSA on vblank
 *        lines).
 *
 *        When i_video_enable = 0 the framer emits the Idle Pattern: a
 *        BS + (VB-ID, Mvid(0), Maud(0)) x 4 burst once every 8192 link
 *        symbols (VB-ID = 0x09: VerticalBlanking_Flag | NoVideoStream_Flag
 *        per Table 2-3), with the rest as 0x00 (scrambled).
 */

pub module video_framer #(
    // Substitute SR (K28.0 = 0x1C) for every SR_PERIOD-th BS so that the
    // scrambler can be re-synchronized on each SR (DP 1.2 §3.1.6). The
    // counter is initialized to SR_PERIOD-1 so the very first emitted BS
    // is replaced by SR, giving the sink an immediate scrambler-sync
    // anchor at link bring-up.
    param SR_PERIOD: u32 = 512,
) (
    i_clk:  input clock_posedge,
    i_rstn: input reset_sync_low,

    i_byte_tick: input logic,

    // Enhanced Framing Mode (DP 1.2 §2.2.1.2): BS and SR are sent as
    // 4-symbol sequences (BS BF BF BS / SR BF BF SR). Mandatory when the
    // sink's DPCD revision is 1.2 or higher.
    i_enhanced_framing: input logic,

    i_video_enable: input logic,

    // MSA fields from CPU registers
    i_htotal:    input logic<16>,
    i_vtotal:    input logic<16>,
    i_hstart:    input logic<16>, // unused for now
    i_vstart:    input logic<16>,
    i_hwidth:    input logic<16>,
    i_vheight:   input logic<16>,
    i_hsw_hsp:   input logic<16>,
    i_vsw_vsp:   input logic<16>,
    i_mvid:      input logic<24>,
    i_nvid:      input logic<24>,
    i_misc:      input logic<16>,
    i_tu_active: input logic<7>,
    // Link symbols per line (per lane). FW computes
    // htotal * LS_clk / pixel_clk, which must be an integer (e.g.
    // 480p on RBR x1: 858 * 6 = 5148; 1080p60 on RBR x4:
    // 2200 * 12/11 = 2400).
    i_line_symbols: input logic<16>,
    // Symbols per line occupied by the TU region (per lane). FW
    // computes floor(B / tu_active) * 64 + (B mod tu_active), with
    // B = active pixel bytes per lane per line, so the TU packer
    // consumes exactly B bytes; the final truncated TU is cut by the
    // BS per section 2.2.1.4, and the remainder of the line widens the
    // hblank window (BE moves later, invisible to the sink which
    // reconstructs timing from the MSA).
    i_active_window: input logic<16>,

    // 0: 1-lane (o_byte only). 1: 4-lane — o_byte/o_byte1..3 carry
    // lanes 0..3; the BS header triple is sent once per lane
    // (Fig 2-12), the MSA uses the 12-symbol-per-lane layout
    // (Fig 2-18), and the pixel input is one color component of four
    // consecutive pixels per pop (pixel_fifo_quad).
    i_four_lane: input logic,

    // Pixel input from pixel_fifo (1-lane: [7:0]) / pixel_fifo_quad.
    i_pixel_bytes: input  logic<32>,
    i_pixel_empty: input  logic,
    o_pixel_pop:   output logic,

    // Downstream byte interface (to scrambler). K flags and windows are
    // common to all lanes (control symbols are lane-aligned pre-skew).
    o_valid:            output logic,
    o_byte:             output logic<8>,
    o_byte1:            output logic<8>,
    o_byte2:            output logic<8>,
    o_byte3:            output logic<8>,
    o_is_k:             output logic,
    o_scramble_disable: output logic,
) {
    let _unused_hstart: logic<16> = i_hstart; // forwarded to msa_generator only

    // Timing in BYTES per line / frame. The inputs are quasi-static CPU
    // registers (programmed strictly before video_enable), so every
    // derived constant is registered: the multiply/subtract/add cones
    // settle once and stay out of the per-byte timing paths.
    var bytes_per_line: logic<18>;
    var active_window:  logic<18>; // link symbols occupied by the TU region
    var hblank_bytes:   logic<18>;
    var bpl_m1:         logic<18>; // bytes_per_line - 1 (line wrap slot)
    var bpl_m2:         logic<18>; // bytes_per_line - 2
    var hblank_m1:      logic<18>; // hblank_bytes - 1 (BE slot)
    var hblank_m2:      logic<18>; // hblank_bytes - 2 (TU phase reset slot)
    var hblank_m3:      logic<18>; // hblank_bytes - 3
    var bs_len_m1:      logic<18>; // last slot of the BS group
    var bs_len_m2:      logic<18>; // slot before the BS group's last
    var hdr_leave_at:   logic<18>; // last header slot   (bs_len + 11)
    var msa_leave_at:   logic<18>; // last MSA slot      (bs_len + 50)
    var msa_trig_prev:  logic<18>; // slot before trigger (bs_len + 9)
    var msa_pre_enter:  logic<18>; // slot before msa_pre (bs_len + 10)
    var msa_pre_leave:  logic<18>; // last msa_pre slot   (bs_len + 49)
    var vend:           logic<16>; // vstart + vheight
    var vtotal_m1:      logic<16>;
    var idle_bs_m1:     logic<13>;
    var idle_bs_m2:     logic<13>;
    var idle_hdr_leave: logic<13>;
    always_ff (i_clk, i_rstn) {
        if_reset {
            bytes_per_line = 0;
            active_window  = 0;
            hblank_bytes   = 0;
            bpl_m1         = 0;
            bpl_m2         = 0;
            hblank_m1      = 0;
            hblank_m2      = 0;
            hblank_m3      = 0;
            bs_len_m1      = 0;
            bs_len_m2      = 0;
            hdr_leave_at   = 12;
            msa_leave_at   = 51;
            msa_trig_prev  = 10;
            msa_pre_enter  = 11;
            msa_pre_leave  = 50;
            vend           = 0;
            vtotal_m1      = 0;
            idle_bs_m1     = 0;
            idle_bs_m2     = 0;
            idle_hdr_leave = 12;
        } else {
            // Stage 1: register the quasi-static FW-computed line
            // accounting (see the port comments for the formulas).
            bytes_per_line = {2'b0, i_line_symbols};
            active_window  = {2'b0, i_active_window};
            // Stage 2: from the stage-1 registers, so no path runs the
            // whole subtract cone in one cycle.
            hblank_bytes   = bytes_per_line - active_window;
            bpl_m1         = bytes_per_line - 18'd1;
            bpl_m2         = bytes_per_line - 18'd2;
            hblank_m1      = hblank_bytes - 18'd1;
            hblank_m2      = hblank_bytes - 18'd2;
            hblank_m3      = hblank_bytes - 18'd3;
            bs_len_m1      = if i_enhanced_framing ? 18'd3 : 18'd0;
            bs_len_m2      = if i_enhanced_framing ? 18'd2 : 18'd0;
            // Header: the (VB-ID, Mvid, Maud) triple is transported four
            // times total regardless of lane count (Fig 2-12): 12 slots
            // per lane at 1 lane, 3 slots per lane at 4 lanes. The MSA
            // occupies 39 slots (1 lane) / 12 slots (4 lanes, Fig 2-18)
            // right after the header.
            hdr_leave_at   = if i_enhanced_framing ?
                (if i_four_lane ? 18'd6 : 18'd15) :
                (if i_four_lane ? 18'd3 : 18'd12);
            msa_leave_at   = if i_enhanced_framing ?
                (if i_four_lane ? 18'd18 : 18'd54) :
                (if i_four_lane ? 18'd15 : 18'd51);
            msa_trig_prev  = if i_enhanced_framing ?
                (if i_four_lane ? 18'd4 : 18'd13) :
                (if i_four_lane ? 18'd1 : 18'd10);
            msa_pre_enter  = if i_enhanced_framing ?
                (if i_four_lane ? 18'd5 : 18'd14) :
                (if i_four_lane ? 18'd2 : 18'd11);
            msa_pre_leave  = if i_enhanced_framing ?
                (if i_four_lane ? 18'd17 : 18'd53) :
                (if i_four_lane ? 18'd14 : 18'd50);
            vend           = i_vstart + i_vheight;
            vtotal_m1      = i_vtotal - 16'd1;
            idle_bs_m1     = if i_enhanced_framing ? 13'd3 : 13'd0;
            idle_bs_m2     = if i_enhanced_framing ? 13'd2 : 13'd0;
            idle_hdr_leave = if i_enhanced_framing ?
                (if i_four_lane ? 13'd6 : 13'd15) :
                (if i_four_lane ? 13'd3 : 13'd12);
        }
    }

    var byte_in_line: logic<18>; // 0..bytes_per_line-1
    var line:         logic<16>; // 0..vtotal-1
    var idle_counter: logic<13>; // 0..8191 for IDLE pattern

    // BS-substitution counter for SR injection.
    const BS_BITS: u32 = $clog2(SR_PERIOD);
    type bs_count_t = logic<BS_BITS>;
    var bs_count: bs_count_t;
    // Registered copy of the SR decision. bs_count only changes on the
    // tick that emits a group's first symbol, hundreds of ticks apart,
    // and the registered copy still holds the pre-update value on that
    // very tick (non-blocking), so it is always coherent where used.
    var use_sr_now_r: logic;
    always_ff (i_clk, i_rstn) {
        if_reset {
            use_sr_now_r = 0;
        } else {
            use_sr_now_r = (bs_count == (SR_PERIOD - 1) as bs_count_t);
        }
    }
    // bs_count updates on the tick of group byte 0. Latch the decision
    // there so the trailing symbol of an enhanced-framing group (byte
    // bs_len-1) matches the leading one (SR BF BF SR / BS BF BF BS,
    // never mixed).
    var group_is_sr: logic;

    // ------------------------------------------------------------------
    // Look-ahead per-slot flags.
    //
    // All per-byte window predicates are registered flags maintained by
    // set/hold/clear rules keyed on EQUALITY compares of the current
    // position against (boundary - 1) constants: "the next slot enters
    // window W" is detected as `byte_in_line == first(W) - 1` on a tick,
    // with the line wrap handled as an explicit case. This avoids both
    // an increment adder and magnitude compares in the per-byte paths;
    // each flag path is one 18-bit equality plus a small select. When no
    // tick fires the flags hold, so they stay coherent for paced
    // (non-continuous) byte ticks too.
    // ------------------------------------------------------------------
    let wrap_v:        logic = (byte_in_line == bpl_m1);
    let line_wrap_now: logic = i_byte_tick && wrap_v && i_video_enable;
    let wrap_i:        logic = (idle_counter == 13'd8191);

    // Registered per-line helpers: `line` is stable for a whole line, so
    // these deep compares settle long before the line wraps.
    var frame_wrap_r:        logic;     // line == vtotal-1
    var line_p1:             logic<16>; // line + 1 (stage 1)
    var np1_ge_vstart:       logic;     // stage 2
    var np1_lt_vend:         logic;     // stage 2
    var next_line_is_vblank: logic;     // stage 3: vblank-ness of line+1
    var line0_is_vblank:     logic;     // vblank-ness of line 0
    var next_line_is_msa:    logic;     // (line+1) is the once-per-frame MSA line
    always_ff (i_clk, i_rstn) {
        if_reset {
            frame_wrap_r        = 0;
            line_p1             = 1;
            np1_ge_vstart       = 0;
            np1_lt_vend         = 0;
            next_line_is_vblank = 1;
            line0_is_vblank     = 1;
            next_line_is_msa    = 0;
        } else {
            frame_wrap_r        = (line == vtotal_m1);
            line_p1             = line + 16'd1;
            np1_ge_vstart       = (line_p1 >= i_vstart);
            np1_lt_vend         = (line_p1 <: vend);
            next_line_is_vblank = !(np1_ge_vstart && np1_lt_vend);
            line0_is_vblank     = (i_vstart != 16'd0);
            // MSA is sent once per frame, on line 1 (right after the
            // VSync leading edge at line 0; §2.2.4 requires exactly one
            // MSA per frame during the vertical blanking period).
            next_line_is_msa    = (line_p1 == 16'd1);
        }
    }

    // Per-slot flags (describe the slot the mux emits on the NEXT cycle,
    // which by construction is byte_in_line / idle_counter then).
    var f_line_vblank: logic;
    // Duplicate of f_line_vblank dedicated to the (wide, 4-lane) output
    // mux, so the tick-gate copy and the mux copy each keep a small
    // fanout at 162 MHz. Updated identically.
    var f_line_vblank_q: logic;
    // Third copy dedicated to the TU-path gates (tu window / start /
    // pixel pops), whose cone ends in the pixel-FIFO counters.
    var f_line_vblank_tu: logic;
    var f_line_msa:    logic;   // this line carries the once-per-frame MSA
    var f_v_bs_first:  logic;
    var f_v_bs_last:   logic;
    var f_v_bs_in:     logic;
    var f_v_hdr_in:    logic;
    var f_v_msa_in:    logic;
    var f_v_at_be:     logic;
    var f_v_tu_in:     logic;
    var f_v_msa_trig:  logic;
    var f_v_msa_pre:   logic;
    var f_v_tu_pre:    logic;
    var f_v_tu_start:  logic;
    var hdr_phase_v:   logic<2>;
    var f_i_bs_first:  logic;
    var f_i_bs_last:   logic;
    var f_i_bs_in:     logic;
    var f_i_hdr_in:    logic;
    var hdr_phase_i:   logic<2>;

    always_ff (i_clk, i_rstn) {
        if_reset {
            f_line_vblank    = 1;
            f_line_vblank_q  = 1;
            f_line_vblank_tu = 1;
            f_line_msa    = 0;
            f_v_bs_first  = 1;
            f_v_bs_last   = 0;
            f_v_bs_in     = 1;
            f_v_hdr_in    = 0;
            f_v_msa_in    = 0;
            f_v_at_be     = 0;
            f_v_tu_in     = 0;
            f_v_msa_trig  = 0;
            f_v_msa_pre   = 0;
            f_v_tu_pre    = 0;
            f_v_tu_start  = 0;
            hdr_phase_v   = 0;
            f_i_bs_first  = 1;
            f_i_bs_last   = 0;
            f_i_bs_in     = 1;
            f_i_hdr_in    = 0;
            hdr_phase_i   = 0;
        } else {
            // ---- video-path flags ----
            if !i_video_enable {
                // Park at slot 0 so the first enabled tick emits a
                // correct BS group start.
                f_v_bs_first = 1;
                f_v_bs_last  = bs_len_m1 == 18'd0;
                f_v_bs_in    = 1;
                f_v_hdr_in   = 0;
                f_v_msa_in   = 0;
                f_v_at_be    = 0;
                f_v_tu_in    = 0;
                f_v_msa_trig = 0;
                f_v_msa_pre  = 0;
                f_v_tu_pre   = 0;
                f_v_tu_start = 0;
                hdr_phase_v  = 0;
            } else if i_byte_tick {
                // next == K  <=>  byte_in_line == K-1 (or wrap for K=0).
                f_v_bs_first = wrap_v;
                f_v_bs_last  = if bs_len_m1 == 18'd0 ?
                                   wrap_v : (byte_in_line == bs_len_m2);
                f_v_msa_trig = (byte_in_line == msa_trig_prev);
                f_v_at_be    = (byte_in_line == hblank_m2);
                f_v_tu_start = (byte_in_line == hblank_m3);
                // Range flags: set on entering, clear on leaving.
                if wrap_v {
                    f_v_bs_in = 1;
                } else if byte_in_line == bs_len_m1 {
                    f_v_bs_in = 0;
                }
                if byte_in_line == bs_len_m1 {
                    f_v_hdr_in = 1;
                } else if byte_in_line == hdr_leave_at {
                    f_v_hdr_in = 0;
                }
                if byte_in_line == hdr_leave_at {
                    f_v_msa_in = 1;
                } else if byte_in_line == msa_leave_at {
                    f_v_msa_in = 0;
                }
                if byte_in_line == hblank_m1 {
                    f_v_tu_in = 1;
                } else if wrap_v {
                    f_v_tu_in = 0;
                }
                if byte_in_line == msa_pre_enter {
                    f_v_msa_pre = 1;
                } else if byte_in_line == msa_pre_leave {
                    f_v_msa_pre = 0;
                }
                if byte_in_line == hblank_m2 {
                    f_v_tu_pre = 1;
                } else if byte_in_line == bpl_m2 {
                    f_v_tu_pre = 0;
                }
                // Header byte phase: 0 = VB-ID, 1 = Mvid, 2 = Maud.
                if byte_in_line == bs_len_m1 {
                    hdr_phase_v = 0;
                } else if f_v_hdr_in {
                    hdr_phase_v = if hdr_phase_v == 2'd2 ? 2'd0 : hdr_phase_v + 2'd1;
                }
            }

            if !i_video_enable {
                f_line_vblank    = line0_is_vblank;
                f_line_vblank_q  = line0_is_vblank;
                f_line_vblank_tu = line0_is_vblank;
                f_line_msa    = 0;
            } else if line_wrap_now {
                f_line_vblank    = if frame_wrap_r ? line0_is_vblank : next_line_is_vblank;
                f_line_vblank_q  = if frame_wrap_r ? line0_is_vblank : next_line_is_vblank;
                f_line_vblank_tu = if frame_wrap_r ? line0_is_vblank : next_line_is_vblank;
                // Line 0 is never the MSA line (it is 1), so the frame
                // wrap always clears the flag.
                f_line_msa    = if frame_wrap_r ? 1'b0 : next_line_is_msa;
            }

            // ---- idle-path flags ----
            if i_video_enable {
                f_i_bs_first = 1;
                f_i_bs_last  = idle_bs_m1 == 13'd0;
                f_i_bs_in    = 1;
                f_i_hdr_in   = 0;
                hdr_phase_i  = 0;
            } else if i_byte_tick {
                f_i_bs_first = wrap_i;
                f_i_bs_last  = if idle_bs_m1 == 13'd0 ?
                                   wrap_i : (idle_counter == idle_bs_m2);
                if wrap_i {
                    f_i_bs_in = 1;
                } else if idle_counter == idle_bs_m1 {
                    f_i_bs_in = 0;
                }
                if idle_counter == idle_bs_m1 {
                    f_i_hdr_in = 1;
                } else if idle_counter == idle_hdr_leave {
                    f_i_hdr_in = 0;
                }
                if idle_counter == idle_bs_m1 {
                    hdr_phase_i = 0;
                } else if f_i_hdr_in {
                    hdr_phase_i = if hdr_phase_i == 2'd2 ? 2'd0 : hdr_phase_i + 2'd1;
                }
            }
        }
    }

    // Submodule tick gates. Submodule outputs are registered (1-cycle
    // delay), so their windows run one byte EARLIER (msa_pre / tu_pre)
    // than the slot the mux reads them at, exactly as before — the
    // pre-window flags encode the same ranges.
    let msa_trigger:   logic = i_byte_tick && f_line_vblank && f_line_msa && f_v_msa_trig;
    let msa_byte_tick: logic = i_byte_tick && f_line_vblank && f_line_msa && f_v_msa_pre;
    let tu_pre_window: logic = i_video_enable && !f_line_vblank_tu && f_v_tu_pre;
    let tu_start_pulse: logic = i_byte_tick && !f_line_vblank_tu && f_v_tu_start && i_video_enable;
    let tu_byte_tick:  logic = i_byte_tick && tu_pre_window;

    // ------ MSA generator ------
    var msa_byte:  logic<8>;
    var msa_byte1: logic<8>;
    var msa_byte2: logic<8>;
    var msa_byte3: logic<8>;
    var msa_is_k:  logic;
    var msa_valid: logic;
    var msa_busy:  logic;

    inst u_msa: msa_generator (
        i_clk      : i_clk,
        i_rstn     : i_rstn,
        i_byte_tick: msa_byte_tick,
        i_trigger  : msa_trigger,
        i_htotal   : i_htotal,
        i_vtotal   : i_vtotal,
        i_hstart   : i_hstart,
        i_vstart   : i_vstart,
        i_hwidth   : i_hwidth,
        i_vheight  : i_vheight,
        i_hsw_hsp  : i_hsw_hsp,
        i_vsw_vsp  : i_vsw_vsp,
        i_mvid     : i_mvid,
        i_nvid     : i_nvid,
        i_misc     : i_misc,
        i_four_lane: i_four_lane,
        o_busy     : msa_busy,
        o_valid    : msa_valid,
        o_byte     : msa_byte,
        o_byte1    : msa_byte1,
        o_byte2    : msa_byte2,
        o_byte3    : msa_byte3,
        o_is_k     : msa_is_k,
    );

    // ------ TU packer ------
    var tu_bytes: logic<32>;
    var tu_is_k:  logic;
    var tu_valid: logic;
    var tu_pop:   logic;
    assign o_pixel_pop = tu_pop;

    inst u_tu: tu_packer (
        i_clk         : i_clk,
        i_rstn        : i_rstn,
        i_byte_tick   : tu_byte_tick,
        i_emit_enable : tu_pre_window,
        i_tu_start    : tu_start_pulse,
        i_active_count: i_tu_active,
        i_pixel_bytes : i_pixel_bytes,
        i_pixel_empty : i_pixel_empty,
        o_pixel_pop   : tu_pop,
        o_valid       : tu_valid,
        o_bytes       : tu_bytes,
        o_is_k        : tu_is_k,
    );

    // ------ Output mux (flag-based, shallow) ------
    always_comb {
        o_scramble_disable = 0;
        o_valid            = i_byte_tick;
        o_byte             = 8'h00;
        o_is_k             = 0;

        if i_video_enable {
            if f_v_bs_in {
                // BS group. Default framing: single BS (K28.5) or SR
                // (K28.0) when use_sr_now_r. Enhanced framing: 4-symbol
                // sequence BS BF BF BS (or SR BF BF SR), BF = K28.3.
                o_is_k = 1;
                if f_v_bs_first {
                    if use_sr_now_r {
                        o_byte = 8'h1C;
                    } else {
                        o_byte = 8'hBC;
                    }
                } else if f_v_bs_last {
                    // Trailing symbol repeats the group's leading symbol;
                    // bs_count has already advanced, so use the latched
                    // decision.
                    if group_is_sr {
                        o_byte = 8'h1C;
                    } else {
                        o_byte = 8'hBC;
                    }
                } else {
                    o_byte = 8'h7C; // BF
                }
            } else if f_v_hdr_in {
                // (VB-ID, Mvid7:0, Maud7:0) x 4 (Fig 2-11/2-12).
                if hdr_phase_v == 2'd0 {
                    // VB-ID: bit0 = VBlank flag (rest 0 in our scope)
                    o_byte = {7'h00, f_line_vblank_q};
                } else if hdr_phase_v == 2'd1 {
                    o_byte = i_mvid[7:0];
                } else {
                    o_byte = 8'h00; // Maud
                }
            } else if !f_line_vblank_q && f_v_at_be {
                o_byte = 8'hFB; // BE = K27.7
                o_is_k = 1;
            } else if f_line_vblank_q && f_v_msa_in {
                if msa_valid {
                    o_byte = msa_byte;
                    o_is_k = msa_is_k;
                }
            } else if !f_line_vblank_q && f_v_tu_in {
                if tu_valid {
                    o_byte = tu_bytes[7:0];
                    o_is_k = tu_is_k;
                }
            }
        } else {
            // Idle Pattern: BS group, then (VB-ID, Mvid=0, Maud=0) x 4,
            // then 0x00 stuffing for the remainder of the 8192-symbol
            // window. VB-ID = 0x09: NoVideoStream_Flag (bit 3) plus
            // VerticalBlanking_Flag (bit 0), which Table 2-3 requires to
            // be set whenever bit 3 is set.
            if f_i_bs_in {
                o_is_k = 1;
                if f_i_bs_first {
                    if use_sr_now_r {
                        o_byte = 8'h1C;
                    } else {
                        o_byte = 8'hBC;
                    }
                } else if f_i_bs_last {
                    if group_is_sr {
                        o_byte = 8'h1C;
                    } else {
                        o_byte = 8'hBC;
                    }
                } else {
                    o_byte = 8'h7C; // BF
                }
            } else if f_i_hdr_in {
                if hdr_phase_i == 2'd0 {
                    o_byte = 8'h09; // VB-ID
                } else {
                    o_byte = 8'h00; // Mvid7:0 / Maud7:0
                }
            }
        }
    }

    // ------ Lanes 1..3 (4-lane mode) ------
    // Identical to lane 0 except in the two per-lane-data arms: the MSA
    // attribute columns and the TU pixel bytes. The guards replicate the
    // priority of the lane-0 chain (BS group and header outrank both;
    // the BE arm is mutually exclusive with the MSA arm via
    // f_line_vblank and with the TU arm via f_v_at_be ordering).
    always_comb {
        o_byte1 = o_byte;
        o_byte2 = o_byte;
        o_byte3 = o_byte;
        if i_video_enable && !f_v_bs_in && !f_v_hdr_in {
            if f_line_vblank_q && f_v_msa_in && msa_valid {
                o_byte1 = msa_byte1;
                o_byte2 = msa_byte2;
                o_byte3 = msa_byte3;
            } else if !f_line_vblank_q && !f_v_at_be && f_v_tu_in && tu_valid {
                o_byte1 = tu_bytes[15:8];
                o_byte2 = tu_bytes[23:16];
                o_byte3 = tu_bytes[31:24];
            }
        }
    }

    // ------ Frame counters ------
    always_ff (i_clk, i_rstn) {
        if_reset {
            byte_in_line = 0;
            line         = 0;
            idle_counter = 0;
            group_is_sr  = 0;
            // Initialize so the very first emitted BS is replaced by SR.
            // This anchors the sink scrambler at INIT from the first
            // K-comma it sees, eliminating the startup mismatch window.
            bs_count = (SR_PERIOD - 1) as bs_count_t;
        } else {
            if i_byte_tick &&
               ((i_video_enable && f_v_bs_first) || (!i_video_enable && f_i_bs_first)) {
                // Latch the SR decision for the rest of this group before
                // the counter advances (non-blocking: use_sr_now_r still
                // reflects the pre-update bs_count here).
                group_is_sr = use_sr_now_r;
                if use_sr_now_r {
                    bs_count = 0;
                } else {
                    bs_count = bs_count + (1 as bs_count_t);
                }
            }
            if !i_video_enable {
                byte_in_line = 0;
                line         = 0;
                if i_byte_tick {
                    idle_counter = if wrap_i ? 13'd0 : idle_counter + 13'd1;
                }
            } else {
                idle_counter = 0;
                if i_byte_tick {
                    byte_in_line = if wrap_v ? 18'd0 : byte_in_line + 18'd1;
                    if wrap_v {
                        line = if frame_wrap_r ? 16'd0 : line + 16'd1;
                    }
                }
            }
        }
    }
}
