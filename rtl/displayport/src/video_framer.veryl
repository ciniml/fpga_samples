/**
 * @file video_framer.veryl
 * @brief Top-level DP main-link video framer for a 1-lane / 24bpp / sync
 *        video pipeline (DP 1.2 §2.2). Wraps msa_generator and tu_packer
 *        and emits the proper byte sequence per line:
 *
 *          bytes 0..bs_len-1     : BS group. Default framing: single BS
 *                                  (K28.5). Enhanced framing (§2.2.1.2):
 *                                  BS BF BF BS (BF = K28.3); every
 *                                  SR_PERIOD-th group becomes SR / SR BF
 *                                  BF SR
 *          next 12 bytes         : (VB-ID, Mvid7:0, Maud7:0) x 4 — the
 *                                  header must be transported four times
 *                                  regardless of lane count (Fig 2-11/12)
 *          next 39 bytes (vblank): MSA (39 symbols from msa_generator)
 *          byte hblank_bytes-1   : BE (K27.7)        -- active lines only
 *          bytes hblank_bytes..  : TU pixel bytes    -- active lines only
 *          all other bytes       : 0x00 stuffing
 *
 *        Constraints: hblank_bytes >= bs_len + 13 (BS group + 4x3 header
 *        + BE) and bytes_per_line >= bs_len + 51 (header + MSA on vblank
 *        lines).
 *
 *        When i_video_enable = 0 the framer emits the Idle Pattern: a
 *        BS + (VB-ID, Mvid(0), Maud(0)) x 4 burst once every 8192 link
 *        symbols (VB-ID = 0x09: VerticalBlanking_Flag | NoVideoStream_Flag
 *        per Table 2-3), with the rest as 0x00 (scrambled).
 */

pub module video_framer #(
    // Substitute SR (K28.0 = 0x1C) for every SR_PERIOD-th BS so that the
    // scrambler can be re-synchronized on each SR (DP 1.2 §3.1.6). The
    // counter is initialized to SR_PERIOD-1 so the very first emitted BS
    // is replaced by SR, giving the sink an immediate scrambler-sync
    // anchor at link bring-up.
    param SR_PERIOD: u32 = 512,
) (
    i_clk:  input clock_posedge,
    i_rstn: input reset_sync_low,

    i_byte_tick: input logic,

    // Enhanced Framing Mode (DP 1.2 §2.2.1.2): BS and SR are sent as
    // 4-symbol sequences (BS BF BF BS / SR BF BF SR). Mandatory when the
    // sink's DPCD revision is 1.2 or higher.
    i_enhanced_framing: input logic,

    i_video_enable: input logic,

    // MSA fields from CPU registers
    i_htotal:    input logic<16>,
    i_vtotal:    input logic<16>,
    i_hstart:    input logic<16>, // unused for now
    i_vstart:    input logic<16>,
    i_hwidth:    input logic<16>,
    i_vheight:   input logic<16>,
    i_hsw_hsp:   input logic<16>,
    i_vsw_vsp:   input logic<16>,
    i_mvid:      input logic<24>,
    i_nvid:      input logic<24>,
    i_misc:      input logic<16>,
    i_tu_active: input logic<7>,

    // Pixel input from pixel_fifo
    i_pixel_byte:  input  logic<8>,
    i_pixel_empty: input  logic,
    o_pixel_pop:   output logic,

    // Downstream byte interface (to scrambler)
    o_valid:            output logic,
    o_byte:             output logic<8>,
    o_is_k:             output logic,
    o_scramble_disable: output logic,
) {
    let _unused_hstart: logic<16> = i_hstart; // forwarded to msa_generator only

    // Timing in BYTES per line / frame.
    let bytes_per_line: logic<18> = ({2'b0, i_htotal} * 18'd3);
    let hblank_bytes:   logic<18> = (({2'b0, i_htotal} - {2'b0, i_hwidth}) * 18'd3);

    var byte_in_line: logic<18>; // 0..bytes_per_line-1
    var line:         logic<16>; // 0..vtotal-1
    var idle_counter: logic<13>; // 0..8191 for IDLE pattern

    // BS-substitution counter for SR injection.
    const BS_BITS: u32 = $clog2(SR_PERIOD);
    type bs_count_t = logic<BS_BITS>;
    var bs_count: bs_count_t;
    let use_sr_now: logic = (bs_count == (SR_PERIOD - 1) as bs_count_t);
    // bs_count updates on the tick of group byte 0, so use_sr_now is only
    // valid at byte 0. Latch the decision there so the trailing symbol of
    // an enhanced-framing group (byte bs_len-1) matches the leading one
    // (SR BF BF SR / BS BF BF BS, never mixed).
    var group_is_sr: logic;

    // Length of the BS/SR group at line start: 1 symbol in default
    // framing, 4 symbols (BS BF BF BS / SR BF BF SR) in enhanced framing.
    let bs_len: logic<18> = if i_enhanced_framing ? 18'd4 : 18'd1;

    let at_video_bs: logic = i_video_enable && (byte_in_line == 18'd0);
    let at_idle_bs:  logic = !i_video_enable && (idle_counter == 13'd0);
    let at_any_bs:   logic = at_video_bs || at_idle_bs;

    let line_is_active: logic =
        (line >= i_vstart) && (line <: i_vstart + i_vheight);
    let line_is_vblank: logic = !line_is_active;

    // BS/SR group window (bytes [0..bs_len)).
    let in_bs_window: logic = byte_in_line <: bs_len;

    // (VB-ID, Mvid7:0, Maud7:0) x 4 header right after the BS group.
    let in_hdr_window: logic =
        (byte_in_line >= bs_len) && (byte_in_line <: bs_len + 18'd12);
    // Position within the repeating 3-byte header group: 0=VB-ID,
    // 1=Mvid7:0, 2=Maud7:0.
    let hdr_phase: logic<18> = (byte_in_line - bs_len) % 18'd3;

    // Window predicates (bytes inside the line).
    let in_msa_window: logic =
        line_is_vblank && (byte_in_line >= bs_len + 18'd12) &&
        (byte_in_line <: bs_len + 18'd51);
    let in_tu_window: logic =
        line_is_active && (byte_in_line >= hblank_bytes);
    let at_be: logic =
        line_is_active && (byte_in_line == hblank_bytes - 18'd1);

    // Trigger / start pulses for submodules. Submodule outputs are
    // registered (1-cycle delay), so we drive their byte_ticks one byte
    // EARLIER than the slot the mux reads them at.
    //
    // MSA mux range is byte_in_line [bs_len+12..bs_len+50]. Pre-emit at
    // [bs_len+11..bs_len+49]; trigger at bs_len+10 so the first byte is
    // ready by bs_len+12.
    let msa_trigger: logic =
        i_byte_tick && line_is_vblank && (byte_in_line == bs_len + 18'd10);
    let msa_pre_window: logic =
        line_is_vblank && (byte_in_line >= bs_len + 18'd11) &&
        (byte_in_line <: bs_len + 18'd50);
    let msa_byte_tick: logic = i_byte_tick && msa_pre_window;

    // TU mux range is byte_in_line [hblank..bytes_per_line-1]. Pre-emit at
    // byte_in_line [hblank-1..bytes_per_line-1]; reset phase at hblank-2.
    // The hblank-1 emit is masked at the mux because at_be takes priority.
    let tu_pre_window: logic =
        line_is_active && (byte_in_line + 18'd1 >= hblank_bytes) &&
        (byte_in_line + 18'd1 <: bytes_per_line);
    let tu_start_pulse: logic =
        i_byte_tick && line_is_active && (byte_in_line + 18'd2 == hblank_bytes);
    let tu_byte_tick:  logic = i_byte_tick && tu_pre_window;

    // ------ MSA generator ------
    var msa_byte:  logic<8>;
    var msa_is_k:  logic;
    var msa_valid: logic;
    var msa_busy:  logic;

    inst u_msa: msa_generator (
        i_clk      : i_clk,
        i_rstn     : i_rstn,
        i_byte_tick: msa_byte_tick,
        i_trigger  : msa_trigger,
        i_htotal   : i_htotal,
        i_vtotal   : i_vtotal,
        i_hstart   : i_hstart,
        i_vstart   : i_vstart,
        i_hwidth   : i_hwidth,
        i_vheight  : i_vheight,
        i_hsw_hsp  : i_hsw_hsp,
        i_vsw_vsp  : i_vsw_vsp,
        i_mvid     : i_mvid,
        i_nvid     : i_nvid,
        i_misc     : i_misc,
        o_busy     : msa_busy,
        o_valid    : msa_valid,
        o_byte     : msa_byte,
        o_is_k     : msa_is_k,
    );

    // ------ TU packer ------
    var tu_byte:  logic<8>;
    var tu_is_k:  logic;
    var tu_valid: logic;
    var tu_pop:   logic;
    assign o_pixel_pop = tu_pop;

    inst u_tu: tu_packer (
        i_clk         : i_clk,
        i_rstn        : i_rstn,
        i_byte_tick   : tu_byte_tick,
        i_emit_enable : tu_pre_window,
        i_tu_start    : tu_start_pulse,
        i_active_count: i_tu_active,
        i_pixel_byte  : i_pixel_byte,
        i_pixel_empty : i_pixel_empty,
        o_pixel_pop   : tu_pop,
        o_valid       : tu_valid,
        o_byte        : tu_byte,
        o_is_k        : tu_is_k,
    );

    // ------ Output mux ------
    always_comb {
        o_scramble_disable = 0;
        o_valid            = i_byte_tick;
        o_byte             = 8'h00;
        o_is_k             = 0;

        if i_video_enable {
            if in_bs_window {
                // BS group. Default framing: single BS (K28.5) or SR
                // (K28.0) when use_sr_now. Enhanced framing: 4-symbol
                // sequence BS BF BF BS (or SR BF BF SR), BF = K28.3.
                o_is_k = 1;
                if byte_in_line == 18'd0 {
                    if use_sr_now {
                        o_byte = 8'h1C;
                    } else {
                        o_byte = 8'hBC;
                    }
                } else if byte_in_line == bs_len - 18'd1 {
                    // Trailing symbol repeats the group's leading symbol;
                    // bs_count has already advanced, so use the latched
                    // decision.
                    if group_is_sr {
                        o_byte = 8'h1C;
                    } else {
                        o_byte = 8'hBC;
                    }
                } else {
                    o_byte = 8'h7C; // BF
                }
            } else if in_hdr_window {
                // (VB-ID, Mvid7:0, Maud7:0) x 4 (Fig 2-11/2-12).
                if hdr_phase == 18'd0 {
                    // VB-ID: bit0 = VBlank flag (rest 0 in our scope)
                    o_byte = {7'h00, line_is_vblank};
                } else if hdr_phase == 18'd1 {
                    o_byte = i_mvid[7:0];
                } else {
                    o_byte = 8'h00; // Maud
                }
            } else if at_be {
                o_byte = 8'hFB; // BE = K27.7
                o_is_k = 1;
            } else if in_msa_window {
                if msa_valid {
                    o_byte = msa_byte;
                    o_is_k = msa_is_k;
                }
            } else if in_tu_window {
                if tu_valid {
                    o_byte = tu_byte;
                    o_is_k = tu_is_k;
                }
            }
        } else {
            // Idle Pattern: BS group, then (VB-ID, Mvid=0, Maud=0) x 4,
            // then 0x00 stuffing for the remainder of the 8192-symbol
            // window. VB-ID = 0x09: NoVideoStream_Flag (bit 3) plus
            // VerticalBlanking_Flag (bit 0), which Table 2-3 requires to
            // be set whenever bit 3 is set.
            if {5'b0, idle_counter} <: bs_len {
                o_is_k = 1;
                if idle_counter == 13'd0 {
                    if use_sr_now {
                        o_byte = 8'h1C;
                    } else {
                        o_byte = 8'hBC;
                    }
                } else if {5'b0, idle_counter} == bs_len - 18'd1 {
                    if group_is_sr {
                        o_byte = 8'h1C;
                    } else {
                        o_byte = 8'hBC;
                    }
                } else {
                    o_byte = 8'h7C; // BF
                }
            } else if ({5'b0, idle_counter} >= bs_len) && ({5'b0, idle_counter} <: bs_len + 18'd12) {
                if (({5'b0, idle_counter} - bs_len) % 18'd3) == 18'd0 {
                    o_byte = 8'h09; // VB-ID
                } else {
                    o_byte = 8'h00; // Mvid7:0 / Maud7:0
                }
            }
        }
    }

    // ------ Frame counters ------
    always_ff (i_clk, i_rstn) {
        if_reset {
            byte_in_line = 0;
            line         = 0;
            idle_counter = 0;
            group_is_sr  = 0;
            // Initialize so the very first emitted BS is replaced by SR.
            // This anchors the sink scrambler at INIT from the first
            // K-comma it sees, eliminating the startup mismatch window.
            bs_count = (SR_PERIOD - 1) as bs_count_t;
        } else {
            if i_byte_tick && at_any_bs {
                // Latch the SR decision for the rest of this group before
                // the counter advances (non-blocking: use_sr_now still
                // reflects the pre-update bs_count here).
                group_is_sr = use_sr_now;
                if use_sr_now {
                    bs_count = 0;
                } else {
                    bs_count = bs_count + (1 as bs_count_t);
                }
            }
            if !i_video_enable {
                if i_byte_tick {
                    if idle_counter == 13'd8191 {
                        idle_counter = 0;
                    } else {
                        idle_counter = idle_counter + 13'd1;
                    }
                }
                byte_in_line = 0;
                line         = 0;
            } else {
                idle_counter = 0;
                if i_byte_tick {
                    if byte_in_line + 18'd1 >= bytes_per_line {
                        byte_in_line = 0;
                        if line + 16'd1 >= i_vtotal {
                            line = 0;
                        } else {
                            line = line + 16'd1;
                        }
                    } else {
                        byte_in_line = byte_in_line + 18'd1;
                    }
                }
            }
        }
    }
}
