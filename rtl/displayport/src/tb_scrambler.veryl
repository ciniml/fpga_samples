/**
 * @file tb_scrambler.veryl
 * @brief Phase B unit tests for the scrambler.
 *
 * scrambler_loopback verifies:
 *        - K-coded bytes pass through unchanged
 *        - Scrambling followed by descrambling (same module) recovers
 *          the original byte stream
 *        - Re-seeding via i_seed_reset does not break the round-trip
 *
 * scrambler_golden verifies the output against byte values computed with
 * the DP 1.2 Appendix E reference C code (resetLfsr/advanceLfsr/
 * scrambleByte). A loopback alone cannot catch a wrong LFSR topology —
 * both sides would share the error — so this golden comparison is the
 * test that pins the implementation to the spec:
 *        - 16 scrambled 0x00 bytes right after SR (first byte 0xFF,
 *          LFSR 0xFFFF -> 0xE817 -> ... per §3.1.6)
 *        - the LFSR advances across K-coded symbols (§3.1.6: "The LFSR
 *          advances on all symbols, both D and K")
 */

module TbScrambler {}

#[test(scrambler_loopback)]
embed (inline) sv{{{
module scrambler_loopback;
    logic clk;
    logic rstn;
    initial clk = 0;
    always #5 clk = ~clk;

    logic       a_seed_reset;
    logic       a_valid;
    logic [7:0] a_data;
    logic       a_is_k;

    logic       b_seed_reset;
    logic       b_valid;
    logic [7:0] b_data;
    logic       b_is_k;

    logic       c_valid;
    logic [7:0] c_data;
    logic       c_is_k;

    // Forward (TX) scrambler
    displayport_scrambler tx_scram (
        .i_clk              (clk),
        .i_rstn             (rstn),
        .i_seed_reset       (a_seed_reset),
        .i_scramble_disable (1'b0),
        .i_valid            (a_valid),
        .i_data             (a_data),
        .i_is_k             (a_is_k),
        .o_valid      (b_valid),
        .o_data       (b_data),
        .o_is_k       (b_is_k)
    );

    // Reverse (RX) descrambler — same module, same INIT seed.
    // SR detection on RX: assert seed_reset whenever the K-code 0x1C
    // (scrambler reset symbol) flows through.
    wire   rx_seed_reset = b_valid && b_is_k && (b_data == 8'h1C);
    displayport_scrambler rx_descram (
        .i_clk              (clk),
        .i_rstn             (rstn),
        .i_seed_reset       (rx_seed_reset),
        .i_scramble_disable (1'b0),
        .i_valid            (b_valid),
        .i_data             (b_data),
        .i_is_k             (b_is_k),
        .o_valid      (c_valid),
        .o_data       (c_data),
        .o_is_k       (c_is_k)
    );

    // Capture the input stream into a queue so we can compare against
    // the descrambled output. Two cycles of pipeline = two-deep delay.
    typedef struct packed {
        logic [7:0] data;
        logic       is_k;
    } sample_t;
    sample_t tx_pipe [0:1];

    integer mismatches;
    integer checked;

    initial begin
        rstn         = 1'b0;
        a_seed_reset = 1'b0;
        a_valid      = 1'b0;
        a_data       = 8'h00;
        a_is_k       = 1'b0;
        mismatches   = 0;
        checked      = 0;
        tx_pipe[0]   = '0;
        tx_pipe[1]   = '0;
        repeat (4) @(posedge clk);
        rstn = 1'b1;
        @(posedge clk);

        // Force matching seeds on both sides (reset symbol).
        a_valid      = 1'b1;
        a_is_k       = 1'b1;
        a_data       = 8'h1C; // SR
        a_seed_reset = 1'b1;
        @(posedge clk);
        a_seed_reset = 1'b0;
        a_is_k       = 1'b0;

        // Stream a deterministic pattern (256 D-bytes + 4 K-bytes interleaved).
        for (int i = 0; i < 320; i++) begin
            a_valid = 1'b1;
            if (i % 64 == 63) begin
                // Slip in a K-code; should bypass the scrambler.
                a_is_k = 1'b1;
                a_data = 8'hBC; // BS
            end else begin
                a_is_k = 1'b0;
                a_data = 8'(i & 8'hff);
            end
            @(posedge clk);
        end
        a_valid = 1'b0;

        // Drain the pipeline.
        repeat (8) @(posedge clk);

        if (mismatches != 0) begin
            $fatal(1, "[tb_scrambler] %0d mismatches across %0d samples", mismatches, checked);
        end
        if (checked < 200) begin
            $fatal(1, "[tb_scrambler] only checked %0d samples", checked);
        end
        $display("[tb_scrambler] PASS (%0d samples checked)", checked);
        $finish;
    end

    // Reference pipeline: capture (a_valid, a_data, a_is_k) two cycles
    // earlier and compare against the (c_valid, c_data, c_is_k) output.
    always_ff @(posedge clk) begin
        if (!rstn) begin
            tx_pipe[0] <= '0;
            tx_pipe[1] <= '0;
        end else begin
            tx_pipe[1] <= tx_pipe[0];
            if (a_valid) begin
                tx_pipe[0].data <= a_data;
                tx_pipe[0].is_k <= a_is_k;
            end else begin
                tx_pipe[0] <= '0;
            end
        end
    end

    always_ff @(posedge clk) begin
        if (rstn && c_valid) begin
            checked <= checked + 1;
            if (c_data !== tx_pipe[1].data || c_is_k !== tx_pipe[1].is_k) begin
                mismatches <= mismatches + 1;
                $display("[tb_scrambler] MISMATCH @%0t: expected data=%02h k=%b got data=%02h k=%b",
                         $time, tx_pipe[1].data, tx_pipe[1].is_k, c_data, c_is_k);
            end
        end
    end

    // Hard timeout
    initial begin
        #1_000_000;
        $fatal(1, "[tb_scrambler] timeout");
    end
endmodule
}}}

#[test(scrambler_golden)]
embed (inline) sv{{{
module scrambler_golden;
    logic clk;
    logic rstn;
    initial clk = 0;
    always #5 clk = ~clk;

    logic       seed_reset;
    logic       a_valid;
    logic [7:0] a_data;
    logic       a_is_k;

    logic       b_valid;
    logic [7:0] b_data;
    logic       b_is_k;

    displayport_scrambler u_scram (
        .i_clk              (clk),
        .i_rstn             (rstn),
        .i_seed_reset       (seed_reset),
        .i_scramble_disable (1'b0),
        .i_valid            (a_valid),
        .i_data             (a_data),
        .i_is_k             (a_is_k),
        .o_valid            (b_valid),
        .o_data             (b_data),
        .o_is_k             (b_is_k)
    );

    // Golden values computed with the DP 1.2 Appendix E reference code:
    // 0x00 data bytes scrambled right after an SR seed reset. The first
    // byte is 0xFF (LFSR = 0xFFFF) and the LFSR then advances to 0xE817,
    // 0x0328, ... as required by §3.1.6.
    localparam logic [7:0] GOLDEN_AFTER_SR [0:15] = '{
        8'hFF, 8'h17, 8'hC0, 8'h14, 8'hB2, 8'hE7, 8'h02, 8'h82,
        8'h72, 8'h6E, 8'h28, 8'hA6, 8'hBE, 8'h6D, 8'hBF, 8'h8D
    };
    // 0x00 data bytes following ONE K-coded symbol (which is not
    // scrambled but must still advance the LFSR by 8 steps).
    localparam logic [7:0] GOLDEN_AFTER_K [0:3] = '{
        8'h40, 8'hA7, 8'hE6, 8'h2C
    };

    integer errors;

    task automatic push(input logic [7:0] d, input logic k, input logic sr);
        a_valid    = 1'b1;
        a_data     = d;
        a_is_k     = k;
        seed_reset = sr;
        @(posedge clk);
        #1;
    endtask

    task automatic expect_out(input logic [7:0] d, input logic k, input string what);
        if (!b_valid || b_data !== d || b_is_k !== k) begin
            errors = errors + 1;
            $display("[tb_scrambler_golden] MISMATCH (%s): expected (%02h, k=%b) got (valid=%b, %02h, k=%b)",
                     what, d, k, b_valid, b_data, b_is_k);
        end
    endtask

    initial begin
        rstn       = 1'b0;
        seed_reset = 1'b0;
        a_valid    = 1'b0;
        a_data     = 8'h00;
        a_is_k     = 1'b0;
        errors     = 0;
        repeat (4) @(posedge clk);
        rstn = 1'b1;
        @(posedge clk);

        // SR symbol with seed reset. Passes through unchanged.
        push(8'h1C, 1'b1, 1'b1);
        expect_out(8'h1C, 1'b1, "SR passthrough");

        // 16 zero bytes: must match the Appendix E reference sequence.
        for (int i = 0; i < 16; i++) begin
            push(8'h00, 1'b0, 1'b0);
            expect_out(GOLDEN_AFTER_SR[i], 1'b0, $sformatf("byte %0d after SR", i));
        end

        // One K-coded byte (BS): passes through un-scrambled but the
        // LFSR must advance across it.
        push(8'hBC, 1'b1, 1'b0);
        expect_out(8'hBC, 1'b1, "K passthrough");

        for (int i = 0; i < 4; i++) begin
            push(8'h00, 1'b0, 1'b0);
            expect_out(GOLDEN_AFTER_K[i], 1'b0, $sformatf("byte %0d after K", i));
        end

        a_valid = 1'b0;
        repeat (4) @(posedge clk);

        if (errors != 0) begin
            $fatal(1, "[tb_scrambler_golden] %0d mismatches", errors);
        end
        $display("[tb_scrambler_golden] PASS");
        $finish;
    end

    initial begin
        #1_000_000;
        $fatal(1, "[tb_scrambler_golden] timeout");
    end
endmodule
}}}
