/**
 * @file main_link_tx.veryl
 * @brief DisplayPort main-link TX wrapper. Phase D forwards video pipeline
 *        ports through to a single lane instance.
 */

pub module main_link_tx #(
    param ENABLE_LANES2: u32 = 1,
    param SR_PERIOD:            u32 = 512,
    param CONTINUOUS_BYTE_TICK: u32 = 0,
) (
    i_clk:  input clock_posedge,
    i_rstn: input reset_sync_low,

    i_pattern_select:   input logic<2>,
    i_enable:           input logic,
    i_rd_reset:         input logic,
    i_lane_count:       input logic<3>,
    // Enhanced Framing Mode (DP 1.2 §2.2.1.2): BS/SR become 4-symbol
    // sequences. Must be enabled when the sink's DPCD revision is 1.2+.
    i_enhanced_framing: input logic,

    // Video pipeline inputs (forwarded to lane 0 in Phase D).
    i_video_enable: input logic,
    i_htotal:       input logic<16>,
    i_vtotal:       input logic<16>,
    i_hstart:       input logic<16>,
    i_vstart:       input logic<16>,
    i_hwidth:       input logic<16>,
    i_vheight:      input logic<16>,
    i_hsw_hsp:      input logic<16>,
    i_vsw_vsp:      input logic<16>,
    i_mvid:         input logic<24>,
    i_nvid:         input logic<24>,
    i_misc:         input logic<16>,
    i_tu_active:    input logic<7>,
    i_line_symbols: input logic<16>,
    i_active_window: input logic<16>,
    i_four_lane:    input logic,
    i_two_lane:     input logic,
    i_alt_seed:     input logic,

    // AXI-Stream pixel input (24bpp RGB)
    s_axis_tvalid: input  logic,
    s_axis_tready: output logic,
    s_axis_tdata:  input  logic<24>,

    o_lane0_bit:          output logic,
    o_lane0_bit_valid:    output logic,
    o_lane0_symbol_valid: output logic,
    o_lane0_symbol:       output logic<10>,
    o_lane1_symbol:       output logic<10>,
    o_lane2_symbol:       output logic<10>,
    o_lane3_symbol:       output logic<10>,
) {
    let _unused_lane_count: logic<3> = i_lane_count;

    inst u_lane0: main_link_tx_lane #(
        ENABLE_LANES2: ENABLE_LANES2,
        SR_PERIOD:            SR_PERIOD,
        CONTINUOUS_BYTE_TICK: CONTINUOUS_BYTE_TICK,
    ) (
        i_clk             : i_clk,
        i_rstn            : i_rstn,
        i_pattern_select  : i_pattern_select,
        i_enable          : i_enable,
        i_rd_reset        : i_rd_reset,
        i_enhanced_framing: i_enhanced_framing,
        i_video_enable    : i_video_enable,
        i_htotal        : i_htotal,
        i_vtotal        : i_vtotal,
        i_hstart        : i_hstart,
        i_vstart        : i_vstart,
        i_hwidth        : i_hwidth,
        i_vheight       : i_vheight,
        i_hsw_hsp       : i_hsw_hsp,
        i_vsw_vsp       : i_vsw_vsp,
        i_mvid          : i_mvid,
        i_nvid          : i_nvid,
        i_misc          : i_misc,
        i_tu_active     : i_tu_active,
        i_line_symbols  : i_line_symbols,
        i_active_window : i_active_window,
        i_four_lane     : i_four_lane,
        i_two_lane      : i_two_lane,
        i_alt_seed      : i_alt_seed,
        s_axis_tvalid   : s_axis_tvalid,
        s_axis_tready   : s_axis_tready,
        s_axis_tdata    : s_axis_tdata,
        o_bit           : o_lane0_bit,
        o_bit_valid     : o_lane0_bit_valid,
        o_symbol_valid  : o_lane0_symbol_valid,
        o_symbol        : o_lane0_symbol,
        o_symbol1       : o_lane1_symbol,
        o_symbol2       : o_lane2_symbol,
        o_symbol3       : o_lane3_symbol,
    );
}
