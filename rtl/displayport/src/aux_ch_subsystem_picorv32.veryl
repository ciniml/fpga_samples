/**
 * @file aux_ch_subsystem.veryl
 * @brief DisplayPort AUX_CH Subsystem
 */

pub module aux_ch_subsystem_picorv32 #(
    param CLOCK_HZ: u32 = 32'd100_000_000,  // Clock frequency (default = 100MHz)
    param MANCHESTER_CLOCK_HZ: u32 = 32'd1_000_000,  // Manchester clock frequency (default = 1MHz)
    param PRECHARGE_CYCLES: u32 = 32'd16,   // Number of precharge cycles
    param BUFFER_SIZE: u32 = 256,           // Buffer size
    param DEBUG_OUT: bit = 0,               // Enable debug output messages
    param PROCESSOR_ID: u32 = 32'h01234567, // Processor ID
    param PROCESSOR_ROM_SIZE: u32 = 8192,   // Processor ROM size (default = 8kB)
    param PROCESSOR_RAM_SIZE: u32 = 8192,   // Processor RAM size (default = 8kB)
    local REGISTER_COUNT: u32 = 32,         // Number of registers
) (
    clock:   input logic,
    aresetn: input logic,

    // AUX_CH input
    aux_ch_in:        input logic,
    // AUX_CH output
    aux_ch_out:        output logic,
    aux_ch_out_enable: output logic,

    // CPU output
    cpu_io_out: output logic<32>,

    // Serial output
    maxis_serial_out_tvalid: output logic,
    maxis_serial_out_tready: input  logic,
    maxis_serial_out_tdata : output logic<8>,
) {
    type U32 = logic<32>;
    
    local PROCESSOR_ROM_ADDRESS_WIDTH: u32 = $clog2(PROCESSOR_ROM_SIZE/4);  // プロセッサのROMアドレス幅
    type rom_address_t = logic<PROCESSOR_ROM_ADDRESS_WIDTH>;
    var processor_rom: logic<32>[PROCESSOR_ROM_SIZE/4];  // プロセッサのプログラムメモリ
    local PROCESSOR_RAM_ADDRESS_WIDTH: u32 = $clog2(PROCESSOR_RAM_SIZE/4);  // プロセッサのRAMアドレス幅
    type ram_address_t = logic<PROCESSOR_RAM_ADDRESS_WIDTH>;
    var processor_ram: logic<32>[PROCESSOR_RAM_SIZE/4];  // プロセッサのメモリ

    // PicoRV32 メモリインターフェース信号
    var mem_valid: logic;
    var mem_instr: logic;
    var mem_ready: logic;
    var mem_addr : logic<32>;
    var mem_wdata: logic<32>;
    var mem_wstrb: logic<4>;
    var mem_rdata: logic<32>;

    // Pico Co-Processor Interface (PCPI)
    // PicoRV32固有のCPUのコプロセッサを繋ぐインターフェース (未使用)
    var pcpi_valid: logic;
    var pcpi_insn : logic<32>;
    var pcpi_rs1  : logic<32>;
    var pcpi_rs2  : logic<32>;
    var pcpi_wr   : logic;
    var pcpi_rd   : logic<32>;
    var pcpi_wait : logic;
    var pcpi_ready: logic;

    always_comb {
        pcpi_wr = 0;
        pcpi_rd = 0;
        pcpi_wait = 0;
        pcpi_ready = 0;
    }

    // 割り込みインターフェース (未使用)
    var irq: logic<32>;
    var eoi: logic<32>;
    // Look-Ahead インターフェース (未使用)
    var mem_la_read : logic;
    var mem_la_write: logic;
    var mem_la_addr : logic<32>;
    var mem_la_wdata: logic<32>;
    var mem_la_wstrb: logic<4>;
    var trap: logic;
    // トレースIF (未使用)
    var trace_valid: logic;
    var trace_data: logic<36>;

    // PicoRV32のインスタンス
    inst picorv_inst: $sv::picorv32 #(
        PROGADDR_RESET: 32'h8000_0000,  // リセットアドレス = 32'h8000_0000
        ENABLE_IRQ: 1,  // 割り込み有効
    ) (
        clk:    clock,    // クロック
        resetn: aresetn,  // リセット
        mem_valid,
        mem_instr,
        mem_ready,
        mem_addr,
        mem_wdata,
        mem_wstrb,
        mem_rdata,
        pcpi_valid,
        pcpi_insn,
        pcpi_rs1,
        pcpi_rs2,
        pcpi_wr,
        pcpi_rd,
        pcpi_wait,
        pcpi_ready,
        irq,
        eoi,
        mem_la_read,
        mem_la_write,
        mem_la_addr,
        mem_la_wdata,
        mem_la_wstrb,
        trap,
        trace_valid,
        trace_data,
    );
    
    var mem_read: logic;
    assign mem_read = mem_wstrb == '0;

    local IBUS_MEM_SPACE: logic<4> = 4'h8;   // 命令メモリ空間   : 32'h8000_0000 ~ 32'h8fff_ffff
    local DBUS_MEM_SPACE: logic<4> = 4'h2;   // データメモリ空間 : 32'h2000_0000 ~ 32'h2fff_ffff
    local REG_MEM_SPACE : logic<4> = 4'h4;   // レジスタメモリ空間: 32'h4000_0000 ~ 32'h4fff_ffff
    local REG_SPACE_SYSTEM: logic<12> = 12'h000;  // システムレジスタ
    local REG_SPACE_AUX_CH: logic<12> = 12'h001;  // AUX_CHレジスタ
    local REG_SYSTEM_ID      : logic<14> = 14'h0000;  // IDレジスタ
    local REG_SYSTEM_CLOCK_HZ: logic<14> = 14'h0001;  // クロック周波数レジスタ
    local REG_SYSTEM_OUT     : logic<14> = 14'h0002;  // OUTレジスタ
    local REG_SYSTEM_SERIAL_OUT: logic<14> = 14'h0003;  // SERIAL_OUTレジスタ

    var mem_space: logic<4>;
    var is_mem_space_ibus: logic;
    var is_mem_space_dbus: logic;
    var is_mem_space_reg: logic;
    always_comb {
        mem_space = mem_addr[31:28];
        is_mem_space_ibus = (mem_space == IBUS_MEM_SPACE);
        is_mem_space_dbus = (mem_space == DBUS_MEM_SPACE);
        is_mem_space_reg = (mem_space == REG_MEM_SPACE);
    }

    var reg_space: logic<12>;
    always_comb {
        reg_space = mem_addr[27:16];
    }

    var aux_ch_address: logic<9>;
    var aux_ch_read_en: logic;
    var aux_ch_read_data: logic<8>;
    var aux_ch_write_en: logic;
    var aux_ch_write_data: logic<8>;
    var aux_ch_interrupt: logic;

    inst aux_ch_inst: aux_ch_peripheral #(

    ) (
        clock,
        aresetn,

        mcu_address   : aux_ch_address,
        mcu_read_en   : aux_ch_read_en,
        mcu_read_data : aux_ch_read_data,
        mcu_write_en  : aux_ch_write_en,
        mcu_write_data: aux_ch_write_data,
        mcu_interrupt : aux_ch_interrupt,

        aux_ch_in,
        aux_ch_out,
        aux_ch_out_enable,
    );

    type aux_ch_address_t = logic<9>;
    always_comb {
        let is_aux_ch_address: logic = (mem_addr[31:28] == REG_MEM_SPACE && mem_addr[27:16] == REG_SPACE_AUX_CH);
        aux_ch_address = mem_addr[8:0] as aux_ch_address_t;
        aux_ch_read_en = mem_valid && !mem_instr && mem_read && is_aux_ch_address;
        aux_ch_write_en = mem_valid && !mem_instr && mem_wstrb[0] && is_aux_ch_address;
        aux_ch_write_data = mem_wdata[7:0];
    }

    always_ff (clock, aresetn) {
        if_reset {
            mem_ready = 0;
            mem_rdata = 0;
        } else {
            mem_ready = 0;
            if maxis_serial_out_tvalid && maxis_serial_out_tready {
                maxis_serial_out_tvalid = 0;
            }
            
            if mem_valid && !mem_ready {
                mem_ready = 1;

                if mem_read {
                    mem_rdata = 0;
                    if is_mem_space_reg {
                        case reg_space {
                            REG_SPACE_SYSTEM: {
                                case mem_addr[15:2] {
                                    REG_SYSTEM_ID: mem_rdata = PROCESSOR_ID;
                                    REG_SYSTEM_CLOCK_HZ: mem_rdata = CLOCK_HZ;
                                    REG_SYSTEM_OUT: mem_rdata = cpu_io_out;
                                    REG_SYSTEM_SERIAL_OUT: mem_rdata = {23'0, maxis_serial_out_tvalid, maxis_serial_out_tdata};
                                    default: mem_rdata = 0;
                                }
                            }
                            REG_SPACE_AUX_CH: {
                                mem_rdata = {24'0, aux_ch_read_data};
                            }
                            default: mem_rdata = 0;
                        }
                    }
                    if is_mem_space_ibus {
                        mem_rdata = processor_rom[mem_addr[2 +: PROCESSOR_ROM_ADDRESS_WIDTH]];
                    }
                    if is_mem_space_dbus {
                        mem_rdata = processor_ram[mem_addr[2 +: PROCESSOR_RAM_ADDRESS_WIDTH]];
                    }
                } else {
                    let mask: logic<32> = {mem_wstrb[3] repeat 8, mem_wstrb[2] repeat 8, mem_wstrb[1] repeat 8, mem_wstrb[0] repeat 8};
                    let masked_data: logic<32> = mem_wdata & mask;
                    if is_mem_space_reg {
                        case reg_space {
                            REG_SPACE_SYSTEM: {
                                case mem_addr[15:2] {
                                    REG_SYSTEM_OUT: cpu_io_out = (cpu_io_out & ~mask) | masked_data;
                                    REG_SYSTEM_SERIAL_OUT: {
                                        if mem_wstrb[0] && (!maxis_serial_out_tvalid || maxis_serial_out_tready) {
                                            maxis_serial_out_tdata = mem_wdata[7:0];
                                            maxis_serial_out_tvalid = 1;
                                        }
                                    }
                                    default: {}
                                }
                            }
                            REG_SPACE_AUX_CH: {
                                // Nothing to do.
                            }
                            default: {}
                        }
                    }
                    if is_mem_space_dbus {
                        processor_ram[mem_addr[2 +: PROCESSOR_RAM_ADDRESS_WIDTH]] = (processor_ram[mem_addr[2 +: PROCESSOR_RAM_ADDRESS_WIDTH]] & ~mask) | masked_data;
                    }
                }
            }
        }
    }
}