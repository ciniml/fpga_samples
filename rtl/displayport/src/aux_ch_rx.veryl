/**
 * @file aux_ch_rx.veryl
 * @brief DisplayPort AUX_CH RX module
 */

pub module aux_ch_rx #(
    param CLOCK_HZ: u32 = 32'd100_000_000,  // Clock frequency (default = 100MHz)
    param MANCHESTER_CLOCK_HZ: u32 = 32'd1_000_000,  // Manchester clock frequency (default = 1MHz)
    param DEBUG_OUT: bit = 0,               // Enable debug output messages
) (
    clock: input logic,
    aresetn: input logic,

    // AUX_CH data stream output
    maxis_data_tvalid: output logic,
    maxis_data_tready: input logic,
    maxis_data_tdata : output logic<8>,
    maxis_data_tlast : output logic,

    // AUX_CH input
    aux_ch_in:        input logic,
) {
    local CLOCK_COUNT_MAX: u32 = (CLOCK_HZ / MANCHESTER_CLOCK_HZ) - 1;   // Max clock counter value
    type clock_counter_t = logic<$clog2(CLOCK_COUNT_MAX + 1)>;
    type U32 = u32;
    var clock_counter: clock_counter_t;

    function rounded_clock_count(clock_hz: input u32, target_clock_hz: input u32) -> clock_counter_t {
        let clock_count: u32 = ((clock_hz + target_clock_hz/2 - 1) / target_clock_hz);
        return (if clock_count == 0 { 0 } else { clock_count - 1 }) as clock_counter_t;
    }

    local CLOCK_COUNT_HALF: clock_counter_t = rounded_clock_count(CLOCK_HZ * 1, MANCHESTER_CLOCK_HZ * 2);
    local CLOCK_COUNT_1_4 : clock_counter_t = rounded_clock_count(CLOCK_HZ * 1, MANCHESTER_CLOCK_HZ * 4);
    local CLOCK_COUNT_3_4 : clock_counter_t = rounded_clock_count(CLOCK_HZ * 3, MANCHESTER_CLOCK_HZ * 4);

    var symbol_buffer: logic<16>;
    var next_valid: logic;
    var next_buffer: logic<8>;
    var aux_ch_in_prev: logic;

    enum State: logic<2> {
        IDLE,
        SYNC_END,
        RECEIVE,
    }

    var state: State;
    type symbol_counter_t = logic<4>;
    var symbol_counter: symbol_counter_t;

    always_ff (clock, aresetn) {
        if_reset {
            clock_counter = 0;
            
            symbol_buffer = 0;
            symbol_counter = 0;
            state = State::IDLE;
            
            next_valid = 0;
            next_buffer = 0;

            aux_ch_in_prev = 0;

            maxis_data_tvalid = 0;
            maxis_data_tdata = 0;
            maxis_data_tlast = 0;
        } else {
            aux_ch_in_prev = aux_ch_in;

            if maxis_data_tvalid && maxis_data_tready {
                maxis_data_tvalid = 0;
            }

            // default clock counter operation: increment
            clock_counter = clock_counter + 1;

            case state {
                State::IDLE: {
                    let clock_max: clock_counter_t = CLOCK_COUNT_HALF * 2 + 1;
                    let sync_end: logic = symbol_buffer[15:0] == 16'b01010101_11110000; // SYNC last 4 symbols + SYNC_END HHLL

                    next_valid = 0;

                    if aux_ch_in_prev != aux_ch_in {
                        clock_counter = 0;
                        if sync_end { // SYNC end
                            // Must be at the edge of the first `1` bit.
                            symbol_counter = 0;
                            state = State::RECEIVE;
                        }
                    }
                    if clock_counter == CLOCK_COUNT_1_4 {
                        symbol_buffer = {symbol_buffer[14:0], aux_ch_in};
                    }
                    if clock_counter == CLOCK_COUNT_3_4 {
                        symbol_buffer = {symbol_buffer[14:0], aux_ch_in};
                    }
                    if clock_counter == CLOCK_COUNT_MAX as clock_counter_t {
                        clock_counter = 0;
                        if sync_end { // SYNC end
                            // Must be at the edge of the first `0` or `1` bit.
                            symbol_counter = 0;
                            state = State::RECEIVE;
                        }
                    } 
                }
                State::RECEIVE: {
                    if aux_ch_in_prev != aux_ch_in {
                        // Resync to the edge.
                        clock_counter = 0;
                    }
                    if clock_counter == CLOCK_COUNT_MAX as clock_counter_t {
                        clock_counter = 0;
                    }
                    let is_sample_point: logic = clock_counter == CLOCK_COUNT_1_4 || clock_counter == CLOCK_COUNT_3_4;   // Sample at 1/4 or 3/4 of the clock period.
                    
                    if is_sample_point {
                        let next_symbol_buffer: logic<16> = {symbol_buffer[14:0], aux_ch_in};
                        symbol_buffer = next_symbol_buffer;

                        if symbol_counter[0] && next_symbol_buffer[7:0] == 8'b11110000 { // STOP
                            maxis_data_tvalid = 1;
                            maxis_data_tdata = next_buffer;
                            maxis_data_tlast = 1;
                            symbol_buffer = 0;
                            state = State::IDLE;
                        }
                        if symbol_counter == (16 - 1) as symbol_counter_t {
                            let next_symbol_valid: logic = &({next_symbol_buffer[15] ^ next_symbol_buffer[14], next_symbol_buffer[13] ^ next_symbol_buffer[12], next_symbol_buffer[11] ^ next_symbol_buffer[10], next_symbol_buffer[9] ^ next_symbol_buffer[8], next_symbol_buffer[7] ^ next_symbol_buffer[6], next_symbol_buffer[5] ^ next_symbol_buffer[4], next_symbol_buffer[3] ^ next_symbol_buffer[2], next_symbol_buffer[1] ^ next_symbol_buffer[0]});
                            symbol_counter = '0;
                            next_valid = 0;

                            if next_valid {
                                // Push out the buffer data.
                                maxis_data_tvalid = 1;
                                maxis_data_tdata = next_buffer;
                                maxis_data_tlast = !next_symbol_valid;  // If the next symbol is invalid, Treat this as the last data and end the transmission.
                            }
                            if !next_symbol_valid {
                                symbol_buffer = 0;
                                state = State::IDLE;
                            } else {
                                next_buffer = {next_symbol_buffer[15], next_symbol_buffer[13], next_symbol_buffer[11], next_symbol_buffer[9], next_symbol_buffer[7], next_symbol_buffer[5], next_symbol_buffer[3], next_symbol_buffer[1]};
                                next_valid = 1;
                            }
                        } else {
                            symbol_counter = symbol_counter + 1;
                        }
                    }
                }
                default: {
                    state = State::IDLE;
                }
            }
        }
    }
}