/**
 * @file aux_ch_subsystem.veryl
 * @brief DisplayPort AUX_CH Subsystem
 */

pub module aux_ch_subsystem #(
    param CLOCK_HZ: u32 = 32'd100_000_000,  // Clock frequency (default = 100MHz)
    param MANCHESTER_CLOCK_HZ: u32 = 32'd1_000_000,  // Manchester i_clk frequency (default = 1MHz)
    param PRECHARGE_CYCLES: u32 = 32'd16,   // Number of precharge cycles
    param BUFFER_SIZE: u32 = 256,           // Buffer size
    param DEBUG_OUT: logic<1> = 1'b0,               // Enable debug output messages
    param PROCESSOR_ID: u32 = 32'h01234567, // Processor ID
    param PROCESSOR_ROM_SIZE: u32 = 8192,   // Processor ROM size (default = 8kB)
    param PROCESSOR_RAM_SIZE: u32 = 8192,   // Processor RAM size (default = 8kB)
    param PROCESSOR_ROM_FILE: string = "",  // Processor ROM file
) (
    i_clk:   input clock_posedge,
    i_rstn: input reset_sync_low,

    // AUX_CH input
    aux_ch_in:        input logic,
    // AUX_CH output
    aux_ch_out:        output logic,
    aux_ch_out_enable: output logic,

    // Hot Plug Detect (DP 1.2 §3.3)
    hpd_in: input logic,

    // CPU output
    cpu_io_out: output logic<32>,

    // Serial input
    saxis_serial_in_tvalid: input  logic,
    saxis_serial_in_tready: output logic,
    saxis_serial_in_tdata : input  logic<8>,

    // Serial output
    maxis_serial_out_tvalid: output logic,
    maxis_serial_out_tready: input  logic,
    maxis_serial_out_tdata : output logic<8>,

    // Main link control outputs (driven from MAIN_LINK CPU registers).
    // See DP 1.2 §3.5.1.2 for semantics.
    main_link_pattern_select: output logic<2>,  // 00=IDLE, 01=TPS1, 10=TPS2, 11=reserved
    main_link_enable:         output logic,     // 1 = main link emits symbols
    main_link_rd_reset:       output logic,     // 1-cycle pulse forcing RD- on next byte
    main_link_lane_count:     output logic<3>,  // 1, 2, or 4
    main_link_lane0_drive:    output logic<8>,  // [1:0]=swing, [4:3]=preemph (informational)
    // 1 = Enhanced Framing Mode (BS/SR sent as 4-symbol sequences, §2.2.1.2).
    // Set by FW together with ENHANCED_FRAME_EN (DPCD 101h bit7).
    main_link_enhanced_framing: output logic,

    // Video pipeline control outputs (driven from VIDEO CPU registers).
    // See DP 1.2 §2.2.4 for MSA field semantics.
    video_enable:    output logic,
    video_htotal:    output logic<16>,
    video_vtotal:    output logic<16>,
    video_hstart:    output logic<16>,
    video_vstart:    output logic<16>,
    video_hwidth:    output logic<16>,
    video_vheight:   output logic<16>,
    video_hsw_hsp:   output logic<16>,  // [14:0]=HSW, [15]=HSP
    video_vsw_vsp:   output logic<16>,
    video_mvid:      output logic<24>,
    video_nvid:      output logic<24>,
    video_misc:      output logic<16>,  // [7:0]=MISC0, [15:8]=MISC1
    video_tu_active: output logic<7>,
) {
    type U32 = logic<32>;
    
    const PROCESSOR_ROM_ADDRESS_WIDTH: u32 = $clog2(PROCESSOR_ROM_SIZE/4);  // プロセッサのROMアドレス幅
    type rom_address_t = logic<PROCESSOR_ROM_ADDRESS_WIDTH>;
    var processor_rom: logic<32>[PROCESSOR_ROM_SIZE/4];  // プロセッサのプログラムメモリ
    const PROCESSOR_RAM_ADDRESS_WIDTH: u32 = $clog2(PROCESSOR_RAM_SIZE/4);  // プロセッサのRAMアドレス幅
    type ram_address_t = logic<PROCESSOR_RAM_ADDRESS_WIDTH>;
    var processor_ram: logic<32>[PROCESSOR_RAM_SIZE/4];  // プロセッサのメモリ

    initial {
        if (PROCESSOR_ROM_FILE != "") {
            $readmemh(PROCESSOR_ROM_FILE, processor_rom);
        }
    }

    // PicoRV32 メモリインターフェース信号
    var mem_addr : logic<32>;
    var mem_wdata: logic<32>;
    var mem_wmask: logic<4>;
    var mem_rdata: logic<32>;
    var mem_rstrb: logic;
    var mem_rbusy: logic;
    var mem_wbusy: logic;

    var interrupt_request: logic;
    var processor_reset: logic;

    // FemtoRV32 reset は active-low。i_rstn と processor_reset の AND を渡す。
    let femtorv_reset_n: logic = i_rstn && !processor_reset;

    inst femtorv_inst: $sv::displayport_femtorv_wrap #(
        RESET_ADDR: 32'h8000_0000,
        ADDR_WIDTH: 32,
    ) (
        i_clk            : i_clk            ,
        i_reset_n        : femtorv_reset_n  ,
        mem_addr         : mem_addr         ,
        mem_wdata        : mem_wdata        ,
        mem_wmask        : mem_wmask        ,
        mem_rdata        : mem_rdata        ,
        mem_rstrb        : mem_rstrb        ,
        mem_rbusy        : mem_rbusy        ,
        mem_wbusy        : mem_wbusy        ,
        interrupt_request: interrupt_request,
    );
    
    always_comb {
        mem_wbusy = 0;
        interrupt_request = 0;
    }

    var mem_read: logic;
    assign mem_read = mem_wmask == '0;

    const IBUS_MEM_SPACE: logic<4> = 4'h8;   // 命令メモリ空間   : 32'h8000_0000 ~ 32'h8fff_ffff
    const DBUS_MEM_SPACE: logic<4> = 4'h2;   // データメモリ空間 : 32'h2000_0000 ~ 32'h2fff_ffff
    const REG_MEM_SPACE : logic<4> = 4'h4;   // レジスタメモリ空間: 32'h4000_0000 ~ 32'h4fff_ffff
    const REG_SPACE_SYSTEM   : logic<12> = 12'h000;  // システムレジスタ
    const REG_SPACE_AUX_CH   : logic<12> = 12'h001;  // AUX_CHレジスタ
    const REG_SPACE_MAIN_LINK: logic<12> = 12'h002;  // メインリンク制御 (Phase C, DP 1.2 §3.5)
    const REG_SPACE_VIDEO    : logic<12> = 12'h003;  // 映像パイプライン (Phase D, DP 1.2 §2.2)
    const REG_SYSTEM_ID        : logic<14> = 14'h0000;  // IDレジスタ
    const REG_SYSTEM_CLOCK_HZ  : logic<14> = 14'h0001;  // クロック周波数レジスタ
    const REG_SYSTEM_OUT       : logic<14> = 14'h0002;  // OUTレジスタ
    const REG_SYSTEM_SERIAL_OUT: logic<14> = 14'h0003;  // SERIAL_OUTレジスタ
    const REG_SYSTEM_HPD       : logic<14> = 14'h0004;  // HPD ステータス (DP 1.2 §3.3)
    const REG_MAIN_LINK_CTRL       : logic<14> = 14'h0000;  // [1:0]=pattern, [4]=enable, [5]=rd_reset (W1P)
    const REG_MAIN_LINK_LANE_COUNT : logic<14> = 14'h0001;  // [2:0]=1/2/4
    const REG_MAIN_LINK_LANE0_DRIVE: logic<14> = 14'h0002;  // [1:0]=swing, [4:3]=preemphasis
    const REG_VIDEO_CTRL     : logic<14> = 14'h0000;  // [0]=enable
    const REG_VIDEO_HTOTAL   : logic<14> = 14'h0001;
    const REG_VIDEO_VTOTAL   : logic<14> = 14'h0002;
    const REG_VIDEO_HSTART   : logic<14> = 14'h0003;
    const REG_VIDEO_VSTART   : logic<14> = 14'h0004;
    const REG_VIDEO_HWIDTH   : logic<14> = 14'h0005;
    const REG_VIDEO_VHEIGHT  : logic<14> = 14'h0006;
    const REG_VIDEO_HSW_HSP  : logic<14> = 14'h0007;
    const REG_VIDEO_VSW_VSP  : logic<14> = 14'h0008;
    const REG_VIDEO_MVID     : logic<14> = 14'h0009;
    const REG_VIDEO_NVID     : logic<14> = 14'h000A;
    const REG_VIDEO_MISC     : logic<14> = 14'h000B;
    const REG_VIDEO_TU_ACTIVE: logic<14> = 14'h000C;

    var mem_space: logic<4>;
    var is_mem_space_ibus: logic;
    var is_mem_space_dbus: logic;
    var is_mem_space_reg: logic;
    always_comb {
        mem_space = mem_addr[31:28];
        is_mem_space_ibus = (mem_space == IBUS_MEM_SPACE);
        is_mem_space_dbus = (mem_space == DBUS_MEM_SPACE);
        is_mem_space_reg = (mem_space == REG_MEM_SPACE);
    }

    var reg_space: logic<12>;
    always_comb {
        reg_space = mem_addr[27:16];
    }

    var aux_ch_address: logic<9>;
    var aux_ch_read_en: logic;
    var aux_ch_read_data: logic<8>;
    var aux_ch_write_en: logic;
    var aux_ch_write_data: logic<8>;
    var aux_ch_interrupt: logic;

    // Half-duplex turnaround guard: while this side drives the AUX pair,
    // a bidirectional pad (e.g. TLVDS_IOBUF) feeds our own transmission
    // back into aux_ch_in. The armed RX would then decode our own
    // request as the "reply" (observed on hardware as a Protocol error
    // with rx_count equal to the request header length). Force the RX
    // input to the idle level while transmitting. Simulation testbenches
    // wire only the peer's output, so this is a no-op there.
    let aux_ch_in_rx: logic = if aux_ch_out_enable ? 1'b0 : aux_ch_in;

    inst aux_ch_inst: aux_ch_peripheral #(
        CLOCK_HZ,
        MANCHESTER_CLOCK_HZ,
        PRECHARGE_CYCLES,
        BUFFER_SIZE,
        DEBUG_OUT,
    ) (
        i_clk,
        i_rstn,

        mcu_address   : aux_ch_address,
        mcu_read_en   : aux_ch_read_en,
        mcu_read_data : aux_ch_read_data,
        mcu_write_en  : aux_ch_write_en,
        mcu_write_data: aux_ch_write_data,
        mcu_interrupt : aux_ch_interrupt,

        aux_ch_in     : aux_ch_in_rx,
        aux_ch_out,
        aux_ch_out_enable,
    );

    // HPD 検出 (DP 1.2 §3.3)
    var hpd_level:        logic;
    var hpd_event_plug:   logic;
    var hpd_event_unplug: logic;
    var hpd_event_irq:    logic;
    var hpd_event_plug_sticky:   logic;
    var hpd_event_unplug_sticky: logic;
    var hpd_event_irq_sticky:    logic;

    inst hpd_detect_inst: hpd_detect #(
        CLOCK_HZ,
    ) (
        i_clk,
        i_rstn,
        hpd_in,
        hpd_level,
        hpd_event_plug,
        hpd_event_unplug,
        hpd_event_irq,
    );

    // Main link control registers (DP 1.2 §3.5).
    var ml_pattern_select:   logic<2>;
    var ml_enable:           logic;
    var ml_rd_reset_pulse:   logic; // 1 cycle pulse on writes with bit[5]=1
    var ml_lane_count:       logic<3>;
    var ml_lane0_drive:      logic<8>;
    var ml_enhanced_framing: logic;

    // Video pipeline registers (DP 1.2 §2.2).
    var v_enable:    logic;
    var v_htotal:    logic<16>;
    var v_vtotal:    logic<16>;
    var v_hstart:    logic<16>;
    var v_vstart:    logic<16>;
    var v_hwidth:    logic<16>;
    var v_vheight:   logic<16>;
    var v_hsw_hsp:   logic<16>;
    var v_vsw_vsp:   logic<16>;
    var v_mvid:      logic<24>;
    var v_nvid:      logic<24>;
    var v_misc:      logic<16>;
    var v_tu_active: logic<7>;

    always_comb {
        main_link_pattern_select   = ml_pattern_select;
        main_link_enable           = ml_enable;
        main_link_rd_reset         = ml_rd_reset_pulse;
        main_link_lane_count       = ml_lane_count;
        main_link_lane0_drive      = ml_lane0_drive;
        main_link_enhanced_framing = ml_enhanced_framing;

        video_enable    = v_enable;
        video_htotal    = v_htotal;
        video_vtotal    = v_vtotal;
        video_hstart    = v_hstart;
        video_vstart    = v_vstart;
        video_hwidth    = v_hwidth;
        video_vheight   = v_vheight;
        video_hsw_hsp   = v_hsw_hsp;
        video_vsw_vsp   = v_vsw_vsp;
        video_mvid      = v_mvid;
        video_nvid      = v_nvid;
        video_misc      = v_misc;
        video_tu_active = v_tu_active;
    }

    type aux_ch_address_t = logic<9>;
    var mem_buffer: logic<32>;
    always_comb {
        let is_aux_ch_address: logic = (mem_addr[31:28] == REG_MEM_SPACE && mem_addr[27:16] == REG_SPACE_AUX_CH);
        aux_ch_address = mem_addr[2 +: 9] as aux_ch_address_t;
        aux_ch_read_en = mem_rstrb && is_aux_ch_address;
        aux_ch_write_en = mem_wmask[0] && is_aux_ch_address;
        aux_ch_write_data = mem_wdata[7:0];
        mem_rbusy = 0;

        mem_rdata = 0;
        if is_mem_space_reg {
            case reg_space {
                REG_SPACE_SYSTEM: {
                    case mem_addr[15:2] {
                        REG_SYSTEM_ID: mem_rdata = PROCESSOR_ID;
                        REG_SYSTEM_CLOCK_HZ: mem_rdata = CLOCK_HZ;
                        REG_SYSTEM_OUT: mem_rdata = cpu_io_out;
                        REG_SYSTEM_SERIAL_OUT: mem_rdata = {23'0, maxis_serial_out_tvalid, maxis_serial_out_tdata};
                        REG_SYSTEM_HPD: mem_rdata = {28'0, hpd_event_irq_sticky, hpd_event_unplug_sticky, hpd_event_plug_sticky, hpd_level};
                        default: mem_rdata = 0;
                    }
                }
                REG_SPACE_AUX_CH: {
                    mem_rdata = {24'0, aux_ch_read_data};
                }
                REG_SPACE_MAIN_LINK: {
                    case mem_addr[15:2] {
                        REG_MAIN_LINK_CTRL: {
                            mem_rdata = {25'0, ml_enhanced_framing, ml_rd_reset_pulse, ml_enable, 2'b00, ml_pattern_select};
                        }
                        REG_MAIN_LINK_LANE_COUNT: mem_rdata = {29'0, ml_lane_count};
                        REG_MAIN_LINK_LANE0_DRIVE: mem_rdata = {24'0, ml_lane0_drive};
                        default: mem_rdata = 0;
                    }
                }
                REG_SPACE_VIDEO: {
                    case mem_addr[15:2] {
                        REG_VIDEO_CTRL    : mem_rdata = {31'0, v_enable};
                        REG_VIDEO_HTOTAL  : mem_rdata = {16'0, v_htotal};
                        REG_VIDEO_VTOTAL  : mem_rdata = {16'0, v_vtotal};
                        REG_VIDEO_HSTART  : mem_rdata = {16'0, v_hstart};
                        REG_VIDEO_VSTART  : mem_rdata = {16'0, v_vstart};
                        REG_VIDEO_HWIDTH  : mem_rdata = {16'0, v_hwidth};
                        REG_VIDEO_VHEIGHT : mem_rdata = {16'0, v_vheight};
                        REG_VIDEO_HSW_HSP : mem_rdata = {16'0, v_hsw_hsp};
                        REG_VIDEO_VSW_VSP : mem_rdata = {16'0, v_vsw_vsp};
                        REG_VIDEO_MVID    : mem_rdata = {8'0, v_mvid};
                        REG_VIDEO_NVID    : mem_rdata = {8'0, v_nvid};
                        REG_VIDEO_MISC    : mem_rdata = {16'0, v_misc};
                        REG_VIDEO_TU_ACTIVE: mem_rdata = {25'0, v_tu_active};
                        default: mem_rdata = 0;
                    }
                }
                default: mem_rdata = 0;
            }
        }
        if is_mem_space_ibus {
            mem_rdata = mem_buffer;
        }
        if is_mem_space_dbus {
            mem_rdata = mem_buffer;
        }
    }

    always_ff (i_clk, i_rstn) {
        if_reset {
            mem_buffer              = 0;
            maxis_serial_out_tvalid = 0;
            maxis_serial_out_tdata  = 0;
            cpu_io_out              = 0;
            hpd_event_plug_sticky   = 0;
            hpd_event_unplug_sticky = 0;
            hpd_event_irq_sticky    = 0;
            ml_pattern_select       = 0;
            ml_enable               = 0;
            ml_rd_reset_pulse       = 0;
            ml_lane_count           = 3'd1;
            ml_lane0_drive          = 0;
            ml_enhanced_framing     = 0;
            v_enable                = 0;
            v_htotal                = 0;
            v_vtotal                = 0;
            v_hstart                = 0;
            v_vstart                = 0;
            v_hwidth                = 0;
            v_vheight               = 0;
            v_hsw_hsp               = 0;
            v_vsw_vsp               = 0;
            v_mvid                  = 0;
            v_nvid                  = 0;
            v_misc                  = 0;
            v_tu_active             = 0;
        } else {
            // rd_reset is a single-cycle pulse — auto-clear every cycle.
            ml_rd_reset_pulse = 0;

            if maxis_serial_out_tvalid && maxis_serial_out_tready {
                maxis_serial_out_tvalid = 0;
            }

            if mem_rstrb {
                mem_buffer = 0;
                if is_mem_space_ibus {
                    mem_buffer = processor_rom[mem_addr[2 +: PROCESSOR_ROM_ADDRESS_WIDTH]];
                }
                if is_mem_space_dbus {
                    mem_buffer = processor_ram[mem_addr[2 +: PROCESSOR_RAM_ADDRESS_WIDTH]];
                }
            } else if mem_wmask != 0 {
                let mask: logic<32> = {mem_wmask[3] repeat 8, mem_wmask[2] repeat 8, mem_wmask[1] repeat 8, mem_wmask[0] repeat 8};
                let masked_data: logic<32> = mem_wdata & mask;
                if is_mem_space_reg {
                    case reg_space {
                        REG_SPACE_SYSTEM: {
                            case mem_addr[15:2] {
                                REG_SYSTEM_OUT: cpu_io_out = (cpu_io_out & ~mask) | masked_data;
                                REG_SYSTEM_SERIAL_OUT: {
                                    if mem_wmask[0] && (!maxis_serial_out_tvalid || maxis_serial_out_tready) {
                                        maxis_serial_out_tdata = mem_wdata[7:0];
                                        maxis_serial_out_tvalid = 1;
                                    }
                                }
                                REG_SYSTEM_HPD: {
                                    // W1C: writing 1 to event bits clears them
                                    if mem_wmask[0] {
                                        if mem_wdata[1] {
                                            hpd_event_plug_sticky = 0;
                                        }
                                        if mem_wdata[2] {
                                            hpd_event_unplug_sticky = 0;
                                        }
                                        if mem_wdata[3] {
                                            hpd_event_irq_sticky = 0;
                                        }
                                    }
                                }
                                default: {}
                            }
                        }
                        REG_SPACE_AUX_CH: {
                            // Nothing to do.
                        }
                        REG_SPACE_MAIN_LINK: {
                            if mem_wmask[0] {
                                case mem_addr[15:2] {
                                    REG_MAIN_LINK_CTRL: {
                                        ml_pattern_select = mem_wdata[1:0];
                                        ml_enable         = mem_wdata[4];
                                        // bit[5] = rd_reset (write-1-pulse)
                                        if mem_wdata[5] {
                                            ml_rd_reset_pulse = 1;
                                        }
                                        // bit[6] = enhanced framing mode (§2.2.1.2)
                                        ml_enhanced_framing = mem_wdata[6];
                                    }
                                    REG_MAIN_LINK_LANE_COUNT: {
                                        ml_lane_count = mem_wdata[2:0];
                                    }
                                    REG_MAIN_LINK_LANE0_DRIVE: {
                                        ml_lane0_drive = mem_wdata[7:0];
                                    }
                                    default: {}
                                }
                            }
                        }
                        REG_SPACE_VIDEO: {
                            if mem_wmask[0] {
                                case mem_addr[15:2] {
                                    REG_VIDEO_CTRL:     v_enable    = mem_wdata[0];
                                    REG_VIDEO_HTOTAL:   v_htotal    = mem_wdata[15:0];
                                    REG_VIDEO_VTOTAL:   v_vtotal    = mem_wdata[15:0];
                                    REG_VIDEO_HSTART:   v_hstart    = mem_wdata[15:0];
                                    REG_VIDEO_VSTART:   v_vstart    = mem_wdata[15:0];
                                    REG_VIDEO_HWIDTH:   v_hwidth    = mem_wdata[15:0];
                                    REG_VIDEO_VHEIGHT:  v_vheight   = mem_wdata[15:0];
                                    REG_VIDEO_HSW_HSP:  v_hsw_hsp   = mem_wdata[15:0];
                                    REG_VIDEO_VSW_VSP:  v_vsw_vsp   = mem_wdata[15:0];
                                    REG_VIDEO_MVID:     v_mvid      = mem_wdata[23:0];
                                    REG_VIDEO_NVID:     v_nvid      = mem_wdata[23:0];
                                    REG_VIDEO_MISC:     v_misc      = mem_wdata[15:0];
                                    REG_VIDEO_TU_ACTIVE: v_tu_active = mem_wdata[6:0];
                                    default: {}
                                }
                            }
                        }
                        default: {}
                    }
                }
                if is_mem_space_dbus {
                    if mem_wmask[0] {
                        processor_ram[mem_addr[2 +: PROCESSOR_RAM_ADDRESS_WIDTH]][ 7: 0] = mem_wdata[ 7: 0];
                    }
                    if mem_wmask[1] {
                        processor_ram[mem_addr[2 +: PROCESSOR_RAM_ADDRESS_WIDTH]][15: 8] = mem_wdata[15: 8];
                    }
                    if mem_wmask[2] {
                        processor_ram[mem_addr[2 +: PROCESSOR_RAM_ADDRESS_WIDTH]][23:16] = mem_wdata[23:16];
                    }
                    if mem_wmask[3] {
                        processor_ram[mem_addr[2 +: PROCESSOR_RAM_ADDRESS_WIDTH]][31:24] = mem_wdata[31:24];
                    }
                }
            }

            // HPD sticky-bit set placed last so HW set has priority over W1C clear in the same cycle
            if hpd_event_plug {
                hpd_event_plug_sticky = 1;
            }
            if hpd_event_unplug {
                hpd_event_unplug_sticky = 1;
            }
            if hpd_event_irq {
                hpd_event_irq_sticky = 1;
            }
        }
    }

    // Memory I/O
    var loader_mem_address: logic<32>;
    var loader_mem_rreq   : logic;
    var loader_mem_rdata  : logic<8>;
    var loader_mem_wreq   : logic;
    var loader_mem_wdata  : logic<8>;

    // Serial output
    var loader_maxis_serial_out_tvalid: logic;
    var loader_maxis_serial_out_tready: logic;
    var loader_maxis_serial_out_tdata : logic<8>;

    // Serial input
    var loader_saxis_serial_in_tvalid: logic;
    var loader_saxis_serial_in_tready: logic;
    var loader_saxis_serial_in_tdata : logic<8>;
    
    assign loader_maxis_serial_out_tready = 1;

    inst loader_memory_access: stream_memory_access #(
        ADDRESS_BITS: 32,
    ) (
        i_clk,
        i_rstn,

        mem_address:loader_mem_address,
        mem_rreq:   loader_mem_rreq,
        mem_rdata:  loader_mem_rdata,
        mem_wreq:   loader_mem_wreq,
        mem_wdata:  loader_mem_wdata,

        maxis_serial_out_tvalid: loader_maxis_serial_out_tvalid,
        maxis_serial_out_tready: loader_maxis_serial_out_tready,
        maxis_serial_out_tdata : loader_maxis_serial_out_tdata,

        saxis_serial_in_tvalid: loader_saxis_serial_in_tvalid,
        saxis_serial_in_tready: loader_saxis_serial_in_tready,
        saxis_serial_in_tdata : loader_saxis_serial_in_tdata,
    );

    always_ff(i_clk, i_rstn) {
        if_reset {
            processor_reset  = 0;
            loader_mem_rdata = 0;
        } else {
            if loader_mem_rreq {
                case loader_mem_address[31:28] {
                    IBUS_MEM_SPACE: {
                        let loader_rom_rdata: logic<32> = processor_rom[loader_mem_address[2 +: PROCESSOR_ROM_ADDRESS_WIDTH]];
                        case loader_mem_address[1:0] {
                            2'd0: loader_mem_rdata = loader_rom_rdata[ 0 +: 8];
                            2'd1: loader_mem_rdata = loader_rom_rdata[ 8 +: 8];
                            2'd2: loader_mem_rdata = loader_rom_rdata[16 +: 8];
                            2'd3: loader_mem_rdata = loader_rom_rdata[24 +: 8];
                        }
                    }
                    DBUS_MEM_SPACE: {
                        let loader_ram_rdata: logic<32> = processor_ram[loader_mem_address[2 +: PROCESSOR_RAM_ADDRESS_WIDTH]];
                        case loader_mem_address[1:0] {
                            2'd0: loader_mem_rdata = loader_ram_rdata[ 0 +: 8];
                            2'd1: loader_mem_rdata = loader_ram_rdata[ 8 +: 8];
                            2'd2: loader_mem_rdata = loader_ram_rdata[16 +: 8];
                            2'd3: loader_mem_rdata = loader_ram_rdata[24 +: 8];
                        }
                    }
                    default: loader_mem_rdata = 8'h00;
                }
            }
            if loader_mem_wreq {
                case loader_mem_address[31:28] {
                    IBUS_MEM_SPACE: {
                        let loader_rom_address: rom_address_t = loader_mem_address[2 +: PROCESSOR_ROM_ADDRESS_WIDTH];
                        case loader_mem_address[1:0] {
                            2'd0: processor_rom[loader_rom_address][ 0 +: 8] = loader_mem_wdata;
                            2'd1: processor_rom[loader_rom_address][ 8 +: 8] = loader_mem_wdata;
                            2'd2: processor_rom[loader_rom_address][16 +: 8] = loader_mem_wdata;
                            2'd3: processor_rom[loader_rom_address][24 +: 8] = loader_mem_wdata;
                        }
                    }
                    DBUS_MEM_SPACE: {
                        let loader_ram_address: ram_address_t = loader_mem_address[2 +: PROCESSOR_RAM_ADDRESS_WIDTH];
                        case loader_mem_address[1:0] {
                            2'd0: processor_ram[loader_ram_address][ 0 +: 8] = loader_mem_wdata;
                            2'd1: processor_ram[loader_ram_address][ 8 +: 8] = loader_mem_wdata;
                            2'd2: processor_ram[loader_ram_address][16 +: 8] = loader_mem_wdata;
                            2'd3: processor_ram[loader_ram_address][24 +: 8] = loader_mem_wdata;
                        }
                    }
                    4'hf: {
                        if loader_mem_address == 32'hffff_ffff {
                            processor_reset = loader_mem_wdata[0];
                        }
                    }
                    default: {}
                }
            }
        }
    }
}