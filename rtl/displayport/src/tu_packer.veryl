/**
 * @file tu_packer.veryl
 * @brief Packs pixel bytes into 64-symbol Transfer Units (DP 1.2 §2.2.1.4,
 *        Fig 2-13) for a single lane. Phase D fixes TU = 64 link symbols.
 *
 * Layout per TU (active_count = N):
 *   N == 64 : 64 valid pixel bytes (no FS / no FE)
 *   N == 63 : 63 valid + FE                (no FS — only one stuffing symbol)
 *   N == 62 : 62 valid + FS + FE           (FS and FE adjacent)
 *   N <= 61 : N valid + FS + dummy(0x00) × (62 - N) + FE
 *
 * FS = K30.7 = 0xFE (Table 3-15)
 * FE = K23.7 = 0xF7 (Table 3-15)
 *
 * `i_tu_start` resets the per-TU phase counter (used by video_framer at
 * the start of each active line). Otherwise the phase wraps 0..63.
 */

pub module tu_packer (
    i_clk:  input clock_posedge,
    i_rstn: input reset_sync_low,

    // Pacing pulse (= 1 byte / pulse from upstream byte clock).
    i_byte_tick:    input logic,
    // 1 = drive output, 0 = freeze (no o_valid, no FIFO pop).
    i_emit_enable:  input logic,
    // Pulse to reset the TU phase counter.
    i_tu_start:     input logic,
    // 1..64 valid bytes per TU (CPU-set).
    i_active_count: input logic<7>,

    // Pixel data input. 1-lane mode uses [7:0] (pixel_fifo byte);
    // 4-lane mode uses all 32 bits (pixel_fifo_quad: one color
    // component of four consecutive pixels, lane L on [8*L +: 8]).
    // One i_pop consumes one pop-unit from whichever FIFO is attached.
    i_pixel_bytes: input  logic<32>,
    i_pixel_empty: input  logic,
    o_pixel_pop:   output logic,

    o_valid: output logic,
    // Lane L on [8*L +: 8]. FS/FE/stuffing are replicated on all four
    // byte lanes (they are inserted in all lanes in the same LS_Clk
    // cycle, DP 1.2 section 2.2.1.4); 1-lane mode consumes [7:0] only.
    o_bytes: output logic<32>,
    o_is_k:  output logic,
) {
    var phase: logic<6>; // 0..63

    // Quasi-static helpers derived from i_active_count (a CPU register),
    // registered so the 7-bit compares stay out of per-byte paths.
    var ac_nonzero: logic;
    var ac_lt63:    logic;
    var ac_lt64:    logic;
    always_ff (i_clk, i_rstn) {
        if_reset {
            ac_nonzero = 0;
            ac_lt63    = 0;
            ac_lt64    = 0;
        } else {
            ac_nonzero = (i_active_count != 7'd0);
            ac_lt63    = (i_active_count <: 7'd63);
            ac_lt64    = (i_active_count <: 7'd64);
        }
    }

    // Look-ahead flags describing the CURRENT phase slot, updated one
    // tick ahead (from phase_next) so the emit path and the pop gate see
    // only registered 1-bit flags instead of the 7-bit compares.
    var f_active: logic; // phase <  active_count
    var f_fs:     logic; // phase == active_count && stuffing >= 2
    var f_fe:     logic; // phase == 63 && at least one stuffing symbol
    let phase_next: logic<6> = if phase == 6'd63 ? 6'd0 : phase + 6'd1;

    // o_pixel_pop is combinational so the upstream FIFO advances within the
    // same cycle the byte is consumed. This avoids a 2-stage NBA delay.
    let in_active_region: logic =
        i_emit_enable && i_byte_tick && !i_tu_start && f_active;
    assign o_pixel_pop = in_active_region && !i_pixel_empty;

    always_ff (i_clk, i_rstn) {
        if_reset {
            phase    = 0;
            f_active = 0;
            f_fs     = 0;
            f_fe     = 0;
            o_valid  = 0;
            o_bytes  = 0;
            o_is_k   = 0;
        } else {
            // Sticky outputs: only the emit branch updates o_byte/o_is_k.
            // The upstream mux reads these registers on the NEXT byte_tick,
            // so they must persist between ticks rather than being cleared.
            if i_tu_start {
                phase    = 0;
                // Flags for phase 0.
                f_active = ac_nonzero;
                f_fs     = !ac_nonzero && ac_lt63;
                f_fe     = 0;
            } else if i_emit_enable && i_byte_tick {
                o_valid = 1;
                o_is_k  = 0;

                if f_active {
                    // Active region — pull from pixel FIFO when available.
                    if i_pixel_empty {
                        o_bytes = 32'h0;
                    } else {
                        o_bytes = i_pixel_bytes;
                    }
                } else if f_fs {
                    // FS (only when stuffing >= 2 symbols).
                    o_bytes = {8'hFE repeat 4};
                    o_is_k  = 1;
                } else if f_fe {
                    // FE (every TU with at least one stuffing symbol).
                    o_bytes = {8'hF7 repeat 4};
                    o_is_k  = 1;
                } else {
                    // Dummy stuffing.
                    o_bytes = 32'h0;
                }

                phase    = phase_next;
                f_active = ({1'b0, phase_next} <: i_active_count);
                f_fs     = ({1'b0, phase_next} == i_active_count) && ac_lt63;
                f_fe     = (phase_next == 6'd63) && ac_lt64;
            }
        }
    }
}
