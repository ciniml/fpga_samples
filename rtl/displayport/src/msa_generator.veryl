/**
 * @file msa_generator.veryl
 * @brief Generates the 39-symbol Main Stream Attribute (MSA) sequence for
 *        a 1-lane DP main link, exactly as DP 1.2 Fig 2-18 (1-lane column):
 *        SS SS + 36 attribute bytes + SE. Mvid23:0 is transported four
 *        times, once at the head of each attribute group.
 *
 * Byte sequence (per i_byte_tick):
 *   00, 01: SS, SS                 (K28.2 = 0x5C)
 *   02..04: Mvid23:16, Mvid15:8, Mvid7:0
 *   05, 06: Htotal15:8, Htotal7:0
 *   07, 08: Vtotal15:8, Vtotal7:0
 *   09, 10: HSP|HSW14:8, HSW7:0
 *   11..13: Mvid23:16, Mvid15:8, Mvid7:0
 *   14, 15: Hstart15:8, Hstart7:0
 *   16, 17: Vstart15:8, Vstart7:0
 *   18, 19: VSP|VSW14:8, VSW7:0
 *   20..22: Mvid23:16, Mvid15:8, Mvid7:0
 *   23, 24: Hwidth15:8, Hwidth7:0
 *   25, 26: Vheight15:8, Vheight7:0
 *   27, 28: 0x00, 0x00 (All 0s)
 *   29..31: Mvid23:16, Mvid15:8, Mvid7:0
 *   32..34: Nvid23:16, Nvid15:8, Nvid7:0
 *   35, 36: MISC0_7:0, MISC1_7:0
 *   37    : 0x00 (All 0s)
 *   38    : SE                      (K29.7 = 0xFD, Table 3-15)
 */

pub module msa_generator (
    i_clk:  input clock_posedge,
    i_rstn: input reset_sync_low,

    // Pacing pulse from the upstream byte clock domain (= 1 byte / pulse).
    i_byte_tick: input logic,
    // Single-cycle trigger to start a new 39-byte MSA emission.
    i_trigger: input logic,

    // MSA fields. All driven from CPU-set VIDEO registers.
    i_htotal:  input logic<16>,
    i_vtotal:  input logic<16>,
    i_hstart:  input logic<16>,
    i_vstart:  input logic<16>,
    i_hwidth:  input logic<16>,
    i_vheight: input logic<16>,
    i_hsw_hsp: input logic<16>, // [14:0]=HSW, [15]=HSP
    i_vsw_vsp: input logic<16>, // [14:0]=VSW, [15]=VSP
    i_mvid:    input logic<24>,
    i_nvid:    input logic<24>,
    i_misc:    input logic<16>, // [7:0]=MISC0, [15:8]=MISC1

    // 0: 1-lane 39-symbol sequence on o_byte.
    // 1: 4-lane 12-symbol-per-lane layout (Fig 2-18): o_byte = lane 0,
    //    o_byte1..3 = lanes 1..3. SS/SE and the Mvid triple are common
    //    to all lanes.
    i_four_lane: input logic,

    // 1 while emission is in progress (or scheduled). Upstream may use it
    // to gate other byte sources.
    o_busy:  output logic,
    // Single-cycle pulse with each emitted byte.
    o_valid: output logic,
    o_byte:  output logic<8>,
    o_byte1: output logic<8>,
    o_byte2: output logic<8>,
    o_byte3: output logic<8>,
    o_is_k:  output logic,
) {
    // One-hot slot ring (39 slots). A shift register instead of a
    // binary counter keeps the per-byte output selection a flat AND-OR
    // over disjoint one-hot terms rather than a 6-bit compare/decode
    // cone per case arm.
    var oh:     logic<39>;
    var active: logic;

    // Field-select terms (each slot bit appears in exactly one group).
    let sel_ss:     logic = oh[0] | oh[1];
    let sel_mvid_h: logic = oh[2] | oh[11] | oh[20] | oh[29];
    let sel_mvid_m: logic = oh[3] | oh[12] | oh[21] | oh[30];
    let sel_mvid_l: logic = oh[4] | oh[13] | oh[22] | oh[31];
    let sel_htot_h: logic = oh[5];
    let sel_htot_l: logic = oh[6];
    let sel_vtot_h: logic = oh[7];
    let sel_vtot_l: logic = oh[8];
    let sel_hsw_h:  logic = oh[9];
    let sel_hsw_l:  logic = oh[10];
    let sel_hst_h:  logic = oh[14];
    let sel_hst_l:  logic = oh[15];
    let sel_vst_h:  logic = oh[16];
    let sel_vst_l:  logic = oh[17];
    let sel_vsw_h:  logic = oh[18];
    let sel_vsw_l:  logic = oh[19];
    let sel_hw_h:   logic = oh[23];
    let sel_hw_l:   logic = oh[24];
    let sel_vh_h:   logic = oh[25];
    let sel_vh_l:   logic = oh[26];
    let sel_nvid_h: logic = oh[32];
    let sel_nvid_m: logic = oh[33];
    let sel_nvid_l: logic = oh[34];
    let sel_misc0:  logic = oh[35];
    let sel_misc1:  logic = oh[36];
    let sel_se:     logic = oh[38];
    // (slots 27, 28, 37 are the All-0s bytes)

    let mux_byte: logic<8> =
        (if sel_ss     ? 8'h5C                          : 8'h00) |
        (if sel_mvid_h ? i_mvid[23:16]                  : 8'h00) |
        (if sel_mvid_m ? i_mvid[15:8]                   : 8'h00) |
        (if sel_mvid_l ? i_mvid[7:0]                    : 8'h00) |
        (if sel_htot_h ? i_htotal[15:8]                 : 8'h00) |
        (if sel_htot_l ? i_htotal[7:0]                  : 8'h00) |
        (if sel_vtot_h ? i_vtotal[15:8]                 : 8'h00) |
        (if sel_vtot_l ? i_vtotal[7:0]                  : 8'h00) |
        (if sel_hsw_h  ? {i_hsw_hsp[15], i_hsw_hsp[14:8]} : 8'h00) |
        (if sel_hsw_l  ? i_hsw_hsp[7:0]                 : 8'h00) |
        (if sel_hst_h  ? i_hstart[15:8]                 : 8'h00) |
        (if sel_hst_l  ? i_hstart[7:0]                  : 8'h00) |
        (if sel_vst_h  ? i_vstart[15:8]                 : 8'h00) |
        (if sel_vst_l  ? i_vstart[7:0]                  : 8'h00) |
        (if sel_vsw_h  ? {i_vsw_vsp[15], i_vsw_vsp[14:8]} : 8'h00) |
        (if sel_vsw_l  ? i_vsw_vsp[7:0]                 : 8'h00) |
        (if sel_hw_h   ? i_hwidth[15:8]                 : 8'h00) |
        (if sel_hw_l   ? i_hwidth[7:0]                  : 8'h00) |
        (if sel_vh_h   ? i_vheight[15:8]                : 8'h00) |
        (if sel_vh_l   ? i_vheight[7:0]                 : 8'h00) |
        (if sel_nvid_h ? i_nvid[23:16]                  : 8'h00) |
        (if sel_nvid_m ? i_nvid[15:8]                   : 8'h00) |
        (if sel_nvid_l ? i_nvid[7:0]                    : 8'h00) |
        (if sel_misc0  ? i_misc[7:0]                    : 8'h00) |
        (if sel_misc1  ? i_misc[15:8]                   : 8'h00) |
        (if sel_se     ? 8'hFD                          : 8'h00);

    // ---- 4-lane layout (Fig 2-18): 12 slots per lane ----
    //   slot  0, 1: SS SS                 (all lanes)
    //   slot  2..4: Mvid23:16/15:8/7:0    (all lanes)
    //   slot  5..10: per-lane attribute column:
    //     lane0: Htotal15:8, Htotal7:0, Vtotal15:8, Vtotal7:0,
    //            HSP|HSW14:8, HSW7:0
    //     lane1: Hstart15:8, Hstart7:0, Vstart15:8, Vstart7:0,
    //            VSP|VSW14:8, VSW7:0
    //     lane2: Hwidth15:8, Hwidth7:0, Vheight15:8, Vheight7:0, 0, 0
    //     lane3: Nvid23:16, Nvid15:8, Nvid7:0, MISC0, MISC1, 0
    //   slot 11: SE                       (all lanes)
    var oh4:     logic<12>;
    var active4: logic;

    let s4_ss: logic = oh4[0] | oh4[1];
    let s4_common: logic<8> =
        (if s4_ss   ? 8'h5C          : 8'h00) |
        (if oh4[2]  ? i_mvid[23:16]  : 8'h00) |
        (if oh4[3]  ? i_mvid[15:8]   : 8'h00) |
        (if oh4[4]  ? i_mvid[7:0]    : 8'h00) |
        (if oh4[11] ? 8'hFD          : 8'h00);
    let mux4_l0: logic<8> = s4_common |
        (if oh4[5]  ? i_htotal[15:8] : 8'h00) |
        (if oh4[6]  ? i_htotal[7:0]  : 8'h00) |
        (if oh4[7]  ? i_vtotal[15:8] : 8'h00) |
        (if oh4[8]  ? i_vtotal[7:0]  : 8'h00) |
        (if oh4[9]  ? {i_hsw_hsp[15], i_hsw_hsp[14:8]} : 8'h00) |
        (if oh4[10] ? i_hsw_hsp[7:0] : 8'h00);
    let mux4_l1: logic<8> = s4_common |
        (if oh4[5]  ? i_hstart[15:8] : 8'h00) |
        (if oh4[6]  ? i_hstart[7:0]  : 8'h00) |
        (if oh4[7]  ? i_vstart[15:8] : 8'h00) |
        (if oh4[8]  ? i_vstart[7:0]  : 8'h00) |
        (if oh4[9]  ? {i_vsw_vsp[15], i_vsw_vsp[14:8]} : 8'h00) |
        (if oh4[10] ? i_vsw_vsp[7:0] : 8'h00);
    let mux4_l2: logic<8> = s4_common |
        (if oh4[5]  ? i_hwidth[15:8]  : 8'h00) |
        (if oh4[6]  ? i_hwidth[7:0]   : 8'h00) |
        (if oh4[7]  ? i_vheight[15:8] : 8'h00) |
        (if oh4[8]  ? i_vheight[7:0]  : 8'h00);
    let mux4_l3: logic<8> = s4_common |
        (if oh4[5]  ? i_nvid[23:16] : 8'h00) |
        (if oh4[6]  ? i_nvid[15:8]  : 8'h00) |
        (if oh4[7]  ? i_nvid[7:0]   : 8'h00) |
        (if oh4[8]  ? i_misc[7:0]   : 8'h00) |
        (if oh4[9]  ? i_misc[15:8]  : 8'h00);

    always_ff (i_clk, i_rstn) {
        if_reset {
            oh      = 39'd1;
            active  = 0;
            oh4     = 12'd1;
            active4 = 0;
            o_valid = 0;
            o_byte  = 0;
            o_byte1 = 0;
            o_byte2 = 0;
            o_byte3 = 0;
            o_is_k  = 0;
        } else {
            // Sticky outputs: only the emit branch updates o_byte/o_is_k.
            // Mux upstream samples them on the NEXT byte_tick, so the
            // registered value must persist between ticks.
            if !active && !active4 && i_trigger {
                if i_four_lane {
                    active4 = 1;
                    oh4     = 12'd1;
                } else {
                    active = 1;
                    oh     = 39'd1;
                }
            } else if active && i_byte_tick {
                o_valid = 1;
                o_byte  = mux_byte;
                o_is_k  = sel_ss | sel_se;
                if oh[38] {
                    active = 0;
                } else {
                    oh = {oh[37:0], 1'b0};
                }
            } else if active4 && i_byte_tick {
                o_valid = 1;
                o_byte  = mux4_l0;
                o_byte1 = mux4_l1;
                o_byte2 = mux4_l2;
                o_byte3 = mux4_l3;
                o_is_k  = s4_ss | oh4[11];
                if oh4[11] {
                    active4 = 0;
                } else {
                    oh4 = {oh4[10:0], 1'b0};
                }
            }
        }
    }

    assign o_busy = active || active4 || i_trigger;
}
