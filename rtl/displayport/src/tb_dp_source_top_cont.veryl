/**
 * @file tb_dp_source_top_cont.veryl
 * @brief E2E test of the CONTINUOUS_BYTE_TICK = 1 (FPGA / OSER10) path:
 *        one 10-bit symbol per clock on o_lane0_symbol, exactly as an
 *        external SerDes (Gowin OSER10) consumes it. The sink here feeds
 *        the symbols straight into an 8B/10B decoder + descrambler (no
 *        bit aligner — the parallel symbol interface is already aligned)
 *        and verifies bit-exact reconstruction of 3 frames, like
 *        tb_dp_source_top does for the behavioural serial path.
 */

module TbDpSourceTopCont {}

#[test(dp_source_top_cont)]
embed (inline) sv{{{
module dp_source_top_cont;
    // The CPU/AUX subsystem runs on a divided clock (link/4 = 25 MHz)
    // so this test exercises the real sys->link CDC inside
    // dp_source_top, mirroring the FPGA topology (27 MHz vs 162 MHz).
    parameter int unsigned CLOCK_HZ            = 32'd25_000_000;
    parameter int unsigned MANCHESTER_CLOCK_HZ = 32'd1_000_000;
    parameter int unsigned PROCESSOR_ROM_SIZE  = 32'd16384;
    parameter int unsigned PROCESSOR_RAM_SIZE  = 32'd8192;

    localparam int unsigned FRAME_W    = 64;
    localparam int unsigned FRAME_H    = 16;
    localparam int unsigned NUM_FRAMES = 3;
    localparam int unsigned BYTES_PER_FRAME = FRAME_W * FRAME_H * 3;
    localparam int unsigned TOTAL_BYTES     = NUM_FRAMES * BYTES_PER_FRAME;

    logic clk;
    logic rstn;
    initial clk = 1'b0;
    always #5 clk = ~clk;

    // Divided system clock (clk / 10) for the CPU/AUX domain.
    logic       clk_sys;
    logic [2:0] clk_sys_div;
    initial begin
        clk_sys     = 1'b0;
        clk_sys_div = '0;
    end
    always_ff @(posedge clk) begin
        if (clk_sys_div == 3'd1) begin
            clk_sys_div <= '0;
            clk_sys     <= ~clk_sys;
        end else begin
            clk_sys_div <= clk_sys_div + 3'd1;
        end
    end

    logic [1:0]  aux_out;
    logic [1:0]  aux_oen;
    logic [1:0]  aux_in;
    logic [1:0]  hpd;
    logic [31:0] cpu_out [0:1];

    logic [1:0] lane0_symbol_valid;
    logic [9:0] lane0_symbol [0:1];

    assign aux_in[0] = aux_oen[1] ? aux_out[1] : 1'b0;
    assign aux_in[1] = aux_oen[0] ? aux_out[0] : 1'b0;

    // CPU0's pixel input (driven by TB).
    logic        pix_tvalid;
    logic        pix_tready;
    logic [23:0] pix_tdata;

    genvar i;
    generate
        for (i = 0; i < 2; i++) begin: g
            logic       ser_valid;
            logic [7:0] ser_data;

            logic        local_pix_tvalid;
            logic        local_pix_tready;
            logic [23:0] local_pix_tdata;
            assign local_pix_tvalid = (i == 0) ? pix_tvalid : 1'b0;
            assign local_pix_tdata  = (i == 0) ? pix_tdata  : 24'h000000;

            displayport_dp_source_top #(
                .CLOCK_HZ(CLOCK_HZ),
                .MANCHESTER_CLOCK_HZ(MANCHESTER_CLOCK_HZ),
                .PROCESSOR_ID(32'(i)),
                .PROCESSOR_ROM_SIZE(PROCESSOR_ROM_SIZE),
                .PROCESSOR_RAM_SIZE(PROCESSOR_RAM_SIZE),
                .SR_PERIOD(32'd4),
                .CONTINUOUS_BYTE_TICK(32'd1)
            ) dut (
                .i_clk                  (clk),
                .i_rstn                 (rstn),
                .i_clk_sys              (clk_sys),
                .i_rstn_sys             (rstn),
                .aux_ch_in              (aux_in[i]),
                .aux_ch_out              (aux_out[i]),
                .aux_ch_out_enable      (aux_oen[i]),
                .hpd_in                 (hpd[i]),
                .cpu_io_out             (cpu_out[i]),
                .saxis_serial_in_tvalid (1'b0),
                .saxis_serial_in_tready (),
                .saxis_serial_in_tdata  (8'h00),
                .maxis_serial_out_tvalid(ser_valid),
                .maxis_serial_out_tready(1'b1),
                .maxis_serial_out_tdata (ser_data),
                // Behavioural bit-serial output is meaningless in
                // continuous mode (the on-chip serializer loses bits).
                .o_lane0_bit            (),
                .o_lane0_bit_valid      (),
                .o_lane0_symbol_valid   (lane0_symbol_valid[i]),
                .o_lane0_symbol         (lane0_symbol[i]),
                .s_axis_video_tvalid    (local_pix_tvalid),
                .s_axis_video_tready    (local_pix_tready),
                .s_axis_video_tdata     (local_pix_tdata)
            );

            string line_buf;
            always_ff @(posedge clk_sys) begin
                if (!rstn) begin
                    line_buf = "";
                end else if (ser_valid) begin
                    if (ser_data == 8'h0a) begin
                        $display("[%0d] %s", i, line_buf);
                        $fflush(1);
                        line_buf = "";
                    end else begin
                        line_buf = {line_buf, ser_data};
                    end
                end
            end
        end
    endgenerate

    assign pix_tready = g[0].local_pix_tready;

    // ----- Sink: symbol-parallel RX chain (decoder + descrambler), the
    //       same consumption model as an OSER10-style external SerDes.
    logic       dec_valid;
    logic [7:0] dec_byte;
    logic       dec_is_k;
    logic       dec_code_err;

    displayport_decoder_8b10b u_dec (
        .i_clk     (clk),
        .i_rstn    (rstn),
        .i_valid   (lane0_symbol_valid[0]),
        .i_symbol  (lane0_symbol[0]),
        .o_valid   (dec_valid),
        .o_data    (dec_byte),
        .o_is_k    (dec_is_k),
        .o_code_err(dec_code_err)
    );

    // Descrambler resets only on SR (K28.0), like a spec sink.
    wire dec_sr = dec_valid && dec_is_k && (dec_byte == 8'h1C);

    logic       rx_valid;
    logic [31:0] rx_byte_w;
    wire  [7:0]  rx_byte = rx_byte_w[7:0];
    logic       rx_is_k;

    displayport_scrambler u_desc (
        .i_clk             (clk),
        .i_rstn            (rstn),
        .i_seed_reset      (dec_sr),
        .i_scramble_disable(1'b0),
        .i_valid           (dec_valid),
        .i_data            ({24'h0, dec_byte}),
        .i_is_k            (dec_is_k),
        .o_valid           (rx_valid),
        .o_data            (rx_byte_w),
        .o_is_k            (rx_is_k)
    );

    // Count code errors only once video is up (cpu_out[0] bit0): the
    // training-pattern phase switches sources mid-stream and may produce
    // transient invalid symbols at the mux boundaries.
    integer code_err_count;
    always_ff @(posedge clk) begin
        if (!rstn) code_err_count <= 0;
        else if (cpu_out[0][0] && dec_valid && dec_code_err)
            code_err_count <= code_err_count + 1;
    end

    integer rx_sr_count;
    always_ff @(posedge clk) begin
        if (!rstn) rx_sr_count <= 0;
        else if (rx_valid && rx_is_k && rx_byte == 8'h1C)
            rx_sr_count <= rx_sr_count + 1;
    end

    // ----- Frame parser (same FSM as tb_dp_source_top) -----
    typedef enum logic [2:0] {
        PS_WAIT_BS    = 3'd0,
        PS_HDR        = 3'd1, // 12 header bytes: (VBID, Mvid, Maud) x 4
        PS_BSSEQ      = 3'd2, // enhanced framing: BF BF BS/SR after group start
        PS_VBLANK     = 3'd4,
        PS_WAIT_BE    = 3'd5,
        PS_ACTIVE     = 3'd6
    } parse_state_t;

    parse_state_t pstate;
    logic         line_is_vblank;
    logic         in_stuffing;
    integer       hdr_count;
    integer       bsseq_count;
    logic [7:0]   bs_first;
    logic [7:0]   vbid_ref;
    integer       active_line_count;
    integer       pixels_collected_this_line;
    logic [7:0]   recovered_bytes [0:TOTAL_BYTES - 1];
    integer       recovered_index;
    integer       parse_errors;

    always_ff @(posedge clk) begin
        if (!rstn) begin
            pstate                     <= PS_WAIT_BS;
            line_is_vblank             <= 1'b0;
            in_stuffing                <= 1'b0;
            hdr_count                  <= 0;
            bsseq_count                <= 0;
            bs_first                   <= 8'h00;
            vbid_ref                   <= 8'h00;
            active_line_count          <= 0;
            pixels_collected_this_line <= 0;
            recovered_index            <= 0;
            parse_errors               <= 0;
        end else begin
            if (rx_valid) begin
                case (pstate)
                    PS_WAIT_BS: begin
                        // Start at an SR (K28.0): the descrambler is
                        // guaranteed in step with the TX from the first
                        // SR onward.
                        if (rx_is_k && rx_byte == 8'h1C) begin
                            pstate      <= PS_BSSEQ;
                            bs_first    <= rx_byte;
                            bsseq_count <= 0;
                        end
                    end
                    PS_BSSEQ: begin
                        // Enhanced framing (Table 2-1): group start (BS or
                        // SR) followed by BF, BF, then a repeat of the
                        // start symbol.
                        if (bsseq_count < 2) begin
                            if (!(rx_is_k && rx_byte == 8'h7C)) begin
                                $display("[tb_cont] BS group byte %0d: expected BF got (%02h, k=%b)",
                                         bsseq_count + 1, rx_byte, rx_is_k);
                                parse_errors <= parse_errors + 1;
                            end
                        end else begin
                            if (!(rx_is_k && rx_byte == bs_first)) begin
                                $display("[tb_cont] BS group byte 3: expected %02h got (%02h, k=%b)",
                                         bs_first, rx_byte, rx_is_k);
                                parse_errors <= parse_errors + 1;
                            end
                            pstate    <= PS_HDR;
                            hdr_count <= 0;
                        end
                        bsseq_count <= bsseq_count + 1;
                    end
                    PS_HDR: begin
                        if (hdr_count == 0) begin
                            line_is_vblank <= rx_byte[0];
                            vbid_ref       <= rx_byte;
                        end else if (hdr_count % 3 == 0 && rx_byte !== vbid_ref) begin
                            $display("[tb_cont] VB-ID repeat %0d mismatch: expected %02h got %02h",
                                     hdr_count / 3, vbid_ref, rx_byte);
                            parse_errors <= parse_errors + 1;
                        end
                        if (hdr_count == 11) begin
                            if (line_is_vblank) pstate <= PS_VBLANK;
                            else                 pstate <= PS_WAIT_BE;
                        end
                        hdr_count <= hdr_count + 1;
                    end
                    PS_VBLANK: begin
                        if (rx_is_k && (rx_byte == 8'hBC || rx_byte == 8'h1C)) begin
                            pstate      <= PS_BSSEQ;
                            bs_first    <= rx_byte;
                            bsseq_count <= 0;
                        end
                    end
                    PS_WAIT_BE: begin
                        if (rx_is_k && rx_byte == 8'hFB) begin
                            pstate                     <= PS_ACTIVE;
                            in_stuffing                <= 1'b0;
                            pixels_collected_this_line <= 0;
                        end else if (rx_is_k && (rx_byte == 8'hBC || rx_byte == 8'h1C)) begin
                            pstate      <= PS_BSSEQ;
                            bs_first    <= rx_byte;
                            bsseq_count <= 0;
                        end
                    end
                    PS_ACTIVE: begin
                        if (rx_is_k && (rx_byte == 8'hBC || rx_byte == 8'h1C)) begin
                            if (pixels_collected_this_line != FRAME_W * 3) begin
                                $display("[tb_cont] line %0d: collected %0d bytes (expected %0d)",
                                         active_line_count, pixels_collected_this_line, FRAME_W * 3);
                                parse_errors <= parse_errors + 1;
                            end
                            active_line_count <= active_line_count + 1;
                            pstate            <= PS_BSSEQ;
                            bs_first          <= rx_byte;
                            bsseq_count       <= 0;
                        end else if (rx_is_k && rx_byte == 8'hFE) begin
                            in_stuffing <= 1'b1;
                        end else if (rx_is_k && rx_byte == 8'hF7) begin
                            in_stuffing <= 1'b0;
                        end else if (!rx_is_k && !in_stuffing) begin
                            if (recovered_index < TOTAL_BYTES) begin
                                recovered_bytes[recovered_index] <= rx_byte;
                                recovered_index                  <= recovered_index + 1;
                                pixels_collected_this_line       <= pixels_collected_this_line + 1;
                            end
                        end
                    end
                    default: pstate <= PS_WAIT_BS;
                endcase
            end
        end
    end

    // ----- TB stimulus -----
    initial begin
        $readmemh("bootrom-rs.hex", g[0].dut.aux_subsystem.processor_rom);
        $readmemh("bootrom-rs.hex", g[1].dut.aux_subsystem.processor_rom);

        rstn       = 1'b0;
        hpd[0]     = 1'b0;
        hpd[1]     = 1'b0;
        pix_tvalid = 1'b0;
        pix_tdata  = 24'h000000;
        repeat (16) @(posedge clk);
        rstn = 1'b1;

        repeat (2000) @(posedge clk);
        $display("[TB] asserting HPD on CPU0");
        hpd[0] = 1'b1;

        // Wait for parser to collect NUM_FRAMES frames (or timeout).
        for (int t = 0; t < 50_000_000; t++) begin
            @(posedge clk);
            if (recovered_index >= TOTAL_BYTES) break;
        end

        if (recovered_index < TOTAL_BYTES) begin
            $fatal(1, "[TB] parser collected only %0d / %0d bytes (code errs=%0d)",
                   recovered_index, TOTAL_BYTES, code_err_count);
        end

        // Compare each frame against its expected (frame-indexed) pattern.
        for (int f = 0; f < NUM_FRAMES; f++) begin
            for (int y = 0; y < FRAME_H; y++) begin
                for (int x = 0; x < FRAME_W; x++) begin
                    int idx;
                    logic [7:0] er, eg, eb, xb, yb;
                    xb  = x[7:0];
                    yb  = y[7:0];
                    idx = f * BYTES_PER_FRAME + (y * FRAME_W + x) * 3;
                    er  = xb;
                    eg  = yb;
                    eb  = (x + y + 16 * f) & 32'hFF;
                    if (recovered_bytes[idx]   !== er ||
                        recovered_bytes[idx+1] !== eg ||
                        recovered_bytes[idx+2] !== eb) begin
                        $display("[TB] frame %0d pixel (%0d,%0d) mismatch: expected (%02h,%02h,%02h) got (%02h,%02h,%02h)",
                                 f, x, y, er, eg, eb,
                                 recovered_bytes[idx], recovered_bytes[idx+1], recovered_bytes[idx+2]);
                        parse_errors = parse_errors + 1;
                    end
                end
            end
        end

        if (parse_errors != 0) begin
            $fatal(1, "[TB] %0d pixel mismatches (code errs=%0d)",
                   parse_errors, code_err_count);
        end

        if (rx_sr_count == 0) begin
            $fatal(1, "[TB] no SR (K28.0) seen at sink — SR substitution not working");
        end

        if (code_err_count != 0) begin
            $fatal(1, "[TB] %0d 8B/10B code errors while video active", code_err_count);
        end

        $display("[TB] PASS: %0d frames x %0d pixels reconstructed via the continuous symbol path (SR seen=%0d).",
                 NUM_FRAMES, FRAME_W * FRAME_H, rx_sr_count);
        $finish;
    end

    initial begin
        #400_000_000;
        $fatal(1, "[TB] timeout");
    end

    // ----- Pixel pump: same frame-indexed pattern as tb_dp_source_top.
    initial begin
        @(posedge rstn);
        wait (hpd[0] == 1'b1);
        for (int f = 0; f < NUM_FRAMES; f++) begin
            for (int y = 0; y < FRAME_H; y++) begin
                for (int x = 0; x < FRAME_W; x++) begin
                    logic [7:0] xb, yb, bb;
                    xb = x[7:0];
                    yb = y[7:0];
                    bb = (x + y + 16 * f) & 32'hFF;
                    pix_tdata  = {xb, yb, bb};
                    pix_tvalid = 1'b1;
                    @(posedge clk);
                    while (!pix_tready) @(posedge clk);
                end
            end
        end
        pix_tvalid = 1'b0;
    end
endmodule
}}}
