/**
 * @file tb_msa_generator.veryl
 * @brief Phase D unit test for msa_generator. Drives a known set of MSA
 *        fields, triggers, and compares the 33-byte output sequence
 *        against a golden vector derived from DP 1.2 Fig 2-18 (1-lane).
 */

module TbMsaGenerator {}

#[test(msa_generator_golden)]
embed (inline) sv{{{
module msa_generator_golden;
    logic clk;
    logic rstn;
    initial clk = 0;
    always #5 clk = ~clk;

    logic        byte_tick;
    logic        trigger;
    logic [15:0] htotal;
    logic [15:0] vtotal;
    logic [15:0] hstart;
    logic [15:0] vstart;
    logic [15:0] hwidth;
    logic [15:0] vheight;
    logic [15:0] hsw_hsp;
    logic [15:0] vsw_vsp;
    logic [23:0] mvid;
    logic [23:0] nvid;
    logic [15:0] misc;

    logic        busy;
    logic        valid;
    logic [7:0]  out_byte;
    logic        out_is_k;

    displayport_msa_generator u_msa (
        .i_clk       (clk),
        .i_rstn      (rstn),
        .i_byte_tick (byte_tick),
        .i_trigger   (trigger),
        .i_htotal    (htotal),
        .i_vtotal    (vtotal),
        .i_hstart    (hstart),
        .i_vstart    (vstart),
        .i_hwidth    (hwidth),
        .i_vheight   (vheight),
        .i_hsw_hsp   (hsw_hsp),
        .i_vsw_vsp   (vsw_vsp),
        .i_mvid      (mvid),
        .i_nvid      (nvid),
        .i_misc      (misc),
        .o_busy      (busy),
        .o_valid     (valid),
        .o_byte      (out_byte),
        .o_is_k      (out_is_k)
    );

    // Golden: {is_k, byte} per row, 33 entries.
    typedef struct packed {
        logic [7:0] data;
        logic       is_k;
    } sample_t;
    sample_t golden [0:32];

    integer mismatches;
    integer checked;

    initial begin
        rstn      = 1'b0;
        byte_tick = 1'b0;
        trigger   = 1'b0;
        htotal    = 16'h0050;
        vtotal    = 16'h0018;
        hstart    = 16'h0010;
        vstart    = 16'h0008;
        hwidth    = 16'h0040;
        vheight   = 16'h0010;
        hsw_hsp   = 16'h8004; // HSP=1, HSW=4
        vsw_vsp   = 16'h0002; // VSP=0, VSW=2
        mvid      = 24'h001234;
        nvid      = 24'h008000;
        misc      = 16'h0001; // MISC0=0x01 (sync mode), MISC1=0x00

        // Build golden vector matching the table above.
        golden[0]  = '{data: 8'h5C, is_k: 1'b1}; // SS
        golden[1]  = '{data: 8'h5C, is_k: 1'b1}; // SS
        golden[2]  = '{data: 8'h00, is_k: 1'b0}; // Mvid23:16
        golden[3]  = '{data: 8'h12, is_k: 1'b0}; // Mvid15:8
        golden[4]  = '{data: 8'h34, is_k: 1'b0}; // Mvid7:0
        golden[5]  = '{data: 8'h00, is_k: 1'b0}; // Htotal15:8
        golden[6]  = '{data: 8'h50, is_k: 1'b0}; // Htotal7:0
        golden[7]  = '{data: 8'h00, is_k: 1'b0}; // Vtotal15:8
        golden[8]  = '{data: 8'h18, is_k: 1'b0}; // Vtotal7:0
        golden[9]  = '{data: 8'h80, is_k: 1'b0}; // HSP|HSW14:8 = 1_0000000
        golden[10] = '{data: 8'h04, is_k: 1'b0}; // HSW7:0
        golden[11] = '{data: 8'h00, is_k: 1'b0}; // VSP|VSW14:8 = 0_0000000
        golden[12] = '{data: 8'h02, is_k: 1'b0}; // VSW7:0
        golden[13] = '{data: 8'h00, is_k: 1'b0}; // Hstart15:8
        golden[14] = '{data: 8'h10, is_k: 1'b0}; // Hstart7:0
        golden[15] = '{data: 8'h00, is_k: 1'b0}; // Vstart15:8
        golden[16] = '{data: 8'h08, is_k: 1'b0}; // Vstart7:0
        golden[17] = '{data: 8'h00, is_k: 1'b0}; // Hwidth15:8
        golden[18] = '{data: 8'h40, is_k: 1'b0}; // Hwidth7:0
        golden[19] = '{data: 8'h00, is_k: 1'b0}; // Vheight15:8
        golden[20] = '{data: 8'h10, is_k: 1'b0}; // Vheight7:0
        golden[21] = '{data: 8'h00, is_k: 1'b0};
        golden[22] = '{data: 8'h00, is_k: 1'b0};
        golden[23] = '{data: 8'h00, is_k: 1'b0}; // Mvid23:16 (redundancy)
        golden[24] = '{data: 8'h12, is_k: 1'b0};
        golden[25] = '{data: 8'h34, is_k: 1'b0};
        golden[26] = '{data: 8'h00, is_k: 1'b0}; // Nvid23:16
        golden[27] = '{data: 8'h80, is_k: 1'b0};
        golden[28] = '{data: 8'h00, is_k: 1'b0};
        golden[29] = '{data: 8'h01, is_k: 1'b0}; // MISC0
        golden[30] = '{data: 8'h00, is_k: 1'b0}; // MISC1
        golden[31] = '{data: 8'h00, is_k: 1'b0};
        golden[32] = '{data: 8'h7C, is_k: 1'b1}; // SE

        mismatches = 0;
        checked    = 0;
        repeat (4) @(posedge clk);
        rstn = 1'b1;
        @(posedge clk);

        // Trigger with byte_tick low so trigger cycle doesn't emit.
        byte_tick = 1'b0;
        trigger   = 1'b1;
        @(posedge clk);
        #1;
        trigger   = 1'b0;
        byte_tick = 1'b1;

        // Sample one byte per posedge. msa_generator should emit byte 0
        // on the first posedge after trigger captures.
        for (int i = 0; i < 33; i++) begin
            @(posedge clk);
            #1;
            if (valid) begin
                checked = checked + 1;
                if (out_byte !== golden[i].data || out_is_k !== golden[i].is_k) begin
                    mismatches = mismatches + 1;
                    $display("[tb_msa_generator] MISMATCH @byte %0d: expected (%02h, k=%b) got (%02h, k=%b)",
                             i, golden[i].data, golden[i].is_k, out_byte, out_is_k);
                end
            end
        end
        byte_tick = 1'b0;
        repeat (4) @(posedge clk);

        if (mismatches != 0) begin
            $fatal(1, "[tb_msa_generator] %0d mismatches across %0d bytes", mismatches, checked);
        end
        if (checked != 33) begin
            $fatal(1, "[tb_msa_generator] only checked %0d bytes (expected 33)", checked);
        end
        $display("[tb_msa_generator] PASS (%0d bytes checked)", checked);
        $finish;
    end

    initial begin
        #2_000_000;
        $fatal(1, "[tb_msa_generator] timeout");
    end
endmodule
}}}
