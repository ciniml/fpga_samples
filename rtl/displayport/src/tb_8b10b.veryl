/**
 * @file tb_8b10b.veryl
 * @brief Phase B unit test for the 8B/10B encoder + decoder.
 *
 * Round-trip checks:
 *   1. All 256 D-byte values encode to a valid 10b symbol that decodes
 *      back to the same byte with is_k = 0 and code_err = 0.
 *   2. The 12 K-codes (K28.0..K28.7, K23.7, K27.7, K29.7, K30.7) each
 *      round-trip with is_k = 1.
 *   3. After the full pass the K28.5 (BC) symbol decodes correctly with
 *      is_k = 1 from both RD-/RD+ entry contexts.
 */

module Tb8b10b {}

#[test(eight_b_ten_b_round_trip)]
embed (inline) sv{{{
module eight_b_ten_b_round_trip;
    logic clk;
    logic rstn;
    initial clk = 0;
    always #5 clk = ~clk;

    // Stimulus to encoder
    logic        enc_valid;
    logic [7:0]  enc_data;
    logic        enc_is_k;

    // Encoder -> decoder bus
    logic        sym_valid;
    logic [9:0]  sym_data;

    // Decoder output
    logic        dec_valid;
    logic [7:0]  dec_data;
    logic        dec_is_k;
    logic        dec_err;

    displayport_encoder_8b10b u_enc (
        .i_clk      (clk),
        .i_rstn     (rstn),
        .i_valid    (enc_valid),
        .i_data     (enc_data),
        .i_is_k     (enc_is_k),
        .i_rd_reset (1'b0),
        .o_valid    (sym_valid),
        .o_symbol   (sym_data)
    );

    displayport_decoder_8b10b u_dec (
        .i_clk      (clk),
        .i_rstn     (rstn),
        .i_valid    (sym_valid),
        .i_symbol   (sym_data),
        .o_valid    (dec_valid),
        .o_data     (dec_data),
        .o_is_k     (dec_is_k),
        .o_code_err (dec_err)
    );

    // 2-deep reference pipeline.
    typedef struct packed {
        logic [7:0] data;
        logic       is_k;
    } sample_t;
    sample_t pipe [0:1];

    integer mismatches;
    integer checked;
    integer code_err_count;

    // Helper: drive (data, k) for one cycle.
    task automatic send(input logic [7:0] d, input logic k);
        enc_valid = 1'b1;
        enc_data  = d;
        enc_is_k  = k;
        @(posedge clk);
    endtask

    initial begin
        rstn       = 1'b0;
        enc_valid  = 1'b0;
        enc_data   = 8'h00;
        enc_is_k   = 1'b0;
        mismatches = 0;
        checked    = 0;
        code_err_count = 0;
        pipe[0]    = '0;
        pipe[1]    = '0;
        repeat (4) @(posedge clk);
        rstn = 1'b1;
        @(posedge clk);

        // Sweep all 256 D-byte values.
        for (int i = 0; i < 256; i++) begin
            send(8'(i), 1'b0);
        end

        // K codes.
        send(8'h1C, 1'b1); // K28.0
        send(8'h3C, 1'b1); // K28.1
        send(8'h5C, 1'b1); // K28.2
        send(8'h7C, 1'b1); // K28.3
        send(8'h9C, 1'b1); // K28.4
        send(8'hBC, 1'b1); // K28.5
        send(8'hDC, 1'b1); // K28.6
        send(8'hFC, 1'b1); // K28.7
        send(8'hF7, 1'b1); // K23.7
        send(8'hFB, 1'b1); // K27.7
        send(8'hFD, 1'b1); // K29.7
        send(8'hFE, 1'b1); // K30.7

        enc_valid = 1'b0;
        repeat (8) @(posedge clk);

        if (mismatches != 0) begin
            $fatal(1, "[tb_8b10b] %0d mismatches across %0d samples", mismatches, checked);
        end
        if (code_err_count != 0) begin
            $fatal(1, "[tb_8b10b] %0d code_err pulses", code_err_count);
        end
        if (checked < 256 + 12) begin
            $fatal(1, "[tb_8b10b] only checked %0d samples", checked);
        end
        $display("[tb_8b10b] PASS (%0d samples checked)", checked);
        $finish;
    end

    always_ff @(posedge clk) begin
        if (!rstn) begin
            pipe[0] <= '0;
            pipe[1] <= '0;
        end else begin
            pipe[1] <= pipe[0];
            if (enc_valid) begin
                pipe[0].data <= enc_data;
                pipe[0].is_k <= enc_is_k;
            end else begin
                pipe[0] <= '0;
            end
        end
    end

    always_ff @(posedge clk) begin
        if (rstn && dec_valid) begin
            checked <= checked + 1;
            if (dec_err) begin
                code_err_count <= code_err_count + 1;
                $display("[tb_8b10b] CODE_ERR @%0t: input data=%02h k=%b symbol=%010b",
                         $time, pipe[1].data, pipe[1].is_k, sym_data);
            end
            if (dec_data !== pipe[1].data || dec_is_k !== pipe[1].is_k) begin
                mismatches <= mismatches + 1;
                $display("[tb_8b10b] MISMATCH @%0t: expected (%02h, k=%b) got (%02h, k=%b) symbol=%010b",
                         $time, pipe[1].data, pipe[1].is_k, dec_data, dec_is_k, sym_data);
            end
        end
    end

    initial begin
        #2_000_000;
        $fatal(1, "[tb_8b10b] timeout");
    end
endmodule
}}}
