<?xml version="1.0" encoding="utf-8"?>
<device schemaVersion="1.1" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
    <vendor>fugafuga.org</vendor>
    <name>display_port_aux_ch_subsystem</name>
    <series>display_port_aux_ch_subsystem</series>
    <version>0.1</version>
    <description>display_port_aux_ch_subsystem</description>
    <addressUnitBits>8</addressUnitBits>
    <width>32</width>
    <size>32</size>
    <access>read-write</access>
    <resetValue>0x00000000</resetValue>
    <resetMask>0xffffffff</resetMask>
    
    <peripherals>
        <peripheral>
            <name>SYSTEM</name>
            <description>SYSTEM</description>
            <baseAddress>0x40000000</baseAddress>
            <registers>
                <register>
                    <name>ID</name>
                    <addressOffset>0x00</addressOffset>
                    <fields>
                        <field>
                            <name>ID</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>32</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>CLOCK_HZ</name>
                    <addressOffset>0x04</addressOffset>
                    <fields>
                        <field>
                            <name>CLOCK_HZ</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>32</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>OUT</name>
                    <addressOffset>0x08</addressOffset>
                    <fields>
                        <field>
                            <name>OUT</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>32</bitWidth>
                            <access>read-write</access>
                            <writeConstraint>
                                <range>
                                    <minimum>0x00000000</minimum>
                                    <maximum>0xffffffff</maximum>
                                </range>
                            </writeConstraint>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HPD</name>
                    <description>Hot Plug Detect status. DP 1.2 section 3.3.</description>
                    <addressOffset>0x10</addressOffset>
                    <fields>
                        <field>
                            <name>LEVEL</name>
                            <description>Debounced HPD level. 1 = sink connected.</description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>EVENT_PLUG</name>
                            <description>Sticky plug event. Write 1 to clear.</description>
                            <bitOffset>1</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>EVENT_UNPLUG</name>
                            <description>Sticky unplug event. Write 1 to clear.</description>
                            <bitOffset>2</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field><name>VHPD</name><description>Virtual HPD level (Type-C alt mode: FW mirrors the PD Attention HPD state here; ORed with the physical pin). Note: any write to this register updates VHPD from bit 4.</description><bitOffset>4</bitOffset><bitWidth>1</bitWidth><access>read-write</access></field>
                        </fields>
                </register>
            </registers>
        </peripheral>
        <peripheral>
            <name>SYSTEM_SERIALOUT</name>
            <description>SYSTEM_SERIALOUT</description>
            <baseAddress>0x40000000</baseAddress>
            <registers>
                <register>
                    <name>SERIAL_OUT</name>
                    <addressOffset>0x0c</addressOffset>
                    <fields>
                        <field>
                            <name>DATA</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-write</access>
                            <writeConstraint>
                                <range>
                                    <minimum>0x00</minimum>
                                    <maximum>0xff</maximum>
                                </range>
                            </writeConstraint>
                        </field>
                        <field>
                            <name>TXBUSY</name>
                            <bitOffset>8</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>busy</name>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>idle</name>
                                    <value>0</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
            </registers>
        </peripheral>
        <peripheral>
            <name>AUX_CH</name>
            <description>BUFFER</description>
            <baseAddress>0x40010000</baseAddress>
            <registers>
                <register>
                    <dim>256</dim>
                    <dimIncrement>4</dimIncrement>
                    <name>BUFFER[%s]</name>
                    <addressOffset>0x0000</addressOffset>
                    <fields>
                        <field>
                            <name>DATA</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-write</access>
                            <writeConstraint>
                                <range>
                                    <minimum>0x00</minimum>
                                    <maximum>0xff</maximum>
                                </range>
                            </writeConstraint>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>OPERATION_STATUS</name>
                    <addressOffset>0x0400</addressOffset>
                    <fields>
                        <field>
                            <name>TX_START</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>start</name>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>idle</name>
                                    <value>0</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>TX_RUNNING</name>
                            <bitOffset>1</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>running</name>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>idle</name>
                                    <value>0</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                        <name>RX_ENABLE</name>
                            <bitOffset>2</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>enabled</name>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>disabled</name>
                                    <value>0</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                        <name>RX_RUNNING</name>
                            <bitOffset>3</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>running</name>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>idle</name>
                                    <value>0</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>INTERRUPT_STATUS</name>
                    <addressOffset>0x0404</addressOffset>
                    <fields>
                        <field>
                            <name>TX_COMPLETE</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>pending</name>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>free</name>
                                    <value>0</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>RX_COMPLETE</name>
                            <bitOffset>1</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>pending</name>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>free</name>
                                    <value>0</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>RX_COUNT</name>
                    <addressOffset>0x0408</addressOffset>
                    <fields>
                        <field>
                            <name>VALUE</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>RX_INDEX</name>
                    <addressOffset>0x040c</addressOffset>
                    <fields>
                        <field>
                            <name>VALUE</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-write</access>
                            <writeConstraint>
                                <range>
                                    <minimum>0x00</minimum>
                                    <maximum>0xff</maximum>
                                </range>
                            </writeConstraint>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TX_COUNT</name>
                    <addressOffset>0x0410</addressOffset>
                    <fields>
                        <field>
                            <name>VALUE</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-write</access>
                            <writeConstraint>
                                <range>
                                    <minimum>0x00</minimum>
                                    <maximum>0xff</maximum>
                                </range>
                            </writeConstraint>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TX_INDEX</name>
                    <addressOffset>0x0414</addressOffset>
                    <fields>
                        <field>
                            <name>VALUE</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-write</access>
                            <writeConstraint>
                                <range>
                                    <minimum>0x00</minimum>
                                    <maximum>0xff</maximum>
                                </range>
                            </writeConstraint>
                        </field>
                    </fields>
                </register>
            </registers>
        </peripheral>
        <peripheral>
            <name>MAIN_LINK</name>
            <description>DisplayPort main-link control (Phase C)</description>
            <baseAddress>0x40020000</baseAddress>
            <registers>
                <register>
                    <name>CTRL</name>
                    <description>Main-link control. Pattern select / enable / RD reset pulse.</description>
                    <addressOffset>0x00</addressOffset>
                    <fields>
                        <field>
                            <name>PATTERN_SELECT</name>
                            <description>00=IDLE, 01=TPS1, 10=TPS2 (DP 1.2 Tab 3-16)</description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>ENABLE</name>
                            <description>1 = main link transmitter enabled</description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>RD_RESET</name>
                            <description>Write 1 to force the next encoder input to start at RD=- (DP 1.2 §3.5.1.2). Self-clearing.</description>
                            <bitOffset>5</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field><name>ASSR</name><description>eDP Alternate Scrambler Seed Reset: scramble with seed 0xFFFE.</description><bitOffset>7</bitOffset><bitWidth>1</bitWidth><access>read-write</access></field>
                        </fields>
                </register>
                <register>
                    <name>LANE_COUNT</name>
                    <description>Active lane count (1, 2, or 4). Phase C uses 1 only.</description>
                    <addressOffset>0x04</addressOffset>
                    <fields>
                        <field>
                            <name>VALUE</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>LANE0_DRIVE</name>
                    <description>Drive setting for lane 0 (informational in sim).</description>
                    <addressOffset>0x08</addressOffset>
                    <fields>
                        <field>
                            <name>VOLTAGE_SWING</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MAX_SWING</name>
                            <bitOffset>2</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>PRE_EMPHASIS</name>
                            <bitOffset>3</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MAX_PRE_EMPHASIS</name>
                            <bitOffset>5</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
            </registers>
        </peripheral>
        <peripheral>
            <name>VIDEO</name>
            <description>DisplayPort video pipeline (Phase D). Sync clock mode.</description>
            <baseAddress>0x40030000</baseAddress>
            <registers>
                <register>
                    <name>CTRL</name>
                    <description>Video control. ENABLE=1 starts framing video using the configured MSA fields.</description>
                    <addressOffset>0x00</addressOffset>
                    <fields>
                        <field><name>ENABLE</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth><access>read-write</access></field>
                    </fields>
                </register>
                <register>
                    <name>HTOTAL</name>
                    <addressOffset>0x04</addressOffset>
                    <fields><field><name>VALUE</name><bitOffset>0</bitOffset><bitWidth>16</bitWidth><access>read-write</access></field></fields>
                </register>
                <register>
                    <name>VTOTAL</name>
                    <addressOffset>0x08</addressOffset>
                    <fields><field><name>VALUE</name><bitOffset>0</bitOffset><bitWidth>16</bitWidth><access>read-write</access></field></fields>
                </register>
                <register>
                    <name>HSTART</name>
                    <addressOffset>0x0C</addressOffset>
                    <fields><field><name>VALUE</name><bitOffset>0</bitOffset><bitWidth>16</bitWidth><access>read-write</access></field></fields>
                </register>
                <register>
                    <name>VSTART</name>
                    <addressOffset>0x10</addressOffset>
                    <fields><field><name>VALUE</name><bitOffset>0</bitOffset><bitWidth>16</bitWidth><access>read-write</access></field></fields>
                </register>
                <register>
                    <name>HWIDTH</name>
                    <addressOffset>0x14</addressOffset>
                    <fields><field><name>VALUE</name><bitOffset>0</bitOffset><bitWidth>16</bitWidth><access>read-write</access></field></fields>
                </register>
                <register>
                    <name>VHEIGHT</name>
                    <addressOffset>0x18</addressOffset>
                    <fields><field><name>VALUE</name><bitOffset>0</bitOffset><bitWidth>16</bitWidth><access>read-write</access></field></fields>
                </register>
                <register>
                    <name>HSW_HSP</name>
                    <description>Horizontal sync. [14:0]=HSW, [15]=HSP polarity.</description>
                    <addressOffset>0x1C</addressOffset>
                    <fields>
                        <field><name>HSW</name><bitOffset>0</bitOffset><bitWidth>15</bitWidth><access>read-write</access></field>
                        <field><name>HSP</name><bitOffset>15</bitOffset><bitWidth>1</bitWidth><access>read-write</access></field>
                    </fields>
                </register>
                <register>
                    <name>VSW_VSP</name>
                    <description>Vertical sync. [14:0]=VSW, [15]=VSP polarity.</description>
                    <addressOffset>0x20</addressOffset>
                    <fields>
                        <field><name>VSW</name><bitOffset>0</bitOffset><bitWidth>15</bitWidth><access>read-write</access></field>
                        <field><name>VSP</name><bitOffset>15</bitOffset><bitWidth>1</bitWidth><access>read-write</access></field>
                    </fields>
                </register>
                <register>
                    <name>MVID</name>
                    <addressOffset>0x24</addressOffset>
                    <fields><field><name>VALUE</name><bitOffset>0</bitOffset><bitWidth>24</bitWidth><access>read-write</access></field></fields>
                </register>
                <register>
                    <name>NVID</name>
                    <addressOffset>0x28</addressOffset>
                    <fields><field><name>VALUE</name><bitOffset>0</bitOffset><bitWidth>24</bitWidth><access>read-write</access></field></fields>
                </register>
                <register>
                    <name>MISC</name>
                    <description>[7:0]=MISC0, [15:8]=MISC1.</description>
                    <addressOffset>0x2C</addressOffset>
                    <fields>
                        <field><name>MISC0</name><bitOffset>0</bitOffset><bitWidth>8</bitWidth><access>read-write</access></field>
                        <field><name>MISC1</name><bitOffset>8</bitOffset><bitWidth>8</bitWidth><access>read-write</access></field>
                    </fields>
                </register>
                <register>
                    <name>TU_ACTIVE</name>
                    <description>Number of active (valid pixel) bytes per 64-symbol TU. CPU computes from Mvid/Nvid.</description>
                    <addressOffset>0x30</addressOffset>
                    <fields><field><name>VALUE</name><bitOffset>0</bitOffset><bitWidth>7</bitWidth><access>read-write</access></field></fields>
                </register>
                <register>
                    <name>LINE_SYMBOLS</name>
                    <description>Link symbols per line per lane (= htotal * LS_clk / pixel_clk; must be an integer). CPU computes.</description>
                    <addressOffset>0x34</addressOffset>
                    <fields><field><name>VALUE</name><bitOffset>0</bitOffset><bitWidth>16</bitWidth><access>read-write</access></field></fields>
                </register>
                <register>
                    <name>ACTIVE_WINDOW</name>
                    <description>Symbols per line per lane occupied by the TU region: floor(B/tu_active)*64 + (B mod tu_active), B = active bytes per lane per line. CPU computes.</description>
                    <addressOffset>0x38</addressOffset>
                    <fields><field><name>VALUE</name><bitOffset>0</bitOffset><bitWidth>16</bitWidth><access>read-write</access></field></fields>
                </register>
            </registers>
        </peripheral>
        <peripheral>
            <name>I2C</name>
            <description>Minimal I2C master (PD PHY / EEPROM). Primitive-per-command model.</description>
            <baseAddress>0x40040000</baseAddress>
            <registers>
                <register>
                    <name>CMD</name>
                    <description>Write: [0]=START [1]=STOP [2]=WRITE [3]=READ [4]=NACK-on-read (one command bit per write). Read: [0]=BUSY [1]=ACK_ERROR (last WRITE not ACKed).</description>
                    <addressOffset>0x00</addressOffset>
                    <fields>
                        <field><name>BUSY</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth><access>read-only</access></field>
                        <field><name>ACK_ERROR</name><bitOffset>1</bitOffset><bitWidth>1</bitWidth><access>read-only</access></field>
                    </fields>
                </register>
                <register>
                    <name>DATA</name>
                    <description>Write: TX byte for the next WRITE command. Read: byte captured by the last READ command.</description>
                    <addressOffset>0x04</addressOffset>
                    <fields><field><name>VALUE</name><bitOffset>0</bitOffset><bitWidth>8</bitWidth><access>read-write</access></field></fields>
                </register>
            </registers>
        </peripheral>
    </peripherals>
</device>