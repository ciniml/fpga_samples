<?xml version="1.0" encoding="utf-8"?>
<device schemaVersion="1.1" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
    <vendor>fugafuga.org</vendor>
    <name>display_port_aux_ch_subsystem</name>
    <series>display_port_aux_ch_subsystem</series>
    <version>0.1</version>
    <description>display_port_aux_ch_subsystem</description>
    <addressUnitBits>8</addressUnitBits>
    <width>32</width>
    <size>32</size>
    <access>read-write</access>
    <resetValue>0x00000000</resetValue>
    <resetMask>0xffffffff</resetMask>
    
    <peripherals>
        <peripheral>
            <name>SYSTEM</name>
            <description>SYSTEM</description>
            <baseAddress>0x40000000</baseAddress>
            <registers>
                <register>
                    <name>ID</name>
                    <addressOffset>0x00</addressOffset>
                    <fields>
                        <field>
                            <name>ID</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>32</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>CLOCK_HZ</name>
                    <addressOffset>0x04</addressOffset>
                    <fields>
                        <field>
                            <name>CLOCK_HZ</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>32</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>OUT</name>
                    <addressOffset>0x08</addressOffset>
                    <fields>
                        <field>
                            <name>OUT</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>32</bitWidth>
                            <access>read-write</access>
                            <writeConstraint>
                                <range>
                                    <minimum>0x00000000</minimum>
                                    <maximum>0xffffffff</maximum>
                                </range>
                            </writeConstraint>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HPD</name>
                    <description>Hot Plug Detect status. DP 1.2 section 3.3.</description>
                    <addressOffset>0x10</addressOffset>
                    <fields>
                        <field>
                            <name>LEVEL</name>
                            <description>Debounced HPD level. 1 = sink connected.</description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>EVENT_PLUG</name>
                            <description>Sticky plug event. Write 1 to clear.</description>
                            <bitOffset>1</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>EVENT_UNPLUG</name>
                            <description>Sticky unplug event. Write 1 to clear.</description>
                            <bitOffset>2</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
            </registers>
        </peripheral>
        <peripheral>
            <name>SYSTEM_SERIALOUT</name>
            <description>SYSTEM_SERIALOUT</description>
            <baseAddress>0x40000000</baseAddress>
            <registers>
                <register>
                    <name>SERIAL_OUT</name>
                    <addressOffset>0x0c</addressOffset>
                    <fields>
                        <field>
                            <name>DATA</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-write</access>
                            <writeConstraint>
                                <range>
                                    <minimum>0x00</minimum>
                                    <maximum>0xff</maximum>
                                </range>
                            </writeConstraint>
                        </field>
                        <field>
                            <name>TXBUSY</name>
                            <bitOffset>8</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>busy</name>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>idle</name>
                                    <value>0</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
            </registers>
        </peripheral>
        <peripheral>
            <name>AUX_CH</name>
            <description>BUFFER</description>
            <baseAddress>0x40010000</baseAddress>
            <registers>
                <register>
                    <dim>256</dim>
                    <dimIncrement>4</dimIncrement>
                    <name>BUFFER[%s]</name>
                    <addressOffset>0x0000</addressOffset>
                    <fields>
                        <field>
                            <name>DATA</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-write</access>
                            <writeConstraint>
                                <range>
                                    <minimum>0x00</minimum>
                                    <maximum>0xff</maximum>
                                </range>
                            </writeConstraint>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>OPERATION_STATUS</name>
                    <addressOffset>0x0400</addressOffset>
                    <fields>
                        <field>
                            <name>TX_START</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>start</name>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>idle</name>
                                    <value>0</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>TX_RUNNING</name>
                            <bitOffset>1</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>running</name>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>idle</name>
                                    <value>0</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                        <name>RX_ENABLE</name>
                            <bitOffset>2</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>enabled</name>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>disabled</name>
                                    <value>0</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                        <name>RX_RUNNING</name>
                            <bitOffset>3</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>running</name>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>idle</name>
                                    <value>0</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>INTERRUPT_STATUS</name>
                    <addressOffset>0x0404</addressOffset>
                    <fields>
                        <field>
                            <name>TX_COMPLETE</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>pending</name>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>free</name>
                                    <value>0</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>RX_COMPLETE</name>
                            <bitOffset>1</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>pending</name>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>free</name>
                                    <value>0</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>RX_COUNT</name>
                    <addressOffset>0x0408</addressOffset>
                    <fields>
                        <field>
                            <name>VALUE</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>RX_INDEX</name>
                    <addressOffset>0x040c</addressOffset>
                    <fields>
                        <field>
                            <name>VALUE</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-write</access>
                            <writeConstraint>
                                <range>
                                    <minimum>0x00</minimum>
                                    <maximum>0xff</maximum>
                                </range>
                            </writeConstraint>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TX_COUNT</name>
                    <addressOffset>0x0410</addressOffset>
                    <fields>
                        <field>
                            <name>VALUE</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-write</access>
                            <writeConstraint>
                                <range>
                                    <minimum>0x00</minimum>
                                    <maximum>0xff</maximum>
                                </range>
                            </writeConstraint>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TX_INDEX</name>
                    <addressOffset>0x0414</addressOffset>
                    <fields>
                        <field>
                            <name>VALUE</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-write</access>
                            <writeConstraint>
                                <range>
                                    <minimum>0x00</minimum>
                                    <maximum>0xff</maximum>
                                </range>
                            </writeConstraint>
                        </field>
                    </fields>
                </register>
            </registers>
        </peripheral>
    </peripherals>
</device>