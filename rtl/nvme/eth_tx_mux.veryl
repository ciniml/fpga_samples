/**
 * @file eth_tx_mux.veryl
 * @brief Two-input AXIS frame arbiter for the MAC TX path: a grant is
 *        taken at idle and held until tlast (port 0 has priority).
 */
pub module EthTxMux (
    i_clk: input clock,
    i_rst: input reset,

    i_s0_data : input  logic<8>,
    i_s0_valid: input  logic   ,
    o_s0_ready: output logic   ,
    i_s0_last : input  logic   ,

    i_s1_data : input  logic<8>,
    i_s1_valid: input  logic   ,
    o_s1_ready: output logic   ,
    i_s1_last : input  logic   ,

    o_m_data : output logic<8>,
    o_m_valid: output logic   ,
    i_m_ready: input  logic   ,
    o_m_last : output logic   ,
) {
    var busy: logic;
    var gsel: logic;

    let sel: logic = if busy ? gsel : (if i_s0_valid ? 1'b0 : 1'b1);
    let act: logic = busy || i_s0_valid || i_s1_valid;

    assign o_m_valid  = act && (if sel ? i_s1_valid : i_s0_valid);
    assign o_m_data   = if sel ? i_s1_data : i_s0_data;
    assign o_m_last   = if sel ? i_s1_last : i_s0_last;
    assign o_s0_ready = act && !sel && i_m_ready;
    assign o_s1_ready = act && sel && i_m_ready;

    always_ff (i_clk, i_rst) {
        if_reset {
            busy = 0;
            gsel = 0;
        } else {
            if o_m_valid && i_m_ready {
                if o_m_last {
                    busy = 0;
                } else {
                    busy = 1;
                    gsel = sel;
                }
            }
        }
    }
}
