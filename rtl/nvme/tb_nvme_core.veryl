/**
 * @file tb_nvme_core.veryl
 * @brief NvmeCore tests.
 *
 * nvme_core: the test body (test/nvme_core_test_body.sv) plays the
 *   transport role: it streams SQEs, moves the h2c/c2h data phases
 *   (with random backpressure on c2h), receives completions and models
 *   the backing RAM. Covers Identify (controller / namespace / active
 *   NS list), Set Features, Write/Read round trips including the last
 *   block, Flush, and the error paths (bad NSID, LBA out of range,
 *   unknown opcodes).
 */

module TbNvmeCore {}

#[test(nvme_core)]
embed (inline) sv{{{
module nvme_core_test;
    nvme_core_test_body #(.RUN(1)) body();
endmodule
}}}
