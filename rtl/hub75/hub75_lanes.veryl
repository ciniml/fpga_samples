//
// HUB75 controller with N colour lanes and a dual-clock frame buffer.
//
// The row-scan / BCM engine is the one of Hub75 (hub75.veryl); what
// changes is the data side:
//   - NUM_LANES RGB lanes are shifted out in parallel on one CLK / LAT /
//     OE / row address. A lane is one R/G/B triplet of a connector
//     (R1G1B1 or R2G2B2); several connectors that share the control
//     signals just add lanes. Lane l shows display rows
//     l*SCAN_ROWS .. l*SCAN_ROWS + SCAN_ROWS-1.
//   - The frame buffer is written from another clock domain (`'w`) by
//     lane / address, with the bank (double buffer) folded into the
//     address MSB: one memory per lane of 2 × SCAN_ROWS × CHAIN_LEN
//     pixels, COMPONENT_BITS per colour.
//   - A flip request from the writer is carried over with a toggle and
//     consumed at the next panel frame boundary; `o_flip_busy` stays set
//     (in the writer's domain) until the display has switched banks, and
//     the writer must not write meanwhile (the back bank is about to be
//     shown).
//
// Lane address = {scan_row, chain_x}; chain_x 0 is the first pixel
// shifted out of a row (it ends up at the far end of the chain).
pub module Hub75Lanes #(
    param SCAN_ROWS     : u32 = 32                                       , // rows sharing one row address (1/SCAN_ROWS scan, <= 32)
    param CHAIN_LEN     : u32 = 128                                      , // shift cells per row (panel width × panels in the chain)
    param NUM_LANES     : u32 = 4                                        ,
    param CLOCK_DIVIDER : u32 = 0                                        , // HUB75 clk period = (2 + CLK_LOW_EXTRA) * (N+1) clocks
    param CLK_LOW_EXTRA : u32 = 1                                        ,
    param COMPONENT_BITS: u32 = 6                                        , // BCM bit planes per colour component
    param BASE_OE_CYCLES: u32 = 16                                       , // OE pulse unit; LSB plane shows 2×this
    const ROW_BITS      : u32 = $clog2(SCAN_ROWS)                        ,
    const X_BITS        : u32 = $clog2(CHAIN_LEN)                        ,
    const LANE_BITS     : u32 = if NUM_LANES >: 1 ? $clog2(NUM_LANES) : 1,
    const PX_BITS       : u32 = 3 * COMPONENT_BITS                       ,
) (
    // ---- writer domain ----
    i_wclk     : input  'w clock                   ,
    i_wrst     : input  'w logic                   , // synchronous, active high
    i_we       : input  'w logic                   ,
    i_wlane    : input  'w logic<LANE_BITS>        ,
    i_waddr    : input  'w logic<ROW_BITS + X_BITS>, // {scan_row, chain_x}
    i_wdata    : input  'w logic<PX_BITS>          , // {R, G, B}
    i_flip_req : input  'w logic                   , // pulse, ignored while busy
    o_flip_busy: output 'w logic                   ,

    // ---- display domain ----
    i_clk  : input  'd clock           ,
    i_rst  : input  'd logic           , // synchronous, active high
    o_frame: output 'd logic           , // pulse at every panel frame boundary
    o_row  : output 'd logic<5>        , // row address A..E
    o_r    : output 'd logic<NUM_LANES>,
    o_g    : output 'd logic<NUM_LANES>,
    o_b    : output 'd logic<NUM_LANES>,
    o_oe   : output 'd logic           , // active low
    o_lat  : output 'd logic           ,
    o_clk  : output 'd logic           ,
) {
    const LANE_ADDR_BITS: u32 = ROW_BITS + X_BITS;
    const DEPTH         : u32 = 2 * SCAN_ROWS * CHAIN_LEN; // both banks
    const OE_MAX        : u32 = BASE_OE_CYCLES << COMPONENT_BITS;
    const OE_BITS       : u32 = $clog2(OE_MAX + 1);
    const CLKDIV_BITS   : u32 = $clog2(CLOCK_DIVIDER + 2);
    const LOW_BITS      : u32 = $clog2(CLK_LOW_EXTRA + 2);

    const ST_RESET      : logic<4> = 4'd0;
    const ST_INIT_BRIGHT: logic<4> = 4'd1;
    const ST_INIT_OUTPUT: logic<4> = 4'd2;
    const ST_START_FRAME: logic<4> = 4'd3;
    const ST_SETUP_ROW  : logic<4> = 4'd4;
    const ST_OUTPUT_ROW : logic<4> = 4'd5;
    const ST_WAIT_OE    : logic<4> = 4'd6;
    const ST_NEXT_ROW   : logic<4> = 4'd7;
    const ST_LATCH      : logic<4> = 4'd8;

    // FM6126A init patterns.
    const BRIGHTNESS_PATTERN: logic<16> = 16'b0000_0111_1110_0000;
    const ENABLE_PATTERN    : logic<16> = 16'b0000_0010_0000_0000;

    // ---------------------------------------------------------------
    // Flip handshake. read_bank == ack_tog at all times (both start at 0
    // and change together), so the writer's back bank is ~ack.
    // ---------------------------------------------------------------
    var req_tog: 'w logic;
    var ack_w1 : 'w logic;
    var ack_w2 : 'w logic;
    var req_d1 : 'd logic;
    var req_d2 : 'd logic;
    var ack_tog: 'd logic;

    let flip_busy: 'w logic = req_tog != ack_w2;
    let wbank    : 'w logic = ~ack_w2;
    assign o_flip_busy = flip_busy;

    unsafe (cdc) {
        always_ff (i_wclk) {
            if i_wrst {
                req_tog = 1'b0;
                ack_w1  = 1'b0;
                ack_w2  = 1'b0;
            } else {
                ack_w1 = ack_tog;
                ack_w2 = ack_w1;
                if i_flip_req && !flip_busy {
                    req_tog = ~req_tog;
                }
            }
        }
    }

    // ---------------------------------------------------------------
    // Frame buffer: one dual-clock memory per lane.
    // ---------------------------------------------------------------
    var address  : 'd logic<LANE_ADDR_BITS>            ; // registered read address (without the bank)
    var read_bank: 'd logic                            ;
    var lane_dout: 'd logic<PX_BITS>        [NUM_LANES];

    for i in 0..NUM_LANES :g_lane {
        #[sv("ram_style=\"block\"")]
        var mem: logic<PX_BITS> [DEPTH];
        always_ff (i_wclk) {
            if i_we && i_wlane == i {
                mem[{wbank, i_waddr}] = i_wdata;
            }
        }
        unsafe (cdc) {
            assign lane_dout[i] = mem[{read_bank, address}];
        }
    }

    // ---------------------------------------------------------------
    // FSM registers.
    // ---------------------------------------------------------------
    var state        : 'd logic<4>             ;
    var x_counter    : 'd logic<X_BITS>        ;
    var y_counter    : 'd logic<5>             ;
    var oe_counter   : 'd logic<OE_BITS>       ;
    var next_oe      : 'd logic<OE_BITS>       ;
    var output_bit   : 'd logic<COMPONENT_BITS>; // one-hot BCM plane mask, MSB→LSB
    var row_addr     : 'd logic<LANE_ADDR_BITS>;
    var clk_reg      : 'd logic                ;
    var clock_counter: 'd logic<CLKDIV_BITS>   ;
    var out_phase    : 'd logic                ;
    var low_wait     : 'd logic<LOW_BITS>      ;
    var latch_line   : 'd logic                ;
    var oe_active    : 'd logic                ;
    var frame_q      : 'd logic                ;
    var rgb_r        : 'd logic<NUM_LANES>     ;
    var rgb_g        : 'd logic<NUM_LANES>     ;
    var rgb_b        : 'd logic<NUM_LANES>     ;

    var plane_r: 'd logic<NUM_LANES>;
    var plane_g: 'd logic<NUM_LANES>;
    var plane_b: 'd logic<NUM_LANES>;
    for i in 0..NUM_LANES :g_plane {
        assign plane_r[i] = (lane_dout[i][3 * COMPONENT_BITS - 1:2 * COMPONENT_BITS] & output_bit) != 0;
        assign plane_g[i] = (lane_dout[i][2 * COMPONENT_BITS - 1:COMPONENT_BITS] & output_bit) != 0;
        assign plane_b[i] = (lane_dout[i][COMPONENT_BITS - 1:0] & output_bit) != 0;
    }

    let clock_enable : 'd logic                 = (state != ST_RESET) && (clock_counter == 0);
    let initializing : 'd logic                 = (state == ST_RESET) || (state == ST_INIT_BRIGHT)
        || (state == ST_INIT_OUTPUT);
    let bright_bit   : 'd logic                 = BRIGHTNESS_PATTERN[x_counter[3:0]];
    let enable_bit   : 'd logic                 = ENABLE_PATTERN[x_counter[3:0]];
    let row_init_addr: 'd logic<LANE_ADDR_BITS> = {y_counter[ROW_BITS - 1:0], 1'b0 repeat X_BITS};
    let flip_pending : 'd logic                 = req_d2 != ack_tog;

    assign o_frame = frame_q;
    assign o_row   = y_counter;
    assign o_r     = rgb_r;
    assign o_g     = rgb_g;
    assign o_b     = rgb_b;
    assign o_lat   = latch_line;
    assign o_clk   = clk_reg;
    // OE is active-low on the panel — high while idle / blanked.
    assign o_oe = (oe_counter == 0) || initializing;

    unsafe (cdc) {
        always_ff (i_clk) {
            if i_rst {
                req_d1 = 1'b0;
                req_d2 = 1'b0;
            } else {
                req_d1 = req_tog;
                req_d2 = req_d1;
            }
        }
    }

    always_ff (i_clk) {
        if i_rst {
            state         = ST_RESET;
            x_counter     = 0 as X_BITS;
            y_counter     = 5'd0;
            oe_counter    = 0 as OE_BITS;
            next_oe       = 0 as OE_BITS;
            output_bit    = 0 as COMPONENT_BITS;
            address       = 0 as LANE_ADDR_BITS;
            row_addr      = 0 as LANE_ADDR_BITS;
            clk_reg       = 1'b0;
            clock_counter = 0 as CLKDIV_BITS;
            out_phase     = 1'b0;
            low_wait      = 0 as LOW_BITS;
            latch_line    = 1'b0;
            oe_active     = 1'b0;
            frame_q       = 1'b0;
            rgb_r         = 0 as NUM_LANES;
            rgb_g         = 0 as NUM_LANES;
            rgb_b         = 0 as NUM_LANES;
            read_bank     = 1'b0;
            ack_tog       = 1'b0;
        } else {
            frame_q = 1'b0;
            if oe_counter >: 0 as OE_BITS {
                oe_counter = oe_counter - (1 as OE_BITS);
            }
            if state != ST_RESET {
                if clock_counter == 0 as CLKDIV_BITS {
                    // free-running shift clock only for the FM6126A init
                    if state == ST_INIT_BRIGHT || state == ST_INIT_OUTPUT {
                        clk_reg = ~clk_reg;
                    }
                    clock_counter = CLOCK_DIVIDER as CLKDIV_BITS;
                } else {
                    clock_counter = clock_counter - (1 as CLKDIV_BITS);
                }
            }

            case state {
                ST_RESET: {
                    address    = 0 as LANE_ADDR_BITS;
                    x_counter  = 0 as X_BITS;
                    y_counter  = 5'd0;
                    oe_counter = 0 as OE_BITS;
                    latch_line = 1'b0;
                    clk_reg    = 1'b0;
                    out_phase  = 1'b0;
                    rgb_r      = 0 as NUM_LANES;
                    rgb_g      = 0 as NUM_LANES;
                    rgb_b      = 0 as NUM_LANES;
                    oe_active  = 1'b0;
                    state      = ST_INIT_BRIGHT;
                }

                ST_INIT_BRIGHT: {
                    if clock_enable {
                        if !clk_reg && !out_phase {
                            rgb_r      = {bright_bit repeat NUM_LANES};
                            rgb_g      = {bright_bit repeat NUM_LANES};
                            rgb_b      = {bright_bit repeat NUM_LANES};
                            latch_line = x_counter >: ((CHAIN_LEN - 12) as X_BITS);
                            out_phase  = 1'b1;
                        } else if !clk_reg && out_phase {
                            clk_reg = 1'b1;
                        } else {
                            clk_reg   = 1'b0;
                            out_phase = 1'b0;
                            x_counter = x_counter + (1 as X_BITS);
                            if x_counter == ((CHAIN_LEN - 1) as X_BITS) {
                                x_counter  = 0 as X_BITS;
                                latch_line = 1'b0;
                                state      = ST_INIT_OUTPUT;
                            }
                        }
                    }
                }

                ST_INIT_OUTPUT: {
                    if clock_enable {
                        if !clk_reg && !out_phase {
                            rgb_r      = {enable_bit repeat NUM_LANES};
                            rgb_g      = {enable_bit repeat NUM_LANES};
                            rgb_b      = {enable_bit repeat NUM_LANES};
                            latch_line = x_counter >: ((CHAIN_LEN - 13) as X_BITS);
                            out_phase  = 1'b1;
                        } else if !clk_reg && out_phase {
                            clk_reg = 1'b1;
                        } else {
                            out_phase = 1'b0;
                            x_counter = x_counter + (1 as X_BITS);
                            if x_counter == ((CHAIN_LEN - 1) as X_BITS) {
                                clk_reg    = 1'b1;
                                x_counter  = 0 as X_BITS;
                                latch_line = 1'b0;
                                state      = ST_START_FRAME;
                            } else {
                                clk_reg = 1'b0;
                            }
                        }
                    }
                }

                ST_START_FRAME: {
                    y_counter = 5'd0;
                    address   = 0 as LANE_ADDR_BITS;
                    frame_q   = 1'b1;
                    // consume a pending flip exactly at the frame boundary
                    if flip_pending {
                        read_bank = ~read_bank;
                        ack_tog   = ~ack_tog;
                    }
                    state = ST_SETUP_ROW;
                }

                ST_SETUP_ROW: {
                    x_counter  = 0 as X_BITS;
                    clk_reg    = 1'b0;
                    address    = row_init_addr;
                    row_addr   = row_init_addr;
                    output_bit = (1 << (COMPONENT_BITS - 1)) as COMPONENT_BITS;
                    next_oe    = OE_MAX as OE_BITS;
                    out_phase  = 1'b0;
                    state      = ST_OUTPUT_ROW;
                }

                ST_OUTPUT_ROW: {
                    // CHAIN_LEN pulses per plane: CLK low with the plane bits
                    // on the data lines (1 + CLK_LOW_EXTRA ticks), then CLK
                    // high while the frame buffer address advances.
                    if clock_enable {
                        if !out_phase {
                            clk_reg   = 1'b0;
                            rgb_r     = plane_r;
                            rgb_g     = plane_g;
                            rgb_b     = plane_b;
                            out_phase = 1'b1;
                            low_wait  = CLK_LOW_EXTRA as LOW_BITS;
                        } else if low_wait != 0 {
                            low_wait = low_wait - (1 as LOW_BITS);
                        } else {
                            clk_reg   = 1'b1;
                            out_phase = 1'b0;
                            address   = address + (1 as LANE_ADDR_BITS);
                            if x_counter == ((CHAIN_LEN - 1) as X_BITS) {
                                x_counter = 0 as X_BITS;
                                state     = ST_LATCH;
                            } else {
                                x_counter = x_counter + (1 as X_BITS);
                            }
                        }
                    }
                }

                ST_LATCH: {
                    if clock_enable {
                        if clk_reg {
                            clk_reg = 1'b0;
                        } else if !latch_line {
                            latch_line = 1'b1;
                        } else {
                            latch_line = 1'b0;
                            oe_counter = next_oe;
                            oe_active  = 1'b1;
                            state      = ST_WAIT_OE;
                        }
                    }
                }

                ST_WAIT_OE: {
                    if oe_active && oe_counter == 0 as OE_BITS {
                        oe_active = 1'b0;
                        next_oe   = next_oe >> 1;
                        if output_bit == (1 as COMPONENT_BITS) {
                            state = ST_NEXT_ROW;
                        } else {
                            output_bit = output_bit >> 1;
                            address    = row_addr;
                            x_counter  = 0 as X_BITS;
                            out_phase  = 1'b0;
                            state      = ST_OUTPUT_ROW;
                        }
                    }
                }

                ST_NEXT_ROW: {
                    if y_counter == ((SCAN_ROWS - 1) as 5) {
                        state = ST_START_FRAME;
                    } else {
                        y_counter = y_counter + 5'd1;
                        state     = ST_SETUP_ROW;
                    }
                }

                default: {}
            }
        }
    }
}
