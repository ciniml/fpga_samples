/**
 * @file usb3_rx_fifo.veryl
 * @brief Receive symbol window: a plain shift register of the last 24
 *        symbols (6 PIPE words) with the raw and descrambled copies, the K
 *        flag and the class bits of each symbol, plus a fill count.
 *
 * Nothing is removed or realigned here: the parser keeps a registered
 * read position into this window, which keeps its decision loop short
 * (the window shifts by exactly one word every clock; filler without
 * class bits when the PHY has no data). SKP symbols stay in the stream and
 * are ignored by the parser.
 */
module Usb3RxFifo (
    i_clk  : input  clock     ,
    i_rst  : input  reset     ,
    i_flush: input  logic     , // discard everything (link state change)
    i_valid: input  logic     ,
    i_raw  : input  logic<32> ,
    i_desc : input  logic<32> ,
    i_k    : input  logic<4>  ,
    i_cls  : input  logic<32> , // symbol class bits (usb3_pkg::sym_class) per symbol
    o_raw  : output logic<192>, // window symbol j = [j*8 +: 8], j = 0 oldest
    o_desc : output logic<192>,
    o_k    : output logic<24> ,
    o_cls  : output logic<192>,
    o_fill : output logic<5>  , // valid symbols at the top of the window (saturates at 24)
) {
    const N: u32 = 24;

    var fill: logic<5>;
    assign o_fill = fill;

    always_ff {
        if_reset {
            fill   = 0;
            o_raw  = 0;
            o_desc = 0;
            o_k    = 0;
            o_cls  = 0;
        } else if i_flush {
            fill = 0;
        } else {
            // the window always advances: a word with no class bits is shifted
            // in when the PHY delivers nothing, so that the last symbols of a
            // stream (e.g. LPMA before U3) are still reached by the parser
            if i_valid {
                o_raw  = {i_raw, o_raw[191:32]};
                o_desc = {i_desc, o_desc[191:32]};
                o_k    = {i_k, o_k[23:4]};
                o_cls  = {i_cls, o_cls[191:32]};
            } else {
                o_raw  = {32'h0, o_raw[191:32]};
                o_desc = {32'h0, o_desc[191:32]};
                o_k    = {4'h0, o_k[23:4]};
                o_cls  = {32'h0, o_cls[191:32]};
            }
            if fill <= (N - 4) as 5 {
                fill = fill + 4;
            }
        }
    }
}
