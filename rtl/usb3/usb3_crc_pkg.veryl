/**
 * @file usb3_crc_pkg.veryl
 * @brief Parallel CRC-16 / CRC-32 updates over 1..4 bytes (generated by
 *        gen_crc_pkg.py, do not edit). Same registers and conventions as
 *        the byte-serial helpers in usb3_pkg; flattened so that each
 *        output bit is one XOR of the inputs.
 */
pub package usb3_crc_pkg {
    function crc16_w1 (
        crc: input logic<16>,
        d  : input logic<8> ,
    ) -> logic<16> {
        var r    : logic<16>;
        r[0]  = crc[0] ^ crc[4] ^ crc[8] ^ d[0] ^ d[4];
        r[1]  = crc[1] ^ crc[5] ^ crc[9] ^ d[1] ^ d[5];
        r[2]  = crc[2] ^ crc[6] ^ crc[10] ^ d[2] ^ d[6];
        r[3]  = crc[3] ^ crc[7] ^ crc[11] ^ d[3] ^ d[7];
        r[4]  = crc[12];
        r[5]  = crc[0] ^ crc[13] ^ d[0];
        r[6]  = crc[1] ^ crc[14] ^ d[1];
        r[7]  = crc[0] ^ crc[2] ^ crc[15] ^ d[0] ^ d[2];
        r[8]  = crc[0] ^ crc[1] ^ crc[3] ^ d[0] ^ d[1] ^ d[3];
        r[9]  = crc[0] ^ crc[1] ^ crc[2] ^ crc[4] ^ d[0] ^ d[1] ^ d[2] ^ d[4];
        r[10] = crc[1] ^ crc[2] ^ crc[3] ^ crc[5] ^ d[1] ^ d[2] ^ d[3] ^ d[5];
        r[11] = crc[0] ^ crc[2] ^ crc[3] ^ crc[4] ^ crc[6] ^ d[0] ^ d[2] ^ d[3] ^ d[4] ^ d[6];
        r[12] = crc[0] ^ crc[1] ^ crc[3] ^ crc[4] ^ crc[5] ^ crc[7] ^ d[0] ^ d[1] ^ d[3] ^ d[4] ^ d[5] ^ d[7];
        r[13] = crc[1] ^ crc[2] ^ crc[5] ^ crc[6] ^ d[1] ^ d[2] ^ d[5] ^ d[6];
        r[14] = crc[2] ^ crc[3] ^ crc[6] ^ crc[7] ^ d[2] ^ d[3] ^ d[6] ^ d[7];
        r[15] = crc[3] ^ crc[7] ^ d[3] ^ d[7];
        return r;
    }
    function crc16_w2 (
        crc: input logic<16>,
        d  : input logic<16>,
    ) -> logic<16> {
        var r    : logic<16>;
        r[0]  = crc[1] ^ crc[3] ^ crc[4] ^ crc[8] ^ crc[12] ^ d[1] ^ d[3] ^ d[4] ^ d[8] ^ d[12];
        r[1]  = crc[2] ^ crc[4] ^ crc[5] ^ crc[9] ^ crc[13] ^ d[2] ^ d[4] ^ d[5] ^ d[9] ^ d[13];
        r[2]  = crc[3] ^ crc[5] ^ crc[6] ^ crc[10] ^ crc[14] ^ d[3] ^ d[5] ^ d[6] ^ d[10] ^ d[14];
        r[3]  = crc[4] ^ crc[6] ^ crc[7] ^ crc[11] ^ crc[15] ^ d[4] ^ d[6] ^ d[7] ^ d[11] ^ d[15];
        r[4]  = crc[0] ^ crc[1] ^ crc[3] ^ crc[4] ^ crc[5] ^ crc[7] ^ d[0] ^ d[1] ^ d[3] ^ d[4] ^ d[5] ^ d[7];
        r[5]  = crc[0] ^ crc[1] ^ crc[2] ^ crc[4] ^ crc[5] ^ crc[6] ^ crc[8] ^ d[0] ^ d[1] ^ d[2] ^ d[4] ^ d[5] ^ d[6]
            ^ d[8];
        r[6]  = crc[1] ^ crc[2] ^ crc[3] ^ crc[5] ^ crc[6] ^ crc[7] ^ crc[9] ^ d[1] ^ d[2] ^ d[3] ^ d[5] ^ d[6] ^ d[7]
            ^ d[9];
        r[7]  = crc[0] ^ crc[2] ^ crc[3] ^ crc[4] ^ crc[6] ^ crc[7] ^ crc[8] ^ crc[10] ^ d[0] ^ d[2] ^ d[3] ^ d[4]
            ^ d[6] ^ d[7] ^ d[8] ^ d[10];
        r[8]  = crc[0] ^ crc[1] ^ crc[3] ^ crc[4] ^ crc[5] ^ crc[7] ^ crc[8] ^ crc[9] ^ crc[11] ^ d[0] ^ d[1] ^ d[3]
            ^ d[4] ^ d[5] ^ d[7] ^ d[8] ^ d[9] ^ d[11];
        r[9]  = crc[0] ^ crc[1] ^ crc[2] ^ crc[4] ^ crc[5] ^ crc[6] ^ crc[8] ^ crc[9] ^ crc[10] ^ crc[12] ^ d[0] ^ d[1]
            ^ d[2] ^ d[4] ^ d[5] ^ d[6] ^ d[8] ^ d[9] ^ d[10] ^ d[12];
        r[10] = crc[0] ^ crc[1] ^ crc[2] ^ crc[3] ^ crc[5] ^ crc[6] ^ crc[7] ^ crc[9] ^ crc[10] ^ crc[11] ^ crc[13]
            ^ d[0] ^ d[1] ^ d[2] ^ d[3] ^ d[5] ^ d[6] ^ d[7] ^ d[9] ^ d[10] ^ d[11] ^ d[13];
        r[11] = crc[0] ^ crc[1] ^ crc[2] ^ crc[3] ^ crc[4] ^ crc[6] ^ crc[7] ^ crc[8] ^ crc[10] ^ crc[11] ^ crc[12]
            ^ crc[14] ^ d[0] ^ d[1] ^ d[2] ^ d[3] ^ d[4] ^ d[6] ^ d[7] ^ d[8] ^ d[10] ^ d[11] ^ d[12] ^ d[14];
        r[12] = crc[0] ^ crc[1] ^ crc[2] ^ crc[3] ^ crc[4] ^ crc[5] ^ crc[7] ^ crc[8] ^ crc[9] ^ crc[11] ^ crc[12]
            ^ crc[13] ^ crc[15] ^ d[0] ^ d[1] ^ d[2] ^ d[3] ^ d[4] ^ d[5] ^ d[7] ^ d[8] ^ d[9] ^ d[11] ^ d[12] ^ d[13]
            ^ d[15];
        r[13] = crc[0] ^ crc[2] ^ crc[5] ^ crc[6] ^ crc[9] ^ crc[10] ^ crc[13] ^ crc[14] ^ d[0] ^ d[2] ^ d[5] ^ d[6]
            ^ d[9] ^ d[10] ^ d[13] ^ d[14];
        r[14] = crc[0] ^ crc[1] ^ crc[3] ^ crc[6] ^ crc[7] ^ crc[10] ^ crc[11] ^ crc[14] ^ crc[15] ^ d[0] ^ d[1] ^ d[3]
            ^ d[6] ^ d[7] ^ d[10] ^ d[11] ^ d[14] ^ d[15];
        r[15] = crc[0] ^ crc[2] ^ crc[3] ^ crc[7] ^ crc[11] ^ crc[15] ^ d[0] ^ d[2] ^ d[3] ^ d[7] ^ d[11] ^ d[15];
        return r;
    }
