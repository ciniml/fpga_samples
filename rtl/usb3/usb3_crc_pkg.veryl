            ^ crc[12] ^ crc[14] ^ crc[15] ^ d[0] ^ d[1] ^ d[2] ^ d[4] ^ d[5] ^ d[6] ^ d[7] ^ d[8] ^ d[9] ^ d[10] ^ d[11]
            ^ d[12] ^ d[14] ^ d[15] ^ d[16] ^ d[18] ^ d[19] ^ d[20] ^ d[22];
        r[12] = crc[0] ^ crc[1] ^ crc[2] ^ crc[3] ^ crc[5] ^ crc[6] ^ crc[7] ^ crc[8] ^ crc[9] ^ crc[10] ^ crc[11]
            ^ crc[12] ^ crc[13] ^ crc[15] ^ d[0] ^ d[1] ^ d[2] ^ d[3] ^ d[5] ^ d[6] ^ d[7] ^ d[8] ^ d[9] ^ d[10] ^ d[11]
            ^ d[12] ^ d[13] ^ d[15] ^ d[16] ^ d[17] ^ d[19] ^ d[20] ^ d[21] ^ d[23];
        r[13] = crc[0] ^ crc[2] ^ crc[6] ^ crc[7] ^ crc[8] ^ crc[10] ^ crc[13] ^ crc[14] ^ d[0] ^ d[2] ^ d[6] ^ d[7]
            ^ d[8] ^ d[10] ^ d[13] ^ d[14] ^ d[17] ^ d[18] ^ d[21] ^ d[22];
