            ^ d[14] ^ d[15] ^ d[19] ^ d[23];
        r[4]  = crc[0] ^ crc[1] ^ crc[2] ^ crc[3] ^ crc[4] ^ crc[5] ^ crc[7] ^ crc[8] ^ crc[9] ^ crc[11] ^ crc[12]
