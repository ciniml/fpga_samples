/**
 * @file usb3_phy_ctl.veryl
 * @brief Control of the soft USB 3.0 PHY on the GW5AT GTR12 quad.
 *
 * Usb3PhyCtl (pclk) answers the PIPE side: PhyStatus for power state
 * changes (at once, as Gowin's PHY does) and for receiver detection (with
 * RxStatus 3 = receiver present, 0 = none), RxElecIdle from the lane's signal
 * detector. In P0, while proper 8b/10b words come in (within the last 64
 * clocks), RxElecIdle stays 1: the signal then is data, not LFPS, and the
 * LTSSM takes a long RxElecIdle 0 for a Warm Reset (Gowin's PHY keeps it at 1
 * throughout P0). A Warm Reset's LFPS does not decode, so it still shows.
 *
 * Usb3PhyDrp (the quad's DRP clock) does what has to go through the
 * register port, in the order Gowin's PHY was seen doing it
 * (eda/slogic16u3_usb3 TAP=1, README):
 *   driver on / off (data or LFPS on the line):   0x8003a4 <- 7 / 1
 *   receiver detection: 0x80033f <- 0x03000000, wait, 0x80033f <- 0, read
 *     0x808b34; the result is the quad's rxdet_result pin, seen rising in the
 *     meantime (a level left over from the previous detection does not count); when present: 0x808238 <- 0, 0x8082d8 <- 0, 0x110
 *   entering P0: 0x808238 <- 0x805, 0x8082d8 <- 0, 0x110
 * Requests come from pclk as levels (drive, power state) and a toggle
 * (detection); the answer to a detection goes back as a toggle + result.
 */
module Usb3PhyCtl (
    i_clk        : input  clock   ,
    i_rst        : input  reset   ,
    i_power_down : input  logic<2>,
    i_elecidle   : input  logic   , // TxElecIdle
    i_detectrx   : input  logic   , // TxDetectRx_loopback
    i_sig        : input  logic   , // lane signal present (asynchronous)
    i_rx_good    : input  logic   , // a received word without decode / disparity error (this clock)
    i_det_done   : input  logic   , // toggle from Usb3PhyDrp (asynchronous)
    i_det_res    : input  logic   , // result, stable when i_det_done toggles
    o_det_req    : output logic   , // toggle to Usb3PhyDrp
    o_phy_status : output logic   ,
    o_det_status : output logic<3>, // RxStatus while o_phy_status answers a detection (else 0)
    o_rx_elecidle: output logic   ,
) {
    var pd_d   : logic<2>;
    var req    : logic   ;
    var busy   : logic   ;
    var done_s : logic<3>;
    var res_s  : logic<2>;
    var sig_s  : logic<2>;
    var physt  : logic   ;
    var detst  : logic<3>;
    var det_d  : logic   ;
    var good   : logic<7>; // clocks since the last good word (saturating)

    assign o_det_req     = req;
    assign o_phy_status  = physt;
    assign o_det_status  = detst;
    assign o_rx_elecidle = !sig_s[1] || i_power_down == 2'd0 && good != 7'h7F;

    always_ff {
        if_reset {
            pd_d   = 2'd2;
            req    = 0;
            busy   = 0;
            done_s = 0;
            res_s  = 0;
            sig_s  = 0;
            physt  = 0;
            detst  = 0;
            det_d  = 0;
            good   = 7'h7F;
        } else {
            good = if i_rx_good ? 7'd0 : if good != 7'h7F ? good + 7'd1 : good;
            if good == 7'd63 {
                good = 7'h7F;
            }
            done_s = {done_s[1:0], i_det_done};
            res_s  = {res_s[0], i_det_res};
            sig_s  = {sig_s[0], i_sig};
            pd_d   = i_power_down;
            det_d  = i_detectrx && i_elecidle && i_power_down != 2'd0;
            physt  = 0;
            detst  = 0;
            if done_s[2] != done_s[1] {
                busy  = 0;
                physt = 1;
                detst = if res_s[1] ? 3'd3 : 3'd0;
            } else if i_power_down != pd_d {
                physt = 1;
            } else if !busy && i_detectrx && i_elecidle && i_power_down != 2'd0 && !det_d {
                // a new request (TxDetectRx rose); it is held until PhyStatus answers it
                req  = !req;
                busy = 1;
            }
        }
    }
}

module Usb3PhyDrp #(
    param WAIT_CLKS: u32 = 300, // receiver detection time (~5.4 us at the ~56 MHz DRP clock)
) (
    i_clk       : input  clock    ,
    i_rst       : input  reset    ,
    i_drive     : input  logic    , // asynchronous (pclk)
    i_power_down: input  logic<2> , // asynchronous (pclk)
    i_det_req   : input  logic    , // toggle (pclk)
    i_rxdet     : input  logic    , // quad rxdet_result pin
    o_det_done  : output logic    , // toggle back
    o_det_res   : output logic    ,
    o_rd_last   : output logic<32>, // last read value (debug)
    // DRP master (the IP's channel of the upar arbiter)
    o_wren      : output logic    ,
    o_rden      : output logic    ,
    o_addr      : output logic<24>,
    o_wrdata    : output logic<32>,
    o_strb      : output logic<8> ,
    i_ready     : input  logic    ,
    i_rdvld     : input  logic    ,
    i_rddata    : input  logic<32>,
) {
    // sequences
    const SQ_DRV_ON : logic<3> = 3'd0;
    const SQ_DRV_OFF: logic<3> = 3'd1;
    const SQ_DET    : logic<3> = 3'd2;
    const SQ_POSTDET: logic<3> = 3'd3;
    const SQ_P0     : logic<3> = 3'd4;
    const OP_END    : logic<2> = 2'd0;
    const OP_W      : logic<2> = 2'd1;
    const OP_R      : logic<2> = 2'd2;
    const OP_WAIT   : logic<2> = 2'd3;

    /// {op, addr, data}
    function rom (
        sq: input logic<3>,
        st: input logic<3>,
    ) -> logic<58> {
        return case {sq, st} {
            {SQ_DRV_ON, 3'd0} : {OP_W, 24'h8003a4, 32'h00000007},
            {SQ_DRV_OFF, 3'd0}: {OP_W, 24'h8003a4, 32'h00000001},
            {SQ_DET, 3'd0}    : {OP_W, 24'h80033f, 32'h03000000},
            {SQ_DET, 3'd1}    : {OP_WAIT, 24'h0, 32'h0},
            {SQ_DET, 3'd2}    : {OP_W, 24'h80033f, 32'h00000000},
            {SQ_DET, 3'd3}    : {OP_R, 24'h808b34, 32'h0},
            {SQ_POSTDET, 3'd0}: {OP_W, 24'h808238, 32'h00000000},
            {SQ_POSTDET, 3'd1}: {OP_W, 24'h8082d8, 32'h00000000},
            {SQ_POSTDET, 3'd2}: {OP_W, 24'h8082d8, 32'h00000110},
            {SQ_P0, 3'd0}     : {OP_W, 24'h808238, 32'h00000805},
            {SQ_P0, 3'd1}     : {OP_W, 24'h8082d8, 32'h00000000},
            {SQ_P0, 3'd2}     : {OP_W, 24'h8082d8, 32'h00000110},
            default           : {OP_END, 24'h0, 32'h0},
        };
    }

    var drv_s  : logic<2>;
    var pd_s1  : logic<2>;
    var pd_s2  : logic<2>;
    var req_s  : logic<3>;
    var det_s  : logic<3>;
    var drv_cur: logic   ;
    var pd_cfg : logic<2>;
    var req_ack: logic   ; // last request toggle served
    var busy   : logic   ;
    var acc    : logic   ; // an access is on the bus
    var sq     : logic<3>;
    var st     : logic<3>;
    var wcnt   : logic<10>;
    var det    : logic   ;
    var done   : logic   ;
    var res    : logic   ;
    var rd_last: logic<32>;
    var wren   : logic   ;
    var rden   : logic   ;
    var addr   : logic<24>;
    var wrdata : logic<32>;

    assign o_det_done = done;
    assign o_det_res  = res;
    assign o_rd_last  = rd_last;
    assign o_wren     = wren;
    assign o_rden     = rden;
    assign o_addr     = addr;
    assign o_wrdata   = wrdata;
    assign o_strb     = 8'hFF;

    let cur    : logic<58> = rom(sq, st);
    let cur_op : logic<2>  = cur[57:56];
    let det_pnd: logic     = req_s[2] != req_ack;

    always_ff {
        if_reset {
            drv_s   = 0;
            pd_s1   = 2'd2;
            pd_s2   = 2'd2;
            req_s   = 0;
            det_s   = 0;
            drv_cur = 0;
            pd_cfg  = 2'd2;
            req_ack = 0;
            busy    = 0;
            acc     = 0;
            sq      = 0;
            st      = 0;
            wcnt    = 0;
            det     = 0;
            done    = 0;
            res     = 0;
            rd_last = 0;
            wren    = 0;
            rden    = 0;
            addr    = 0;
            wrdata  = 0;
        } else {
            drv_s = {drv_s[0], i_drive};
            pd_s1 = i_power_down;
            pd_s2 = pd_s1;
            req_s = {req_s[1:0], i_det_req};
            det_s = {det_s[1:0], i_rxdet};
            if busy && sq == SQ_DET && det_s[1] && !det_s[2] {
                det = 1;
            }
            if !busy {
                st = 0;
                if det_pnd {
                    busy    = 1;
                    sq      = SQ_DET;
                    det     = 0;
                    req_ack = req_s[2];
                } else if pd_s2 == 2'd0 && pd_cfg != 2'd0 {
                    busy   = 1;
                    sq     = SQ_P0;
                    pd_cfg = 2'd0;
                } else if pd_s2 != pd_cfg && pd_s2 == pd_s1 {
                    pd_cfg = pd_s2;
                } else if drv_s[1] != drv_cur {
                    busy    = 1;
                    sq      = if drv_s[1] ? SQ_DRV_ON : SQ_DRV_OFF;
                    drv_cur = drv_s[1];
                }
            } else if acc {
                // wait for the access to complete, then drop the request
                if wren && i_ready {
                    wren = 0;
                    acc  = 0;
                    st   += 1;
                } else if rden && i_rdvld {
                    rden    = 0;
                    acc     = 0;
                    rd_last = i_rddata;
                    st      += 1;
                }
            } else {
                case cur_op {
                    OP_W: {
                        wren   = 1;
                        acc    = 1;
                        addr   = cur[55:32];
                        wrdata = cur[31:0];
                    }
                    OP_R: {
                        rden = 1;
                        acc  = 1;
                        addr = cur[55:32];
                    }
                    OP_WAIT: {
                        if wcnt == WAIT_CLKS {
                            wcnt = 0;
                            st   += 1;
                        } else {
                            wcnt += 1;
                        }
                    }
                    default: {
                        // end of the sequence
                        if sq == SQ_DET && det {
                            sq = SQ_POSTDET;
                            st = 0;
                        } else {
                            busy = 0;
                            if sq == SQ_DET || sq == SQ_POSTDET {
                                res  = sq == SQ_POSTDET;
                                done = !done;
                            }
                        }
                    }
                }
            }
        }
    }
}
