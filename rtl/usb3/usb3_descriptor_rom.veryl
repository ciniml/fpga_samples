/**
 * @file usb3_descriptor_rom.veryl
 * @brief Word-wide descriptor ROM for the SuperSpeed sample device
 *        (generated by gen_descriptor_rom.py, do not edit by hand).
 *
 * Word address (relative to ROM_BASE) and byte length of each descriptor:
 *   DEV   @w  0 len 18
 *   CFG   @w  5 len 44
 *   STR0  @w 16 len 4
 *   STR1  @w 17 len 26
 *   STR2  @w 24 len 28
 *   STR3  @w 31 len 14
 *   BOS   @w 35 len 50
 *   MSOS  @w 48 len 30
 *
 * bcdUSB 3.10, vendor-specific class, bMaxPacketSize0 = 9 (512 bytes), one
 * configuration with EP1 OUT / EP1 IN bulk (1024 bytes, bMaxBurst 0). The
 * BOS carries the USB 2.0 Extension (LPM), the SuperSpeed USB Device
 * Capability and the Microsoft OS 2.0 platform capability (vendor code
 * 0x20, descriptor set with Compatible ID WINUSB served at wIndex 7).
 */
pub package usb3_desc_pkg {
    const ROM_BASE      : logic<13> = 13'h1000; // framer read address of ROM word 0
    const DEV_ADDR      : logic<13> = 13'h1000;
    const DEV_LEN       : logic<11> = 11'd18;
    const CFG_ADDR      : logic<13> = 13'h1005;
    const CFG_LEN       : logic<11> = 11'd44;
    const STR0_ADDR     : logic<13> = 13'h1010;
    const STR0_LEN      : logic<11> = 11'd4;
    const STR1_ADDR     : logic<13> = 13'h1011;
    const STR1_LEN      : logic<11> = 11'd26;
    const STR2_ADDR     : logic<13> = 13'h1018;
    const STR2_LEN      : logic<11> = 11'd28;
    const STR3_ADDR     : logic<13> = 13'h101F;
    const STR3_LEN      : logic<11> = 11'd14;
    const BOS_ADDR      : logic<13> = 13'h1023;
    const BOS_LEN       : logic<11> = 11'd50;
    const MSOS_ADDR     : logic<13> = 13'h1030;
    const MSOS_LEN      : logic<11> = 11'd30;
    const MS_VENDOR_CODE: logic<8>  = 8'h20;
}

pub module Usb3DescriptorRom #(
    param VENDOR_ID : logic<16> = 16'h1209,
    param PRODUCT_ID: logic<16> = 16'h0001,
) (
    i_addr: input  logic<8> , // word address relative to ROM_BASE
    o_data: output logic<32>, // byte 0 of the word in [7:0]
) {
    always_comb {
        case i_addr {
            8'd0   : o_data = {8'h03, 8'h10, 8'h01, 8'h12};
            8'd1   : o_data = {8'h09, 8'h00, 8'h00, 8'hFF};
            8'd2   : o_data = {PRODUCT_ID[15:8], PRODUCT_ID[7:0], VENDOR_ID[15:8], VENDOR_ID[7:0]};
            8'd3   : o_data = {8'h02, 8'h01, 8'h01, 8'h00};
            8'd4   : o_data = {8'h00, 8'h00, 8'h01, 8'h03};
            8'd5   : o_data = {8'h00, 8'h2C, 8'h02, 8'h09};
            8'd6   : o_data = {8'h80, 8'h00, 8'h01, 8'h01};
            8'd7   : o_data = {8'h00, 8'h04, 8'h09, 8'h0D};
            8'd8   : o_data = {8'h00, 8'hFF, 8'h02, 8'h00};
            8'd9   : o_data = {8'h05, 8'h07, 8'h00, 8'h00};
            8'd10  : o_data = {8'h04, 8'h00, 8'h02, 8'h01};
            8'd11  : o_data = {8'h00, 8'h30, 8'h06, 8'h00};
            8'd12  : o_data = {8'h07, 8'h00, 8'h00, 8'h00};
            8'd13  : o_data = {8'h00, 8'h02, 8'h81, 8'h05};
            8'd14  : o_data = {8'h30, 8'h06, 8'h00, 8'h04};
            8'd15  : o_data = {8'h00, 8'h00, 8'h00, 8'h0F};
            8'd16  : o_data = {8'h04, 8'h09, 8'h03, 8'h04};
            8'd17  : o_data = {8'h00, 8'h66, 8'h03, 8'h1A};
            8'd18  : o_data = {8'h00, 8'h67, 8'h00, 8'h70};
            8'd19  : o_data = {8'h00, 8'h5F, 8'h00, 8'h61};
            8'd20  : o_data = {8'h00, 8'h61, 8'h00, 8'h73};
            8'd21  : o_data = {8'h00, 8'h70, 8'h00, 8'h6D};
            8'd22  : o_data = {8'h00, 8'h65, 8'h00, 8'h6C};
            8'd23  : o_data = {8'h00, 8'h00, 8'h00, 8'h73};
            8'd24  : o_data = {8'h00, 8'h55, 8'h03, 8'h1C};
            8'd25  : o_data = {8'h00, 8'h42, 8'h00, 8'h53};
            8'd26  : o_data = {8'h00, 8'h53, 8'h00, 8'h20};
            8'd27  : o_data = {8'h00, 8'h20, 8'h00, 8'h53};
            8'd28  : o_data = {8'h00, 8'h61, 8'h00, 8'h53};
            8'd29  : o_data = {8'h00, 8'h70, 8'h00, 8'h6D};
            8'd30  : o_data = {8'h00, 8'h65, 8'h00, 8'h6C};
            8'd31  : o_data = {8'h00, 8'h30, 8'h03, 8'h0E};
            8'd32  : o_data = {8'h00, 8'h30, 8'h00, 8'h30};
            8'd33  : o_data = {8'h00, 8'h30, 8'h00, 8'h30};
            8'd34  : o_data = {8'h00, 8'h00, 8'h00, 8'h31};
            8'd35  : o_data = {8'h00, 8'h32, 8'h0F, 8'h05};
            8'd36  : o_data = {8'h02, 8'h10, 8'h07, 8'h03};
            8'd37  : o_data = {8'h00, 8'h00, 8'h00, 8'h02};
            8'd38  : o_data = {8'h00, 8'h03, 8'h10, 8'h0A};
            8'd39  : o_data = {8'h0A, 8'h03, 8'h00, 8'h0E};
            8'd40  : o_data = {8'h10, 8'h1C, 8'h07, 8'hFF};
            8'd41  : o_data = {8'h60, 8'hDF, 8'h00, 8'h05};
            8'd42  : o_data = {8'h45, 8'h89, 8'hD8, 8'hDD};
            8'd43  : o_data = {8'hD2, 8'h9C, 8'h4C, 8'hC7};
            8'd44  : o_data = {8'h64, 8'h9E, 8'h9D, 8'h65};
            8'd45  : o_data = {8'h00, 8'h00, 8'h9F, 8'h8A};
            8'd46  : o_data = {8'h00, 8'h1E, 8'h06, 8'h03};
            8'd47  : o_data = {8'h00, 8'h00, 8'h00, 8'h20};
            8'd48  : o_data = {8'h00, 8'h00, 8'h00, 8'h0A};
            8'd49  : o_data = {8'h06, 8'h03, 8'h00, 8'h00};
            8'd50  : o_data = {8'h00, 8'h14, 8'h00, 8'h1E};
            8'd51  : o_data = {8'h49, 8'h57, 8'h00, 8'h03};
            8'd52  : o_data = {8'h42, 8'h53, 8'h55, 8'h4E};
            8'd53  : o_data = {8'h00, 8'h00, 8'h00, 8'h00};
            8'd54  : o_data = {8'h00, 8'h00, 8'h00, 8'h00};
            8'd55  : o_data = {8'h00, 8'h00, 8'h00, 8'h00};
            default: o_data = 32'h0;
        }
    }
}
