/**
 * @file usb3_rx_parser.veryl
 * @brief Receive-side framing parser for USB 3.2 Gen1 (7.2, 6.4).
 *
 * Works on the 8-symbol window of Usb3RxFifo (SKP already removed) and
 * consumes 4..7 symbols per clock so that packet bodies are always
 * word-aligned internally, whatever their alignment on the wire:
 *   - SEARCH: looks for HPSTART / LCSTART / COM COM COM COM at symbol
 *     offsets 0..3 (3-of-4 rule for framing sets, Table 7-9/7-10), counts
 *     Logical Idle symbols, and gives polarity hints (D21.5 runs)
 *   - header packet: 16 symbols -> o_hp_* with CRC-16 / CRC-5 result
 *   - link command: 4 symbols -> o_lc_* (both copies equal and CRC-5 OK)
 *   - DPP: DPPSTART must immediately follow a DP header; data is streamed
 *     as words with byte enables, then CRC-32 and DPPEND/DPPABORT are
 *     checked (7.2.4.1.9)
 *   - TS1/TS2 (16 symbols, raw) -> o_ts_* for the LTSSM
 * Outputs are registered (one clock after the symbols were consumed).
 * Clocks without a PHY word (RxValid 0, which the PHY may insert anywhere,
 * also inside a packet) are skipped: the window holds and the parser stalls
 * (i_adv = 0); only a long gap advances the window with empty words.
 */
module Usb3RxParser (
    i_clk   : input clock,
    i_rst   : input reset,
    i_enable: input logic, // 0: drain the window and stay idle
    i_adv   : input logic, // the window shifts by 4 at the end of this clock (Usb3RxFifo o_adv); 0: hold everything

    i_raw : input logic<192>, // 24-symbol window from Usb3RxFifo (j = 0 oldest)
    i_desc: input logic<192>,
    i_k   : input logic<24> ,
    i_cls : input logic<192>,
    i_fill: input logic<5>  ,

    o_ts_valid    : output logic   , // a complete TS1/TS2 was received
    o_ts_type     : output logic<2>, // 1 = TS1, 2 = TS2
    o_ts_cfg      : output logic<8>, // link configuration byte (symbol 5)
    o_ts_inv      : output logic   , // TS1 whose fillers were D21.5 (polarity inverted)
    o_pol_inv_hint: output logic   , // 4 consecutive D21.5 seen while searching
    o_idle8       : output logic   , // >= 8 consecutive Logical Idle symbols received

    o_lc_valid: output logic    ,
    o_lc_word : output logic<11>,

    o_hp_valid : output logic    ,
    o_hp_hdr   : output logic<96>, // header bytes 0..11, byte 0 = [7:0]
    o_hp_lcw   : output logic<16>,
    o_hp_crc_ok: output logic    , // CRC-16 and CRC-5 good, no K-code inside

    o_dpp_start: output logic    ,
    o_dpp_valid: output logic    ,
    o_dpp_data : output logic<32>,
    o_dpp_be   : output logic<4> ,
    o_dpp_end  : output logic    , // DPPEND seen and CRC-32 good
    o_dpp_err  : output logic    , // missing / aborted / corrupt DPP
) {
    import usb3_pkg::*;
    import usb3_crc_pkg::*;

    enum State: logic<3> {
        Search,
        HpBody,
        LcBody,
        DppStart,
        DppData,
        DppTail1,
        DppTail2,
        TsBody,
    }

    var state: State;

    // ---------------------------------------------------------------- read position
    // The next 8 symbols are selected from the window by the registered
    // position; the parser consumes pop symbols per clock and the window
    // shifts by 4 every clock. pos stays within 0..POS_MAX: the states that
    // may consume more than 4 symbols only run while pos <= 4 (otherwise
    // they stall for a clock, which moves pos down by 4).
    //
    // Ordered-set detection is precomputed for every window position and
    // registered (hit_r): position p of the current window was position
    // p + 4 one clock ago, so hit_r[p] is derived from last clock's window.
    // The decision loop is then: pos -> small flag mux -> priority -> pop.
    const N      : u32                = 24;
    const POS_MAX: u32                = 7;
    const H_SHP  : u32                = 0;
    const H_SLC  : u32                = 1;
    const H_COM  : u32                = 2;
    const H_SDP  : u32                = 3;
    const H_END  : u32                = 4;
    var   pos    : logic<3>          ;
    var   v_raw  : logic<64>         ;
    var   v_desc : logic<64>         ;
    var   v_k    : logic<8>          ;
    var   v_cls  : logic<64>         ;
    var   i_avail: logic<5>          ; // 11 when the 8 symbols at pos are valid and progress is allowed, else 0
    var   hit_c  : logic<5>      [21]; // {END, SDP, COM4, SLC, SHP} ordered set starting at window position p
    var   hit_r  : logic<8 * 17>     ; // flat, 8 bits per position (an array maps to LUT RAM; a stride of 5 made a multiplier)

    function cls_at (
        p: input u32,
        b: input u32,
    ) -> logic {
        return i_cls[p * 8 + b];
    }
    // framing ordered set (v v v EPF) at absolute position p, one symbol may be wrong
    function fos_at (
        p: input u32,
        b: input u32,
    ) -> logic {
        var m0: logic;
        var m1: logic;
        var m2: logic;
        var m3: logic;
        m0 = cls_at(p, b);
        m1 = cls_at(p + 1, b);
        m2 = cls_at(p + 2, b);
        m3 = cls_at(p + 3, CLS_EPF);
        return (m0 && m1 && m2) || (m0 && m1 && m3) || (m0 && m2 && m3) || (m1 && m2 && m3);
    }
    always_comb {
        for p in 0..21 {
            hit_c[p][H_SHP] = fos_at(p, CLS_SHP);
            hit_c[p][H_SLC] = fos_at(p, CLS_SLC);
            hit_c[p][H_COM] = cls_at(p, CLS_COM) && cls_at(p + 1, CLS_COM) && cls_at(p + 2, CLS_COM)
                && cls_at(p + 3, CLS_COM);
            hit_c[p][H_SDP] = fos_at(p, CLS_SDP);
            hit_c[p][H_END] = fos_at(p, CLS_END);
        }
    }
    always_ff {
        if_reset {
            hit_r = 0;
        } else {
            if i_adv {
                for p in 0..17 {
                    hit_r[p * 8+:8] = {3'b0, hit_c[p + 4]};
                }
            }
        }
    }
    always_comb {
        var enough: logic;
        for j in 0..8 {
            var p               : logic<5>;
            p                = pos + j;
            v_raw[j * 8+:8]  = i_raw[p * 8+:8];
            v_desc[j * 8+:8] = i_desc[p * 8+:8];
            v_k[j]           = i_k[p];
            v_cls[j * 8+:8]  = i_cls[p * 8+:8];
        }
        // the states that consume exactly 4 symbols keep pos; Search and the
        // DPP end may consume up to 7 and are only allowed while pos <= 4
        enough  = ({2'b0, pos} + i_fill >= N as 5)
            && (pos <= 4 || !(state == State::Search || state == State::DppTail2));
        i_avail = if enough ? 11 : 0;
    }

    var widx    : logic<2>     ; // word index inside a body
    var hdr     : logic<96>    ;
    var crc16   : logic<16>    ;
    var kbad    : logic        ;
    var remain  : logic<11>    ; // DPP data bytes still to come
    var crc32   : logic<32>    ;
    var crc_rx  : logic<32>    ;
    var ts_cnt  : logic<2>  [3]; // filler votes: [0] D10.2, [1] D5.2, [2] D21.5 (per word, 0..4 -> saturate)
    var ts_ok   : logic<3>     ; // all fillers so far matched: {D21.5, D5.2, D10.2}
    var idle_cnt: logic<4>     ;

    function sym (
        w: input logic<64>,
        j: input logic<3> ,
    ) -> logic<8> {
        return w[j * 8+:8];
    }

    // K-code at window offset j equal to v
    // class bit b of the symbol at window offset j
    function isc (
        j: input logic<3>,
        b: input u32     ,
    ) -> logic {
        return v_cls[j * 8 + b];
    }

    // ordered set of kind h at window offset s (from the registered flags)
    function hit_at (
        s2: input logic<2>,
        h : input u32     ,
    ) -> logic {
        var p: logic<4>;
        p = {1'b0, pos} + {2'b0, s2};
        return hit_r[p * 8 + h];
    }

    // ---------------------------------------------------------------- comb
    var pop     : logic<4> ;
    var nstate  : State    ;
    var found   : logic    ;
    var found_s : logic<2> ;
    var found_hp: logic    ;
    var found_lc: logic    ;
    var found_ts: logic    ;
    var w_k     : logic<4> ; // K flags of window symbols 0..3
    var w_desc  : logic<32>; // descrambled symbols 0..3
    var w_raw   : logic<32>;

    assign w_k    = v_k[3:0];
    assign w_desc = v_desc[31:0];
    assign w_raw  = v_raw[31:0];

    always_comb {
        var s       : logic<2>;
        found    = 0;
        found_s  = 0;
        found_hp = 0;
        found_lc = 0;
        found_ts = 0;
        for i in 0..4 {
            s = i as 2;
            if !found {
                if hit_at(s, H_SHP) {
                    found    = 1;
                    found_s  = s;
                    found_hp = 1;
                } else if hit_at(s, H_SLC) {
                    found    = 1;
                    found_s  = s;
                    found_lc = 1;
                } else if hit_at(s, H_COM) {
                    found    = 1;
                    found_s  = s;
                    found_ts = 1;
                }
            }
        }
    }

    var crc16_w: logic<16>;
    var crc32_w: logic<32>;
    assign crc16_w = crc16_w4(crc16, w_desc);
    always_comb {
        if remain >= 4 {
            crc32_w = crc32_w4(crc32, w_desc);
        } else {
            crc32_w = case remain[1:0] {
                1      : crc32_w1(crc32, w_desc[7:0]),
                2      : crc32_w2(crc32, w_desc[15:0]),
                3      : crc32_w3(crc32, w_desc[23:0]),
                default: crc32,
            };
        }
    }

    always_comb {
        pop    = 0;
        nstate = state;
        if !i_enable {
            pop    = 0;
            nstate = State::Search;
        } else {
            case state {
                State::Search: {
                    if i_avail >= 7 {
                        if found {
                            pop    = found_s + 4;
                            nstate = if found_hp ? State::HpBody : if found_lc ? State::LcBody : State::TsBody;
                        } else {
                            pop = 4;
                        }
                    }
                }
                State::HpBody: {
                    if i_avail >= 4 {
                        pop = 4;
                        if widx == 3 {
                            // DP header with good CRC: the DPP must follow immediately
                            if hdr[4:0] == PKT_DP && !kbad && w_k == 0 && ~crc16 == {w_desc[15:8], w_desc[7:0]}
                                && lcw_ok(w_desc[31:16]) {
                                nstate = State::DppStart;
                            } else {
                                nstate = State::Search;
                            }
                        }
                    }
                }
                State::LcBody: {
                    if i_avail >= 4 {
                        pop    = 4;
                        nstate = State::Search;
                    }
                }
                State::DppStart: {
                    if i_avail >= 4 {
                        if hit_at(0, H_SDP) {
                            pop    = 4;
                            nstate = if remain >= 4 ? State::DppData : State::DppTail1;
                        } else {
                            nstate = State::Search;
                        }
                    }
                }
                State::DppData: {
                    // remain >= 4 here: one full data word
                    if i_avail >= 4 {
                        pop = 4;
                        if w_k != 0 {
                            nstate = State::Search;
                        } else if remain >= 8 {
                            nstate = State::DppData;
                        } else {
                            nstate = State::DppTail1;
                        }
                    }
                }
                State::DppTail1: {
                    // remain (0..3) data bytes + (4 - remain) CRC bytes
                    if i_avail >= 4 {
                        pop    = 4;
                        nstate = State::DppTail2;
                    }
                }
                State::DppTail2: {
                    // remain CRC bytes then DPPEND / DPPABORT
                    if i_avail >= remain[2:0] + 4 {
                        pop    = remain[2:0] + 4;
                        nstate = State::Search;
                    }
                }
                State::TsBody: {
                    if i_avail >= 4 {
                        pop = 4;
                        if widx == 2 {
                            nstate = State::Search;
                        }
                    }
                }
            }
        }
    }

    // ---------------------------------------------------------------- seq
    always_ff {
        if_reset {
            state          = State::Search;
            pos            = 0;
            widx           = 0;
            hdr            = 0;
            crc16          = 0;
            kbad           = 0;
            remain         = 0;
            crc32          = 0;
            crc_rx         = 0;
            ts_ok          = 0;
            idle_cnt       = 0;
            o_ts_valid     = 0;
            o_ts_type      = 0;
            o_ts_cfg       = 0;
            o_ts_inv       = 0;
            o_pol_inv_hint = 0;
            o_idle8        = 0;
            o_lc_valid     = 0;
            o_lc_word      = 0;
            o_hp_valid     = 0;
            o_hp_hdr       = 0;
            o_hp_lcw       = 0;
            o_hp_crc_ok    = 0;
            o_dpp_start    = 0;
            o_dpp_valid    = 0;
            o_dpp_data     = 0;
            o_dpp_be       = 0;
            o_dpp_end      = 0;
            o_dpp_err      = 0;
        } else {
            o_ts_valid     = 0;
            o_pol_inv_hint = 0;
            o_lc_valid     = 0;
            o_hp_valid     = 0;
            o_dpp_start    = 0;
            o_dpp_valid    = 0;
            o_dpp_end      = 0;
            o_dpp_err      = 0;
            // a clock without a PHY word (RxValid 0) does not exist for the parser: the window
            // holds (Usb3RxFifo), so nothing is consumed and no state moves; only the pulses drop
            if i_adv {
                state = nstate;
                // window advanced by 4: the read position moves down unless it is
                // already at the bottom (window not yet full, nothing consumed)
                if pop == 0 && pos <: 4 {
                    pos = 0;
                } else {
                    pos = pos + pop - 4;
                }

                if !i_enable {
                    pos      = 0;
                    widx     = 0;
                    idle_cnt = 0;
                    o_idle8  = 0;
                } else {
                    case state {
                        State::Search: {
                            if i_avail >= 7 {
                                if found {
                                    widx     = 0;
                                    kbad     = 0;
                                    crc16    = 16'hFFFF;
                                    ts_ok    = 3'b111;
                                    idle_cnt = 0;
                                    o_idle8  = 0;
                                } else {
                                    // idle counting / polarity hints over the 4 consumed symbols
                                    var c: logic<4>;
                                    c = idle_cnt;
                                    for i in 0..4 {
                                        if v_cls[i * 8 + CLS_IDLE] {
                                            if c != 15 {
                                                c = c + 1;
                                            }
                                        } else if !v_cls[i * 8 + CLS_SKP] {
                                            c = 0; // SKP ordered sets do not break the idle run (6.4.3.1)
                                        }
                                    }
                                    idle_cnt = c;
                                    o_idle8  = c >= 8;
                                    if w_k == 0 && w_raw == {D21_5, D21_5, D21_5, D21_5} {
                                        o_pol_inv_hint = 1;
                                    }
                                }
                            }
                        }
                        State::HpBody: {
                            if i_avail >= 4 {
                                widx = widx + 1;
                                if w_k != 0 {
                                    kbad = 1;
                                }
                                if widx != 3 {
                                    hdr[widx * 32+:32] = w_desc;
                                    crc16              = crc16_w;
                                } else {
                                    o_hp_valid  = 1;
                                    o_hp_hdr    = hdr;
                                    o_hp_lcw    = w_desc[31:16];
                                    o_hp_crc_ok = !kbad && w_k == 0 && ~crc16 == {w_desc[15:8], w_desc[7:0]}
                                        && lcw_ok(w_desc[31:16]);
                                    remain      = hdr[58:48]; // Data Length (DW1[31:16]), max 1024
                                    if hdr[63:59] != 0 {
                                        remain = 11'h7FF; // > 1024: treat as babble, DPP will fail
                                    }
                                    crc32 = 32'hFFFFFFFF;
                                }
                            }
                        }
                        State::LcBody: {
                            if i_avail >= 4 {
                                o_lc_valid = w_k == 0 && w_desc[15:0] == w_desc[31:16] && lcw_ok(w_desc[15:0]);
                                o_lc_word  = w_desc[10:0];
                            }
                        }
                        State::DppStart: {
                            if i_avail >= 4 {
                                if hit_at(0, H_SDP) {
                                    o_dpp_start = 1;
                                } else {
                                    o_dpp_err = 1;
                                }
                            }
                        }
                        State::DppData: {
                            if i_avail >= 4 {
                                if w_k != 0 {
                                    o_dpp_err = 1;
                                } else {
                                    o_dpp_valid = 1;
                                    o_dpp_data  = w_desc;
                                    o_dpp_be    = 4'b1111;
                                    crc32       = crc32_w;
                                    remain      = remain - 4;
                                }
                            }
                        }
                        State::DppTail1: {
                            if i_avail >= 4 {
                                if w_k != 0 {
                                    o_dpp_err = 1;
                                }
                                o_dpp_valid = remain != 0;
                                o_dpp_data  = w_desc;
                                o_dpp_be    = case remain[1:0] {
                                    0      : 4'b0000,
                                    1      : 4'b0001,
                                    2      : 4'b0011,
                                    default: 4'b0111,
                                };
                                crc32 = crc32_w;
                                case remain[1:0] {
                                    0      : crc_rx[31:0] = w_desc;
                                    1      : crc_rx[23:0] = w_desc[31:8];
                                    2      : crc_rx[15:0] = w_desc[31:16];
                                    default: crc_rx[7:0]  = w_desc[31:24];
                                }
                            }
                        }
                        State::DppTail2: {
                            if i_avail >= remain[2:0] + 4 {
                                var crc_full: logic<32>;
                                var kk      : logic    ;
                                var r       : logic<2> ;
                                r        = remain[1:0];
                                crc_full = crc_rx;
                                kk       = 0;
                                case r {
                                    0: {}
                                    1: {
                                        crc_full[31:24] = sym(v_desc, 0);
                                        kk              = v_k[0];
                                    }
                                    2: {
                                        crc_full[31:16] = v_desc[15:0];
                                        kk              = v_k[0] | v_k[1];
                                    }
                                    default: {
                                        crc_full[31:8] = v_desc[23:0];
                                        kk             = v_k[0] | v_k[1] | v_k[2];
                                    }
                                }
                                if !kk && hit_at(r, H_END) && crc_full == ~crc32 {
                                    o_dpp_end = 1;
                                } else {
                                    o_dpp_err = 1;
                                }
                            }
                        }
                        State::TsBody: {
                            if i_avail >= 4 {
                                var ok  : logic<3>;
                                widx = widx + 1;
                                ok   = ts_ok;
                                if widx == 0 {
                                    o_ts_cfg = w_raw[15:8];
                                    for i in 2..4 {
                                        if w_k[i] || w_raw[i * 8+:8] != D10_2 {
                                            ok[0] = 0;
                                        }
                                        if w_k[i] || w_raw[i * 8+:8] != D5_2 {
                                            ok[1] = 0;
                                        }
                                        if w_k[i] || w_raw[i * 8+:8] != D21_5 {
                                            ok[2] = 0;
                                        }
                                    }
                                } else {
                                    for i in 0..4 {
                                        if w_k[i] || w_raw[i * 8+:8] != D10_2 {
                                            ok[0] = 0;
                                        }
                                        if w_k[i] || w_raw[i * 8+:8] != D5_2 {
                                            ok[1] = 0;
                                        }
                                        if w_k[i] || w_raw[i * 8+:8] != D21_5 {
                                            ok[2] = 0;
                                        }
                                    }
                                }
                                ts_ok = ok;
                                if widx == 2 {
                                    o_ts_valid = ok != 0;
                                    o_ts_type  = if ok[1] ? 2 : 1;
                                    o_ts_inv   = ok[2];
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
