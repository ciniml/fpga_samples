/**
 * @file usb3_rx_parser.veryl
 * @brief Receive-side framing parser for USB 3.2 Gen1 (7.2, 6.4).
 *
 * Works on the 8-symbol window of Usb3RxFifo (SKP already removed) and
 * consumes 4..7 symbols per clock so that packet bodies are always
 * word-aligned internally, whatever their alignment on the wire:
 *   - SEARCH: looks for HPSTART / LCSTART / COM COM COM COM at symbol
 *     offsets 0..3 (3-of-4 rule for framing sets, Table 7-9/7-10), counts
 *     Logical Idle symbols, and gives polarity hints (D21.5 runs)
 *   - header packet: 16 symbols -> o_hp_* with CRC-16 / CRC-5 result
 *   - link command: 4 symbols -> o_lc_* (both copies equal and CRC-5 OK)
 *   - DPP: DPPSTART must immediately follow a DP header; data is streamed
 *     as words with byte enables, then CRC-32 and DPPEND/DPPABORT are
 *     checked (7.2.4.1.9)
 *   - TS1/TS2 (16 symbols, raw) -> o_ts_* for the LTSSM
 * Outputs are registered (one clock after the symbols were consumed).
 */
module Usb3RxParser (
    i_clk   : input clock,
    i_rst   : input reset,
    i_enable: input logic, // 0: drain the window and stay idle

    i_raw  : input  logic<64>,
    i_desc : input  logic<64>,
    i_k    : input  logic<8> ,
    i_avail: input  logic<5> ,
    o_pop  : output logic<4> ,

    o_ts_valid    : output logic   , // a complete TS1/TS2 was received
    o_ts_type     : output logic<2>, // 1 = TS1, 2 = TS2
    o_ts_cfg      : output logic<8>, // link configuration byte (symbol 5)
    o_ts_inv      : output logic   , // TS1 whose fillers were D21.5 (polarity inverted)
    o_pol_inv_hint: output logic   , // 4 consecutive D21.5 seen while searching
    o_idle8       : output logic   , // >= 8 consecutive Logical Idle symbols received

    o_lc_valid: output logic    ,
    o_lc_word : output logic<11>,

    o_hp_valid : output logic    ,
    o_hp_hdr   : output logic<96>, // header bytes 0..11, byte 0 = [7:0]
    o_hp_lcw   : output logic<16>,
    o_hp_crc_ok: output logic    , // CRC-16 and CRC-5 good, no K-code inside

    o_dpp_start: output logic    ,
    o_dpp_valid: output logic    ,
    o_dpp_data : output logic<32>,
    o_dpp_be   : output logic<4> ,
    o_dpp_end  : output logic    , // DPPEND seen and CRC-32 good
    o_dpp_err  : output logic    , // missing / aborted / corrupt DPP
) {
    import usb3_pkg::*;

    enum State: logic<3> {
        Search,
        HpBody,
        LcBody,
        DppStart,
        DppData,
        DppTail1,
        DppTail2,
        TsBody,
    }

    var state   : State        ;
    var widx    : logic<2>     ; // word index inside a body
    var hdr     : logic<96>    ;
    var crc16   : logic<16>    ;
    var kbad    : logic        ;
    var remain  : logic<11>    ; // DPP data bytes still to come
    var crc32   : logic<32>    ;
    var crc_rx  : logic<32>    ;
    var ts_cnt  : logic<2>  [3]; // filler votes: [0] D10.2, [1] D5.2, [2] D21.5 (per word, 0..4 -> saturate)
    var ts_ok   : logic<3>     ; // all fillers so far matched: {D21.5, D5.2, D10.2}
    var idle_cnt: logic<4>     ;

    function sym (
        w: input logic<64>,
        j: input logic<3> ,
    ) -> logic<8> {
        return w[j * 8+:8];
    }

    // K-code at window offset j equal to v
    function isk (
        j: input logic<3>,
        v: input logic<8>,
    ) -> logic {
        return i_k[j] && i_raw[j * 8+:8] == v;
    }

    // Framing ordered set (v v v EPF) at offset s with at most one bad symbol
    // (7.3.4.1). Offsets are widened to 3 bits before adding.
    function os_at (
        s2: input logic<2>,
        v : input logic<8>,
    ) -> logic {
        var n: logic<3>;
        var s: logic<3>;
        s = {1'b0, s2};
        n = 0;
        if isk(s, v) {
            n = n + 1;
        }
        if isk(s + 1, v) {
            n = n + 1;
        }
        if isk(s + 2, v) {
            n = n + 1;
        }
        if isk(s + 3, K_EPF) {
            n = n + 1;
        }
        return n >= 3;
    }

    // Four COMs at offset s. Exact: with one symbol of tolerance a run of
    // identical symbols would also match one position early.
    function com4_at (
        s2: input logic<2>,
    ) -> logic {
        var s: logic<3>;
        s = {1'b0, s2};
        return isk(s, K_COM) && isk(s + 1, K_COM) && isk(s + 2, K_COM) && isk(s + 3, K_COM);
    }

    // ---------------------------------------------------------------- comb
    var pop     : logic<4> ;
    var nstate  : State    ;
    var found   : logic    ;
    var found_s : logic<2> ;
    var found_hp: logic    ;
    var found_lc: logic    ;
    var found_ts: logic    ;
    var w_k     : logic<4> ; // K flags of window symbols 0..3
    var w_desc  : logic<32>; // descrambled symbols 0..3
    var w_raw   : logic<32>;

    assign w_k    = i_k[3:0];
    assign w_desc = i_desc[31:0];
    assign w_raw  = i_raw[31:0];
    assign o_pop  = pop;

    always_comb {
        var s       : logic<2>;
        found    = 0;
        found_s  = 0;
        found_hp = 0;
        found_lc = 0;
        found_ts = 0;
        for i in 0..4 {
            s = i as 2;
            if !found {
                if os_at(s, K_SHP) {
                    found    = 1;
                    found_s  = s;
                    found_hp = 1;
                } else if os_at(s, K_SLC) {
                    found    = 1;
                    found_s  = s;
                    found_lc = 1;
                } else if com4_at(s) {
                    found    = 1;
                    found_s  = s;
                    found_ts = 1;
                }
            }
        }
    }

    var crc16_w: logic<16>;
    var crc32_w: logic<32>;
    always_comb {
        var c: logic<16>;
        var d: logic<32>;
        var m: logic<2> ;
        c = crc16;
        for i in 0..4 {
            c = crc16_byte(c, w_desc[i * 8+:8]);
        }
        crc16_w = c;
        d       = crc32;
        if remain >= 4 {
            m = 3;
        } else {
            m = remain[1:0];
        }
        for i in 0..4 {
            if (remain >= 4) || ((i as 11) <: remain) {
                d = crc32_byte(d, w_desc[i * 8+:8]);
            }
        }
        crc32_w = d;
    }

    always_comb {
        pop    = 0;
        nstate = state;
        if !i_enable {
            pop    = if i_avail >= 8 ? 8 : i_avail[3:0];
            nstate = State::Search;
        } else {
            case state {
                State::Search: {
                    if i_avail >= 7 {
                        if found {
                            pop    = found_s + 4;
                            nstate = if found_hp ? State::HpBody : if found_lc ? State::LcBody : State::TsBody;
                        } else {
                            pop = 4;
                        }
                    }
                }
                State::HpBody: {
                    if i_avail >= 4 {
                        pop = 4;
                        if widx == 3 {
                            // DP header with good CRC: the DPP must follow immediately
                            if hdr[4:0] == PKT_DP && !kbad && w_k == 0 && ~crc16 == {w_desc[15:8], w_desc[7:0]}
                                && lcw_ok(w_desc[31:16]) {
                                nstate = State::DppStart;
                            } else {
                                nstate = State::Search;
                            }
                        }
                    }
                }
                State::LcBody: {
                    if i_avail >= 4 {
                        pop    = 4;
                        nstate = State::Search;
                    }
                }
                State::DppStart: {
                    if i_avail >= 4 {
                        if os_at(0, K_SDP) {
                            pop    = 4;
                            nstate = if remain >= 4 ? State::DppData : State::DppTail1;
                        } else {
                            nstate = State::Search;
                        }
                    }
                }
                State::DppData: {
                    // remain >= 4 here: one full data word
                    if i_avail >= 4 {
                        pop = 4;
                        if w_k != 0 {
                            nstate = State::Search;
                        } else if remain >= 8 {
                            nstate = State::DppData;
                        } else {
                            nstate = State::DppTail1;
                        }
                    }
                }
                State::DppTail1: {
                    // remain (0..3) data bytes + (4 - remain) CRC bytes
                    if i_avail >= 4 {
                        pop    = 4;
                        nstate = State::DppTail2;
                    }
                }
                State::DppTail2: {
                    // remain CRC bytes then DPPEND / DPPABORT
                    if i_avail >= remain[2:0] + 4 {
                        pop    = remain[2:0] + 4;
                        nstate = State::Search;
                    }
                }
                State::TsBody: {
                    if i_avail >= 4 {
                        pop = 4;
                        if widx == 2 {
                            nstate = State::Search;
                        }
                    }
                }
            }
        }
    }

    // ---------------------------------------------------------------- seq
    always_ff {
        if_reset {
            state          = State::Search;
            widx           = 0;
            hdr            = 0;
            crc16          = 0;
            kbad           = 0;
            remain         = 0;
            crc32          = 0;
            crc_rx         = 0;
            ts_ok          = 0;
            idle_cnt       = 0;
            o_ts_valid     = 0;
            o_ts_type      = 0;
            o_ts_cfg       = 0;
            o_ts_inv       = 0;
            o_pol_inv_hint = 0;
            o_idle8        = 0;
            o_lc_valid     = 0;
            o_lc_word      = 0;
            o_hp_valid     = 0;
            o_hp_hdr       = 0;
            o_hp_lcw       = 0;
            o_hp_crc_ok    = 0;
            o_dpp_start    = 0;
            o_dpp_valid    = 0;
            o_dpp_data     = 0;
            o_dpp_be       = 0;
            o_dpp_end      = 0;
            o_dpp_err      = 0;
        } else {
            o_ts_valid     = 0;
            o_pol_inv_hint = 0;
            o_lc_valid     = 0;
            o_hp_valid     = 0;
            o_dpp_start    = 0;
            o_dpp_valid    = 0;
            o_dpp_end      = 0;
            o_dpp_err      = 0;
            state          = nstate;

            if !i_enable {
                widx     = 0;
                idle_cnt = 0;
                o_idle8  = 0;
            } else {
                case state {
                    State::Search: {
                        if pop != 0 {
                            if found {
                                widx     = 0;
                                kbad     = 0;
                                crc16    = 16'hFFFF;
                                ts_ok    = 3'b111;
                                idle_cnt = 0;
                                o_idle8  = 0;
                            } else {
                                // idle counting / polarity hints over the 4 consumed symbols
                                var c: logic<4>;
                                c = idle_cnt;
                                for i in 0..4 {
                                    if !w_k[i] && w_desc[i * 8+:8] == 8'h00 {
                                        if c != 15 {
                                            c = c + 1;
                                        }
                                    } else {
                                        c = 0;
                                    }
                                }
                                idle_cnt = c;
                                o_idle8  = c >= 8;
                                if w_k == 0 && w_raw == {D21_5, D21_5, D21_5, D21_5} {
                                    o_pol_inv_hint = 1;
                                }
                            }
                        }
                    }
                    State::HpBody: {
                        if pop != 0 {
                            widx = widx + 1;
                            if w_k != 0 {
                                kbad = 1;
                            }
                            if widx != 3 {
                                hdr[widx * 32+:32] = w_desc;
                                crc16              = crc16_w;
                            } else {
                                o_hp_valid  = 1;
                                o_hp_hdr    = hdr;
                                o_hp_lcw    = w_desc[31:16];
                                o_hp_crc_ok = !kbad && w_k == 0 && ~crc16 == {w_desc[15:8], w_desc[7:0]}
                                    && lcw_ok(w_desc[31:16]);
                                remain      = hdr[58:48]; // Data Length (DW1[31:16]), max 1024
                                if hdr[63:59] != 0 {
                                    remain = 11'h7FF; // > 1024: treat as babble, DPP will fail
                                }
                                crc32 = 32'hFFFFFFFF;
                            }
                        }
                    }
                    State::LcBody: {
                        if pop != 0 {
                            o_lc_valid = w_k == 0 && w_desc[15:0] == w_desc[31:16] && lcw_ok(w_desc[15:0]);
                            o_lc_word  = w_desc[10:0];
                        }
                    }
                    State::DppStart: {
                        if i_avail >= 4 {
                            if os_at(0, K_SDP) {
                                o_dpp_start = 1;
                            } else {
                                o_dpp_err = 1;
                            }
                        }
                    }
                    State::DppData: {
                        if pop != 0 {
                            if w_k != 0 {
                                o_dpp_err = 1;
                            } else {
                                o_dpp_valid = 1;
                                o_dpp_data  = w_desc;
                                o_dpp_be    = 4'b1111;
                                crc32       = crc32_w;
                                remain      = remain - 4;
                            }
                        }
                    }
                    State::DppTail1: {
                        if pop != 0 {
                            if w_k != 0 {
                                o_dpp_err = 1;
                            }
                            o_dpp_valid = remain != 0;
                            o_dpp_data  = w_desc;
                            o_dpp_be    = case remain[1:0] {
                                0      : 4'b0000,
                                1      : 4'b0001,
                                2      : 4'b0011,
                                default: 4'b0111,
                            };
                            crc32 = crc32_w;
                            case remain[1:0] {
                                0      : crc_rx[31:0] = w_desc;
                                1      : crc_rx[23:0] = w_desc[31:8];
                                2      : crc_rx[15:0] = w_desc[31:16];
                                default: crc_rx[7:0]  = w_desc[31:24];
                            }
                        }
                    }
                    State::DppTail2: {
                        if pop != 0 {
                            var crc_full: logic<32>;
                            var kk      : logic    ;
                            var r       : logic<2> ;
                            r        = remain[1:0];
                            crc_full = crc_rx;
                            kk       = 0;
                            case r {
                                0: {}
                                1: {
                                    crc_full[31:24] = sym(i_desc, 0);
                                    kk              = i_k[0];
                                }
                                2: {
                                    crc_full[31:16] = i_desc[15:0];
                                    kk              = i_k[0] | i_k[1];
                                }
                                default: {
                                    crc_full[31:8] = i_desc[23:0];
                                    kk             = i_k[0] | i_k[1] | i_k[2];
                                }
                            }
                            if !kk && os_at(r, K_END) && crc_full == ~crc32 {
                                o_dpp_end = 1;
                            } else {
                                o_dpp_err = 1;
                            }
                        }
                    }
                    State::TsBody: {
                        if pop != 0 {
                            var ok  : logic<3>;
                            widx = widx + 1;
                            ok   = ts_ok;
                            if widx == 0 {
                                o_ts_cfg = w_raw[15:8];
                                for i in 2..4 {
                                    if w_k[i] || w_raw[i * 8+:8] != D10_2 {
                                        ok[0] = 0;
                                    }
                                    if w_k[i] || w_raw[i * 8+:8] != D5_2 {
                                        ok[1] = 0;
                                    }
                                    if w_k[i] || w_raw[i * 8+:8] != D21_5 {
                                        ok[2] = 0;
                                    }
                                }
                            } else {
                                for i in 0..4 {
                                    if w_k[i] || w_raw[i * 8+:8] != D10_2 {
                                        ok[0] = 0;
                                    }
                                    if w_k[i] || w_raw[i * 8+:8] != D5_2 {
                                        ok[1] = 0;
                                    }
                                    if w_k[i] || w_raw[i * 8+:8] != D21_5 {
                                        ok[2] = 0;
                                    }
                                }
                            }
                            ts_ok = ok;
                            if widx == 2 {
                                o_ts_valid = ok != 0;
                                o_ts_type  = if ok[1] ? 2 : 1;
                                o_ts_inv   = ok[2];
                            }
                        }
                    }
                }
            }
        }
    }
}
