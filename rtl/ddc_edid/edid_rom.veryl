/**
 * @file edid_rom.veryl
 * @brief EDID contents (generated by gen_edid.py - do not edit).
 *
 * DVI-only EDID 1.3, "FPGA DVI RX", preferred 1280x720@60, checksum 0x28.
 * Combinational 128-byte ROM; offsets 128-255 mirror the base block.
 */

pub module edid_rom (
    i_addr: input  logic<8>,
    o_data: output logic<8>,
) {
    always_comb {
        case i_addr[6:0] {
            7'h00  : o_data = 8'h00;
            7'h01  : o_data = 8'hFF;
            7'h02  : o_data = 8'hFF;
            7'h03  : o_data = 8'hFF;
