//
// RmiiRx: RMII (100 Mb/s) receive adapter for EthRxMac. Finds the
// preamble / SFD in the dibit stream, assembles bytes (LSB dibit first)
// and reports the end of the frame. CRS_DV is only looked at on the
// second dibit of each nibble: at the end of a frame the PHY toggles it
// at 25 MHz while the last data are still valid.
//
// From the RX engine of riscv-veryl/src/eth_mac.veryl.
module RmiiRx (
    i_clk   : input  clock   , // 50 MHz reference clock
    i_rst   : input  logic   ,
    i_rxd   : input  logic<2>,
    i_crs_dv: input  logic   ,
    o_bvalid: output logic   ,
    o_bdata : output logic<8>,
    o_end   : output logic   ,
    o_err   : output logic   , // with o_end: the frame ended mid-byte or the preamble was bad
) {
    enum RxState {
        IDLE,
        PREAMBLE,
        DATA,
        DROP, // wait for the line to go idle after an error
    }
    var state : RxState   ;
    var rxd_q : logic  <2>;
    var dv_q  : logic     ;
    var dv_q2 : logic     ;
    var dibit : logic  <2>; // dibit index within the current byte
    var sh    : logic  <8>;
    var bvalid: logic     ;
    var bdata : logic  <8>;
    var fend  : logic     ;
    var ferr  : logic     ;

    let second: logic    = dibit[0];
    let at_end: logic    = second && !dv_q;
    let bfull : logic<8> = {rxd_q, sh[7:2]}; // the byte once this dibit is in

    assign o_bvalid = bvalid;
    assign o_bdata  = bdata;
    assign o_end    = fend;
    assign o_err    = ferr;

    always_ff {
        rxd_q = i_rxd;
        dv_q  = i_crs_dv;
        dv_q2 = dv_q;
    }

    always_ff {
        if i_rst {
            state  = RxState::IDLE;
            dibit  = 2'd0;
            sh     = 8'b0;
            bvalid = 1'b0;
            bdata  = 8'b0;
            fend   = 1'b0;
            ferr   = 1'b0;
        } else {
            bvalid = 1'b0;
            fend   = 1'b0;
            ferr   = 1'b0;
            case state {
                RxState::IDLE: {
                    if dv_q && rxd_q == 2'b01 {
                        state = RxState::PREAMBLE;
                    }
                }
                RxState::PREAMBLE: {
                    if !dv_q {
                        state = RxState::IDLE;
                    } else if rxd_q == 2'b11 {
                        // SFD complete: data start with the next dibit
                        state = RxState::DATA;
                        dibit = 2'd0;
                    } else if rxd_q != 2'b01 {
                        state = RxState::DROP;
                    }
                }
                RxState::DATA: {
                    if at_end {
                        // frame over (this nibble is not valid); a whole
                        // number of bytes leaves us on the 2nd dibit
                        fend  = 1'b1;
                        ferr  = dibit != 2'd1;
                        state = RxState::IDLE;
                    } else {
                        sh    = bfull;
                        dibit = dibit + 1;
                        if dibit == 2'd3 {
                            bvalid = 1'b1;
                            bdata  = bfull;
                        }
                    }
                }
                RxState::DROP: {
                    if !dv_q && !dv_q2 {
                        state = RxState::IDLE;
                    }
                }
                default: {
                    state = RxState::IDLE;
                }
            }
        }
    }
}
