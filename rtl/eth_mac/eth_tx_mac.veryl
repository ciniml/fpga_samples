//
// EthTxMac: transmit half of an Ethernet MAC, PHY-interface independent.
//
// The writer (system clock) pushes a frame's bytes (destination MAC up to
// the end of the payload, no FCS) into a PktFifo and commits it with its
// length. The engine in the PHY transmit domain sends preamble + SFD, the
// bytes, zero padding up to 60 bytes, the FCS and a 12-byte gap.
//
// Byte interface to the PHY adapter (RmiiTx, RgmiiTx, ...): `o_ben` /
// `o_bdata` hold the byte to send next. The adapter takes it on a cycle
// with `i_ce` set, and on that same edge the engine moves on to the
// following byte. When `o_ben` is low the line is idle.
//
// Derived from the TX engine of riscv-veryl/src/eth_mac.veryl (the CRC is
// folded when a byte is loaded, so the FCS is ready right after the last
// data or pad byte).
module EthTxMac #(
    param DEPTH_LOG2: u32 = 11,
    param REC_LOG2  : u32 = 3 ,
) (
    // ---- writer (system) domain ----
    i_clk      : input  's clock                ,
    i_rst      : input  's logic                , // synchronous, active high
    i_wvalid   : input  's logic                ,
    i_wdata    : input  's logic<8>             ,
    i_wcommit  : input  's logic                ,
    i_wlen     : input  's logic<11>            ,
    i_wabort   : input  's logic                ,
    o_wspace   : output 's logic<DEPTH_LOG2 + 1>,
    o_wrec_full: output 's logic                ,

    // ---- PHY transmit domain ----
    i_tx_clk: input  't clock   ,
    i_tx_rst: input  't logic   , // synchronous, active high
    i_ce    : input  't logic   ,
    o_ben   : output 't logic   ,
    o_bdata : output 't logic<8>,
    o_tx_ok : output 't logic   , // pulse: a frame was sent
) {
    import Crc32Pkg::*;

    var rrec_valid: 't logic            ;
    var rlen      : 't logic<11>        ;
    var rflag     : 't logic            ;
    var rremain   : 't logic<11>        ;
    var rdata     : 't logic<32>        ;
    var rpop      : 't logic            ;
    var rpop_cnt  : 't logic<3>         ;
    var rrelease  : 't logic            ;
    var wcount    : 's logic<DEPTH_LOG2>;

    inst fifo: PktFifo #(
        DEPTH_LOG2: DEPTH_LOG2,
        REC_LOG2  : REC_LOG2  ,
    ) (
        i_wclk      : i_clk      ,
        i_wrst      : i_rst      ,
        i_wvalid    : i_wvalid   ,
        i_wdata     : i_wdata    ,
        i_wcommit   : i_wcommit  ,
        i_wlen      : i_wlen     ,
        i_wflag     : 1'b0       ,
        i_wabort    : i_wabort   ,
        o_wspace    : o_wspace   ,
        o_wrec_full : o_wrec_full,
        o_wcount    : wcount     ,
        i_rclk      : i_tx_clk   ,
        i_rrst      : i_tx_rst   ,
        o_rrec_valid: rrec_valid ,
        o_rlen      : rlen       ,
        o_rflag     : rflag      ,
        o_rremain   : rremain    ,
        o_rdata     : rdata      ,
        i_rpop      : rpop       ,
        i_rpop_n    : 3'd1       ,
        o_rpop_cnt  : rpop_cnt   ,
        i_rrelease  : rrelease   ,
    );

    enum TxState {
        IDLE,
        PREAMBLE,
        DATA,
        FCS,
        IFG,
    }
    var state: 't TxState    ;
    var cnt  : 't logic  <11>; // preamble bytes / data+pad bytes / FCS bytes / gap bytes loaded
    var crc  : 't logic  <32>;
    var fcs  : 't logic  <32>; // ~crc, shifted out LSB first
    var ben  : 't logic      ;
    var bdata: 't logic  <8> ;
    var ok_q : 't logic      ;

    assign o_ben   = ben;
    assign o_bdata = bdata;
    assign o_tx_ok = ok_q;

    // next byte from the FIFO (lane select of the row); frames start at
    // lane 0 and are popped one byte at a time, so a 2-bit count of the
    // pops gives the lane (instead of rlen - rremain)
    var lane     : 't logic<2>;
    let fifo_byte: 't logic<8>  = case lane {
        2'd0   : rdata[7:0],
        2'd1   : rdata[15:8],
        2'd2   : rdata[23:16],
        default: rdata[31:24],
    };

    // popped on the edge that loads the byte, so that the next byte is
    // ready even when i_ce is set on every cycle (GMII rate)
    assign rpop = i_ce && state == TxState::DATA && rremain != 11'd0;

    always_ff (i_tx_clk) {
        if i_tx_rst {
            state    = TxState::IDLE;
            cnt      = 11'd0;
            crc      = CRC32_INIT;
            fcs      = 32'b0;
            ben      = 1'b0;
            bdata    = 8'b0;
            rrelease = 1'b0;
            ok_q     = 1'b0;
            lane     = 2'd0;
        } else {
            if rpop {
                lane = lane + 2'd1;
            }
            if rrelease {
                lane = 2'd0;
            }
            rrelease = 1'b0;
            ok_q     = 1'b0;
            if i_ce {
                case state {
                    TxState::IDLE: {
                        ben   = 1'b0;
                        bdata = 8'h00;
                        if rrec_valid {
                            state = TxState::PREAMBLE;
                            ben   = 1'b1;
                            bdata = 8'h55;
                            cnt   = 11'd1;
                        }
                    }
                    TxState::PREAMBLE: {
                        // 7 x 0x55 then the SFD
                        if cnt == 11'd7 {
                            bdata = 8'hD5;
                            state = TxState::DATA;
                            cnt   = 11'd0;
                            crc   = CRC32_INIT;
                        } else {
                            bdata = 8'h55;
                            cnt   = cnt + 1;
                        }
                    }
                    TxState::DATA: {
                        if rremain != 11'd0 {
                            bdata = fifo_byte;
                            crc   = crc32_byte(crc, fifo_byte);
                            cnt   = cnt + 1;
                        } else if cnt <: 11'd60 {
                            bdata = 8'h00;
                            crc   = crc32_byte(crc, 8'h00);
                            cnt   = cnt + 1;
                        } else {
                            bdata = ~crc[7:0];
                            fcs   = {8'h00, ~crc[31:8]};
                            cnt   = 11'd1;
                            state = TxState::FCS;
                        }
                    }
                    TxState::FCS: {
                        if cnt == 11'd4 {
                            ben      = 1'b0;
                            bdata    = 8'h00;
                            cnt      = 11'd1;
                            state    = TxState::IFG;
                            rrelease = 1'b1;
                        } else {
                            bdata = fcs[7:0];
                            fcs   = fcs >> 8;
                            cnt   = cnt + 1;
                        }
                    }
                    TxState::IFG: {
                        // 12 idle bytes (this one included)
                        if cnt == 11'd12 {
                            state = TxState::IDLE;
                            ok_q  = 1'b1;
                        } else {
                            cnt = cnt + 1;
                        }
                    }
                    default: {
                        state = TxState::IDLE;
                    }
                }
            }
        }
    }

    let _unused_t: 't logic = rflag | (|rpop_cnt);
    let _unused_s: 's logic = |wcount;
}
