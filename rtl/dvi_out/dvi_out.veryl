/**
 * @file dvi_out.veryl
 * @brief RGB to DVI signal encoder.
 */

module dvi_out (
    r#clock: input clock_posedge,
    r#reset: input reset,

    video_data : input logic<24>,
    video_de   : input logic,
    video_hsync: input logic,
    video_vsync: input logic,

    dvi_clock: output logic<10>,
    dvi_data0: output logic<10>,
    dvi_data1: output logic<10>,
    dvi_data2: output logic<10>,
) {
    assign dvi_clock = 10'b00000_11111;

    // Video signal register type
    struct video_reg_t {
        de   : logic,
        hsync: logic,
        vsync: logic,
        data : logic<27>,
    }

    const VIDEO_REGS_DEPTH: u32 = 2;

    function popCount2 (
        x: input logic<2>,
    ) -> logic<2> {
        return {1'b0, x[0]} + {1'b0, x[1]};
    }

    function popCount4 (
        x: input logic<4>,
    ) -> logic<3> {
        return {1'b0, popCount2(x[3:2])} + {1'b0, popCount2(x[1:0])};
    }

    function popCount8 (
        x: input logic<10>,
    ) -> logic<4> {
        return {1'b0, popCount4(x[7:4])} + {1'b0, popCount4(x[3:0])};
    }

    function transitionMinimized (
        x: input logic<8>,
    ) -> logic<9> {
        var pop_count   : logic<4>;
        var xnor_process: logic   ;
        var bits        : logic<8>;
        pop_count = popCount8(x);
        xnor_process = pop_count >: 4'd4 || (pop_count == 4'd4 && !x[0]);
        bits[0] = x[0];
        for i in 1..8 {
            bits[i] = (bits[i - 1] ^ x[i]) ^ xnor_process;
        }
        return {!xnor_process, bits};
    }

    struct dc_balancing_t {
        out    : logic<10>,
        counter: logic<8>,
    }

    function dcBalancing (
        x      : input logic<9>,
        counter: input logic<8>,
    ) -> dc_balancing_t {
        var n1    : logic<4>       ;
        var n0n1  : logic<8>       ;
        var result: dc_balancing_t ;
        n1 = popCount8(x[7:0]);
        n0n1 = 8'd8 - {3'b000, n1, 1'b0};
        if counter == '0 || n0n1 == '0 {
            result.out     = {!x[8], x[8], if x[8] ? x[7:0] : ~x[7:0]};
            result.counter = if x[8] ? counter - n0n1 : counter + n0n1;
        } else if (!counter[7] && n0n1[7]) || (counter[7] && !n0n1[7]) {
            result.out     = {1'b1, x[8], ~x[7:0]};
            result.counter = if x[8] ? counter + n0n1 + 8'd2 : counter + n0n1;
        } else {
            result.out     = {1'b0, x[8], x[7:0]};
            result.counter = if x[8] ? counter - n0n1 : counter - n0n1 - 8'd2;
        }
        return result;
    }

    function transitionMaximized (
        x: input logic<2>,
    ) -> logic<10> {
        var r: logic<10>;
        case x {
            2'b00  : r = 10'b1101010100;
            2'b01  : r = 10'b0010101011;
            2'b10  : r = 10'b0101010100;
            2'b11  : r = 10'b1010101011;
            default: r = 10'b0000000000;
        }
        return r;
    }

    var video_reg_in: video_reg_t                    ;
    var video_regs  : video_reg_t [VIDEO_REGS_DEPTH] ;
    var video       : video_reg_t                    ;
    assign video = video_regs[0];

    var counter0: logic<8>;
    var counter1: logic<8>;
    var counter2: logic<8>;
    assign video_reg_in.de    = video_de;
    assign video_reg_in.hsync = video_hsync;
    assign video_reg_in.vsync = video_vsync;
    assign video_reg_in.data  = {transitionMinimized(video_data[23:16]), transitionMinimized(video_data[15:8]), transitionMinimized(video_data[7:0])};

    always_ff (r#clock) {
        if r#reset {
            for i in 0..VIDEO_REGS_DEPTH {
                video_regs[i].de    = 0;
                video_regs[i].data  = 0;
                video_regs[i].hsync = 1;
                video_regs[i].vsync = 1;
            }
        } else {
            video_regs[VIDEO_REGS_DEPTH - 1] = video_reg_in;
            for i in 0..VIDEO_REGS_DEPTH - 1 {
                video_regs[i] = video_regs[i + 1];
            }
        }
    }

    always_ff (r#clock) {
        var result0: dc_balancing_t;
        var result1: dc_balancing_t;
        var result2: dc_balancing_t;
        if r#reset {
            counter0  = 0;
            counter1  = 0;
            counter2  = 0;
            dvi_data0 = 0;
            dvi_data1 = 0;
            dvi_data2 = 0;
        } else {
            if !video.de {
                dvi_data0 = transitionMaximized({video.vsync, video.hsync});
                dvi_data1 = transitionMaximized(2'b00);
                dvi_data2 = transitionMaximized(2'b00);
                counter0  = 0;
                counter1  = 0;
                counter2  = 0;
            } else {
                result0   = dcBalancing(video.data[8:0], counter0);
                dvi_data0 = result0.out;
                counter0  = result0.counter;
                result1   = dcBalancing(video.data[17:9], counter1);
                dvi_data1 = result1.out;
                counter1  = result1.counter;
                result2   = dcBalancing(video.data[26:18], counter2);
                dvi_data2 = result2.out;
                counter2  = result2.counter;
            }
        }
    }

}
