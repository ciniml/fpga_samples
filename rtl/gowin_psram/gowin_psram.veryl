/**
 * @file gowin_psram.veryl
 * @brief HyperRAM (HyperBus) controller for Gowin FPGAs, one die per instance.
 *
 * Targets the on-package PSRAM of the Tang Nano 9K (GW1NR-9, Winbond
 * W955D8MBYA, 2 dies x 4MiB) but only uses generic Gowin ODDR/IDDR
 * primitives, so it works for any HyperRAM wired to ordinary I/O as well.
 * No encrypted Gowin IP is involved and the whole design can be simulated
 * with the Gowin primitive simulation models.
 *
 * Clocking: 1:1 design. Everything runs on i_clk; the memory clock CK is
 * generated by an ODDR clocked from i_clk_p, a copy of i_clk shifted by
 * roughly 90 degrees (PLL CLKOUTP with PSDA_SEL = 4), so that CK edges
 * land in the middle of the DQ/RWDS data eyes. The CK enable is
 * re-registered on the falling edge of i_clk before it enters the
 * i_clk_p ODDR (a quarter period would otherwise be all the budget that
 * path gets), which makes CK line up with DQ/CS# for CKD = 0
 * according to the Gowin primitive models and on the Tang Nano 9K;
 * CK_DELAY adds whole cycles for other boards.
 *
 * Protocol choices:
 *  - Fixed (2x) initial latency: CR0 is written at init so the additional
 *    latency indication on RWDS never has to be sampled. Cost: LATENCY
 *    extra cycles per burst.
 *  - Bursts of 1..2**LEN_BITS words (16 bits). The Tang Nano 9K die wraps
 *    every burst at the CR0 burst length even with a linear CA, so a burst
 *    must not cross a WRAP_BYTES boundary (WRAP_BYTES = 128 is the largest
 *    the chip offers: 64 words). Keep CS# low under tCSM (4us) as well.
 *  - Reads are self-timed: data words are captured whenever the RWDS
 *    strobe toggles, so the read side tolerates phase differences.
 *  - Writes stream one word per cycle after the latency; the data source
 *    must keep up (o_wr_ready is a one-cycle-per-word strobe). A word
 *    presented without i_wr_valid is fully masked (not written).
 *
 * Byte order: i_wr_data/o_rd_data[7:0] is the even (lower) address byte,
 * [15:8] the odd byte; on the bus the odd byte is the rising-edge byte.
 * i_wr_mask bits set to 1 mask (do not write) the corresponding byte.
 *
 * Register space (i_cmd_reg = 1): byte address 0x0000 ID0, 0x0002 ID1,
 * 0x1000 CR0, 0x1002 CR1 (one word, i_cmd_len must be 0).
 */
pub module GowinPsram #(
    param CLK_HZ    : u32 = 81_000_000, // i_clk frequency (init timer)
    param LATENCY   : u32 = 3         , // initial latency clocks: 3 (<=83MHz), 4 (<=104), 5 (<=133), 6 (<=166)
    param ADDR_BITS : u32 = 22        , // byte address width (22 = 4MiB die)
    param LEN_BITS  : u32 = 6         , // burst length field width (words - 1)
    param WRAP_BYTES: u32 = 128       , // CR0 burst length: 16, 32, 64 or 128 bytes
    param CK_DELAY  : u32 = 0         , // extra cycles CK enable lags DQ/CS# (0..2, board calibration)
) (
    i_clk     : input 'a clock  ,
    i_clk_p   : input 'b clock  , // i_clk shifted ~90 degrees, drives CK
    i_rst     : input 'a reset  ,
    o_ready   : output 'a logic , // initialization done

    // command
    i_cmd_valid: input 'a logic          ,
    o_cmd_ready: output 'a logic          ,
    i_cmd_write: input 'a logic          ,
    i_cmd_reg  : input 'a logic          , // register space access
    i_cmd_addr : input 'a logic<ADDR_BITS>, // byte address (bit 0 ignored)
    i_cmd_len  : input 'a logic<LEN_BITS>, // words - 1

    // write data (one word per o_wr_ready strobe)
    i_wr_valid: input 'a logic    ,
    o_wr_ready: output 'a logic    ,
    i_wr_data : input 'a logic<16>,
    i_wr_mask : input 'a logic<2> , // 1 = do not write this byte

    // read data
    o_rd_valid: output 'a logic    ,
    o_rd_data : output 'a logic<16>,
    o_rd_last : output 'a logic    ,

    // HyperRAM pins (one die)
    o_psram_ck     : output 'b logic       ,
    o_psram_cs_n   : output 'a logic       ,
    o_psram_reset_n: output 'a logic       ,
    io_psram_dq    : inout 'a tri logic<8>,
    io_psram_rwds  : inout 'a tri logic   ,
) {
    // ---- timing constants ----
    const RESET_CYCLES: u32 = 256;                          // RESET# low (tRP >= 200ns)
    const INIT_CYCLES : u32 = CLK_HZ / 1_000_000 * 160;     // tVCS 150us + margin
    const RECOV_CYCLES: u32 = 8;                            // tRWR 40ns / tCSHI, generous
    const LAT_CODE    : logic<4> = if LATENCY == 3 ? 4'b1110 :
                                  if LATENCY == 4 ? 4'b1111 :
                                  if LATENCY == 5 ? 4'b0000 : 4'b0001;
    const WRAP_CODE: logic<2>  = if WRAP_BYTES == 16 ? 2'b10 :
                                 if WRAP_BYTES == 32 ? 2'b11 :
                                 if WRAP_BYTES == 64 ? 2'b01 : 2'b00;
    // CR0: normal operation, 34ohm drive, reserved 1111, latency, fixed
    // latency, [2] reserved (reads as 1), burst length
    const CR0_VALUE: logic<16> = {1'b1, 3'b000, 4'b1111, LAT_CODE, 1'b1, 1'b1, WRAP_CODE};
    const CKD      : logic<2>  = CK_DELAY;
    const CR0_ADDR : logic<ADDR_BITS> = 'h1000;

    enum State: logic<4> {
        Reset,
        InitWait,
        Idle,
        Ca,
        Lat,
        WrData,
        RdData,
        Recover,
    }

    var state  : 'a State;
    var timer  : 'a logic<32>;
    var init_wr: 'a logic;          // the CR0 write is in flight (init)

    // ---- physical-side registers (all go through ODDR, same latency) ----
    var dq_ris  : 'a logic<8>;
    var dq_fal  : 'a logic<8>;
    var dq_oe   : 'a logic;
    var rwds_ris: 'a logic;
    var rwds_fal: 'a logic;
    var rwds_oe : 'a logic;
    var busy_r  : 'a logic;         // CS# low request
    var busy_d1 : 'a logic;
    var busy_d2 : 'a logic;
    var ck_e_r  : 'a logic;         // CK enable request
    var ck_e_d1 : 'a logic;
    var ck_e_d2 : 'a logic;
    var reset_n : 'a logic;

    let cs_active: 'a logic = busy_r | (busy_d1 & (CKD != 2'd0)) | (busy_d2 & (CKD == 2'd2));
    let ck_e_sel : 'a logic = case CKD {
        2'd0   : ck_e_r,
        2'd1   : ck_e_d1,
        default: ck_e_d2,
    };

    // ---- command latch ----
    var ca      : 'a logic<48>;
    var cmd_wr  : 'a logic;
    var cmd_reg : 'a logic;
    var cnt     : 'a logic<8>;      // generic cycle counter within a state
    var words   : 'a logic<LEN_BITS>; // words remaining - 1

    // ---- read capture ----
    var dq_in_ris  : 'a logic<8>;
    var dq_in_fal  : 'a logic<8>;
    var rwds_in_ris: 'a logic;
    var rwds_in_fal: 'a logic;
    var rd_en      : 'a logic;      // capture window open
    var pend       : 'a logic;      // rising byte captured on the falling sample
    var pend_hi    : 'a logic<8>;
    var rd_valid   : 'a logic;
    var rd_data    : 'a logic<16>;
    var rd_last    : 'a logic;
    var rd_cnt     : 'a logic<LEN_BITS>;
    var rd_done    : 'a logic;

    assign o_ready     = state != State::Reset && state != State::InitWait && !init_wr;
    assign o_cmd_ready = state == State::Idle;
    assign o_wr_ready  = state == State::WrData && !init_wr;
    assign o_rd_valid  = rd_valid;
    assign o_rd_data   = rd_data;
    assign o_rd_last   = rd_last;
    assign o_psram_reset_n = reset_n;

    // word address -> CA (HyperBus: CA[44:16] = addr[..:3], CA[2:0] = addr[2:0])
    function make_ca(wr: input logic, reg_space: input logic, addr: input logic<ADDR_BITS>) -> logic<48> {
        var wa: 'a logic<32>;
        wa                  = 0;
        wa[ADDR_BITS - 2:0] = addr[ADDR_BITS - 1:1];
        return {~wr, reg_space, 1'b1, wa[31:3], 13'h0, wa[2:0]};
    }

    // word source for the data phase (init writes CR0 itself)
    let src_data : 'a logic<16> = if init_wr ? CR0_VALUE : i_wr_data;
    let src_mask : 'a logic<2>  = if init_wr ? 2'b00 : (if i_wr_valid ? i_wr_mask : 2'b11);
    // Fixed (2x) latency. Measured on the W955D8MBYA (Tang Nano 9K):
    // with latency code 3 the data phase starts at CK rising edge 8,
    // i.e. the count runs from the third CA clock (edge 2), not edge 0.
    let lat_total: 'a logic<8>  = 2 * LATENCY + 2;

    always_ff (i_clk, i_rst) {
        if_reset {
            state    = State::Reset;
            timer    = 0;
            init_wr  = 0;
            dq_ris   = 0;
            dq_fal   = 0;
            dq_oe    = 0;
            rwds_ris = 0;
            rwds_fal = 0;
            rwds_oe  = 0;
            busy_r   = 0;
            busy_d1  = 0;
            busy_d2  = 0;
            ck_e_r   = 0;
            ck_e_d1  = 0;
            ck_e_d2  = 0;
            reset_n  = 0;
            ca       = 0;
            cmd_wr   = 0;
            cmd_reg  = 0;
            cnt      = 0;
            words    = 0;
            rd_en    = 0;
            pend     = 0;
            pend_hi  = 0;
            rd_valid = 0;
            rd_data  = 0;
            rd_last  = 0;
            rd_cnt   = 0;
            rd_done  = 0;
        } else {
            busy_d1  = busy_r;
            busy_d2  = busy_d1;
            ck_e_d1  = ck_e_r;
            ck_e_d2  = ck_e_d1;
            rd_valid = 0;
            rd_last  = 0;

            // ---- read capture: RWDS toggles once per data word ----
            // (ris, fal) = (1, 0): the word sits in one cycle.
            // (0, 1): the rising byte arrived on the falling sample; the
            // word completes with the next cycle's rising sample, and is
            // accepted only if that cycle is (0, 1) again, i.e. the strobe
            // really is running (the RWDS high->low step after the CA
            // gives a lone (0, 1) followed by (0, 0), which is dropped).
            if rd_en && !rd_done {
                if pend && !rwds_in_ris && rwds_in_fal {
                    rd_valid = 1;
                    rd_data  = {pend_hi, dq_in_ris};
                } else if rwds_in_ris && !rwds_in_fal {
                    rd_valid = 1;
                    rd_data  = {dq_in_ris, dq_in_fal};
                }
                if (pend && !rwds_in_ris && rwds_in_fal) || (rwds_in_ris && !rwds_in_fal) {
                    rd_cnt = rd_cnt + 1;
                    if rd_cnt == words {
                        rd_last = 1;
                        rd_done = 1;
                    }
                }
                pend = !rwds_in_ris && rwds_in_fal;
                if !rwds_in_ris && rwds_in_fal {
                    pend_hi = dq_in_fal;
                }
            }

            case state {
                State::Reset: {
                    reset_n = 0;
                    timer   = timer + 1;
                    if timer == RESET_CYCLES {
                        reset_n = 1;
                        timer   = 0;
                        state   = State::InitWait;
                    }
                }
                State::InitWait: {
                    timer = timer + 1;
                    if timer == INIT_CYCLES {
                        // configuration register write (no latency)
                        init_wr = 1;
                        ca      = make_ca(1, 1, CR0_ADDR);
                        cmd_wr  = 1;
                        cmd_reg = 1;
                        words   = 0;
                        cnt     = 0;
                        state   = State::Ca;
                    }
                }
                State::Idle: {
                    if i_cmd_valid {
                        ca      = make_ca(i_cmd_write, i_cmd_reg, i_cmd_addr);
                        cmd_wr  = i_cmd_write;
                        cmd_reg = i_cmd_reg;
                        words   = i_cmd_len;
                        cnt     = 0;
                        state   = State::Ca;
                    }
                }
                State::Ca: {
                    // three CA words on DQ, CS# low, CK running
                    busy_r = 1;
                    ck_e_r = 1;
                    dq_oe  = 1;
                    dq_ris = ca[47:40];
                    dq_fal = ca[39:32];
                    ca     = {ca[31:0], 16'h0};
                    cnt    = cnt + 1;
                    if cnt == 8'd2 {
                        cnt = 0;
                        if cmd_wr && cmd_reg {
                            // register write: data immediately follows CA
                            state = State::WrData;
                        } else {
                            state = State::Lat;
                        }
                        rd_cnt  = 0;
                        rd_done = 0;
                        pend    = 0;
                    }
                }
                State::Lat: {
                    // Fixed 2x latency: the data phase starts LAT_TOTAL CK
                    // cycles after CK cycle 0 (see lat_total). Relative to the edge where CA
                    // word 0 was registered (cycle 0): DQ reaches the pins 3
                    // cycles later and so does CK cycle 0 (+ CKD), so
                    // the first data word is registered at cycle
                    // LAT_TOTAL + CKD; this state runs from cycle 3
                    // and cnt is compared before its increment.
                    // Reads open the capture window just before the first
                    // word can appear (its IDDR output is visible from cycle
                    // LAT_TOTAL + CKD + 5).
                    dq_oe = 0;
                    cnt   = cnt + 1;
                    if cmd_wr && (cnt == lat_total - 8'd4 + {6'h0, CKD}) {
                        cnt   = 0;
                        state = State::WrData;
                    }
                    if !cmd_wr && (cnt == lat_total + {6'h0, CKD}) {
                        cnt   = 0;
                        rd_en = 1;
                        state = State::RdData;
                    }
                }
                State::WrData: {
                    // one word per cycle; RWDS carries the byte mask
                    dq_oe    = 1;
                    dq_ris   = src_data[15:8];
                    dq_fal   = src_data[7:0];
                    rwds_oe  = !cmd_reg;
                    rwds_ris = src_mask[1];
                    rwds_fal = src_mask[0];
                    if words == 0 {
                        state = State::Recover;
                    } else {
                        words = words - 1;
                    }
                }
                State::RdData: {
                    cnt = cnt + 1;
                    if rd_done || (cnt == 8'hFF) {
                        // done, or no strobe at all: give up (bus not responding)
                        rd_en = 0;
                        cnt   = 0;
                        state = State::Recover;
                    }
                }
                State::Recover: {
                    // release the bus, honor CK delay, then tRWR
                    dq_oe   = 0;
                    rwds_oe = 0;
                    busy_r  = 0;
                    ck_e_r  = 0;
                    cnt     = cnt + 1;
                    if cnt == RECOV_CYCLES {
                        cnt     = 0;
                        init_wr = 0;
                        state   = State::Idle;
                    }
                }
                default: state = State::Idle;
            }
        }
    }

    // ---- physical layer: Gowin DDR primitives ----
    var dq_o    : 'a logic<8>;
    var dq_t    : 'a logic<8>;
    var rwds_o  : 'a logic;
    var rwds_t  : 'a logic;
    var cs_o    : 'a logic;
    var _cs_t   : 'a logic;
    var ck_o    : 'b logic;
    var _ck_t   : 'b logic;

    for i in 0..8 :g_dq {
        inst u_oddr: $sv::ODDR (
            CLK: i_clk,
            D0 : dq_ris[i],
            D1 : dq_fal[i],
            TX : ~dq_oe,
            Q0 : dq_o[i],
            Q1 : dq_t[i],
        );
        inst u_iddr: $sv::IDDR (
            CLK: i_clk,
            D  : io_psram_dq[i],
            Q0 : dq_in_ris[i],
            Q1 : dq_in_fal[i],
        );
        assign io_psram_dq[i] = if dq_t[i] ? 'z : dq_o[i];
    }

    inst u_oddr_rwds: $sv::ODDR (
        CLK: i_clk,
        D0 : rwds_ris,
        D1 : rwds_fal,
        TX : ~rwds_oe,
        Q0 : rwds_o,
        Q1 : rwds_t,
    );
    inst u_iddr_rwds: $sv::IDDR (
        CLK: i_clk,
        D  : io_psram_rwds,
        Q0 : rwds_in_ris,
        Q1 : rwds_in_fal,
    );
    assign io_psram_rwds = if rwds_t ? 'z : rwds_o;

    inst u_oddr_cs: $sv::ODDR (
        CLK: i_clk,
        D0 : ~cs_active,
        D1 : ~cs_active,
        TX : 1'b0,
        Q0 : cs_o,
        Q1 : _cs_t,
    );
    assign o_psram_cs_n = cs_o;

    // CK: high during the first half of the (phase-shifted) cycle. The
    // enable crosses into the i_clk_p domain by design (same frequency,
    // fixed phase relation) through a falling-edge register, so both
    // hops have at least half a period of timing budget.
    var ck_e_n: 'b logic;
    unsafe (cdc) {
        inst u_ck_e_n: $sv::gowin_psram_negedge_ff (
            clk: i_clk,
            d  : ck_e_sel,
            q  : ck_e_n,
        );
        inst u_oddr_ck: $sv::ODDR (
            CLK: i_clk_p,
            D0 : ck_e_n,
            D1 : 1'b0,
            TX : 1'b0,
            Q0 : ck_o,
            Q1 : _ck_t,
        );
    }
    assign o_psram_ck = ck_o;
}

// falling-edge register for the CK enable (see GowinPsram)
embed (inline) sv{{{
module gowin_psram_negedge_ff (
    input  wire  clk,
    input  wire  d,
    output logic q
);
    always_ff @(negedge clk) q <= d;
endmodule
}}}
