// RAM output delay corner cases: fast (word straddles the sample edges
// differently) and slow parts (the model needs T_CKD below half a period)
#[test(gowin_psram_ckd_fast)]
embed (inline) sv{{{
module gowin_psram_ckd_fast_test;
    gowin_psram_test_body #(.RUN(1), .T_CKD(1.0)) body();
endmodule
}}}

#[test(gowin_psram_ckd_mid)]
embed (inline) sv{{{
module gowin_psram_ckd_mid_test;
    gowin_psram_test_body #(.RUN(1), .T_CKD(3.0)) body();
endmodule
}}}

#[test(gowin_psram_ckd_slow)]
embed (inline) sv{{{
module gowin_psram_ckd_slow_test;
    gowin_psram_test_body #(.RUN(1), .T_CKD(5.9)) body();
endmodule
}}}

