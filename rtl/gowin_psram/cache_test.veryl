/**
 * @file cache_test.veryl
 * @brief Board test driver for PsramDwordCache (user side).
 *
 * Writes TEST_DWORDS dwords sequentially through the cache's synchronous
 * RAM interface, reads them back, counts mismatches and prints one UART
 * line per pass: "p=NN err=XXXXXX first=XXXXX got=XXXXXXXX exp=XXXXXXXX".
 * The pattern alternates between the byte-incrementing one of
 * probe_host.py and an address hash, seeded with the pass number.
 */
pub module CacheTest #(
    param TEST_DWORDS: u32 = 1 << 16, // 256KiB
    param ADDR_BITS  : u32 = 20     ,
) (
    i_clk: input clock,
    i_rst: input reset,

    o_addr : output logic<ADDR_BITS>,
    o_wen  : output logic           ,
    o_wdata: output logic<32>       ,
    o_ren  : output logic           ,
    i_rdata: input  logic<32>       ,
    i_ready: input  logic           ,

    o_tx_valid: output logic   ,
    i_tx_ready: input  logic   ,
    o_tx_data : output logic<8>,
    o_status  : output logic<3>, // {reading, writing, last pass clean}
) {
    enum State: logic<3> {
        Write,
        Read,
        RdWait,
        Print,
        Next,
    }
    var state    : State;
    var addr     : logic<ADDR_BITS>;
    var seed     : logic<8>;
    var errors   : logic<24>;
    var first_adr: logic<20>;
    var first_got: logic<32>;
    var first_exp: logic<32>;
    var clean    : logic;
    var rd_pend  : logic;
    var rd_addr  : logic<ADDR_BITS>;
    var pidx     : logic<8>;

    function pat(a: input logic<ADDR_BITS>, s: input logic<8>) -> logic<32> {
        if s[0] == 1'b0 {
            // bytes 4a+3, 4a+2, 4a+1, 4a (low byte first) xor the seed
            return {a[5:0], 2'b11, a[5:0], 2'b10, a[5:0], 2'b01, a[5:0], 2'b00} ^ {s[7:1], 1'b0, s[7:1], 1'b0, s[7:1], 1'b0, s[7:1], 1'b0};
        } else {
            return {a[15:0], a[15:0]} ^ {a[7:0], a[19:8], a[11:0]} ^ {s, s, s, s} ^ 32'hA5C3_5A3C;
        }
    }

    assign o_addr  = if state == State::RdWait ? rd_addr : addr;
    assign o_wen   = state == State::Write;
    assign o_wdata = pat(addr, seed);
    assign o_ren   = state == State::Read;
    assign o_status = {state == State::Read || state == State::RdWait, state == State::Write, clean};

    function hex(n: input logic<4>) -> logic<8> {
        return if n <: 4'd10 ? 8'h30 + {4'h0, n} : 8'h57 + {4'h0, n};
    }
    // "p=NN err=XXXXXX first=XXXXX got=XXXXXXXX exp=XXXXXXXX\r\n"
    const LINE_LEN: u32 = 52;
    function line_char(i: input logic<8>) -> logic<9> {
        var c: logic<9>;
        c = 9'h020;
        case i {
            8'd0: c = 9'h070; // p
            8'd1: c = 9'h03D;
            8'd2: c = {1'b1, 4'h0, seed[7:4]};
            8'd3: c = {1'b1, 4'h0, seed[3:0]};
            8'd5: c = 9'h065; // e
            8'd6: c = 9'h072; // r
            8'd7: c = 9'h072; // r
            8'd8: c = 9'h03D;
            8'd9: c = {1'b1, 4'h0, errors[23:20]};
            8'd10: c = {1'b1, 4'h0, errors[19:16]};
            8'd11: c = {1'b1, 4'h0, errors[15:12]};
            8'd12: c = {1'b1, 4'h0, errors[11:8]};
            8'd13: c = {1'b1, 4'h0, errors[7:4]};
            8'd14: c = {1'b1, 4'h0, errors[3:0]};
            8'd16: c = 9'h066; // f
            8'd17: c = 9'h069; // i
            8'd18: c = 9'h072; // r
            8'd19: c = 9'h073; // s
            8'd20: c = 9'h074; // t
            8'd21: c = 9'h03D;
            8'd22: c = {1'b1, 4'h0, first_adr[19:16]};
            8'd23: c = {1'b1, 4'h0, first_adr[15:12]};
            8'd24: c = {1'b1, 4'h0, first_adr[11:8]};
            8'd25: c = {1'b1, 4'h0, first_adr[7:4]};
            8'd26: c = {1'b1, 4'h0, first_adr[3:0]};
            8'd28: c = 9'h067; // g
            8'd29: c = 9'h06F; // o
            8'd30: c = 9'h074; // t
            8'd31: c = 9'h03D;
            8'd32: c = {1'b1, 4'h0, first_got[31:28]};
            8'd33: c = {1'b1, 4'h0, first_got[27:24]};
            8'd34: c = {1'b1, 4'h0, first_got[23:20]};
            8'd35: c = {1'b1, 4'h0, first_got[19:16]};
            8'd36: c = {1'b1, 4'h0, first_got[15:12]};
            8'd37: c = {1'b1, 4'h0, first_got[11:8]};
            8'd38: c = {1'b1, 4'h0, first_got[7:4]};
            8'd39: c = {1'b1, 4'h0, first_got[3:0]};
            8'd41: c = 9'h065; // e
            8'd42: c = 9'h078; // x
            8'd43: c = 9'h070; // p
            8'd44: c = 9'h03D;
            8'd45: c = {1'b1, 4'h0, first_exp[31:28]};
            8'd46: c = {1'b1, 4'h0, first_exp[27:24]};
            8'd47: c = {1'b1, 4'h0, first_exp[23:20]};
            8'd48: c = {1'b1, 4'h0, first_exp[19:16]};
            8'd49: c = {1'b1, 4'h0, first_exp[15:12]};
            8'd50: c = {1'b1, 4'h0, first_exp[11:8]};
            8'd51: c = {1'b1, 4'h0, first_exp[7:4]};
            8'd52: c = {1'b1, 4'h0, first_exp[3:0]};
            8'd53: c = 9'h00D;
            8'd54: c = 9'h00A;
            default: c = 9'h020;
        }
        return c;
    }
    var tx_sel : logic<9>;
    var tx_ph  : logic;
    var tx_byte: logic<8>;
    var tx_pend: logic;
    assign o_tx_valid = tx_pend;
    assign o_tx_data  = tx_byte;

    always_ff (i_clk, i_rst) {
        if_reset {
            state     = State::Write;
            addr      = 0;
            seed      = 0;
            errors    = 0;
            first_adr = 0;
            first_got = 0;
            first_exp = 0;
            clean     = 0;
            rd_pend   = 0;
            rd_addr   = 0;
            pidx      = 0;
            tx_sel    = 0;
            tx_ph     = 0;
            tx_byte   = 0;
            tx_pend   = 0;
        } else {
            case state {
                State::Write: {
                    if i_ready {
                        addr = addr + 1;
                        if addr == TEST_DWORDS - 1 {
                            addr  = 0;
                            state = State::Read;
                        }
                    }
                }
                State::Read: {
                    if i_ready {
                        rd_addr = addr;
                        addr    = addr + 1;
                        state   = State::RdWait;
                    }
                }
                State::RdWait: {
                    // data one cycle after the accepted read
                    if i_rdata != pat(rd_addr, seed) {
                        if errors == 0 {
                            first_adr = rd_addr;
                            first_got = i_rdata;
                            first_exp = pat(rd_addr, seed);
                        }
                        errors = errors + 1;
                    }
                    if addr == TEST_DWORDS {
                        addr  = 0;
                        pidx  = 0;
                        state = State::Print;
                    } else {
                        state = State::Read;
                    }
                }
                State::Print: {
                    if !tx_pend && !tx_ph {
                        tx_sel = line_char(pidx);
                        tx_ph  = 1;
                    } else if !tx_pend {
                        tx_byte = if tx_sel[8] ? hex(tx_sel[3:0]) : tx_sel[7:0];
                        tx_pend = 1;
                        tx_ph   = 0;
                    } else if i_tx_ready {
                        tx_pend = 0;
                        pidx    = pidx + 1;
                        if pidx == 8'd54 {
                            state = State::Next;
                        }
                    }
                }
                State::Next: {
                    clean     = errors == 0;
                    errors    = 0;
                    first_adr = 0;
                    first_got = 0;
                    first_exp = 0;
                    seed      = seed + 1;
                    state     = State::Write;
                }
                default: state = State::Write;
            }
        }
    }
}
