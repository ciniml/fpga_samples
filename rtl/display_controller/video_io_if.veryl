/**
 * @file video_io_if.veryl
 * @brief Video output interface with configurable pixel bit depth
 */

pub interface video_io_if #(
    param PIXEL_BITS: u32 = 8,
) {
    var pixel_data: logic<PIXEL_BITS * 3>;  // RGB components
    var hsync: logic;
    var vsync: logic;
    var data_enable: logic;

    modport master {
        pixel_data: output,
        hsync: output,
        vsync: output,
        data_enable: output,
    }

    modport slave {
        ..converse(master)
    }

    modport monitor {
        ..input
    }
}