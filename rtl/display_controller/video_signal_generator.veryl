/**
 * @file video_signal_generator.veryl
 * @brief Video signal generator with RGB332 input and configurable RGB output
 */

embed (inline) sv{{{
`timescale 1ns/1ps
}}}

pub module video_signal_generator #(
    param SCREEN_WIDTH: u32 = 320,
    param SCREEN_HEIGHT: u32 = 240,
    param PIXEL_BITS: u32 = 8,
    param BACK_PORCH_H: u32 = 68,
    param FRONT_PORCH_H: u32 = 18,
    param PULSE_WIDTH_H: u32 = 30,
    param BACK_PORCH_V: u32 = 18,
    param FRONT_PORCH_V: u32 = 4,
    param PULSE_WIDTH_V: u32 = 4,
    param MULTIPLIER_H: u32 = 1,
    param MULTIPLIER_V: u32 = 1,
) (
    r#clock: input clock,
    r#reset: input reset,
    
    // Video output interface
    video: modport video_io_if::master,
    
    // Data input (AXI4S) - RGB332 format
    data: modport axi4s::axi4s_if::<32, true, 1>::slave,
    
    // Status output
    data_in_sync: output logic,
) {
    // Video timing parameters for 320x240 @ 60Hz
    // These are fixed for this implementation    
    const TOTAL_H: u32 = SCREEN_WIDTH + BACK_PORCH_H + FRONT_PORCH_H + PULSE_WIDTH_H;
    const TOTAL_V: u32 = SCREEN_HEIGHT + BACK_PORCH_V + FRONT_PORCH_V + PULSE_WIDTH_V;
    
    // Counter bit widths
    const H_COUNT_BITS: u32 = $clog2(TOTAL_H);
    const V_COUNT_BITS: u32 = $clog2(TOTAL_V);
    const PIXEL_COUNT_BITS: u32 = $clog2(SCREEN_WIDTH);
    const MULTIPLIER_H_BITS: u32 = if MULTIPLIER_H <= 1 ? 1 : $clog2(MULTIPLIER_H);
    const MULTIPLIER_V_BITS: u32 = if MULTIPLIER_V <= 1 ? 1 : $clog2(MULTIPLIER_V);
    
    type pixel_count_t = logic<PIXEL_COUNT_BITS>;
    type h_count_t = logic<H_COUNT_BITS>;
    type v_count_t = logic<V_COUNT_BITS>;
    type multiplier_h_t = logic<MULTIPLIER_H_BITS>;
    type multiplier_v_t = logic<MULTIPLIER_V_BITS>;

    // State definitions
    enum state_t {
        SYNC,
        BACK,
        ACTIVE,
        FRONT,
    }
    
    // State variables
    var state_h: state_t;
    var state_v: state_t;
    
    // Counters
    var active_counter_h: pixel_count_t;
    var active_counter_v: pixel_count_t;
    var inactive_counter_h: h_count_t;
    var inactive_counter_v: v_count_t;

    // Multiplier counters
    var multiplier_h: multiplier_h_t;
    var multiplier_v: multiplier_v_t;
    
    // Pixel data and control
    var pixel_data_internal: logic<8>;
    var data_in_sync_reg: logic;
    var data_ready: logic;
    
    // Video timing control signals
    var advance_v: logic;
    var next_frame: logic;
    
    // Output registers for timing
    var data_enable: logic;
    var data_enable_reg: logic;
    var hsync_reg: logic;
    var vsync_reg: logic;
    
    var multiplier_buffer: logic<8>[SCREEN_WIDTH];
    var next_active_counter_h: pixel_count_t;
    var pixel_from_buffer: logic<8>;
    
    // RGB332 to RGB conversion function
    function rgb332_to_rgb(rgb332: input logic<8>) -> logic<PIXEL_BITS * 3> {
        let r3: logic<3> = rgb332[7:5];
        let g3: logic<3> = rgb332[4:2];
        let b2: logic<2> = rgb332[1:0];
        
        // Expand to full bit width
        let r_full: logic<PIXEL_BITS> = {r3, r3, r3[msb:msb-1]};
        let g_full: logic<PIXEL_BITS> = {g3, g3, g3[msb:msb-1]};
        let b_full: logic<PIXEL_BITS> = {b2, b2, b2, b2};
        
        return {r_full, g_full, b_full};
    }
    
    // Combinational logic
    always_comb {
        // Default values
        advance_v = 1'b0;
        next_frame = 1'b0;
        data_ready = 1'b0;
        
        // Data ready when we need new pixel data:
        // - In active area (both H and V)
        // - First line of vertical multiplication (multiplier_v == 0) 
        // - First pixel of horizontal multiplication (multiplier_h == 0)
        // - Not start of frame (unless we want to accept start of frame)
        if (state_h == state_t::ACTIVE) && (state_v == state_t::ACTIVE) && (multiplier_v == '0) && (multiplier_h == '0) {
            data_ready = 1'b1;
        }

        // Calculate next horizontal counter for buffer read
        if active_counter_h == (SCREEN_WIDTH - 1) as pixel_count_t {
            next_active_counter_h = '0;
        } else {
            next_active_counter_h = active_counter_h + 1;
        }
        
        // Data enable generation
        data_enable = (state_h == state_t::ACTIVE) && (state_v == state_t::ACTIVE);
        
        // Advance vertical state machine when horizontal front porch ends
        if (state_h == state_t::FRONT) && (inactive_counter_h == (FRONT_PORCH_H - 1) as h_count_t) {
            advance_v = 1'b1;
        }
        
        // Signal next frame when vertical front porch ends
        if (state_v == state_t::FRONT) && advance_v && (inactive_counter_v == (FRONT_PORCH_V - 1) as v_count_t) {
            next_frame = 1'b1;
        }
    }
    
    // Sequential logic
    always_ff (r#clock, r#reset) {
        if_reset {
            // Initialize state machines
            state_h = state_t::SYNC;
            state_v = state_t::SYNC;
            
            // Initialize counters
            active_counter_h = '0;
            active_counter_v = '0;
            inactive_counter_h = '0;
            inactive_counter_v = '0;
            multiplier_h = '0;
            multiplier_v = '0;
            
            // Initialize data
            pixel_data_internal = '0;
            data_in_sync_reg = 1'b0;
                        
            // Initialize output registers
            data_enable_reg = 1'b0;
            hsync_reg = 1'b1;  // Idle high
            vsync_reg = 1'b1;  // Idle high
            pixel_from_buffer = '0;
        } else {
            // Buffer pixel data for next clock cycle
            // Calculate input pixel index for next cycle
            pixel_from_buffer = multiplier_buffer[next_active_counter_h];
            
            // Horizontal state machine
            case state_h {
                state_t::SYNC: {
                    inactive_counter_h = inactive_counter_h + 1;
                    if inactive_counter_h == (PULSE_WIDTH_H - 1) as h_count_t {
                        state_h = state_t::BACK;
                        inactive_counter_h = '0;
                    }
                    multiplier_h = '0;  // Reset multiplier counter
                }
                
                state_t::BACK: {
                    inactive_counter_h = inactive_counter_h + 1;
                    if inactive_counter_h == (BACK_PORCH_H - 1) as h_count_t {
                        state_h = state_t::ACTIVE;
                        inactive_counter_h = '0;
                    }
                }
                
                state_t::ACTIVE: {
                    active_counter_h = active_counter_h + 1;
                    if active_counter_h == (SCREEN_WIDTH - 1) as pixel_count_t {
                        state_h = state_t::FRONT;
                        active_counter_h = '0;
                    }
                    
                    // Active area pixel handling
                    if state_v == state_t::ACTIVE {
                        if multiplier_v == '0 {  // First line of vertical multiplication
                            // Update horizontal multiplier counter
                            multiplier_h = multiplier_h + 1;
                            if multiplier_h == (MULTIPLIER_H - 1) as multiplier_h_t {
                                multiplier_h = '0;
                            }
                            
                            if multiplier_h == '0 {  // First pixel of horizontal multiplication
                                let pixel_data_rgb332: logic<8> = if data.tvalid && data_ready ? data.tdata[7:0] : '0;
                                if data_ready {
                                    data_in_sync_reg = data.tvalid;  // Data stream is in sync if we're ready and valid
                                }
                                // Store in buffer at input pixel position
                                multiplier_buffer[active_counter_h] = pixel_data_rgb332;
                                pixel_data_internal = pixel_data_rgb332;
                            } else {  // Not first pixel of horizontal multiplication
                                // Reuse the same pixel data from buffer
                                multiplier_buffer[active_counter_h] = pixel_data_internal;
                            }
                        } else {  // Vertical multiplication - load from buffer
                            pixel_data_internal = pixel_from_buffer;
                        }
                    }
                }
                
                state_t::FRONT: {
                    inactive_counter_h = inactive_counter_h + 1;
                    if inactive_counter_h == (FRONT_PORCH_H - 1) as h_count_t {
                        state_h = state_t::SYNC;
                        inactive_counter_h = '0;
                        // advance_v is now computed combinationally
                    }
                }
            }
            
            // Vertical state machine
            case state_v {
                state_t::SYNC: {
                    if advance_v {
                        inactive_counter_v = inactive_counter_v + 1;
                        if inactive_counter_v == (PULSE_WIDTH_V - 1) as v_count_t {
                            state_v = state_t::BACK;
                            inactive_counter_v = '0;
                        }
                        multiplier_v = '0;  // Reset multiplier
                    }
                }
                
                state_t::BACK: {
                    if advance_v {
                        inactive_counter_v = inactive_counter_v + 1;
                        if inactive_counter_v == (BACK_PORCH_V - 1) as v_count_t {
                            state_v = state_t::ACTIVE;
                            inactive_counter_v = '0;
                        }
                    }
                }
                
                state_t::ACTIVE: {
                    if advance_v {
                        active_counter_v = active_counter_v + 1;
                        if active_counter_v == (SCREEN_HEIGHT - 1) as pixel_count_t {
                            state_v = state_t::FRONT;
                            active_counter_v = '0;
                        }
                        
                        multiplier_v = multiplier_v + 1;
                        if multiplier_v == (MULTIPLIER_V - 1) as multiplier_v_t {
                            multiplier_v = '0;
                        }
                    }
                }
                
                state_t::FRONT: {
                    if advance_v {
                        inactive_counter_v = inactive_counter_v + 1;
                        if inactive_counter_v == (FRONT_PORCH_V - 1) as v_count_t {
                            state_v = state_t::SYNC;
                            inactive_counter_v = '0;
                            // next_frame is now computed combinationally
                        }
                    }
                }
            }
            
            // Register output timing signals
            data_enable_reg = data_enable;
            hsync_reg = state_h == state_t::SYNC;
            vsync_reg = state_v == state_t::SYNC;
        }
    }
    
    // Output assignments
    assign video.hsync = hsync_reg;
    assign video.vsync = vsync_reg;
    assign video.data_enable = data_enable_reg;
    assign video.pixel_data = if data_enable_reg ? rgb332_to_rgb(pixel_data_internal) : '0;
    
    assign data_in_sync = data_in_sync_reg;
    assign data.tready = data_ready;
}