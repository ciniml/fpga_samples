/**
 * @file tb_display_controller.veryl
 * @brief Test bench for display controller module.
 */

include (inline, "tb_display_controller_body.svh");

// Test case: Version command
module tb_display_controller_version() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "version",
        SCREEN_WIDTH: 320,
        SCREEN_HEIGHT: 240,
        VALID_RATE: 10,
        TIMEOUT_CYCLES: 1000
    ) ();
}

// Test case: Fill rectangle command
module tb_display_controller_fill_rect() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "fill_rect",
        SCREEN_WIDTH: 320,
        SCREEN_HEIGHT: 240,
        VALID_RATE: 8,
        TIMEOUT_CYCLES: 2000
    ) ();
}

// Test case: Write pixel command
module tb_display_controller_write_pixel() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "write_pixel",
        SCREEN_WIDTH: 320,
        SCREEN_HEIGHT: 240,
        VALID_RATE: 9,
        TIMEOUT_CYCLES: 1500
    ) ();
}

// Test case: Multiple commands
module tb_display_controller_multiple_commands() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "multiple_commands",
        SCREEN_WIDTH: 320,
        SCREEN_HEIGHT: 240,
        VALID_RATE: 7,
        TIMEOUT_CYCLES: 3000
    ) ();
}

// Default test case
module tb_display_controller_default() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "version",
        SCREEN_WIDTH: 320,
        SCREEN_HEIGHT: 240,
        VALID_RATE: 8,
        TIMEOUT_CYCLES: 1000
    ) ();
}

// Test case: Write raw pixel data
module tb_display_controller_write_raw() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "write_raw",
        SCREEN_WIDTH: 320,
        SCREEN_HEIGHT: 240,
        VALID_RATE: 8,
        TIMEOUT_CYCLES: 2000
    ) ();
}

// Test case with different screen size
module tb_display_controller_small_screen() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "fill_rect",
        SCREEN_WIDTH: 64,
        SCREEN_HEIGHT: 48,
        VALID_RATE: 8,
        TIMEOUT_CYCLES: 2000
    ) ();
}