/**
 * @file tb_video_signal_generator.veryl
 * @brief Test bench for video signal generator module.
 */

include (inline, "tb_video_signal_generator_body.svh");

// Test case: Basic timing without pixel data
module tb_video_signal_generator_basic_timing() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "basic_timing", 
        SCREEN_WIDTH: 320, 
        SCREEN_HEIGHT: 240,
        PIXEL_BITS: 8,
        READY_RATE: 10, 
        TIMEOUT_CYCLES: 50000
    ) ();
}

// Test case: Data synchronization behavior
module tb_video_signal_generator_sync_behavior() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "frame_timing", 
        SCREEN_WIDTH: 16, 
        SCREEN_HEIGHT: 2,
        PIXEL_BITS: 8,
        READY_RATE: 7, 
        TIMEOUT_CYCLES: 320*2*20*2
    ) ();
}

// Test case: Complete frame timing
module tb_video_signal_generator_frame_timing() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "frame_timing", 
        SCREEN_WIDTH: 64, 
        SCREEN_HEIGHT: 48,
        PIXEL_BITS: 8,
        READY_RATE: 9, 
        TIMEOUT_CYCLES: 100000
    ) ();
}

// Test case: Multiplier functionality (2x horizontal, 2x vertical)
module tb_video_signal_generator_multiplier_2x2() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "frame_timing", 
        SCREEN_WIDTH: 16, 
        SCREEN_HEIGHT: 12,
        PIXEL_BITS: 8,
        MULTIPLIER_H: 2,
        MULTIPLIER_V: 2,
        READY_RATE: 8, 
        TIMEOUT_CYCLES: 50000
    ) ();
}

// Test case: Horizontal multiplier only (debug version)
module tb_video_signal_generator_multiplier_h3() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "frame_timing", 
        SCREEN_WIDTH: 12, 
        SCREEN_HEIGHT: 2,
        PIXEL_BITS: 8,
        MULTIPLIER_H: 3,
        MULTIPLIER_V: 1,
        READY_RATE: 8, 
        TIMEOUT_CYCLES: 15000
    ) ();
}

// Test case: TUSER skip functionality
module tb_video_signal_generator_tuser_skip() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "tuser_skip_test",
        SCREEN_WIDTH: 8,
        SCREEN_HEIGHT: 4,
        PIXEL_BITS: 8,
        READY_RATE: 8,
        TIMEOUT_CYCLES: 20000
    ) ();
}

// Default test case
module tb_video_signal_generator_default() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "basic_timing",
        SCREEN_WIDTH: 320,
        SCREEN_HEIGHT: 240,
        PIXEL_BITS: 8,
        READY_RATE: 8,
        TIMEOUT_CYCLES: 50000
    ) ();
}