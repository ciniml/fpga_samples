/**
 * @file tb_vram_writer.veryl
 * @brief Test bench for VRAM writer module.
 */

include (inline, "tb_vram_writer_body.svh");

// Test case: Single pixel write
module tb_vram_writer_single_pixel() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "single_pixel", 
        SCREEN_WIDTH: 320, 
        SCREEN_HEIGHT: 240,
        VALID_RATE: 10, 
        TIMEOUT_CYCLES: 1000
    ) ();
}

// Test case: Single line write
module tb_vram_writer_single_line() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "single_line", 
        SCREEN_WIDTH: 320, 
        SCREEN_HEIGHT: 240,
        VALID_RATE: 8, 
        TIMEOUT_CYCLES: 2000
    ) ();
}

// Test case: Rectangle write
module tb_vram_writer_rectangle() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "rectangle", 
        SCREEN_WIDTH: 320, 
        SCREEN_HEIGHT: 240,
        VALID_RATE: 7, 
        TIMEOUT_CYCLES: 3000
    ) ();
}

// Test case: Multiple commands
module tb_vram_writer_multiple_commands() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "multiple_commands", 
        SCREEN_WIDTH: 320, 
        SCREEN_HEIGHT: 240,
        VALID_RATE: 9, 
        TIMEOUT_CYCLES: 5000
    ) ();
}

// Default test case
module tb_vram_writer_default() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "single_pixel", 
        SCREEN_WIDTH: 320, 
        SCREEN_HEIGHT: 240,
        VALID_RATE: 8, 
        TIMEOUT_CYCLES: 1000
    ) ();
}

// Test case with different screen size
module tb_vram_writer_small_screen() {
    inst tb_inst: $sv::tb #(
        TEST_MODE: "rectangle", 
        SCREEN_WIDTH: 64, 
        SCREEN_HEIGHT: 48,
        VALID_RATE: 8, 
        TIMEOUT_CYCLES: 2000
    ) ();
}