// SPIマスターモジュール
pub module spi_master::<synchronizer_m: $std::synchronizer, SPI_WIDTH: u32 = 8> (
    r#clock: input clock,      // システムクロック
    r#reset: input reset,      // システムリセット

    spi_cs:    output           logic,  // SPIチップセレクト出力
    spi_sck:   output           logic,  // SPIクロック出力
    spi_miso:  input    'spi    logic,  // SPIデータ入力（スレーブからマスターへ）
    spi_mosi:  output           logic,  // SPIデータ出力（マスターからスレーブへ）

    axis_receive: modport axi4s::axi4s_if::<SPI_WIDTH, false, 1>::master,  // 受信データストリーム
    axis_send: modport axi4s::axi4s_if::<SPI_WIDTH, true, 0>::slave,       // 送信データストリーム
) {
    type spi_word_t = logic<SPI_WIDTH>;  // SPIワード型定義

    enum state_t {               // ステートマシンの状態定義
        RESET,                   // リセット状態
        IDLE,                    // アイドル状態
        ASSERT_CS,               // チップセレクトアサート状態
        TRANSFER,                // データ転送状態
        PAUSE,                   // 一時停止状態
        WAIT_LAST_BIT_SYNC_1,    // 最後のビット同期待ち状態1
        WAIT_LAST_BIT_SYNC_2,    // 最後のビット同期待ち状態2
    }

    var state: state_t;              // 現在の状態
    var spi_out_data: spi_word_t;    // 送信データレジスタ
    var spi_out_last: logic;         // 最後のデータフラグ
    var spi_in_data: spi_word_t;     // 受信データレジスタ
    var spi_counter: spi_word_t;     // ビットカウンター
    var spi_miso_sync: logic;        // 同期化されたMISO信号

    var receive_in_frame: logic;       // フレーム内受信フラグ
    var receive_first: logic;          // 最初の受信データフラグ
    var receive_valid: logic;          // 受信データ有効フラグ
    var receive_data: spi_word_t;      // 受信データ

    unsafe(cdc) {  // クロックドメイン跨ぎの同期化処理
        inst spi_miso_sync_inst: synchronizer_m #(WIDTH: 1, STAGES: 2) (i_clk: r#clock, i_rst: r#reset, i_d: spi_miso, o_d: spi_miso_sync);
    }

    always_comb {  // 組み合わせロジック
        axis_receive.tvalid = receive_valid;    // 受信データ有効信号
        axis_receive.tdata = receive_data;      // 受信データ
        axis_receive.tuser[0] = receive_first;  // フレーム開始フラグ
        axis_receive.tlast = 0;                 // 常に0（未使用）
        case state {  // 状態に応じたtreadyの制御
            state_t::IDLE: {        // アイドル状態
                axis_send.tready = 1;  // 送信データを受け付け可能
            }
            state_t::TRANSFER: {    // 転送状態
                axis_send.tready = spi_sck && spi_counter[0] && !spi_out_last;  // 条件が整った時のみ受け付け
            }
            state_t::PAUSE: {       // 一時停止状態
                axis_send.tready = 1;  // 送信データを受け付け可能
            }
            default: {              // その他の状態
                axis_send.tready = 0;  // 送信データを受け付けない
            }
        }

        spi_mosi = spi_out_data[msb];  // 送信データのMSBをMOSIに出力
    }

    always_ff(r#clock, r#reset) {
        if_reset {
            state = state_t::RESET;
            spi_cs = true;
            spi_sck = 0;
            spi_in_data = '0;
            spi_out_data = '0;
            spi_out_last = 0;
            spi_counter[msb] = 1'b1;
            spi_counter[msb-1:0] = '0;

            receive_valid = 0;
            receive_data = '0;
            receive_first = 1;
            receive_in_frame = 0;
        } else {
            if receive_valid && axis_receive.tready {
                receive_valid = 0;
                receive_first = 0;
            }

            case state {
                state_t::RESET: {
                    state = state_t::IDLE;
                }
                state_t::IDLE: {
                    spi_counter = {1'b1, 1'b0 repeat (SPI_WIDTH - 1)};
                    if axis_send.tvalid {
                        spi_out_data = axis_send.tdata;
                        spi_out_last = axis_send.tlast;
                        spi_cs = false;
                        receive_first = 1;
                        receive_in_frame = 0;
                        state = state_t::ASSERT_CS;
                    }
                }
                state_t::ASSERT_CS: {
                    state = state_t::TRANSFER;
                }
                state_t::TRANSFER: {
                    spi_sck = !spi_sck;
                    if( !spi_sck ) {    // rising edge. sample MISO.
                        spi_in_data = {spi_in_data[msb-1:0], spi_miso_sync};
                        if spi_counter[msb-1] {
                            if receive_in_frame {   // check if in-frame
                                receive_valid = 1;
                                if !receive_valid || !axis_receive.tready {
                                    receive_data = spi_in_data;
                                }
                            }
                            receive_in_frame = 1;   // mark as in-frame.
                        }
                    } else {    // falling edge. update MOSI
                        spi_counter = {spi_counter[0], spi_counter[msb:1]};
                        spi_out_data = {spi_out_data[msb-1:0], 1'b0};
                        if spi_counter[0] {
                            if spi_out_last {
                                // End of transmission.
                                state = state_t::WAIT_LAST_BIT_SYNC_1;
                            } else if axis_send.tvalid {
                                // Send next word.
                                spi_out_data = axis_send.tdata;
                                spi_out_last = axis_send.tlast;
                            } else {
                                // No data to send. Pause transmission.
                                state = state_t::PAUSE;
                            }
                        }
                    }
                }
                state_t::PAUSE: {
                    if axis_send.tvalid {
                        spi_out_data = axis_send.tdata;
                        spi_out_last = axis_send.tlast;
                        state = state_t::TRANSFER;
                    }
                }
                state_t::WAIT_LAST_BIT_SYNC_1: { // Wait for the last MISO bit (1)
                    spi_cs = 1;
                    spi_in_data = {spi_in_data[msb-1:0], spi_miso_sync};
                    state = state_t::WAIT_LAST_BIT_SYNC_2;
                }
                state_t::WAIT_LAST_BIT_SYNC_2: { // Wait for the last MISO bit (2)
                    receive_valid = 1;
                    if !receive_valid || !axis_receive.tready {
                        receive_data = spi_in_data;
                    }
                    state = state_t::IDLE;
                }
                default: {
                    state = state_t::IDLE;
                }
            }
        }
    }
}