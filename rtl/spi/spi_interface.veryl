/**
 * @file spi_interface.veryl
 * @brief SPIインターフェース定義
 */

pub interface spi_interface {
    var miso: logic;
    var mosi: logic;
    var cs:  '_ reset;
    var sck: '_ clock;

    modport master {
        miso: input,
        mosi: output,
        cs:   output,
        sck:  output,
    }

    modport slave {
        miso: output,
        mosi: input,
        cs:   input,
        sck:  input,
    }
}