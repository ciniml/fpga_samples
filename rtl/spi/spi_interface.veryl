/**
 * @file spi_interface.veryl
 * @brief SPIインターフェース定義
 */

pub interface spi_interface {
    var miso: logic;        // Master In Slave Out信号
    var mosi: logic;        // Master Out Slave In信号
    var cs:  '_ reset;      // チップセレクト信号（アクティブLow）
    var sck: '_ clock;      // SPIクロック信号

    modport master {        // マスター側のポート定義
        miso: input,        // MISOを入力として使用
        mosi: output,       // MOSIを出力として使用
        cs:   output,       // CSを出力として使用
        sck:  output,       // SCKを出力として使用
    }

    modport slave {         // スレーブ側のポート定義
        miso: output,       // MISOを出力として使用
        mosi: input,        // MOSIを入力として使用
        cs:   input,        // CSを入力として使用
        sck:  input,        // SCKを入力として使用
    }
}