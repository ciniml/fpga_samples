/**
 * @file tb_spi_master.veryl
 * @brief Test bench for SPI master module.
 */


include (inline, "tb_spi_master_body.svh");

module spi_master_dut (
  r#clock: input clock,
  r#reset: input reset,

  spi_cs:    output      logic,
  spi_sck:   output      logic,
  spi_miso:  input  'spi logic,
  spi_mosi:  output      logic,

  axis_receive_tvalid:  output logic,
  axis_receive_tready:  input  logic,
  axis_receive_tdata:   output logic<8>,
  axis_receive_tuser:   output logic,

  axis_send_tvalid:     input  logic,
  axis_send_tready:     output logic,
  axis_send_tdata:      input  logic<8>,
  axis_send_tlast:      input  logic,
){

  inst axis_receive: axi4s::axi4s_if::<8, false, 1>;
  inst axis_send:    axi4s::axi4s_if::<8, true, 0>;
  always_comb {
    axis_receive_tvalid = axis_receive.tvalid;
    axis_receive.tready = axis_receive_tready;
    axis_receive_tdata  = axis_receive.tdata;
    axis_receive_tuser  = axis_receive.tuser[0];

    axis_send.tvalid = axis_send_tvalid;
    axis_send_tready = axis_send.tready;
    axis_send.tdata  = axis_send_tdata;
    axis_send.tlast  = axis_send_tlast;
  }
  inst spi_master_inst: spi_master::<sync::gen_synchronizer, 8> (
    r#clock,
    r#reset,
    spi_cs,
    spi_sck,
    spi_miso,
    spi_mosi,
    axis_receive,
    axis_send,
  );
}

// Test case: Single byte frame
module tb_single_frame() {
    inst tb_inst: $sv::tb #(TEST_MODE: "single_frame", VALID_RATE: 10, READY_RATE: 10, TIMEOUT_CYCLES: 500) ();
}

// Test case: Multi-byte frame
module tb_multi_byte_frame() {
    inst tb_inst: $sv::tb #(TEST_MODE: "multi_byte_frame", VALID_RATE: 8, READY_RATE: 8, TIMEOUT_CYCLES: 1000) ();
}

// Test case: Multiple frames
module tb_multiple_frames() {
    inst tb_inst: $sv::tb #(TEST_MODE: "multiple_frames", VALID_RATE: 9, READY_RATE: 7, TIMEOUT_CYCLES: 1500) ();
}

// Default test case (single frame)
module tb_default() {
    inst tb_inst: $sv::tb #(TEST_MODE: "single_frame", VALID_RATE: 8, READY_RATE: 8, TIMEOUT_CYCLES: 500) ();
}
