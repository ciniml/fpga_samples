/**
 * @file tb_spi_slave.veryl
 * @brief Test bench for SPI slave module.
 */


include (inline, "tb_spi_slave_body.svh");

module tb_spi_slave_dut (
  r#clock: input clock,
  r#reset: input reset,

  spi_cs:    input  'spi_pos reset_async_high,
  spi_sck:   input  'spi_pos clock,
  spi_miso:  output 'spi_neg logic,
  spi_mosi:  input  'spi_pos logic,

  axis_receive_tvalid:  output logic,
  axis_receive_tready:  input  logic,
  axis_receive_tdata:   output logic<8>,
  axis_receive_tuser:   output logic,

  axis_send_tvalid:     input  logic,
  axis_send_tready:     output logic,
  axis_send_tdata:      input  logic<8>,
){

  inst axis_receive_slave: axi4s::axi4s_if::<8, false, 1>;
  inst axis_send_slave:    axi4s::axi4s_if::<8, false, 1>;
  always_comb {
    axis_receive_tvalid = axis_receive_slave.tvalid;
    axis_receive_slave.tready = axis_receive_tready;
    axis_receive_tdata  = axis_receive_slave.tdata;
    axis_receive_tuser  = axis_receive_slave.tuser[0];

    axis_send_slave.tvalid = axis_send_tvalid;
    axis_send_tready = axis_send_slave.tready;
    axis_send_slave.tdata  = axis_send_tdata;
  }
  inst spi_slave_inst_tb: spi_slave::<sync::gen_synchronizer, 8> (
    r#clock,
    r#reset,
    spi_cs,
    spi_sck,
    spi_miso,
    spi_mosi,
    axis_receive: axis_receive_slave,
    axis_send: axis_send_slave,
  );
}

// Test case: Single byte frame
module tb_slave_single_frame() {
    inst tb_slave_inst: $sv::tb #(TEST_MODE: "single_frame", VALID_RATE: 10, READY_RATE: 10, TIMEOUT_CYCLES: 2000) ();
}

// Test case: Multi-byte frame
module tb_slave_multi_byte_frame() {
    inst tb_slave_inst: $sv::tb #(TEST_MODE: "multi_byte_frame", VALID_RATE: 8, READY_RATE: 8, TIMEOUT_CYCLES: 3000) ();
}

// Test case: Multiple frames
module tb_slave_multiple_frames() {
    inst tb_slave_inst: $sv::tb #(TEST_MODE: "multiple_frames", VALID_RATE: 9, READY_RATE: 7) ();
}

// Default test case (single frame)
module tb_slave_default() {
    inst tb_slave_inst: $sv::tb #(TEST_MODE: "single_frame", VALID_RATE: 8, READY_RATE: 8, TIMEOUT_CYCLES: 2000) ();
}

// Test cases with different SPI frequencies near main clock (100MHz)
// Test case: 50MHz SPI clock (half_period=10ns, phase_offset=2ns)
module tb_slave_multiple_frames_50mhz() {
    inst tb_slave_inst: $sv::tb #(
        TEST_MODE: "multiple_frames", 
        VALID_RATE: 9, 
        READY_RATE: 7, 
        SPI_CLK_HALF_PERIOD_NS: 10,    // 50MHz SPI clock
        SPI_CLK_PHASE_OFFSET_NS: 2,    // 2ns phase offset
        CS_ASSERT_AFTER_WAIT_NS: 30,   // Shorter timing for fast clock
        CS_DEASSERT_BEFORE_WAIT_NS: 30,
        INTER_TRANSACTION_DELAY_NS: 80
    ) ();
}

module tb_slave_multiple_frames_100mhz() {
    inst tb_slave_inst: $sv::tb #(
        TEST_MODE: "multiple_frames", 
        VALID_RATE: 9, 
        READY_RATE: 7, 
        SPI_CLK_HALF_PERIOD_NS: 5,     // 100MHz SPI clock
        SPI_CLK_PHASE_OFFSET_NS: 0,    // 0ns phase offset
        CS_ASSERT_AFTER_WAIT_NS: 30,   // Shorter timing for fast clock
        CS_DEASSERT_BEFORE_WAIT_NS: 30,
        INTER_TRANSACTION_DELAY_NS: 80
    ) ();
}

module tb_slave_multiple_frames_100mhz_90() {
    inst tb_slave_inst: $sv::tb #(
        TEST_MODE: "multiple_frames", 
        VALID_RATE: 9, 
        READY_RATE: 7, 
        SPI_CLK_HALF_PERIOD_NS: 5,     // 100MHz SPI clock
        SPI_CLK_PHASE_OFFSET_NS: 2,    // 2ns phase offset (<90°)
        CS_ASSERT_AFTER_WAIT_NS: 30,   // Shorter timing for fast clock
        CS_DEASSERT_BEFORE_WAIT_NS: 30,
        INTER_TRANSACTION_DELAY_NS: 80
    ) ();
}


module tb_slave_multiple_frames_100mhz_180() {
    inst tb_slave_inst: $sv::tb #(
        TEST_MODE: "multiple_frames", 
        VALID_RATE: 9, 
        READY_RATE: 7, 
        SPI_CLK_HALF_PERIOD_NS: 5,     // 100MHz SPI clock
        SPI_CLK_PHASE_OFFSET_NS: 5,    // 5ns phase offset (180°)
        CS_ASSERT_AFTER_WAIT_NS: 30,   // Shorter timing for fast clock
        CS_DEASSERT_BEFORE_WAIT_NS: 30,
        INTER_TRANSACTION_DELAY_NS: 80
    ) ();
}

// Test case: 33MHz SPI clock (half_period=15ns, phase_offset=3ns)
module tb_slave_multiple_frames_33mhz() {
    inst tb_slave_inst: $sv::tb #(
        TEST_MODE: "multiple_frames", 
        VALID_RATE: 9, 
        READY_RATE: 7, 
        SPI_CLK_HALF_PERIOD_NS: 15,    // 33MHz SPI clock
        SPI_CLK_PHASE_OFFSET_NS: 3,    // 3ns phase offset
        CS_ASSERT_AFTER_WAIT_NS: 40,   
        CS_DEASSERT_BEFORE_WAIT_NS: 40,
        INTER_TRANSACTION_DELAY_NS: 90
    ) ();
}

// Test case: 25MHz SPI clock (half_period=20ns, phase_offset=1ns)
module tb_slave_multiple_frames_25mhz() {
    inst tb_slave_inst: $sv::tb #(
        TEST_MODE: "multiple_frames", 
        VALID_RATE: 9, 
        READY_RATE: 7, 
        SPI_CLK_HALF_PERIOD_NS: 20,    // 25MHz SPI clock
        SPI_CLK_PHASE_OFFSET_NS: 1,    // 1ns phase offset
        CS_ASSERT_AFTER_WAIT_NS: 45,   
        CS_DEASSERT_BEFORE_WAIT_NS: 45,
        INTER_TRANSACTION_DELAY_NS: 95
    ) ();
}

// Test case: 20MHz SPI clock (half_period=25ns, phase_offset=4ns) - original default
module tb_slave_multiple_frames_20mhz() {
    inst tb_slave_inst: $sv::tb #(
        TEST_MODE: "multiple_frames", 
        VALID_RATE: 9, 
        READY_RATE: 7, 
        SPI_CLK_HALF_PERIOD_NS: 25,    // 20MHz SPI clock (original default)
        SPI_CLK_PHASE_OFFSET_NS: 4,    // 4ns phase offset
        CS_ASSERT_AFTER_WAIT_NS: 50,   // Original timing
        CS_DEASSERT_BEFORE_WAIT_NS: 50,
        INTER_TRANSACTION_DELAY_NS: 100
    ) ();
}