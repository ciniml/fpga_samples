/**
 * @file la_front.veryl
 * @brief Sample selection of one group of 8 channels: 8 samples per clock
 *        (800 MS/s at 100 MHz) in, the samples to keep out as an AXI4-Stream
 *        (tkeep = how many, at the bottom lanes: 8, 4, 2 or 1).
 *
 * Clock modes (cfg cmode):
 *   0 internal: every div-th sample (800 MHz / div). div 1 / 2 / 4 take 8 /
 *     4 / 2 samples of each word at fixed places, div >= 8 at most one
 *   1 / 2 / 3 : the clock input's rising / falling / both edges, seen in its
 *               own 800 MS/s samples; the data sample taken is the one
 *               `skew` samples before the first sample with the new level.
 *               At most one edge per word (10 ns): up to 100 MHz on one edge,
 *               50 MHz on both
 * Anything else (div 3, 5, 6, 7, or two edges in a word) ends the capture
 * with END flag bit 1. Keeping the number of samples per word a divisor of 8
 * keeps the selection and LaPacker's gathering small.
 *
 * Test mode (cfg test): the channels are a PRBS instead of the pins (PRBS15,
 * or PRBS17 with PRBS17 = 1; restarted at each capture) and the clock input
 * is a square wave of half period thalf = 2^h samples (the highest power of
 * two in i_thalf), low first: sample k of it is bit h of k.
 *
 * A capture (i_go) sends a START beat, then data beats, and on i_stop (or an
 * overflow: a data beat while the previous one still waits for tready, the
 * stream cannot be held) an END beat with the flags. Sample positions count
 * from the first word after i_go (word 0, history only); samples from
 * position 8 on are taken: the internal clock's first one is sample 8, with
 * an edge clock the first edge at or after 8 + skew.
 *
 * Pipeline: the word of a clock (A) is selected from one clock later (P),
 * when the clock samples after it are known: an edge at P's sample n + skew
 * takes sample n.
 *
 * cfg = {ck_sel (8, used outside), skew (7:5), test (4), cmode (3:2), wlog (1:0)}
 */
module LaFront #(
    param PRBS17: bit = 1'b0,
) (
    i_clk   : input  clock    ,
    i_rst   : input  reset    ,
    i_raw   : input  logic<64>, // pin samples, sample i in [8i+7:8i]
    i_ck    : input  logic<8> , // clock input samples, sample i in bit i
    i_cfg   : input  logic<9> ,
    i_div   : input  logic<24>, // internal clock divider (0 = 1)
    i_thalf : input  logic<16>, // test clock half period (power of two)
    i_capid : input  logic<8> ,
    i_go    : input  logic    , // start a capture (the packer is idle)
    i_stop  : input  logic    ,
    o_tvalid: output logic    ,
    o_tdata : output logic<64>,
    o_tkeep : output logic<8> ,
    o_tuser : output logic<2> , // la_pkg::U_*
    i_tready: input  logic    ,
    o_idle  : output logic    ,
    o_run   : output logic    ,
    o_ovf   : output logic    , // the last capture ended in an overflow
) {
    import la_pkg::*;

    enum State: logic<2> {
        Idle,
        Run,
        End,
    }
    var state: State;

    var cmode: logic<2> ;
    var test : logic    ;
    var skew : logic<3> ;
    var div  : logic<24>;
    var fdiv : logic<3> ; // div 1 / 2 / 4 (one-hot), 0: div >= 8
    var th   : logic<4> ; // test clock half period 2^th
    var capid: logic<8> ;
    var ovf  : logic    ;
    var bad  : logic    ; // unsupported timing
    var esent: logic    ; // END beat loaded

    // ---- generator: the word of this clock (pins or test pattern)
    var prbs: logic<17>;
    var wc  : logic<16>; // word count (test clock)
    var w0  : logic    ; // next word is word 0
    var tc  : logic<8> ; // test clock: bit th of the sample position
    always_comb {
        for i in 0..8 {
            var ii   : logic<3>;
            ii    = i;
            tc[i] = if th <: 4'd3 ? ii[th[1:0]] : wc[th - 4'd3];
        }
    }
    let gword: logic<64> = if PRBS17 ? prbs17_word(prbs) : prbs15_word(prbs[14:0]);

    // ---- A: the word of the clock; P: the word before it (the one selected from)
    var a_v    : logic    ;
    var a_first: logic    ;
    var a_data : logic<64>;
    var a_ck   : logic<8> ;
    var p_v    : logic    ;
    var p_first: logic    ;
    var p_data : logic<64>;
    var p_ck   : logic<8> ;
    var pp7    : logic    ; // the clock sample before P's first

    // one sample per word: the internal clock's next sample (rem samples ahead), or the edge
    var rem : logic<24>;
    let tk  : logic<8>  = if rem <: 24'd8 ? (8'd1 << rem[2:0]) : 8'd0;
    let cw  : logic<17> = {a_ck, p_ck, pp7};
    let rise: logic<16> = cw[16:1] & ~cw[15:0];
    let fall: logic<16> = ~cw[16:1] & cw[15:0];
    let edg : logic<16> = case cmode {
        2'd1   : rise,
        2'd2   : fall,
        default: rise | fall,
    };
    let m1   : logic<8> = if cmode == 0 ? tk : edg[skew+:8];
    let multi: logic    = (m1 & (m1 - 8'd1)) != 0; // more than one
    var s1   : logic<8>; // the sample m1 selects
    always_comb {
        s1 = 0;
        for i in 0..8 {
            if m1[i] {
                s1 = s1 | p_data[i * 8+:8];
            }
        }
    }
    // fixed decimation: div 2 / 4
    var d2: logic<64>;
    var d4: logic<64>;
    always_comb {
        d2 = 0;
        d4 = 0;
        for i in 0..4 {
            d2[i * 8+:8] = p_data[i * 16+:8];
        }
        for i in 0..2 {
            d4[i * 8+:8] = p_data[i * 32+:8];
        }
    }

    let out_free: logic = !o_tvalid || i_tready;
    assign o_idle = state == State::Idle && !o_tvalid;
    assign o_run  = state == State::Run;
    assign o_ovf  = ovf;

    always_ff {
        if_reset {
            state    = State::Idle;
            cmode    = 0;
            test     = 0;
            skew     = 0;
            div      = 1;
            fdiv     = 0;
            th       = 0;
            capid    = 0;
            ovf      = 0;
            bad      = 0;
            esent    = 0;
            rem      = 0;
            prbs     = '1;
            wc       = 0;
            w0       = 0;
            a_v      = 0;
            a_first  = 0;
            a_data   = 0;
            a_ck     = 0;
            p_v      = 0;
            p_first  = 0;
            p_data   = 0;
            p_ck     = 0;
            pp7      = 0;
            o_tvalid = 0;
            o_tdata  = 0;
            o_tkeep  = 0;
            o_tuser  = 0;
        } else {
            if o_tvalid && i_tready {
                o_tvalid = 0;
            }
            case state {
                State::Idle: {
                    a_v = 0;
                    p_v = 0;
                    if i_go {
                        var dv   : logic<24>;
                        dv    = if i_div == 0 ? 24'd1 : i_div;
                        cmode = i_cfg[3:2];
                        test  = i_cfg[4];
                        skew  = i_cfg[7:5];
                        div   = dv;
                        fdiv  = case dv {
                            24'd1  : 3'b001,
                            24'd2  : 3'b010,
                            24'd4  : 3'b100,
                            default: 3'b000,
                        };
                        // thalf: its highest power of two
                        th = 0;
                        for b in 1..16 {
                            if i_thalf[b] {
                                th = b;
                            }
                        }
                        capid    = i_capid;
                        ovf      = 0;
                        bad      = i_cfg[3:2] == 0 && dv <: 24'd8 && dv != 1 && dv != 2 && dv != 4;
                        esent    = 0;
                        rem      = 0;
                        prbs     = '1;
                        wc       = 0;
                        w0       = 1;
                        o_tvalid = 1;
                        o_tuser  = U_START;
                        o_tkeep  = 0;
                        o_tdata  = {HDR_START, 4'h0, i_capid, 8'h0, dv, 7'h0, i_cfg};
                        state    = if i_cfg[3:2] == 0 && dv <: 24'd8 && dv != 1 && dv != 2 && dv != 4 ?
                            State::End
                        :
                            State::Run
                        ;
                    }
                }
                State::Run: {
                    // generator -> A
                    a_v     = 1;
                    a_first = w0;
                    w0      = 0;
                    a_data  = if test ? gword : i_raw;
                    a_ck    = if test ? tc : i_ck;
                    prbs    = if PRBS17 ? prbs17_adv(prbs) : {2'b11, prbs15_adv(prbs[14:0])};
                    wc      = wc + 1;
                    // P: select (word 0 is history only), then A -> P
                    if a_v {
                        if p_v && !p_first {
                            var nk  : logic<4> ;
                            var lane: logic<64>;
                            nk   = 0;
                            lane = 0;
                            if cmode == 0 && fdiv != 0 {
                                nk = case fdiv {
                                    3'b001 : 4'd8,
                                    3'b010 : 4'd4,
                                    default: 4'd2,
                                };
                                lane = case fdiv {
                                    3'b001 : p_data,
                                    3'b010 : d2,
                                    default: d4,
                                };
                            } else {
                                if cmode == 0 {
                                    rem = if rem <: 24'd8 ? rem + div - 24'd8 : rem - 24'd8;
                                }
                                nk   = if m1 != 0 ? 4'd1 : 4'd0;
                                lane = {56'h0, s1};
                            }
                            if cmode != 0 && multi {
                                bad   = 1;
                                state = State::End;
                            } else if nk != 0 {
                                if out_free {
                                    o_tvalid = 1;
                                    o_tuser  = U_DATA;
                                    o_tdata  = lane;
                                    o_tkeep  = ((9'd1 << nk) - 9'd1) as 8;
                                } else {
                                    ovf   = 1; // samples lost: end here (the held beat still goes out)
                                    state = State::End;
                                }
                            }
                        }
                        p_v     = 1;
                        p_first = a_first;
                        p_data  = a_data;
                        p_ck    = a_ck;
                        pp7     = p_ck[7];
                    }
                    if i_stop {
                        state = State::End;
                    }
                }
                default: { // End
                    a_v = 0;
                    p_v = 0;
                    if !esent {
                        if out_free {
                            o_tvalid = 1;
                            o_tuser  = U_END;
                            o_tkeep  = 0;
                            o_tdata  = {HDR_END, 2'b0, bad, ovf, capid, 48'h0};
                            esent    = 1;
                        }
                    } else if out_free {
                        state = State::Idle;
                    }
                }
            }
        }
    }
}
