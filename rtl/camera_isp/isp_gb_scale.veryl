/**
 * @file isp_gb_scale.veryl
 * @brief RAW10 words (IspRaw10Unpack) -> 128x112 8-bit luma and RGB565 colour for a Game Boy Camera
 *        style cartridge.
 *
 * A window of 768x672 sensor pixels (words X0W.. of the row, rows Y0..) is cut into 6x6 blocks. The
 * R, G and B pixels of a block are summed separately (CFA as IspDisplay: base RGGB, i_cfa[0] flips
 * the column parity, i_cfa[1] the row parity; a block holds 9 R, 18 G, 9 B). Each block is one write
 * (o_we) at address y * 128 + x:
 *   o_wd   luma: (R + G + B) / 36, black level off, x i_gain (8.8), the sRGB curve
 *   o_cwd  colour RGB565: R / 9, G / 18, B / 9, black level off, x the white balance gain and
 *          i_gain (R and B), the sRGB curve
 * The sRGB curve is 8 straight segments (knots at 0, 8, 16 .. 512, 1024; within 4 of the exact
 * curve, no block RAM).
 * White balance: i_awb = 1: from the frame before (grey world: G / R and G / B of the sums of all
 * blocks after the black level, 8.8, 0.5..4), else i_wb_r / i_wb_b; o_wb_r / o_wb_b the gains in use.
 *
 * Columns: three words (12 pixels) make two blocks, so the sums of a row go out after the second
 * and the third word of each three. Rows: the row sums are added into one accumulator per column
 * (a RAM read one clock and written the next: a column comes back only a row later); the sixth
 * row of a band writes the result. o_frame toggles after the last block of the frame (band 111,
 * column 127) has been written.
 *
 *   i_mirror: x = 127 - column, i_flip: y = 111 - band
 */
pub module IspGbScale #(
    param X0W: u32 = 64, // first word of the window (4 pixels per word): pixel 256 of 1280
    param Y0 : u32 = 24, // first row of the window: row 24 of 720
) (
    i_clk: input clock,
    i_rst: input reset,

    i_we   : input logic    ,
    i_waddr: input logic<9> ,
    i_wdata: input logic<40>, // {P3, P2, P1, P0}
    i_row  : input logic<12>,

    i_black : input logic<10>,
    i_cfa   : input logic<2> ,
    i_gain  : input logic<16>, // 8.8
    i_awb   : input logic    ,
    i_wb_r  : input logic<16>, // 8.8, when !i_awb
    i_wb_b  : input logic<16>,
    i_mirror: input logic    ,
    i_flip  : input logic    ,

    o_we   : output logic    ,
    o_wa   : output logic<14>,
    o_wd   : output logic<8> ,
    o_cwd  : output logic<16>,
    o_frame: output logic    , // toggles when a frame is complete
    o_wb_r : output logic<16>,
    o_wb_b : output logic<16>,
) {
    // ---- rows ----
    var act : logic   ; // the current row is in the window
    var rsub: logic<3>; // row in the band, 0..5
    var band: logic<7>; // 0..111
    var n_act : logic   ;
    var n_rsub: logic<3>;
    var n_band: logic<7>;
    always_comb {
        n_act  = act;
        n_rsub = rsub;
        n_band = band;
        if i_we && i_waddr == 9'd0 {
            // a new row starts with its word 0
            if i_row == Y0[11:0] {
                n_act  = 1;
                n_rsub = 0;
                n_band = 0;
            } else if act {
                if rsub == 3'd5 {
                    n_rsub = 0;
                    if band == 7'd111 {
                        n_act = 0;
                    } else {
                        n_band = band + 7'd1;
                    }
                } else {
                    n_rsub = rsub + 3'd1;
                }
            }
        }
    }

    // ---- columns: three words make two blocks; even and odd columns apart ----
    var ph : logic<2> ; // word in the group of three
    var blk: logic<7> ; // first block of the group
    var se : logic<12>; // the group's second block so far: even columns
    var so : logic<12>; // ... odd columns

    let k    : logic<9>  = i_waddr - X0W[8:0];
    let incol: logic     = i_waddr >= X0W[8:0] && i_waddr <: X0W[8:0] + 9'd192;
    let cph  : logic<2>  = if k == 9'd0 ? 2'd0 : ph;
    let cblk : logic<7>  = if k == 9'd0 ? 7'd0 : blk;
    let p0   : logic<12> = i_wdata[9:0] as 12;
    let p1   : logic<12> = i_wdata[19:10] as 12;
    let p2   : logic<12> = i_wdata[29:20] as 12;
    let p3   : logic<12> = i_wdata[39:30] as 12;
    let take : logic     = i_we && n_act && incol;

    // row sums of one block (3 even + 3 odd pixels), one clock after the word
    var e_v   : logic    ;
    var e_blk : logic<7> ;
    var e_se  : logic<12>;
    var e_so  : logic<12>;
    var e_py  : logic    ; // 0: an R G row, 1: a G B row
    var e_band: logic<7> ;
    var e_rsub: logic<3> ;

    always_ff {
        if_reset {
            act    = 0;
            rsub   = 0;
            band   = 0;
            ph     = 0;
            blk    = 0;
            se     = 0;
            so     = 0;
            e_v    = 0;
            e_blk  = 0;
            e_se   = 0;
            e_so   = 0;
            e_py   = 0;
            e_band = 0;
            e_rsub = 0;
        } else {
            act    = n_act;
            rsub   = n_rsub;
            band   = n_band;
            e_v    = take && cph != 2'd0;
            e_band = n_band;
            e_rsub = n_rsub;
            e_py   = i_row[0] ^ i_cfa[1];
            if take {
                case cph {
                    2'd0: {
                        se  = p0 + p2;
                        so  = p1 + p3;
                        ph  = 2'd1;
                        blk = cblk;
                    }
                    2'd1: {
                        e_blk = cblk;
                        e_se  = se + p0;
                        e_so  = so + p1;
                        se    = p2;
                        so    = p3;
                        ph    = 2'd2;
                        blk   = cblk;
                    }
                    default: {
                        e_blk = cblk + 7'd1;
                        e_se  = se + p0 + p2;
                        e_so  = so + p1 + p3;
                        blk   = cblk + 7'd2;
                        ph    = 2'd0;
                    }
                }
            }
        }
    }
    // the row's pixels by colour (even column: R on an R G row when i_cfa[0] is 0)
    let e_r: logic<12> = if e_py ? 12'd0 : (if i_cfa[0] ? e_so : e_se);
    let e_g: logic<12> = if e_py ? (if i_cfa[0] ? e_so : e_se) : (if i_cfa[0] ? e_se : e_so);
    let e_b: logic<12> = if !e_py ? 12'd0 : (if i_cfa[0] ? e_se : e_so);

    // ---- bands: one accumulator per column, {R 14, G 15, B 14} (the first row of a band overwrites it) ----
    var acc   : logic<43> [128];
    var acc_q : logic<43>       ; // acc[e_blk] of the clock before
    var f_v   : logic    ;
    var f_blk : logic<7> ;
    var f_r   : logic<12>;
    var f_g   : logic<12>;
    var f_b   : logic<12>;
    var f_band: logic<7> ;
    var f_rsub: logic<3> ;
    let f_nr  : logic<14> = (if f_rsub == 3'd0 ? 14'd0 : acc_q[42:29]) + (f_r as 14);
    let f_ng  : logic<15> = (if f_rsub == 3'd0 ? 15'd0 : acc_q[28:14]) + (f_g as 15);
    let f_nb  : logic<14> = (if f_rsub == 3'd0 ? 14'd0 : acc_q[13:0]) + (f_b as 14);
    always_ff (i_clk) {
        acc_q = acc[e_blk];
        if f_v {
            acc[f_blk] = {f_nr, f_ng, f_nb};
        }
    }
    var b_v   : logic    ;
    var b_r   : logic<14>;
    var b_g   : logic<15>;
    var b_b   : logic<14>;
    var b_x   : logic<7> ;
    var b_y   : logic<7> ;
    var b_last: logic    ; // the frame's last block
    always_ff {
        if_reset {
            f_v    = 0;
            f_blk  = 0;
            f_r    = 0;
            f_g    = 0;
            f_b    = 0;
            f_band = 0;
            f_rsub = 0;
            b_v    = 0;
            b_r    = 0;
            b_g    = 0;
            b_b    = 0;
            b_x    = 0;
            b_y    = 0;
            b_last = 0;
        } else {
            f_v    = e_v;
            f_blk  = e_blk;
            f_r    = e_r;
            f_g    = e_g;
            f_b    = e_b;
            f_band = e_band;
            f_rsub = e_rsub;
            b_v    = f_v && f_rsub == 3'd5;
            b_r    = f_nr;
            b_g    = f_ng;
            b_b    = f_nb;
            b_x    = if i_mirror ? 7'd127 - f_blk : f_blk;
            b_y    = if i_flip ? 7'd111 - f_band : f_band;
            b_last = f_band == 7'd111 && f_blk == 7'd127;
        }
    }

    // ---- averages (c), black level (n), gains (m), clamp (d), curves (g, h) ----
    // luma: sum / 36 ~ sum * 1821 >> 16; R, B: / 9 ~ * 7282 >> 16; G: / 18 ~ * 3641 >> 16
    let b_sum: logic<16> = (b_r as 16) + (b_g as 16) + (b_b as 16);
    let avg  : logic<27> = (b_sum as 27) * 27'd1821;
    let avr  : logic<27> = (b_r as 27) * 27'd7282;
    let avgg : logic<27> = (b_g as 27) * 27'd3641;
    let avb  : logic<27> = (b_b as 27) * 27'd7282;
    var c_v   : logic    ;
    var c_avg : logic<11>;
    var c_ar  : logic<11>;
    var c_ag  : logic<11>;
    var c_ab  : logic<11>;
    var c_wa  : logic<14>;
    var c_last: logic    ;
    function sub_black (
        a: input logic<11>,
        k: input logic<10>,
    ) -> logic<11> {
        return if a >: (k as 11) ? a - (k as 11) : 11'd0;
    }
    var n_v   : logic    ;
    var n_net : logic<11>;
    var n_cr  : logic<11>;
    var n_cg  : logic<11>;
    var n_cb  : logic<11>;
    var n_wa  : logic<14>;
    var n_last: logic    ;
    var w_r   : logic<16>; // white balance in use, 8.8
    var w_b   : logic<16>;
    var e_wr  : logic<16>; // x i_gain
    var e_wb  : logic<16>;
    var m_v   : logic    ;
    var m_amp : logic<27>;
    var m_cr  : logic<27>;
    var m_cg  : logic<27>;
    var m_cb  : logic<27>;
    var m_wa  : logic<14>;
    var m_last: logic    ;
    var d_v   : logic    ;
    var d_lin : logic<10>;
    var d_cr  : logic<10>;
    var d_cg  : logic<10>;
    var d_cb  : logic<10>;
    var d_wa  : logic<14>;
    var d_last: logic    ;
    function clamp10 (
        a: input logic<27>,
    ) -> logic<10> {
        return if a[26:18] != 9'd0 ? 10'h3FF : a[17:8];
    }
    // sRGB as 8 segments: knot, value, slope numerator, log2 width
    var g_v   : logic    ;
    var g_wa  : logic<14>;
    var g_last: logic    ;
    var g_y0  : logic<8> [4];
    var g_dx  : logic<9> [4];
    var g_dy  : logic<7> [4];
    var g_sh  : logic<4> [4];
    var h_v   : logic    ;
    var h_wa  : logic<14>;
    var h_c   : logic<8> [4];
    var h_last: logic    ;
    var d_c   : logic<10> [4]; // R, G, B, luma
    assign d_c[0] = d_cr;
    assign d_c[1] = d_cg;
    assign d_c[2] = d_cb;
    assign d_c[3] = d_lin;
    always_ff {
        if_reset {
            c_v    = 0;
            c_avg  = 0;
            c_ar   = 0;
            c_ag   = 0;
            c_ab   = 0;
            c_wa   = 0;
            c_last = 0;
            n_v    = 0;
            n_net  = 0;
            n_cr   = 0;
            n_cg   = 0;
            n_cb   = 0;
            n_wa   = 0;
            n_last = 0;
            e_wr   = 16'h0100;
            e_wb   = 16'h0100;
            m_v    = 0;
            m_amp  = 0;
            m_cr   = 0;
            m_cg   = 0;
            m_cb   = 0;
            m_wa   = 0;
            m_last = 0;
            d_v    = 0;
            d_lin  = 0;
            d_cr   = 0;
            d_cg   = 0;
            d_cb   = 0;
            d_wa   = 0;
            d_last = 0;
            g_v    = 0;
            g_wa   = 0;
            g_last = 0;
            g_y0   = '{0, 0, 0, 0};
            g_dx   = '{0, 0, 0, 0};
            g_dy   = '{0, 0, 0, 0};
            g_sh   = '{0, 0, 0, 0};
            h_v    = 0;
            h_wa   = 0;
            h_c    = '{0, 0, 0, 0};
            h_last = 0;
            o_frame = 0;
        } else {
            c_v    = b_v;
            c_avg  = avg[26:16];
            c_ar   = avr[26:16];
            c_ag   = avgg[26:16];
            c_ab   = avb[26:16];
            c_wa   = {b_y, b_x};
            c_last = b_v && b_last;
            n_v    = c_v;
            n_net  = sub_black(c_avg, i_black);
            n_cr   = sub_black(c_ar, i_black);
            n_cg   = sub_black(c_ag, i_black);
            n_cb   = sub_black(c_ab, i_black);
            n_wa   = c_wa;
            n_last = c_last;
            e_wr   = (((w_r as 32) * (i_gain as 32)) >> 8) as 16;
            e_wb   = (((w_b as 32) * (i_gain as 32)) >> 8) as 16;
            m_v    = n_v;
            m_amp  = (n_net as 27) * (i_gain as 27);
            m_cr   = (n_cr as 27) * (e_wr as 27);
            m_cg   = (n_cg as 27) * (i_gain as 27);
            m_cb   = (n_cb as 27) * (e_wb as 27);
            m_wa   = n_wa;
            m_last = n_last;
            d_v    = m_v;
            d_lin  = clamp10(m_amp);
            d_cr   = clamp10(m_cr);
            d_cg   = clamp10(m_cg);
            d_cb   = clamp10(m_cb);
            d_wa   = m_wa;
            d_last = m_last;
            // the curve: the segment in g, the value in h
            g_v    = d_v;
            g_wa   = d_wa;
            g_last = d_last;
            for c in 0..4 {
                if d_c[c] <: 10'd8 {
                    g_y0[c] = 8'd0;
                    g_dx[c] = d_c[c][8:0];
                    g_dy[c] = 7'd22;
                    g_sh[c] = 4'd3;
                } else if d_c[c] <: 10'd16 {
                    g_y0[c] = 8'd22;
                    g_dx[c] = d_c[c][8:0] - 9'd8;
                    g_dy[c] = 7'd12;
                    g_sh[c] = 4'd3;
                } else if d_c[c] <: 10'd32 {
                    g_y0[c] = 8'd34;
                    g_dx[c] = d_c[c][8:0] - 9'd16;
                    g_dy[c] = 7'd15;
                    g_sh[c] = 4'd4;
                } else if d_c[c] <: 10'd64 {
                    g_y0[c] = 8'd49;
                    g_dx[c] = d_c[c][8:0] - 9'd32;
                    g_dy[c] = 7'd22;
                    g_sh[c] = 4'd5;
                } else if d_c[c] <: 10'd128 {
                    g_y0[c] = 8'd71;
                    g_dx[c] = d_c[c][8:0] - 9'd64;
                    g_dy[c] = 7'd28;
                    g_sh[c] = 4'd6;
                } else if d_c[c] <: 10'd256 {
                    g_y0[c] = 8'd99;
                    g_dx[c] = d_c[c][8:0] - 9'd128;
                    g_dy[c] = 7'd38;
                    g_sh[c] = 4'd7;
                } else if d_c[c] <: 10'd512 {
                    g_y0[c] = 8'd137;
                    g_dx[c] = d_c[c][8:0] - 9'd256;
                    g_dy[c] = 7'd51;
                    g_sh[c] = 4'd8;
                } else {
                    g_y0[c] = 8'd188;
                    g_dx[c] = d_c[c][8:0];
                    g_dy[c] = 7'd67;
                    g_sh[c] = 4'd9;
                }
            }
            h_v    = g_v;
            h_wa   = g_wa;
            h_last = g_last;
            for c in 0..4 {
                h_c[c] = g_y0[c] + ((((g_dx[c] as 16) * (g_dy[c] as 16)) >> g_sh[c]) as 8);
            }
            if h_last {
                o_frame = !o_frame;
            }
        }
    }
    assign o_we  = h_v;
    assign o_wa  = h_wa;
    assign o_wd  = h_c[3];
    assign o_cwd = {h_c[0][7:3], h_c[1][7:2], h_c[2][7:3]};

    // ---- white balance: grey world over the frame, for the next frame ----
    var s_r : logic<24>;
    var s_g : logic<24>;
    var s_b : logic<24>;
    var a_r : logic<16>; // grey world gains
    var a_b : logic<16>;
    var wb_st: logic<2>;
    var dv_go: logic    ;
    var dv_n : logic<32>;
    var dv_d : logic<24>;
    var dv_q : logic<32>;
    var dv_bz: logic    ;
    var t_g  : logic<24>; // the frame's sums, for the divisions
    var t_b  : logic<24>;
    inst u_div: IspDiv (
        i_clk           ,
        i_rst           ,
        i_go  : dv_go   ,
        i_n   : dv_n    ,
        i_d   : dv_d    ,
        o_q   : dv_q    ,
        o_busy: dv_bz   ,
    );
    let wclamp: logic<16> = if dv_q >: 32'd1024 ? 16'd1024 : if dv_q <: 32'd128 ? 16'd128 : dv_q[15:0];
    always_ff {
        if_reset {
            s_r   = 0;
            s_g   = 0;
            s_b   = 0;
            a_r   = 16'h0100;
            a_b   = 16'h0100;
            wb_st = 0;
            dv_go = 0;
            dv_n  = 0;
            dv_d  = 1;
            t_g   = 0;
            t_b   = 0;
            w_r   = 16'h0100;
            w_b   = 16'h0100;
        } else {
            dv_go = 0;
            w_r   = if i_awb ? a_r : i_wb_r;
            w_b   = if i_awb ? a_b : i_wb_b;
            if n_v {
                if n_last {
                    s_r = 0;
                    s_g = 0;
                    s_b = 0;
                    if wb_st == 2'd0 && s_r + (n_cr as 24) != 24'd0 && s_b + (n_cb as 24) != 24'd0 {
                        dv_go = 1;
                        dv_n  = ((s_g + (n_cg as 24)) as 32) << 8;
                        dv_d  = s_r + (n_cr as 24);
                        t_g   = s_g + (n_cg as 24);
                        t_b   = s_b + (n_cb as 24);
                        wb_st = 2'd1;
                    }
                } else {
                    s_r += (n_cr as 24);
                    s_g += (n_cg as 24);
                    s_b += (n_cb as 24);
                }
            }
            case wb_st {
                2'd1: {
                    if !dv_go && !dv_bz {
                        a_r   = wclamp;
                        dv_go = 1;
                        dv_n  = (t_g as 32) << 8;
                        dv_d  = t_b;
                        wb_st = 2'd2;
                    }
                }
                2'd2: {
                    if !dv_go && !dv_bz {
                        a_b   = wclamp;
                        wb_st = 2'd0;
                    }
                }
                default: {}
            }
        }
    }
    assign o_wb_r = w_r;
    assign o_wb_b = w_b;
}

/// Unsigned restoring division, one quotient bit a clock: o_q = i_n / i_d (i_d > 0), o_busy falls
/// 32 clocks after i_go.
pub module IspDiv (
    i_clk : input  clock    ,
    i_rst : input  reset    ,
    i_go  : input  logic    ,
    i_n   : input  logic<32>,
    i_d   : input  logic<24>,
    o_q   : output logic<32>,
    o_busy: output logic    ,
) {
    var rem: logic<25>;
    var dd : logic<24>;
    var n  : logic<6> ;
    let r2 : logic<25> = {rem[23:0], o_q[31]};
    always_ff {
        if_reset {
            rem    = 0;
            dd     = 1;
            n      = 0;
            o_q    = 0;
            o_busy = 0;
        } else if i_go {
            rem    = 0;
            dd     = i_d;
            n      = 6'd32;
            o_q    = i_n;
            o_busy = 1;
        } else if o_busy {
            if r2 >= (dd as 25) {
                rem = r2 - (dd as 25);
                o_q = {o_q[30:0], 1'b1};
            } else {
                rem = r2;
                o_q = {o_q[30:0], 1'b0};
            }
            n -= 1;
            if n == 6'd1 {
                o_busy = 0;
            }
        }
    }
}
