/**
 * @file usb_sie.veryl
 * @brief Serial Interface Engine: packet layer between UTMI and the
 *        device protocol engine (USB 2.0 §8.3 - §8.4).
 *
 * RX: classifies the PID (with the {~pid, pid} check), parses tokens
 * (CRC5 residual check, §8.3.5.1), streams DATAx payload bytes with the
 * trailing CRC16 stripped (2-byte delay line) and validates the CRC16
 * residual (§8.3.5.2), and reports handshakes. Packet end is taken from
 * RxActive falling and evaluated one cycle later so that a byte
 * delivered in the same cycle as the EOP is counted.
 *
 * TX: sends a handshake (PID only) or a DATAx packet (PID + payload +
 * CRC16). Payload bytes are fetched by index: o_tx_idx is the index of
 * the byte currently on the bus, o_tx_idx_next the index that will be
 * needed in the next cycle (use it as the address of a synchronous RAM).
 */
import usb_pkg::*;

pub module UsbSie (
    i_clk: input clock,
    i_rst: input reset,

    // ---- UTMI ----
    i_utmi_data_in : input  logic<8>,
    i_utmi_rxactive: input  logic   ,
    i_utmi_rxvalid : input  logic   ,
    i_utmi_rxerror : input  logic   ,
    o_utmi_data_out: output logic<8>,
    o_utmi_txvalid : output logic   ,
    i_utmi_txready : input  logic   ,

    // ---- decoded RX ----
    o_rx_pid       : output logic<4> , // valid with any of the pulses below
    o_rx_token     : output logic    , // OUT/IN/SETUP/PING token (CRC5 ok)
    o_rx_sof       : output logic    ,
    o_rx_addr      : output logic<7> ,
    o_rx_endp      : output logic<4> ,
    o_rx_frame     : output logic<11>,
    o_rx_data_start: output logic    , // DATAx PID seen
    o_rx_data_valid: output logic    , // payload byte (CRC excluded)
    o_rx_data      : output logic<8> ,
    o_rx_data_end  : output logic    , // DATAx packet finished
    o_rx_data_ok   : output logic    , // with o_rx_data_end: CRC16 ok, no RxError
    o_rx_handshake : output logic    ,

    // ---- TX ----
    i_tx_start   : input  logic    , // pulse; ignored while busy
    i_tx_pid     : input  logic<4> ,
    i_tx_len     : input  logic<10>, // payload bytes (DATAx only)
    i_tx_data    : input  logic<8> , // payload byte o_tx_idx
    o_tx_idx     : output logic<10>,
    o_tx_idx_next: output logic<10>,
    o_tx_busy    : output logic    ,
    o_tx_done    : output logic    , // pulse after the last byte is accepted
) {
    // -----------------------------------------------------------------
    // RX
    // -----------------------------------------------------------------
    enum RxKind: logic<2> {
        None,
        Token,
        Data,
        Handshake,
    }

    var rxactive_d : logic;
    var rx_end     : logic; // one cycle after RxActive fell
    var rx_count   : logic<11>;
    var rx_kind    : RxKind;
    var rx_pid     : logic<4>;
    var rx_err     : logic;
    var rx_b1      : logic<8>;
    var rx_b2      : logic<8>;
    var rx_crc16   : logic<16>;
    var rx_token   : logic;
    var rx_sof     : logic;
    var rx_dstart  : logic;
    var rx_dvalid  : logic;
    var rx_dbyte   : logic<8>;
    var rx_dend    : logic;
    var rx_dok     : logic;
    var rx_hs      : logic;

    let pid_ok   : logic    = i_utmi_data_in[7:4] == ~i_utmi_data_in[3:0];
    let pid_in   : logic<4> = i_utmi_data_in[3:0];
    let is_token : logic    = (pid_in[1:0] == 2'b01) || (pid_in == PID_PING); // PING is a 'special' PID but token-shaped
    let is_data  : logic    = pid_in[1:0] == 2'b11;
    let is_hshake: logic    = pid_in[1:0] == 2'b10;

    // CRC5 residual over the 16 token bits (11 payload + 5 CRC).
    function crc5_residual(d: input logic<16>) -> logic<5> {
        var c: logic<5>;
        c = CRC5_INIT;
        for i in 0..16 {
            c = crc5_bit(c, d[i]);
        }
        return c;
    }
    let tok_field: logic<16> = {rx_b2, rx_b1};
    let crc5_ok  : logic     = crc5_residual(tok_field) == CRC5_RESIDUAL;

    always_ff (i_clk, i_rst) {
        if_reset {
            rxactive_d = 0;
            rx_end     = 0;
            rx_count   = 0;
            rx_kind    = RxKind::None;
            rx_pid     = 0;
            rx_err     = 0;
            rx_b1      = 0;
            rx_b2      = 0;
            rx_crc16   = CRC16_INIT;
            rx_token   = 0;
            rx_sof     = 0;
            rx_dstart  = 0;
            rx_dvalid  = 0;
            rx_dbyte   = 0;
            rx_dend    = 0;
            rx_dok     = 0;
            rx_hs      = 0;
        } else {
            rxactive_d = i_utmi_rxactive;
            rx_end     = rxactive_d && !i_utmi_rxactive;
            rx_token   = 0;
            rx_sof     = 0;
            rx_dstart  = 0;
            rx_dvalid  = 0;
            rx_dend    = 0;
            rx_hs      = 0;

            if i_utmi_rxactive && !rxactive_d {
                rx_count = 0;
                rx_kind  = RxKind::None;
                rx_err   = 0;
                rx_crc16 = CRC16_INIT;
            }
            if i_utmi_rxerror {
                rx_err = 1;
            }
            if i_utmi_rxvalid {
                if rx_count == 0 {
                    rx_pid = pid_in;
                    if !pid_ok {
                        rx_err  = 1;
                        rx_kind = RxKind::None;
                    } else if is_token {
                        rx_kind = RxKind::Token;
                    } else if is_data {
                        rx_kind   = RxKind::Data;
                        rx_dstart = 1;
                    } else if is_hshake {
                        rx_kind = RxKind::Handshake;
                    } else {
                        rx_kind = RxKind::None; // PRE/SPLIT: not supported
                    }
                } else {
                    // Two-byte delay line: emit byte k-2 when byte k arrives.
                    if rx_count >= 11'd3 {
                        rx_dvalid = rx_kind == RxKind::Data;
                        rx_dbyte  = rx_b1;
                    }
                    rx_b1    = rx_b2;
                    rx_b2    = i_utmi_data_in;
                    rx_crc16 = crc16_byte(rx_crc16, i_utmi_data_in);
                }
                if rx_count != 11'h7FF {
                    rx_count = rx_count + 1;
                }
            }
            if rx_end && !rx_err {
                case rx_kind {
                    RxKind::Token: {
                        if (rx_count == 11'd3) && crc5_ok {
                            if rx_pid == PID_SOF {
                                rx_sof = 1;
                            } else {
                                rx_token = 1;
                            }
                        }
                    }
                    RxKind::Data: {
                        rx_dend = 1;
                        rx_dok  = (rx_count >= 11'd3) && (rx_crc16 == CRC16_RESIDUAL);
                    }
                    RxKind::Handshake: {
                        rx_hs = rx_count == 11'd1;
                    }
                    default: {}
                }
            } else if rx_end && (rx_kind == RxKind::Data) {
                rx_dend = 1;
                rx_dok  = 0;
            }
        }
    }

    assign o_rx_pid        = rx_pid;
    assign o_rx_token      = rx_token;
    assign o_rx_sof        = rx_sof;
    assign o_rx_addr       = tok_field[6:0];
    assign o_rx_endp       = tok_field[10:7];
    assign o_rx_frame      = tok_field[10:0];
    assign o_rx_data_start = rx_dstart;
    assign o_rx_data_valid = rx_dvalid;
    assign o_rx_data       = rx_dbyte;
    assign o_rx_data_end   = rx_dend;
    assign o_rx_data_ok    = rx_dok;
    assign o_rx_handshake  = rx_hs;

    // -----------------------------------------------------------------
    // TX
    // -----------------------------------------------------------------
    enum TxState: logic<3> {
        Idle,
        Pid,
        Payload,
        CrcLo,
        CrcHi,
    }

    var tx_state: TxState;
    var tx_pid  : logic<4>;
    var tx_len  : logic<10>;
    var tx_idx  : logic<10>;
    var tx_crc  : logic<16>;
    var tx_done : logic;

    let tx_is_data: logic    = tx_pid[1:0] == 2'b11;
    let tx_crc_out: logic<16> = ~tx_crc;

    var txvalid : logic;
    var data_out: logic<8>;
    always_comb {
        case tx_state {
            TxState::Pid: {
                txvalid  = 1;
                data_out = pid_byte(tx_pid);
            }
            TxState::Payload: {
                txvalid  = 1;
                data_out = i_tx_data;
            }
            TxState::CrcLo: {
                txvalid  = 1;
                data_out = tx_crc_out[7:0];
            }
            TxState::CrcHi: {
                txvalid  = 1;
                data_out = tx_crc_out[15:8];
            }
            default: {
                txvalid  = 0;
                data_out = 0;
            }
        }
    }

    let accept     : logic     = txvalid && i_utmi_txready;
    let payload_acc: logic     = accept && (tx_state == TxState::Payload);
    let idx_next   : logic<10> = if payload_acc ? tx_idx + 1 : tx_idx;

    always_ff (i_clk, i_rst) {
        if_reset {
            tx_state = TxState::Idle;
            tx_pid   = 0;
            tx_len   = 0;
            tx_idx   = 0;
            tx_crc   = CRC16_INIT;
            tx_done  = 0;
        } else {
            tx_done = 0;
            case tx_state {
                TxState::Idle: {
                    if i_tx_start {
                        tx_pid   = i_tx_pid;
                        tx_len   = i_tx_len;
                        tx_idx   = 0;
                        tx_crc   = CRC16_INIT;
                        tx_state = TxState::Pid;
                    }
                }
                TxState::Pid: {
                    if accept {
                        if !tx_is_data {
                            tx_state = TxState::Idle;
                            tx_done  = 1;
                        } else if tx_len == 0 {
                            tx_state = TxState::CrcLo;
                        } else {
                            tx_state = TxState::Payload;
                        }
                    }
                }
                TxState::Payload: {
                    if accept {
                        tx_crc = crc16_byte(tx_crc, i_tx_data);
                        tx_idx = tx_idx + 1;
                        if tx_idx + 1 == tx_len {
                            tx_state = TxState::CrcLo;
                        }
                    }
                }
                TxState::CrcLo: {
                    if accept {
                        tx_state = TxState::CrcHi;
                    }
                }
                TxState::CrcHi: {
                    if accept {
                        tx_state = TxState::Idle;
                        tx_done  = 1;
                    }
                }
            }
        }
    }

    assign o_utmi_txvalid  = txvalid;
    assign o_utmi_data_out = data_out;
    assign o_tx_idx        = tx_idx;
    assign o_tx_idx_next   = idx_next;
    assign o_tx_busy       = tx_state != TxState::Idle;
    assign o_tx_done       = tx_done;
}
