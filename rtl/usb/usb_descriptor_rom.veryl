/**
 * @file usb_descriptor_rom.veryl
 * @brief Descriptor ROM for the sample USB device (generated table).
 *
 * A single byte-addressed combinational ROM holding, in order:
 *   DEV     @  0 len 18
 *   CFG_FS  @ 18 len 32
 *   CFG_HS  @ 50 len 32
 *   QUAL    @ 82 len 10
 *   STR0    @ 92 len 4
 *   STR1    @ 96 len 26
 *   STR2    @122 len 30
 *   STR3    @152 len 14
 *
 * Device: vendor-specific class (0xFF), bMaxPacketSize0 = 64, one
 * configuration with one interface and two bulk endpoints (EP1 OUT /
 * EP1 IN, 64 bytes FS / 512 bytes HS). The HS variant of the
 * configuration doubles as the OTHER_SPEED_CONFIGURATION (the device
 * core patches bDescriptorType to 0x07 when serving it). Vendor / product
 * IDs come from the parameters.
 */
pub package usb_desc_pkg {
    const DEV_ADDR: logic<8> = 8'd0;
    const DEV_LEN : logic<8> = 8'd18;
    const CFG_FS_ADDR: logic<8> = 8'd18;
    const CFG_FS_LEN : logic<8> = 8'd32;
    const CFG_HS_ADDR: logic<8> = 8'd50;
    const CFG_HS_LEN : logic<8> = 8'd32;
    const QUAL_ADDR: logic<8> = 8'd82;
    const QUAL_LEN : logic<8> = 8'd10;
    const STR0_ADDR: logic<8> = 8'd92;
    const STR0_LEN : logic<8> = 8'd4;
    const STR1_ADDR: logic<8> = 8'd96;
    const STR1_LEN : logic<8> = 8'd26;
    const STR2_ADDR: logic<8> = 8'd122;
    const STR2_LEN : logic<8> = 8'd30;
    const STR3_ADDR: logic<8> = 8'd152;
    const STR3_LEN : logic<8> = 8'd14;
}

pub module UsbDescriptorRom #(
    param VENDOR_ID : logic<16> = 16'h1209,
    param PRODUCT_ID: logic<16> = 16'h0001,
) (
    i_addr: input  logic<8>,
    o_data: output logic<8>,
) {
    always_comb {
        case i_addr {
            8'd0: o_data = 8'h12;
            8'd1: o_data = 8'h01;
            8'd2: o_data = 8'h00;
            8'd3: o_data = 8'h02;
            8'd4: o_data = 8'hFF;
            8'd5: o_data = 8'h00;
            8'd6: o_data = 8'h00;
            8'd7: o_data = 8'h40;
            8'd8: o_data = VENDOR_ID[7:0];
            8'd9: o_data = VENDOR_ID[15:8];
            8'd10: o_data = PRODUCT_ID[7:0];
            8'd11: o_data = PRODUCT_ID[15:8];
            8'd12: o_data = 8'h00;
            8'd13: o_data = 8'h01;
            8'd14: o_data = 8'h01;
            8'd15: o_data = 8'h02;
            8'd16: o_data = 8'h03;
            8'd17: o_data = 8'h01;
            8'd18: o_data = 8'h09;
            8'd19: o_data = 8'h02;
            8'd20: o_data = 8'h20;
            8'd21: o_data = 8'h00;
            8'd22: o_data = 8'h01;
            8'd23: o_data = 8'h01;
            8'd24: o_data = 8'h00;
            8'd25: o_data = 8'h80;
            8'd26: o_data = 8'h32;
            8'd27: o_data = 8'h09;
            8'd28: o_data = 8'h04;
            8'd29: o_data = 8'h00;
            8'd30: o_data = 8'h00;
            8'd31: o_data = 8'h02;
            8'd32: o_data = 8'hFF;
            8'd33: o_data = 8'h00;
            8'd34: o_data = 8'h00;
            8'd35: o_data = 8'h00;
            8'd36: o_data = 8'h07;
            8'd37: o_data = 8'h05;
            8'd38: o_data = 8'h01;
            8'd39: o_data = 8'h02;
            8'd40: o_data = 8'h40;
