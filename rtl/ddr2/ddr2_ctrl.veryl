//
// Ddr2Ctrl: DDR2 SDRAM controller for one x16 device, no Gowin IP.
//
// After the DDR3 controller of riscv-veryl (Ddr3Ctrl): the PHY boundary is
// the same "slot vector" one, so the controller can drive either the Gowin
// IOLOGIC wrapper (Ddr2PhyGw3a) or the behavioural model of the test
// bench (test/ddr2_model.sv). What changes for DDR2 / this use:
//   - DLL on (DDR2 has no DLL-off mode in normal operation): CK must be
//     125 MHz or more (tCK <= 8 ns). JEDEC init with DLL reset and OCD
//     default / exit, no RESET# / ZQ.
//   - BL8, CL = 3..6, AL = 0, WL = CL - 1, DQS# enabled, no ODT.
//   - One open row: a request to the open row goes straight to RD / WR,
//     back to back every 2 pclk (4 CK = one BL8), so a stream of
//     sequential requests runs at the full bus rate; a miss precharges
//     (all banks) and activates.
//   - No data mask (the DM pins are not wired to the FPGA on the
//     DK_LED-RXCARD): writes are always whole 16-byte bursts.
//   - The user port is in the pclk domain (no clock crossing inside).
//
// Clocking: i_clk = pclk = CK / 2 (= fclk / 4, from a CLKDIV fed by fclk).
// One pclk carries 8 slots of a quarter CK each.
//
// User port (pclk domain)
//   i_req_valid / o_req_ready: one 16-byte burst (beat b = bytes 2b, 2b+1
//   = i_req_wdata[16b +: 16]); i_req_addr is the burst address (byte
//   address / 16). Requests are carried out in order. o_rd_valid /
//   o_rd_data return the reads in order, a fixed time after the command
//   (no back pressure: the user must be able to take them).
//   Address map: col = {addr[COL_BITS-4:0], 3'b000}, bank = the next
//   BANK_BITS, row = the top ROW_BITS: consecutive 1 KB pages rotate over
//   the banks.
//
// PHY-side slot vectors (pclk domain, as Ddr3Ctrl)
//   Commands are SDR and are only issued in the first CK of a pclk: the
//   PHY drives {cs_n, ras_n, cas_n, we_n, ba, a} for CK 0 and DESELECT for
//   CK 1. CK is generated by the PHY as slots {0,0,1,1,0,0,1,1} (rising
//   edges at slots 2 and 6), so the command is sampled at slot 2.
//   o_dq_out[16*s +: 16]  DQ during slot s      o_dq_oe[s/2]  DQ drive
//   o_dqs_out[2*s +: 2]   {DQSU, DQSL}          o_dqs_oe[s/2] DQS drive
//   i_dq_in[16*s +: 16]   DQ sampled at slot s (IDES8 / model)
//
// Write timing: with the WR command on the PHY port in pclk P (sampled at
// slot 2), the first DQS rising edge is WL CK later, at slot T0 = 2 + 4 WL
// counted from slot 0 of P. DQS is driven low from T0 - 2 (preamble), beat
// b is centred on the edge at T0 + 2b (driven on slots T0 + 2b - 1 and
// T0 + 2b), and the postamble is T0 + 14, T0 + 15. Back-to-back writes
// overlap only there (the next preamble), see the write pipeline below.
//
// Read capture (as Ddr3Ctrl, with a shorter window): DQS is not used. The
// PHY samples DQ at every slot, the controller keeps the last 24 slots per
// bit and takes beat b at slot RD_SEL + 2b (even beats) / RD_SEL_ODD +
// 2(b - 1) (odd beats, RD_SEL / RD_SEL_ODD 0..9) of that window RD_LAT - 1
// pclk after the command. Both come from the
// auto-calibration at the end of the init: a fixed pattern is written to
// the last burst of the device (CAL_ADDR), read back with RD_LAT from
// CAL_LAT_MIN, and every RD_SEL candidate is compared; the middle of the
// matching run is taken, separately for the even and the odd beats. If
// nothing matches up to CAL_LAT_MAX, o_cal_fail is set and the defaults
// stay.
pub module Ddr2Ctrl #(
    // pclk period in ps (pclk = CK / 2). 12000 ps = 83.3 MHz = CK 166.7 MHz.
    param PCLK_PS: u32 = 12000,
    param CL     : u32 = 4    , // CAS latency 3..6
    // Device geometry (W9725G6KB: 256 Mbit x16 = 13 row, 9 col, 2 bank bits).
    param ROW_BITS : u32 = 13,
    param COL_BITS : u32 = 9 ,
    param BANK_BITS: u32 = 2 ,
    // Timing in ps (DDR2-800 / 667 figures, conservative; tRFC of a 1 Gbit
    // part so that a bigger device also works).
    param T_INIT_PS: u32 = 200_000_000, // CKE low with CK running (200 us)
    param T_RCD_PS : u32 = 15_000     ,
    param T_RP_PS  : u32 = 15_000     ,
    param T_RAS_PS : u32 = 45_000     ,
    param T_WR_PS  : u32 = 15_000     ,
    param T_WTR_PS : u32 = 10_000     ,
    param T_RTP_PS : u32 = 7_500      ,
    param T_RFC_PS : u32 = 127_500    ,
    param T_REFI_PS: u32 = 7_800_000  ,
    // EMR1 output drive: 0 full, 1 reduced (weak).
    param REDUCED_DRIVE: bit = 0,
    // Read capture defaults (used if the calibration is off or fails).
    param RD_SEL_DEFAULT: u32 = 2                                  ,
    param RD_LAT_DEFAULT: u32 = 9                                  ,
    param CAL_ENABLE    : bit = 1                                  ,
    param CAL_LAT_MIN   : u32 = 6                                  ,
    param CAL_LAT_MAX   : u32 = 15                                 ,
    const ADDR_BITS     : u32 = ROW_BITS + BANK_BITS + COL_BITS - 3, // burst address
) (
    i_clk: input clock,
    i_rst: input logic, // synchronous, active high

    // ---- user port ----
    i_req_valid: input  logic           ,
    o_req_ready: output logic           ,
    i_req_we   : input  logic           ,
    i_req_addr : input  logic<ADDR_BITS>,
    i_req_wdata: input  logic<128>      ,
    o_rd_valid : output logic           ,
    o_rd_data  : output logic<128>      ,

    // ---- status ----
    o_init_done : output logic   , // initialised and calibrated, requests accepted
    o_cal_ok    : output logic   ,
    o_cal_fail  : output logic   ,
    o_rd_sel    : output logic<6>,
    o_rd_sel_odd: output logic<6>,
    o_rd_lat    : output logic<4>,

    // ---- PHY (slot vectors) ----
    o_cke    : output logic           ,
    o_odt    : output logic           ,
    o_cs_n   : output logic           ,
    o_ras_n  : output logic           ,
    o_cas_n  : output logic           ,
    o_we_n   : output logic           ,
    o_ba     : output logic<BANK_BITS>,
    o_a      : output logic<ROW_BITS> ,
    o_dq_out : output logic<128>      ,
    o_dq_oe  : output logic<4>        ,
    o_dqs_out: output logic<16>       ,
    o_dqs_oe : output logic<4>        ,
    i_dq_in  : input  logic<128>      ,
    i_dqs_in : input  logic<16>       ,
) {
    // ------------------------------------------------------------------
    // Derived timing (pclk cycles, rounded up)
    // ------------------------------------------------------------------
    const CK_PS: u32 = PCLK_PS / 2;
    const WL   : u32 = CL - 1;
    const T0   : u32 = 2 + 4 * WL; // first write DQS rising edge, slots from the WR pclk

    const C_INIT  : u32 = T_INIT_PS / PCLK_PS + 1;
    const C_CKE   : u32 = (400_000 + PCLK_PS - 1) / PCLK_PS; // CKE high -> first command (400 ns)
    const C_MRD   : u32 = 1; // tMRD = 2 CK
    const C_RP    : u32 = (T_RP_PS + PCLK_PS - 1) / PCLK_PS;
    const C_RCD   : u32 = (T_RCD_PS + PCLK_PS - 1) / PCLK_PS;
    const C_RAS   : u32 = (T_RAS_PS + PCLK_PS - 1) / PCLK_PS;
    const C_RC    : u32 = C_RAS + C_RP;
    const C_RFC   : u32 = (T_RFC_PS + PCLK_PS - 1) / PCLK_PS;
    const C_REFI  : u32 = T_REFI_PS / PCLK_PS;
    const C_DLL   : u32 = 100; // 200 CK after the DLL reset before a read
    const C_BURST : u32 = 2; // BL8 = 4 CK
    const C_WR2RD : u32 = ((WL + 4) * CK_PS + T_WTR_PS + PCLK_PS - 1) / PCLK_PS;
    const C_WR2PRE: u32 = ((WL + 4) * CK_PS + T_WR_PS + PCLK_PS - 1) / PCLK_PS;
    const C_RD2PRE: u32 = (6 * CK_PS + T_RTP_PS + PCLK_PS - 1) / PCLK_PS;
    const C_RD2WR : u32 = (7 * CK_PS + PCLK_PS - 1) / PCLK_PS; // BL/2 + 2 CK (+1)

    // write recovery for the mode register (CK, 2..6)
    const WR_CK0: u32 = (T_WR_PS + CK_PS - 1) / CK_PS;
    const WR_CK : u32 = if WR_CK0 <: 2 ? 2 : if WR_CK0 >: 6 ? 6 : WR_CK0;

    // MR: BL8 (A2:0 = 011), sequential, CL (A6:4), DLL reset (A8), WR - 1
    // (A11:9). EMR1: DLL on (A0 = 0), drive (A1), no ODT, AL 0, OCD (A9:7),
    // DQS# on (A10 = 0).
    const MR_RUN  : logic<13> = {1'b0, (WR_CK - 1) as 3, 1'b0, 1'b0, CL as 3, 1'b0, 3'b011};
    const MR_DLL  : logic<13> = MR_RUN | 13'h0100;
    const EMR1    : logic<13> = {12'h000, REDUCED_DRIVE} << 1;
    const EMR1_OCD: logic<13> = EMR1 | 13'h0380;

    // {cs_n, ras_n, cas_n, we_n}
    const CMD_MRS: logic<4> = 4'b0000;
    const CMD_REF: logic<4> = 4'b0001;
    const CMD_PRE: logic<4> = 4'b0010;
    const CMD_ACT: logic<4> = 4'b0011;
    const CMD_WR : logic<4> = 4'b0100;
    const CMD_RD : logic<4> = 4'b0101;
    const CMD_NOP: logic<4> = 4'b0111;
    const CMD_DES: logic<4> = 4'b1111;

    const CAL_ADDR : logic<ADDR_BITS> = '1;
    const SCAN_LAST: logic<4>         = 4'd9; // last window start slot (9 + 14 = 23)
    const ROW_A10  : logic<ROW_BITS>  = 1 << 10; // PRECHARGE: all banks

    enum State {
        PWRUP,
        CKE,
        PREA1,
        EMR2,
        EMR3,
        EMR1,
        MR_DLLRST,
        PREA2,
        REF1,
        REF2,
        MR_RUN,
        DLL_WAIT,
        OCD_DEF,
        OCD_EXIT,
        CAL_ACT,
        CAL_WR,
        CAL_RD,
        CAL_WAIT,
        CAL_PRE,
        RUN,
    }

    var state: State    ;
    var timer: logic<16>;
    var cmd  : logic<4> ;
    // power-up wait, counting up so that the all-zero state after
    // configuration (before the first reset) also waits
    var pwr_cnt: logic<24>;

    // ---- refresh ----
    var ref_cnt: logic<16>;
    var ref_due: logic    ;
    var ref_on : logic    ; // refresh interval running (from the init's REFs)

    // ---- run-time command spacing (cycles left, 0 = allowed) ----
    var cnt_act: logic<5>;
    var cnt_pre: logic<5>;
    var cnt_rd : logic<5>;
    var cnt_wr : logic<5>;

    // ---- open row ----
    var row_open : logic           ;
    var open_bank: logic<BANK_BITS>;
    var open_row : logic<ROW_BITS> ;

    // ---- request register ----
    var req_pend : logic           ;
    var req_we   : logic           ;
    var req_addr : logic<ADDR_BITS>;
    var req_wdata: logic<128>      ;

    let req_col : logic<COL_BITS>  = {req_addr[COL_BITS - 4:0], 3'b000};
    let req_bank: logic<BANK_BITS> = req_addr[COL_BITS - 3+:BANK_BITS];
    let req_row : logic<ROW_BITS>  = req_addr[COL_BITS - 3 + BANK_BITS+:ROW_BITS];
    let req_hit : logic            = row_open && open_bank == req_bank && open_row == req_row;

    const CAL_COL : logic<COL_BITS>  = {CAL_ADDR[COL_BITS - 4:0], 3'b000};
    const CAL_BANK: logic<BANK_BITS> = CAL_ADDR[COL_BITS - 3+:BANK_BITS];
    const CAL_ROW : logic<ROW_BITS>  = CAL_ADDR[COL_BITS - 3 + BANK_BITS+:ROW_BITS];

    var init_done: logic;
    assign o_req_ready = init_done && !req_pend;
    assign o_init_done = init_done;

    assign o_cs_n  = cmd[3];
    assign o_ras_n = cmd[2];
    assign o_cas_n = cmd[1];
    assign o_we_n  = cmd[0];
    assign o_odt   = 1'b0;

    function sat_dec (
        c: input logic<5>,
    ) -> logic<5> {
        return if c == 5'd0 ? 5'd0 : c - 5'd1;
    }
    // at least n cycles from now (counter value n - 1 after this cycle)
    function at_least (
        c: input logic<5>,
        n: input u32     ,
    ) -> logic<5> {
        var d: logic<5>;
        d = sat_dec(c);
        return if d >: (n - 1) as 5 ? d : (n - 1) as 5;
    }

    // ------------------------------------------------------------------
    // Write pipeline: stage a is the write whose command is on the PHY
    // port this cycle (a = 0: wr_issue / wr_data, registered with the
    // command) or a cycles ago (wp_*[a - 1]). The slot vectors are
    // registered, so what is built from stage a shows up one pclk later,
    // at slots 8 (a + 1) + s of that write. Four stages cover CL 3..6.
    // ------------------------------------------------------------------
    var wp_valid: logic<3>      ;
    var wp_data : logic<128> [3];
    var wr_issue: logic         ;
    var wr_data : logic<128>    ;
    var st_valid: logic<4>      ;
    var st_data : logic<128> [4];
    always_comb {
        st_valid   = {wp_valid, wr_issue};
        st_data[0] = wr_data;
        for a in 1..4 {
            st_data[a] = wp_data[a - 1];
        }
    }

    // Calibration pattern: beat b = 0x5A3C ^ {b, b, b, b}.
    function cal_beat (
        b: input logic<4>,
    ) -> logic<16> {
        return 16'h5A3C ^ {b repeat 4};
    }
    var cal_pattern: logic<128>;
    always_comb {
        for b in 0..8 {
            cal_pattern[16 * b+:16] = cal_beat(b[3:0]);
        }
    }

    var dq_n    : logic<128>;
    var dq_oe_n : logic<4>  ;
    var dqs_n   : logic<16> ;
    var dqs_oe_n: logic<4>  ;
    always_comb {
        dq_n     = 128'd0;
        dq_oe_n  = 4'd0;
        dqs_n    = 16'd0;
        dqs_oe_n = 4'd0;
        // padding slots first (T0 - 2: beat 0 early, T0 + 15: beat 7
        // late), then the real beats, which win where a following /
        // preceding write pads
        for a in 0..4 {
            for s in 0..8 {
                if st_valid[a] {
                    if 8 * (a + 1) + s + 2 == T0 {
                        dq_n[16 * s+:16] = st_data[a][15:0];
                    }
                    if 8 * (a + 1) + s == T0 + 15 {
                        dq_n[16 * s+:16] = st_data[a][127:112];
                    }
                }
            }
        }
        for a in 0..4 {
            for s in 0..8 {
                if st_valid[a] {
                    if 8 * (a + 1) + s + 1 >= T0 && 8 * (a + 1) + s <: T0 + 15 {
                        dq_n[16 * s+:16] = st_data[a][16 * ((8 * (a + 1) + s + 1 - T0) / 2)+:16];
                    }
                    if 8 * (a + 1) + s + 2 >= T0 && 8 * (a + 1) + s <: T0 + 16 {
                        dq_oe_n[s / 2]  = 1'b1;
                        dqs_oe_n[s / 2] = 1'b1;
                    }
                    if 8 * (a + 1) + s >= T0 && 8 * (a + 1) + s <: T0 + 16 && (8 * (a + 1) + s - T0) % 4 <: 2 {
                        dqs_n[2 * s+:2] = 2'b11;
                    }
                }
            }
        }
    }

    always_ff {
        if i_rst {
            wp_valid  = 3'd0;
            o_dq_out  = 128'd0;
            o_dq_oe   = 4'd0;
            o_dqs_out = 16'd0;
            o_dqs_oe  = 4'd0;
        } else {
            wp_valid  = {wp_valid[1:0], wr_issue};
            o_dq_out  = dq_n;
            o_dq_oe   = dq_oe_n;
            o_dqs_out = dqs_n;
            o_dqs_oe  = dqs_oe_n;
        }
    }
    always_ff {
        wp_data[0] = wr_data;
        for a in 1..3 {
            wp_data[a] = wp_data[a - 1];
        }
    }

    // ------------------------------------------------------------------
    // Read capture
    // ------------------------------------------------------------------
    var cal_sel     : logic<4>; // slot of beat 0 in the window (even beats), 0..9
    var cal_sel_odd : logic<4>; // slot of beat 1 (odd beats)
    var cal_lat     : logic<4>;
    var cal_eval    : logic   ; // window frozen, scanning candidates
    var cal_rd_pend : logic   ;
    var cal_cnt     : logic<4>;
    var scan_sel    : logic<4>;
    var scan_first  : logic<4>;
    var scan_last   : logic<4>;
    var scan_found  : logic   ;
    var scan_first_o: logic<4>;
    var scan_last_o : logic<4>;
    var scan_found_o: logic   ;
    var scan_done   : logic   ;
    var cal_ok      : logic   ;
    var cal_fail    : logic   ;

    assign o_cal_ok     = cal_ok;
    assign o_cal_fail   = cal_fail;
    assign o_rd_sel     = {2'b0, cal_sel};
    assign o_rd_sel_odd = {2'b0, cal_sel_odd};
    assign o_rd_lat     = cal_lat;

    var sel_used    : logic<4>;
    var sel_odd_used: logic<4>;
    always_comb {
        if cal_eval {
            sel_used     = scan_sel;
            sel_odd_used = scan_sel;
        } else {
            sel_used     = cal_sel;
            sel_odd_used = cal_sel_odd;
        }
    }

    var scan_valid_q: logic;

    // The calibration freezes the window from the cycle a read with RD_LAT
    // would take its beats.
    let hist_hold: logic = cal_eval || scan_valid_q || (cal_rd_pend && cal_cnt == cal_lat);

    // Sample window: the last 3 pclk (24 slots) per DQ bit, index = slot,
    // 0 oldest (index 8k + s = slot s of the pclk 2 - k cycles before the
    // newest). A burst spans 16 slots, so with the start slot 0..9 and
    // RD_LAT in whole pclk every alignment is covered (the 64-slot history
    // of Ddr3Ctrl is not needed).
    var hist_dq: logic<24> [16];
    always_ff {
        if i_rst {
            for i in 0..16 {
                hist_dq[i] = 24'd0;
            }
        } else if !hist_hold {
            for i in 0..16 {
                for s in 0..8 {
                    hist_dq[i][16 + s] = i_dq_in[16 * s + i];
                }
                hist_dq[i][15:0] = hist_dq[i][23:8];
            }
        }
    }

    // beat b: slot RD_SEL + 2b (even), RD_SEL_ODD + 2(b - 1) (odd)
    var rd_beats: logic<16> [8];
    always_comb {
        for i in 0..16 {
            for b in 0..8 {
                var idx: logic<5>;
                if b[0] {
                    idx            = {1'b0, sel_odd_used} + (b[4:0] - 1) * 2;
                    rd_beats[b][i] = hist_dq[i][idx];
                } else {
                    idx            = {1'b0, sel_used} + b[4:0] * 2;
                    rd_beats[b][i] = hist_dq[i][idx];
                }
            }
        }
    }

    // calibration scan: candidate -> extracted beats (registered) -> compare
    var rd_beats_q  : logic<16> [8];
    var scan_sel_q  : logic<4>     ;
    var scan_match  : logic        ;
    var scan_match_o: logic        ;
    always_ff {
        rd_beats_q   = rd_beats;
        scan_sel_q   = scan_sel;
        scan_valid_q = cal_eval;
    }
    always_comb {
        scan_match   = 1'b1;
        scan_match_o = 1'b1;
        for b in 0..8 {
            if rd_beats_q[b] != cal_beat(b[3:0]) {
                if b[0] {
                    scan_match_o = 1'b0;
                } else {
                    scan_match = 1'b0;
                }
            }
        }
    }
    let scan_sum  : logic<5> = {1'b0, scan_first} + {1'b0, scan_last};
    let scan_sum_o: logic<5> = {1'b0, scan_first_o} + {1'b0, scan_last_o};

    // run-time reads: rd_pipe[k] = a read command was on the PHY port k + 1
    // cycles ago (rd_issue: this cycle). The beats are taken RD_LAT - 1
    // cycles after the command, like the calibration snapshot.
    var rd_pipe : logic<15> ;
    var rd_issue: logic     ;
    var rd_valid: logic     ;
    var rd_data : logic<128>;
    let rd_hist : logic<16>  = {rd_pipe, rd_issue};
    assign o_rd_valid = rd_valid;
    assign o_rd_data  = rd_data;

    always_ff {
        if i_rst {
            rd_pipe  = 15'd0;
            rd_valid = 1'b0;
        } else {
            rd_valid = rd_hist[cal_lat - 4'd1];
            rd_pipe  = {rd_pipe[13:0], rd_issue};
        }
        for b in 0..8 {
            rd_data[16 * b+:16] = rd_beats[b];
        }
    }

    // ------------------------------------------------------------------
    // Command FSM
    // ------------------------------------------------------------------
    always_ff {
        if i_rst {
            state        = State::PWRUP;
            timer        = 16'd0;
            pwr_cnt      = 24'd0;
            cmd          = CMD_NOP;
            o_cke        = 1'b0;
            o_ba         = 0;
            o_a          = 0;
            ref_cnt      = 16'd0;
            ref_due      = 1'b0;
            ref_on       = 1'b0;
            cnt_act      = 5'd0;
            cnt_pre      = 5'd0;
            cnt_rd       = 5'd0;
            cnt_wr       = 5'd0;
            row_open     = 1'b0;
            open_bank    = 0;
            open_row     = 0;
            req_pend     = 1'b0;
            req_we       = 1'b0;
            req_addr     = 0;
            req_wdata    = 128'd0;
            init_done    = 1'b0;
            wr_issue     = 1'b0;
            wr_data      = 128'd0;
            rd_issue     = 1'b0;
            cal_sel      = RD_SEL_DEFAULT[3:0];
            cal_sel_odd  = RD_SEL_DEFAULT[3:0] + 4'd2;
            cal_lat      = RD_LAT_DEFAULT[3:0];
            cal_eval     = 1'b0;
            cal_rd_pend  = 1'b0;
            cal_cnt      = 4'd0;
            scan_sel     = 4'd0;
            scan_first   = 4'd0;
            scan_last    = 4'd0;
            scan_found   = 1'b0;
            scan_first_o = 4'd0;
            scan_last_o  = 4'd0;
            scan_found_o = 1'b0;
            scan_done    = 1'b0;
            cal_ok       = 1'b0;
            cal_fail     = 1'b0;
        } else {
            cmd      = if o_cke ? CMD_DES : CMD_NOP;
            wr_issue = 1'b0;
            rd_issue = 1'b0;
            cnt_act  = sat_dec(cnt_act);
            cnt_pre  = sat_dec(cnt_pre);
            cnt_rd   = sat_dec(cnt_rd);
            cnt_wr   = sat_dec(cnt_wr);

            if o_req_ready && i_req_valid {
                req_pend  = 1'b1;
                req_we    = i_req_we;
                req_addr  = i_req_addr;
                req_wdata = i_req_wdata;
            }

            // refresh interval (from the first REF of the init on)
            if ref_on {
                if ref_cnt >= (C_REFI - 1) as 16 {
                    ref_cnt = 16'd0;
                    ref_due = 1'b1;
                } else {
                    ref_cnt = ref_cnt + 16'd1;
                }
            }

            // ---- calibration read capture / scan ----
            if cal_rd_pend {
                if cal_cnt == cal_lat {
                    cal_rd_pend  = 1'b0;
                    cal_eval     = 1'b1;
                    scan_sel     = 4'd0;
                    scan_found   = 1'b0;
                    scan_found_o = 1'b0;
                    scan_done    = 1'b0;
                } else {
                    cal_cnt = cal_cnt + 4'd1;
                }
            }
            if cal_eval {
                if scan_sel == SCAN_LAST {
                    cal_eval = 1'b0;
                } else {
                    scan_sel = scan_sel + 4'd1;
                }
            }
            if scan_valid_q {
                if scan_match {
                    if !scan_found {
                        scan_first = scan_sel_q;
                    }
                    scan_found = 1'b1;
                    scan_last  = scan_sel_q;
                }
                if scan_match_o {
                    if !scan_found_o {
                        scan_first_o = scan_sel_q;
                    }
                    scan_found_o = 1'b1;
                    scan_last_o  = scan_sel_q;
                }
                if scan_sel_q == SCAN_LAST {
                    scan_done = 1'b1;
                }
            }

            if timer != 16'd0 {
                timer = timer - 16'd1;
            } else {
                case state {
                    State::PWRUP: {
                        if pwr_cnt == C_INIT as 24 {
                            o_cke = 1'b1;
                            timer = (C_CKE - 1) as 16;
                            state = State::CKE;
                        } else {
                            pwr_cnt = pwr_cnt + 24'd1;
                        }
                    }
                    State::CKE: {
                        cmd   = CMD_PRE;
                        o_a   = ROW_A10; // A10: all banks
                        timer = (C_RP - 1) as 16;
                        state = State::PREA1;
                    }
                    State::PREA1: {
                        cmd   = CMD_MRS;
                        o_ba  = 2 as BANK_BITS;
                        o_a   = 0;
                        timer = C_MRD as 16;
                        state = State::EMR2;
                    }
                    State::EMR2: {
                        cmd   = CMD_MRS;
                        o_ba  = 3 as BANK_BITS;
                        o_a   = 0;
                        timer = C_MRD as 16;
                        state = State::EMR3;
                    }
                    State::EMR3: {
                        cmd   = CMD_MRS;
                        o_ba  = 1 as BANK_BITS;
                        o_a   = EMR1 as ROW_BITS;
                        timer = C_MRD as 16;
                        state = State::EMR1;
                    }
                    State::EMR1: {
                        cmd   = CMD_MRS;
                        o_ba  = 0 as BANK_BITS;
                        o_a   = MR_DLL as ROW_BITS;
                        timer = C_MRD as 16;
                        state = State::MR_DLLRST;
                    }
                    State::MR_DLLRST: {
                        cmd   = CMD_PRE;
                        o_a   = ROW_A10;
                        timer = (C_RP - 1) as 16;
                        state = State::PREA2;
                    }
                    State::PREA2: {
                        cmd    = CMD_REF;
                        ref_on = 1'b1;
                        timer  = (C_RFC - 1) as 16;
                        state  = State::REF1;
                    }
                    State::REF1: {
                        cmd   = CMD_REF;
                        timer = (C_RFC - 1) as 16;
                        state = State::REF2;
                    }
                    State::REF2: {
                        cmd   = CMD_MRS;
                        o_ba  = 0 as BANK_BITS;
                        o_a   = MR_RUN as ROW_BITS;
                        timer = C_DLL as 16;
                        state = State::MR_RUN;
                    }
                    State::MR_RUN: {
                        cmd   = CMD_MRS;
                        o_ba  = 1 as BANK_BITS;
                        o_a   = EMR1_OCD as ROW_BITS;
                        timer = C_MRD as 16;
                        state = State::OCD_DEF;
                    }
                    State::OCD_DEF: {
                        cmd   = CMD_MRS;
                        o_ba  = 1 as BANK_BITS;
                        o_a   = EMR1 as ROW_BITS;
                        timer = C_MRD as 16;
                        state = if CAL_ENABLE ? State::OCD_EXIT : State::CAL_PRE;
                    }
                    State::OCD_EXIT: {
                        cmd     = CMD_ACT;
                        o_ba    = CAL_BANK;
                        o_a     = CAL_ROW;
                        timer   = (C_RCD - 1) as 16;
                        cal_lat = CAL_LAT_MIN[3:0];
                        state   = State::CAL_ACT;
                    }
                    State::CAL_ACT: {
                        cmd      = CMD_WR;
                        o_ba     = CAL_BANK;
                        o_a      = {{1'b0 repeat ROW_BITS - COL_BITS}, CAL_COL};
                        wr_issue = 1'b1;
                        wr_data  = cal_pattern;
                        // extra gap: the PHY input also sees our own write,
                        // which must have left the 8-pclk history
                        timer = (C_WR2RD + 8) as 16;
                        state = State::CAL_WR;
                    }
                    State::CAL_WR, State::CAL_RD: {
                        cmd         = CMD_RD;
                        o_ba        = CAL_BANK;
                        o_a         = {{1'b0 repeat ROW_BITS - COL_BITS}, CAL_COL};
                        cal_rd_pend = 1'b1;
                        cal_cnt     = 4'd1;
                        state       = State::CAL_WAIT;
                    }
                    State::CAL_WAIT: {
                        if scan_done {
                            scan_done = 1'b0;
                            if scan_found && scan_found_o {
                                cal_sel     = scan_sum[4:1];
                                cal_sel_odd = scan_sum_o[4:1];
                                cal_ok      = 1'b1;
                                state       = State::CAL_PRE;
                            } else if cal_lat <: CAL_LAT_MAX[3:0] {
                                // nothing in the window: look later
                                cal_lat = cal_lat + 4'd1;
                                timer   = 16'd8;
                                state   = State::CAL_RD;
                            } else {
                                cal_sel     = RD_SEL_DEFAULT[3:0];
                                cal_sel_odd = RD_SEL_DEFAULT[3:0] + 4'd2;
                                cal_lat     = RD_LAT_DEFAULT[3:0];
                                cal_fail    = 1'b1;
                                state       = State::CAL_PRE;
                            }
                        }
                    }
                    State::CAL_PRE: {
                        cmd       = CMD_PRE;
                        o_a       = ROW_A10;
                        row_open  = 1'b0;
                        cnt_act   = (C_RP - 1) as 5;
                        init_done = 1'b1;
                        state     = State::RUN;
                    }
                    State::RUN: {
                        if ref_due {
                            if row_open {
                                if cnt_pre == 5'd0 {
                                    cmd      = CMD_PRE;
                                    o_a      = ROW_A10;
                                    row_open = 1'b0;
                                    cnt_act  = at_least(cnt_act, C_RP);
                                }
                            } else if cnt_act == 5'd0 {
                                cmd     = CMD_REF;
                                ref_due = 1'b0;
                                cnt_act = at_least(cnt_act, C_RFC);
                            }
                        } else if req_pend {
                            if req_hit {
                                if req_we {
                                    if cnt_wr == 5'd0 {
                                        cmd      = CMD_WR;
                                        o_ba     = req_bank;
                                        o_a      = {{1'b0 repeat ROW_BITS - COL_BITS}, req_col};
                                        wr_issue = 1'b1;
                                        wr_data  = req_wdata;
                                        req_pend = 1'b0;
                                        cnt_wr   = at_least(cnt_wr, C_BURST);
                                        cnt_rd   = at_least(cnt_rd, C_WR2RD);
                                        cnt_pre  = at_least(cnt_pre, C_WR2PRE);
                                    }
                                } else if cnt_rd == 5'd0 {
                                    cmd      = CMD_RD;
                                    o_ba     = req_bank;
                                    o_a      = {{1'b0 repeat ROW_BITS - COL_BITS}, req_col};
                                    rd_issue = 1'b1;
                                    req_pend = 1'b0;
                                    cnt_rd   = at_least(cnt_rd, C_BURST);
                                    cnt_wr   = at_least(cnt_wr, C_RD2WR);
                                    cnt_pre  = at_least(cnt_pre, C_RD2PRE);
                                }
                            } else if row_open {
                                if cnt_pre == 5'd0 {
                                    cmd      = CMD_PRE;
                                    o_a      = ROW_A10;
                                    row_open = 1'b0;
                                    cnt_act  = at_least(cnt_act, C_RP);
                                }
                            } else if cnt_act == 5'd0 {
                                cmd       = CMD_ACT;
                                o_ba      = req_bank;
                                o_a       = req_row;
                                row_open  = 1'b1;
                                open_bank = req_bank;
                                open_row  = req_row;
                                cnt_act   = at_least(cnt_act, C_RC);
                                cnt_pre   = at_least(cnt_pre, C_RAS);
                                cnt_rd    = at_least(cnt_rd, C_RCD);
                                cnt_wr    = at_least(cnt_wr, C_RCD);
                            }
                        }
                    }
                    default: {
                        state = State::PWRUP;
                    }
                }
            }
        }
    }

    let _unused: logic = |i_dqs_in;
}
