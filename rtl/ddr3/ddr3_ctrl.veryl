// Copied from ~/repos/riscv-veryl/src/ddr3_ctrl.veryl (commit 78e2537, 2026-09-10) for the NVMe DDR3 namespace.
// Keep in sync with the RISC-V project; local changes should be upstreamed there.
// DDR3 SDRAM controller (single x16 device, BL8, closed-page, DLL-off).
//
// Sits between the CPU-side 128-bit line bus (`LineBusIf` slave; one
// line = one BL8 burst of the x16 device) and a thin DDR3 PHY. Everything the PHY needs to know is
// expressed as *slot vectors* in the memory-side clock domain, so the same
// controller drives either the Gowin GW2A IOLOGIC wrapper on the Tang
// Primer 20K (`Ddr3PhyGw2a`) or the behavioural DRAM model used under
// the simulator (`sim/ddr3/ddr3_model.sv`). See doc/ddr3_controller.md.
//
// Clocking
// --------
//   i_clk_cpu : CPU / bus clock. `bus` and `ctl` live here.
//   i_clk_mem : "pclk" = DDR3 CK / 2. The command FSM, the write pattern
//               generator and the read capture run here. One DDR3 CK is
//               4 *slots* (fclk = 2 x CK, DDR), so one pclk cycle is 8 slots.
//   Requests cross the domains with a toggle + 2-FF synchroniser in each
//   direction. At most one DRAM transaction is in flight (`ready` stays
//   low until it completes, so posted writes and the reads behind them
//   are processed strictly in order); the payload registers are stable
//   while the toggle propagates. Partial writes use the DM pins (no
//   read-modify-write).
//
// PHY-side slot-vector interface (pclk domain, one pclk = 8 slots)
// ----------------------------------------------------------------
//   Commands are SDR and are only ever issued in the first CK of a pclk
//   cycle: the PHY drives {cs_n, ras_n, cas_n, we_n, ba, a} for CK 0 and
//   DESELECT for CK 1. CK itself is generated by the PHY as slots
//   {0,0,1,1,0,0,1,1} (rising edges at the start of slots 2 and 6), so
//   the command changes 2 slots (half a CK) before the CK edge samples it.
//   o_dq_out[16*s +: 16]  DQ value driven during slot s
//   o_dq_oe[s/2]          DQ output enable for slots 2i, 2i+1
//   o_dm_out[2*s +: 2]    {UDM, LDM} during slot s
//   o_dqs_out[2*s +: 2]   {DQSU, DQSL} during slot s (DQS# = inverse)
//   o_dqs_oe[s/2]         DQS output enable
//   i_dq_in[16*s +: 16]   DQ sampled at slot s (IDES8 / model output)
//   i_dqs_in[2*s +: 2]    DQS sampled at slot s (for calibration only)
//
// Write timing (WR at pclk N, CK 0, CWL = 6): first DQS rising edge is
// 6 CK = 24 slots after the CK edge that sampled WR (slot 2 of N), i.e.
// slot 2 of N+3. DQS preamble is driven low from slot 6 of N+2, the eight
// data beats are centred on the DQS edges (beat b occupies slots
// 2b+1 .. 2b+2 counted from N+3 slot 0), and the postamble occupies
// slots 0..1 of N+5.
//
// Read timing (RD at pclk N, CL = 6): the DRAM drives beat 0 from slot 2
// of N+3 (+ tDQSCK + flight time). We do not use DQS for capture: the
// PHY samples DQ (and DQS) at every slot, the controller keeps a 64-slot
// history per DQ bit and picks the eight beats at slot RD_SEL + 2b of
// the history `RD_LAT` pclk cycles after the command.
//
// Read auto-calibration (CAL_ENABLE): right after ZQCL, before init_done,
// the controller writes a fixed 8-beat pattern to the line at CAL_ADDR
// (default: the last line of the device), reads it back, freezes the
// sample history and scans every RD_SEL candidate for an exact match of
// all 128 bits; RD_SEL becomes the middle of the matching run. If nothing
// matches, RD_LAT is stepped from CAL_LAT_MIN to CAL_LAT_MAX and the read
// repeated; if that fails too STATUS.cal_fail is set and the defaults
// stay. Software can still override both through RD_CAL (a write sets
// the override, the register reads back the values in use), and the DQS
// history is exposed for manual sweeps on the board.
//
// Control registers (`ctl`, byte offsets, CPU domain)
// ---------------------------------------------------
//   0x00 STATUS  RO  bit 0 = init done (DRAM initialised, refresh running)
//                    bit 1 = auto-calibration found a working RD_SEL
//                    bit 2 = auto-calibration failed (defaults in use)
//   0x04 RD_CAL  RW  [5:0] RD_SEL (history slot of beat 0, used for the
//                    even beats 0,2,4,6 at RD_SEL + 2b), [11:8] RD_LAT
//                    (pclk cycles from RD to the history snapshot),
//                    [21:16] RD_SEL_ODD (slot of beat 1; odd beats
//                    1,3,5,7 at RD_SEL_ODD + 2(b-1)). Even and odd beats
//                    are calibrated separately so a duty-cycle asymmetry
//                    of the sampling (rising/falling fclk edge) does not
//                    push the odd beats onto the previous beat. Reads
//                    return the values in use (auto-calibrated unless
//                    written); a write overrides all until reset.
//   0x28 RECAL   RW  bit 0 = periodic re-calibration enable (default
//                    RECAL_ENABLE). Every 2^RECAL_REF_SHIFT refreshes the
//                    controller repeats the pattern write / read / scan on
//                    the scratch line and, if the scan matches, moves
//                    RD_SEL / RD_SEL_ODD; a miss keeps the old values.
//                    The scratch line must then be kept away from software
//                    (reserve the last 4 KiB in the device tree).
//   0x2C RECAL_COUNT RO number of successful re-calibrations
//   0x30 RECAL_FAIL  RO number of re-calibrations that found nothing
//   0x34 RECAL_RANGE RO {2'b0, sel_odd_max, 2'b0, sel_odd_min,
//                        2'b0, sel_max, 2'b0, sel_min}: the range the
//                    calibrated slots have covered since init (drift)
//   0x08/0x0C    RO  DQSL history (lo/hi 32 slots) at the last snapshot
//   0x10/0x14    RO  DQSU history
//   0x18/0x1C    RO  DQ[0] history
//   0x20/0x24    RO  DQ[8] history
//   Histories: bit i = slot i, i = 0 is the oldest of the 64 slots.
//
// Address map inside the device (byte address `addr`, 128 MiB):
//   col  = {addr[COL_BITS:4], 3'b000}         (BL8 aligned)
//   bank = addr[COL_BITS+1 +: BANK_BITS]
//   row  = addr[COL_BITS+1+BANK_BITS +: ROW_BITS]
module Ddr3Ctrl #(
    // pclk period in ps (pclk = CK / 2). 13333 ps = 75 MHz pclk = 150 MHz
    // CK = 300 MT/s.
    param PCLK_PS: u32 = 13333,
    // Device geometry (H5TQ1G63EFR / MT41K64M16: 1 Gbit x16).
    param ROW_BITS : u32 = 13,
    param COL_BITS : u32 = 10,
    param BANK_BITS: u32 = 3 ,
    // DDR3 timing (ps unless noted). Conservative DDR3-1600 1 Gb values;
    // tRFC defaults to the 2 Gb figure so a bigger part also works.
    param T_RESET_PS: u32 = 200_000_000, // RESET# low after power up (200 us)
    param T_CKE_PS  : u32 = 500_000_000, // CKE low after RESET# high (500 us)
    param T_XPR_PS  : u32 = 170_000    , // CKE high -> first MRS (tRFC + 10 ns)
    param T_RCD_PS  : u32 = 13_750     ,
    param T_RP_PS   : u32 = 13_750     ,
    param T_WR_PS   : u32 = 15_000     ,
    param T_RFC_PS  : u32 = 160_000    ,
    param T_REFI_PS : u32 = 7_800_000  ,
    // Read capture defaults (see header), used when CAL_ENABLE = 0 or the
    // calibration fails. With the snapshot RD_LAT = 9 cycles after the RD
    // command (the extraction is registered once, so the snapshot sees the
    // history one pclk old) the sim model's samples put beat 0 at history
    // slots 42..43; the real PHY has a different IDES8 latency, which is
    // what the auto-calibration absorbs.
    param RD_SEL_DEFAULT: u32 = 42,
    param RD_LAT_DEFAULT: u32 = 9 ,
    // Read auto-calibration at init (see header). CAL_ADDR is the byte
    // offset of the scratch line (its 16 bytes are overwritten).
    param CAL_ENABLE: bit       = 1            ,
    param CAL_ADDR  : logic<32> = 32'h07FF_FFF0,
    // The scan only looks at windows that start at or after the RD
    // command (RD_LAT >= 8): the PHY input also sees the controller's own
    // pattern write, and with the IOLOGIC round trip that echo would
    // otherwise be found first. The read is also issued a few cycles later
    // than a normal one so the echo has left the history.
    param CAL_LAT_MIN: u32 = 8 ,
    param CAL_LAT_MAX: u32 = 15,
    // Periodic re-calibration (see the register map). Off by default: it
    // overwrites the scratch line at run time.
    param RECAL_ENABLE   : bit = 0 ,
    param RECAL_REF_SHIFT: u32 = 16, // every 2^16 refreshes ~ 0.5 s
) (
    i_clk_cpu: input 'a clock          ,
    i_rst_cpu: input 'a reset_sync_high,
    i_clk_mem: input 'b clock          ,
    i_rst_mem: input 'b reset_sync_high,

    // CPU side
    bus: modport 'a LineBusIf::slave, // 16-byte line requests
    ctl: modport 'a BusIf::slave    , // control / calibration registers

    // PHY side (pclk domain)
    o_reset_n: output 'b logic     ,
    o_cke    : output 'b logic     ,
    o_odt    : output 'b logic     ,
    o_cs_n   : output 'b logic     ,
    o_ras_n  : output 'b logic     ,
    o_cas_n  : output 'b logic     ,
    o_we_n   : output 'b logic     ,
    o_ba     : output 'b logic<3>  ,
    o_a      : output 'b logic<14> ,
    o_dq_out : output 'b logic<128>,
    o_dq_oe  : output 'b logic<4>  ,
    o_dm_out : output 'b logic<16> ,
    o_dqs_out: output 'b logic<16> ,
    o_dqs_oe : output 'b logic<4>  ,
    i_dq_in  : input  'b logic<128>,
    i_dqs_in : input  'b logic<16> ,

    o_init_done: output 'b logic,
) {
    // ------------------------------------------------------------------
    // Derived timing (pclk cycles, rounded up)
    // ------------------------------------------------------------------
    const CK_PS   : u32 = PCLK_PS / 2;
    const C_RESET : u32 = (T_RESET_PS + PCLK_PS - 1) / PCLK_PS;
    const C_CKE   : u32 = (T_CKE_PS + PCLK_PS - 1) / PCLK_PS;
    const C_XPR   : u32 = (T_XPR_PS + PCLK_PS - 1) / PCLK_PS;
    const C_MRD   : u32 = 2; // tMRD = 4 CK
    const C_MOD   : u32 = 6; // tMOD = max(12 CK, 15 ns) -> 12 CK
    const C_ZQINIT: u32 = 256; // tZQinit = 512 CK
    const C_RCD   : u32 = (T_RCD_PS + PCLK_PS - 1) / PCLK_PS;
    // WR -> next ACT: WL (6 CK) + BL8 (4 CK) + tWR + tRP (auto precharge).
    const C_WR_BUSY: u32 = (10 * CK_PS + T_WR_PS + T_RP_PS + PCLK_PS - 1) / PCLK_PS;
    // RD -> next ACT: tRTP (4 CK) + tRP; the read also waits RD_LAT for
    // its data, whichever is longer.
    const C_RD_BUSY: u32 = (4 * CK_PS + T_RP_PS + PCLK_PS - 1) / PCLK_PS;
    const C_RFC    : u32 = (T_RFC_PS + PCLK_PS - 1) / PCLK_PS;
    const C_REFI   : u32 = T_REFI_PS / PCLK_PS;

    // Mode registers (DLL off, CL = 6, CWL = 6, BL8, WR = 6, no ODT).
    const MR0: logic<14> = 14'h0420; // WR=6 (A11:9=010), CL=6 (A6:4=010,A2=0), BL8
    const MR1: logic<14> = 14'h0001; // DLL disable, RZQ/6, RTT_NOM off, AL=0
    const MR2: logic<14> = 14'h0008; // CWL=6 (A5:3=001), RTT_WR off
    const MR3: logic<14> = 14'h0000;

    // {cs_n, ras_n, cas_n, we_n}
    const CMD_MRS : logic<4> = 4'b0000;
    const CMD_REF : logic<4> = 4'b0001;
    const CMD_ACT : logic<4> = 4'b0011;
    const CMD_WR  : logic<4> = 4'b0100;
    const CMD_RD  : logic<4> = 4'b0101;
    const CMD_ZQCL: logic<4> = 4'b0110;
    const CMD_DES : logic<4> = 4'b1111;

    // ------------------------------------------------------------------
    // CPU domain: request capture, control registers
    // ------------------------------------------------------------------
    var req_tog   : 'a logic     ; // toggles per request (cpu -> mem)
    var done_tog_m: 'b logic     ; // toggles per completion (mem -> cpu)
    var done_s1   : 'a logic     ;
    var done_s2   : 'a logic     ;
    var done_s3   : 'a logic     ;
    var req_addr  : 'a logic<32> ;
    var req_we    : 'a logic     ;
    var req_wstrb : 'a logic<16> ;
    var req_wdata : 'a logic<128>;
    var rsp_data  : 'b logic<128>; // written by mem domain before done toggles

    var init_done_m : 'b logic;
    var init_done_s1: 'a logic;
    var init_done_s2: 'a logic;
    var cal_ok_m    : 'b logic;
    var cal_fail_m  : 'b logic;
    var cal_ok_s1   : 'a logic;
    var cal_ok_s2   : 'a logic;
    var cal_fail_s1 : 'a logic;
    var cal_fail_s2 : 'a logic;

    let busy: 'a logic = req_tog != done_s2;
    let done: 'a logic = done_s2 != done_s3; // one-cycle completion pulse

    let engine_idle: 'a logic = !busy && init_done_s2;
    let grant      : 'a logic = bus.valid && engine_idle;

    assign bus.ready = engine_idle;

    var rvalid_q: 'a logic     ;
    var rdata_q : 'a logic<128>;

    assign bus.rvalid = rvalid_q;
    assign bus.rdata  = rdata_q;

    unsafe (cdc) {
        always_ff (i_clk_cpu, i_rst_cpu) {
            if_reset {
                req_tog      = 1'b0;
                done_s1      = 1'b0;
                done_s2      = 1'b0;
                done_s3      = 1'b0;
                init_done_s1 = 1'b0;
                init_done_s2 = 1'b0;
                cal_ok_s1    = 1'b0;
                cal_ok_s2    = 1'b0;
                cal_fail_s1  = 1'b0;
                cal_fail_s2  = 1'b0;
                req_addr     = 32'b0;
                req_we       = 1'b0;
                req_wstrb    = 16'b0;
                req_wdata    = 128'b0;
                rvalid_q     = 1'b0;
                rdata_q      = 128'b0;
            } else {
                done_s1      = done_tog_m;
                done_s2      = done_s1;
                done_s3      = done_s2;
                init_done_s1 = init_done_m;
                init_done_s2 = init_done_s1;
                cal_ok_s1    = cal_ok_m;
                cal_ok_s2    = cal_ok_s1;
                cal_fail_s1  = cal_fail_m;
                cal_fail_s2  = cal_fail_s1;

                rvalid_q = 1'b0;

                if grant {
                    req_addr  = bus.addr;
                    req_we    = bus.we;
                    req_wstrb = bus.wstrb;
                    req_wdata = bus.wdata;
                    req_tog   = ~req_tog;
                }

                if done && !req_we {
                    rvalid_q = 1'b1;
                    rdata_q  = rsp_data;
                }
            }
        }
    }

    // ---- control registers ----
    var rd_sel       : 'a logic<6> ;
    var rd_sel_odd   : 'a logic<6> ;
    var rd_lat       : 'a logic<4> ;
    var rd_sw        : 'a logic    ; // RD_CAL written by software: overrides the calibration
    var recal_en     : 'a logic    ;
    var recal_count_c: 'a logic<32>; // copies from the memory domain (diagnostic)
    var recal_fail_c : 'a logic<32>;
    var recal_range_c: 'a logic<32>;
    var sel_eff      : 'a logic<6> ; // values in use (from the memory domain, quasi-static)
    var sel_odd_eff  : 'a logic<6> ;
    var lat_eff      : 'a logic<4> ;
    var ctl_rvalid   : 'a logic    ;
    var ctl_rdata    : 'a logic<32>;
    var dbg_dqsl     : 'b logic<64>; // mem domain, quasi-static when read
    var dbg_dqsu     : 'b logic<64>;
    var dbg_dq0      : 'b logic<64>;
    var dbg_dq8      : 'b logic<64>;

    assign ctl.ready  = 1'b1;
    assign ctl.rvalid = ctl_rvalid;
    assign ctl.rdata  = ctl_rdata;

    unsafe (cdc) {
        always_ff (i_clk_cpu, i_rst_cpu) {
            if_reset {
                rd_sel     = RD_SEL_DEFAULT[5:0];
                rd_sel_odd = RD_SEL_DEFAULT[5:0] + 6'd2;
                rd_lat     = RD_LAT_DEFAULT[3:0];
                rd_sw      = 1'b0;
                recal_en   = RECAL_ENABLE;
                ctl_rvalid = 1'b0;
                ctl_rdata  = 32'b0;
            } else {
                ctl_rvalid = ctl.valid && !ctl.we;
                if ctl.valid && ctl.we && ctl.addr[5:2] == 4'd1 {
                    // A partial write keeps the other field at its current
                    // effective value.
                    rd_sel     = sel_eff;
                    rd_sel_odd = sel_odd_eff;
                    rd_lat     = lat_eff;
                    if ctl.wstrb[0] {
                        rd_sel = ctl.wdata[5:0];
                    }
                    if ctl.wstrb[1] {
                        rd_lat = ctl.wdata[11:8];
                    }
                    if ctl.wstrb[2] {
                        rd_sel_odd = ctl.wdata[21:16];
                    }
                    rd_sw = 1'b1;
                }
                if ctl.valid && ctl.we && ctl.addr[5:2] == 4'd10 && ctl.wstrb[0] {
                    recal_en = ctl.wdata[0];
                }
                ctl_rdata = case ctl.addr[5:2] {
                    4'd0   : {29'b0, cal_fail_s2, cal_ok_s2, init_done_s2},
                    4'd1   : {10'b0, sel_odd_eff, 4'b0, lat_eff, 2'b0, sel_eff},
                    4'd2   : dbg_dqsl[31:0],
                    4'd3   : dbg_dqsl[63:32],
                    4'd4   : dbg_dqsu[31:0],
                    4'd5   : dbg_dqsu[63:32],
                    4'd6   : dbg_dq0[31:0],
                    4'd7   : dbg_dq0[63:32],
                    4'd8   : dbg_dq8[31:0],
                    4'd9   : dbg_dq8[63:32],
                    4'd10  : {31'b0, recal_en},
                    4'd11  : recal_count_c,
                    4'd12  : recal_fail_c,
                    4'd13  : recal_range_c,
                    default: 32'b0,
                };
            }
        }
    }

    // ------------------------------------------------------------------
    // Clock domain crossing (cpu -> mem). The request payload and the
    // calibration registers are only sampled by the memory domain after
    // the request toggle has passed through the 2-FF synchroniser (or, for
    // rd_sel / rd_lat, are quasi-static), so plain copies are safe.
    // ------------------------------------------------------------------
    var req_addr_m    : 'b logic<32> ;
    var req_we_m      : 'b logic     ;
    var req_wstrb_m   : 'b logic<16> ;
    var req_wdata_m   : 'b logic<128>;
    var rd_sel_m      : 'b logic<6>  ;
    var rd_sel_odd_m  : 'b logic<6>  ;
    var sel_odd_used  : 'b logic<6>  ;
    var sel_odd_used_q: 'b logic<6>  ;
    var rd_lat_m      : 'b logic<4>  ;
    var rd_sw_m       : 'b logic     ;
    var recal_en_m    : 'b logic     ;
    var recal_count   : 'b logic<32> ;
    var recal_fail    : 'b logic<32> ;
    var sel_min       : 'b logic<6>  ;
    var sel_max       : 'b logic<6>  ;
    var sel_odd_min   : 'b logic<6>  ;
    var sel_odd_max   : 'b logic<6>  ;
    var sel_used      : 'b logic<6>  ;
    var sel_used_q    : 'b logic<6>  ; // registered copy feeding the history mux
    var lat_used      : 'b logic<4>  ;
    unsafe (cdc) {
        assign rd_sw_m       = rd_sw;
        assign recal_en_m    = recal_en;
        assign recal_count_c = recal_count;
        assign recal_fail_c  = recal_fail;
        assign recal_range_c = {2'b0, sel_odd_max, 2'b0, sel_odd_min, 2'b0, sel_max, 2'b0, sel_min};
        assign sel_eff       = sel_used;
        assign sel_odd_eff   = sel_odd_used;
        assign lat_eff       = lat_used;
        assign req_addr_m    = req_addr;
        assign req_we_m      = req_we;
        assign req_wstrb_m   = req_wstrb;
        assign req_wdata_m   = req_wdata;
        assign rd_sel_m      = rd_sel;
        assign rd_sel_odd_m  = rd_sel_odd;
        assign rd_lat_m      = rd_lat;
    }

    // ------------------------------------------------------------------
    // Memory domain: init, refresh, command FSM
    // ------------------------------------------------------------------
    enum State {
        RESET,
        CKE,
        XPR,
        MR3,
        MR1,
        MR0,
        ZQ,
        CAL_START,
        IDLE,
        RW,
        RD_WAIT,
        WR_WAIT,
    }

    var   state       : 'b State    ;
    var   timer       : 'b logic<32>;
    var   ref_cnt     : 'b logic<32>;
    var   ref_due     : 'b logic    ;
    var   ref_total   : 'b logic<32>; // refreshes issued (re-calibration period)
    var   recal_due   : 'b logic    ;
    var   recal_active: 'b logic    ; // the running calibration is a periodic one
    const RECAL_MASK  : logic<32> = (32'd1 << RECAL_REF_SHIFT) - 1;
    var   req_s1      : 'b logic    ;
    var   req_s2      : 'b logic    ;
    var   req_s3      : 'b logic    ; // third stage: the payload copies (unconstrained
    // cross-domain paths) get one more pclk to settle
    // before the FSM issues ACT from them
    var cmd    : 'b logic<4>;
    var wr_cnt : 'b logic<3>;
    var rd_cnt : 'b logic<4>;
    var rd_pend: 'b logic   ;

    // ---- read auto-calibration ----
    var cal_active  : 'b logic   ; // the current ACT/RW/wait sequence is a calibration access
    var cal_we      : 'b logic   ; // calibration access is the pattern write
    var cal_sel     : 'b logic<6>; // result (defaults until calibrated)
    var cal_sel_odd : 'b logic<6>;
    var cal_lat     : 'b logic<4>;
    var cal_eval    : 'b logic   ; // history frozen, scanning candidates
    var scan_sel    : 'b logic<6>;
    var scan_first  : 'b logic<6>;
    var scan_last   : 'b logic<6>;
    var scan_found  : 'b logic   ;
    var scan_first_o: 'b logic<6>;
    var scan_last_o : 'b logic<6>;
    var scan_found_o: 'b logic   ;
    var scan_done   : 'b logic   ;

    // Pattern: beat b = 0x5A3C ^ {b, b, b, b} (all 16 DQ bits exercised).
    function cal_beat (
        b: input logic<4>,
    ) -> logic<16> {
        return 16'h5A3C ^ {b repeat 4};
    }

    // Effective capture setting: scanning during calibration, otherwise
    // the software override or the calibration result.
    always_comb {
        if cal_eval {
            sel_used     = scan_sel;
            sel_odd_used = scan_sel;
        } else if rd_sw_m {
            sel_used     = rd_sel_m;
            sel_odd_used = rd_sel_odd_m;
        } else {
            sel_used     = cal_sel;
            sel_odd_used = cal_sel_odd;
        }
        lat_used = if rd_sw_m ? rd_lat_m : cal_lat;
    }

    let pending: 'b logic = req_s3 != done_tog_m;

    // Column / bank / row from the byte address. COL_BITS is 10 for every
    // supported part; the row is taken 14 bits wide (A13 is 0 for a 1 Gb
    // device because the address never reaches bit 27).
    let addr_used: 'b logic<32>        = if cal_active ? CAL_ADDR : req_addr_m;
    let col      : 'b logic<10>        = {addr_used[10:4], 3'b000};
    let bank     : 'b logic<BANK_BITS> = addr_used[COL_BITS + 1+:BANK_BITS];
    let row      : 'b logic<14>        = addr_used[COL_BITS + 1 + BANK_BITS+:14];
    let we_used  : 'b logic            = if cal_active ? cal_we : req_we_m;

    assign o_cs_n      = cmd[3];
    assign o_ras_n     = cmd[2];
    assign o_cas_n     = cmd[1];
    assign o_we_n      = cmd[0];
    assign o_odt       = 1'b0;
    assign o_init_done = init_done_m;

    // Scan pipeline valid flags (assigned with the pipeline below).
    var scan_valid_q : 'b logic;
    var scan_valid_q2: 'b logic;
    var scan_valid_q3: 'b logic;

    // The calibration freezes the history from the same edge a normal
    // read would take its snapshot, so the scan sees exactly what a read
    // with the chosen RD_LAT sees.
    // (The extraction below is registered once more, so a read at RD_LAT
    // sees the history as it was one cycle earlier; the freeze starts one
    // cycle before the snapshot for the same reason.)
    let hist_hold: 'b logic = cal_eval || scan_valid_q || scan_valid_q2 || scan_valid_q3
        || (cal_active && rd_pend && ((rd_cnt + 1 == lat_used) || (rd_cnt == lat_used)));

    // Sample history: bit index = slot, 0 oldest. New samples enter at
    // the top so index i of a DQ bit is slot (i % 8) of pclk (i / 8)
    // counted from 8 cycles ago.
    var hist_dq : 'b logic<64> [16];
    var hist_dqs: 'b logic<64> [2] ;

    unsafe (cdc) {
        always_ff (i_clk_mem, i_rst_mem) {
            if_reset {
                for i in 0..16 {
                    hist_dq[i] = 64'b0;
                }
                hist_dqs[0] = 64'b0;
                hist_dqs[1] = 64'b0;
            } else if !hist_hold {
                for i in 0..16 {
                    for s in 0..8 {
                        hist_dq[i][56 + s] = i_dq_in[16 * s + i];
                    }
                    hist_dq[i][55:0] = hist_dq[i][63:8];
                }
                for s in 0..8 {
                    hist_dqs[0][56 + s] = i_dqs_in[2 * s];
                    hist_dqs[1][56 + s] = i_dqs_in[2 * s + 1];
                }
                hist_dqs[0][55:0] = hist_dqs[0][63:8];
                hist_dqs[1][55:0] = hist_dqs[1][63:8];
            }
        }
    }

    // Beat extraction in two register stages: the coarse 8-slot chunk
    // select (sel[5:3]) lands in win_q, the fine slot select (sel[2:0])
    // is applied from there. Keeps the 64-slot mux off one pclk cycle.
    // Even beats come from the window at RD_SEL, odd beats from the one
    // at RD_SEL_ODD (beat 1's slot), so the two edge phases are
    // calibrated independently.
    var win_q         : 'b logic<24> [16];
    var win_odd_q     : 'b logic<24> [16];
    var sel_fine_q    : 'b logic<3>      ;
    var sel_odd_fine_q: 'b logic<3>      ;
    always_ff (i_clk_mem) {
        for i in 0..16 {
            win_q[i]     = hist_dq[i][sel_used_q[5:3] * 8+:24];
            win_odd_q[i] = hist_dq[i][sel_odd_used_q[5:3] * 8+:24];
        }
        sel_fine_q     = sel_used_q[2:0];
        sel_odd_fine_q = sel_odd_used_q[2:0];
    }
    var rd_beats: 'b logic<16> [8];
    always_comb {
        for i in 0..16 {
            for b in 0..8 {
                var idx: logic<5>;
                if b[0] {
                    idx            = {2'b0, sel_odd_fine_q} + (b[4:0] - 1) * 2;
                    rd_beats[b][i] = win_odd_q[i][idx];
                } else {
                    idx            = {2'b0, sel_fine_q} + b[4:0] * 2;
                    rd_beats[b][i] = win_q[i][idx];
                }
            }
        }
    }

    // Write data beats: beat b carries bytes 2b, 2b+1 of the line; DM
    // masks every byte whose strobe is clear.
    var wr_beat: 'b logic<16> [8];
    var wr_mask: 'b logic<2>  [8];
    always_comb {
        for b in 0..8 {
            if cal_active {
                wr_beat[b] = cal_beat(b[3:0]);
                wr_mask[b] = 2'b00;
            } else {
                wr_beat[b] = req_wdata_m[b * 16+:16];
                wr_mask[b] = ~req_wstrb_m[b * 2+:2];
            }
        }
    }

    // Slot layouts for the data cycles (see header): beat b of a data
    // cycle sits in slots 2b+1, 2b+2; slot 0 carries the tail of the
    // previous cycle's last beat.
    function data_slots (
        b0  : input logic<16>,
        b1  : input logic<16>,
        b2  : input logic<16>,
        b3  : input logic<16>,
        tail: input logic<16>,
    ) -> logic<128> {
        return {b3, b2, b2, b1, b1, b0, b0, tail};
    }
    function mask_slots (
        m0  : input logic<2>,
        m1  : input logic<2>,
        m2  : input logic<2>,
        m3  : input logic<2>,
        tail: input logic<2>,
    ) -> logic<16> {
        return {m3, m2, m2, m1, m1, m0, m0, tail};
    }

    // Centre of the matching run (7-bit sum so 42 + 43 does not wrap).
    let scan_sum  : 'b logic<7> = {1'b0, scan_first} + {1'b0, scan_last};
    let scan_sum_o: 'b logic<7> = {1'b0, scan_first_o} + {1'b0, scan_last_o};

    // The scan is pipelined: the beats extracted for scan_sel are
    // registered and compared one cycle later (keeps the history mux and
    // the 128-bit compare out of the same pclk cycle).
    // Three register stages: sel_used -> sel_used_q -> win_q -> rd_beats
    // -> rd_beats_q -> compare, so scan_sel is delayed three times.
    var rd_beats_q  : 'b logic<16> [8];
    var scan_sel_q  : 'b logic<6>     ;
    var scan_sel_q2 : 'b logic<6>     ;
    var scan_sel_q3 : 'b logic<6>     ;
    var scan_match  : 'b logic        ; // even beats match at the candidate
    var scan_match_o: 'b logic        ; // odd beats match (candidate = beat 1's slot)
    always_ff (i_clk_mem) {
        sel_used_q     = sel_used;
        sel_odd_used_q = sel_odd_used;
        rd_beats_q     = rd_beats;
        scan_sel_q     = scan_sel;
        scan_sel_q2    = scan_sel_q;
        scan_sel_q3    = scan_sel_q2;
        scan_valid_q   = cal_eval;
        scan_valid_q2  = scan_valid_q;
        scan_valid_q3  = scan_valid_q2;
    }
    always_comb {
        scan_match   = 1'b1;
        scan_match_o = 1'b1;
        for b in 0..8 {
            if rd_beats_q[b] != cal_beat(b[3:0]) {
                if b[0] {
                    scan_match_o = 1'b0;
                } else {
                    scan_match = 1'b0;
                }
            }
        }
    }

    const DQS_TOGGLE: logic<16> = 16'b11_11_00_00_11_11_00_00; // {U,L} per slot, slots 2,3,6,7 high

    unsafe (cdc) {
        always_ff (i_clk_mem, i_rst_mem) {
            if_reset {
                state        = State::RESET;
                timer        = C_RESET;
                ref_cnt      = 32'b0;
                ref_due      = 1'b0;
                ref_total    = 32'b0;
                recal_due    = 1'b0;
                recal_active = 1'b0;
                recal_count  = 32'b0;
                recal_fail   = 32'b0;
                sel_min      = 6'h3F;
                sel_max      = 6'h00;
                sel_odd_min  = 6'h3F;
                sel_odd_max  = 6'h00;
                req_s1       = 1'b0;
                req_s2       = 1'b0;
                req_s3       = 1'b0;
                done_tog_m   = 1'b0;
                init_done_m  = 1'b0;
                cmd          = CMD_DES;
                o_ba         = 3'b0;
                o_a          = 14'b0;
                o_reset_n    = 1'b0;
                o_cke        = 1'b0;
                wr_cnt       = 3'b0;
                rd_cnt       = 4'b0;
                rd_pend      = 1'b0;
                cal_active   = 1'b0;
                cal_we       = 1'b0;
                cal_sel      = RD_SEL_DEFAULT[5:0];
                cal_sel_odd  = RD_SEL_DEFAULT[5:0] + 6'd2;
                cal_lat      = RD_LAT_DEFAULT[3:0];
                cal_eval     = 1'b0;
                scan_sel     = 6'b0;
                scan_first   = 6'b0;
                scan_last    = 6'b0;
                scan_found   = 1'b0;
                scan_first_o = 6'b0;
                scan_last_o  = 6'b0;
                scan_found_o = 1'b0;
                scan_done    = 1'b0;
                cal_ok_m     = 1'b0;
                cal_fail_m   = 1'b0;
                o_dq_out     = 128'b0;
                o_dq_oe      = 4'b0;
                o_dm_out     = 16'hFFFF;
                o_dqs_out    = 16'b0;
                o_dqs_oe     = 4'b0;
                rsp_data     = 128'b0;
                dbg_dqsl     = 64'b0;
                dbg_dqsu     = 64'b0;
                dbg_dq0      = 64'b0;
                dbg_dq8      = 64'b0;
            } else {
                req_s1 = req_tog;
                req_s2 = req_s1;
                req_s3 = req_s2;

                // Default: DESELECT, no command.
                cmd = CMD_DES;

                // Refresh interval timer (starts counting once initialised).
                if init_done_m {
                    if ref_cnt >= C_REFI - 1 {
                        ref_cnt = 32'b0;
                        ref_due = 1'b1;
                    } else {
                        ref_cnt = ref_cnt + 1;
                    }
                }

                // ---- write pattern generator ----
                if wr_cnt != 3'b0 {
                    wr_cnt = wr_cnt + 1;
                }
                case wr_cnt {
                    3'd2: { // visible at N+2: DQS preamble on slots 6,7
                        o_dqs_out = 16'b0;
                        o_dqs_oe  = 4'b1000;
                        o_dq_oe   = 4'b0000;
                    }
                    3'd3: { // N+3: beats 0..3
                        o_dqs_out = DQS_TOGGLE;
                        o_dqs_oe  = 4'b1111;
                        o_dq_out  = data_slots(wr_beat[0], wr_beat[1], wr_beat[2], wr_beat[3], wr_beat[0]);
                        o_dm_out  = mask_slots(wr_mask[0], wr_mask[1], wr_mask[2], wr_mask[3], 2'b11);
                        o_dq_oe   = 4'b1111;
                    }
                    3'd4: { // N+4: beats 4..7
                        o_dqs_out = DQS_TOGGLE;
                        o_dqs_oe  = 4'b1111;
                        o_dq_out  = data_slots(wr_beat[4], wr_beat[5], wr_beat[6], wr_beat[7], wr_beat[3]);
                        o_dm_out  = mask_slots(wr_mask[4], wr_mask[5], wr_mask[6], wr_mask[7], wr_mask[3]);
                        o_dq_oe   = 4'b1111;
                    }
                    3'd5: { // N+5: postamble on slots 0,1; last beat tail on slot 0
                        o_dqs_out = 16'b0;
                        o_dqs_oe  = 4'b0001;
                        o_dq_out  = {112'b0, wr_beat[7]};
                        o_dm_out  = {14'h3FFF, wr_mask[7]};
                        o_dq_oe   = 4'b0001;
                    }
                    3'd6: {
                        o_dqs_oe = 4'b0000;
                        o_dq_oe  = 4'b0000;
                        o_dm_out = 16'hFFFF;
                        wr_cnt   = 3'b0;
                    }
                    default: {}
                }

                // ---- read capture ----
                if rd_pend {
                    if rd_cnt == lat_used {
                        rd_pend = 1'b0;
                        if cal_active {
                            // Freeze the history and scan the candidates.
                            cal_eval     = 1'b1;
                            scan_sel     = 6'b0;
                            scan_found   = 1'b0;
                            scan_found_o = 1'b0;
                            scan_done    = 1'b0;
                        } else {
                            for b in 0..8 {
                                rsp_data[b * 16+:16] = rd_beats[b];
                            }
                        }
                        dbg_dqsl = hist_dqs[0];
                        dbg_dqsu = hist_dqs[1];
                        dbg_dq0  = hist_dq[0];
                        dbg_dq8  = hist_dq[8];
                    } else {
                        rd_cnt = rd_cnt + 1;
                    }
                }

                // ---- calibration scan (one RD_SEL candidate per cycle) ----
                if cal_eval {
                    if scan_sel == 6'd49 { // last candidate: 49 + 14 = 63
                        cal_eval = 1'b0;
                    } else {
                        scan_sel = scan_sel + 1;
                    }
                }
                if scan_valid_q3 {
                    if scan_match {
                        if !scan_found {
                            scan_first = scan_sel_q3;
                        }
                        scan_found = 1'b1;
                        scan_last  = scan_sel_q3;
                    }
                    if scan_match_o {
                        if !scan_found_o {
                            scan_first_o = scan_sel_q3;
                        }
                        scan_found_o = 1'b1;
                        scan_last_o  = scan_sel_q3;
                    }
                    if scan_sel_q3 == 6'd49 {
                        scan_done = 1'b1;
                    }
                }

                // ---- command FSM ----
                if timer != 32'b0 {
                    timer = timer - 1;
                } else {
                    case state {
                        State::RESET: {
                            o_reset_n = 1'b1;
                            timer     = C_CKE;
                            state     = State::CKE;
                        }
                        State::CKE: {
                            o_cke = 1'b1;
                            timer = C_XPR;
                            state = State::XPR;
                        }
                        State::XPR: {
                            cmd   = CMD_MRS;
                            o_ba  = 3'd2;
                            o_a   = MR2;
                            timer = C_MRD;
                            state = State::MR3;
                        }
                        State::MR3: {
                            cmd   = CMD_MRS;
                            o_ba  = 3'd3;
                            o_a   = MR3;
                            timer = C_MRD;
                            state = State::MR1;
                        }
                        State::MR1: {
                            cmd   = CMD_MRS;
                            o_ba  = 3'd1;
                            o_a   = MR1;
                            timer = C_MRD;
                            state = State::MR0;
                        }
                        State::MR0: {
                            cmd   = CMD_MRS;
                            o_ba  = 3'd0;
                            o_a   = MR0;
                            timer = C_MOD;
                            state = State::ZQ;
                        }
                        State::ZQ: {
                            cmd   = CMD_ZQCL;
                            o_ba  = 3'd0;
                            o_a   = 14'h0400; // A10 = 1 -> ZQCL
                            timer = C_ZQINIT;
                            state = if CAL_ENABLE ? State::CAL_START : State::IDLE;
                            // Address / data muxes switch to the scratch line
                            // during tZQinit so CAL_START's ACT already uses it.
                            cal_active = CAL_ENABLE;
                            cal_we     = CAL_ENABLE;
                            cal_lat    = CAL_LAT_MIN[3:0];
                        }
                        State::CAL_START: {
                            // Write the pattern line, then read it back.
                            cmd   = CMD_ACT;
                            o_ba  = bank;
                            o_a   = row;
                            timer = C_RCD - 1;
                            state = State::RW;
                        }
                        State::IDLE: {
                            init_done_m = 1'b1;
                            if ref_due {
                                cmd       = CMD_REF;
                                ref_due   = 1'b0;
                                timer     = C_RFC;
                                ref_total = ref_total + 1;
                                if recal_en_m && ((ref_total + 1) & RECAL_MASK) == 32'b0 {
                                    recal_due = 1'b1;
                                }
                            } else if recal_due {
                                // Periodic re-calibration: same sequence as at
                                // init, from the current RD_LAT, result applied
                                // only if the scan matches.
                                recal_due    = 1'b0;
                                recal_active = 1'b1;
                                cal_active   = 1'b1;
                                cal_we       = 1'b1;
                                state        = State::CAL_START;
                            } else if pending {
                                cmd   = CMD_ACT;
                                o_ba  = bank;
                                o_a   = row;
                                timer = C_RCD - 1;
                                state = State::RW;
                            }
                        }
                        State::RW: {
                            o_ba = bank;
                            o_a  = {4'b0001, col}; // A10 = 1: auto precharge (A12 = A11 = 0)
                            if we_used {
                                cmd    = CMD_WR;
                                wr_cnt = 3'd1;
                                timer  = C_WR_BUSY;
                                state  = State::WR_WAIT;
                            } else {
                                cmd     = CMD_RD;
                                rd_pend = 1'b1;
                                rd_cnt  = 4'd1;
                                timer   = C_RD_BUSY;
                                state   = State::RD_WAIT;
                            }
                        }
                        State::RD_WAIT: {
                            if cal_active {
                                if scan_done {
                                    scan_done = 1'b0;
                                    if scan_found && scan_found_o {
                                        cal_sel     = scan_sum[6:1];
                                        cal_sel_odd = scan_sum_o[6:1];
                                        cal_ok_m    = 1'b1;
                                        cal_active  = 1'b0;
                                        state       = State::IDLE;
                                        // drift bookkeeping
                                        if scan_sum[6:1] <: sel_min {
                                            sel_min = scan_sum[6:1];
                                        }
                                        if scan_sum[6:1] >: sel_max {
                                            sel_max = scan_sum[6:1];
                                        }
                                        if scan_sum_o[6:1] <: sel_odd_min {
                                            sel_odd_min = scan_sum_o[6:1];
                                        }
                                        if scan_sum_o[6:1] >: sel_odd_max {
                                            sel_odd_max = scan_sum_o[6:1];
                                        }
                                        if recal_active {
                                            recal_active = 1'b0;
                                            recal_count  = recal_count + 1;
                                        }
                                    } else if recal_active {
                                        // keep the values in use
                                        recal_active = 1'b0;
                                        recal_fail   = recal_fail + 1;
                                        cal_active   = 1'b0;
                                        state        = State::IDLE;
                                    } else if cal_lat <: CAL_LAT_MAX[3:0] {
                                        // No data in the window: look later.
                                        cal_lat = cal_lat + 1;
                                        cmd     = CMD_ACT;
                                        o_ba    = bank;
                                        o_a     = row;
                                        timer   = C_RCD - 1;
                                        state   = State::RW;
                                    } else {
                                        cal_sel     = RD_SEL_DEFAULT[5:0];
                                        cal_sel_odd = RD_SEL_DEFAULT[5:0] + 6'd2;
                                        cal_lat     = RD_LAT_DEFAULT[3:0];
                                        cal_fail_m  = 1'b1;
                                        cal_active  = 1'b0;
                                        state       = State::IDLE;
                                    }
                                }
                            } else if !rd_pend {
                                done_tog_m = ~done_tog_m;
                                state      = State::IDLE;
                            }
                        }
                        State::WR_WAIT: {
                            if cal_active {
                                // Extra gap so the write echo is out of the
                                // history before the calibration read.
                                cal_we = 1'b0;
                                cmd    = CMD_ACT;
                                o_ba   = bank;
                                o_a    = row;
                                timer  = C_RCD - 1 + 8;
                                state  = State::RW;
                            } else {
                                done_tog_m = ~done_tog_m;
                                state      = State::IDLE;
                            }
                        }
                        default: {
                            state = State::IDLE;
                        }
                    }
                }
            }
        }
    }
}
