// Copied from ~/repos/riscv-veryl/src/bus_if.veryl (commit 78e2537, 2026-09-10) for the NVMe DDR3 namespace.
// Keep in sync with the RISC-V project; local changes should be upstreamed there.
// Simple valid/ready system bus used between the Core, the address
// decoder, memories and peripherals.
//
// The interface is deliberately minimal — one outstanding transaction
// per master, no bursts, no IDs — but it decouples request acceptance
// from read-data return, so slow targets (external DRAM controllers,
// caches, clock-domain-crossing bridges, page-table walkers, ...) can be
// attached without the initiator having to know their latency.
//
// Protocol
// --------
// Request channel (master → slave):
//   valid  : a request is being presented. Once asserted, `valid` and the
//            payload (addr / we / wstrb / wdata) must be held stable until
//            the cycle in which `ready` is also high (the *handshake*).
//   ready  : the slave accepts the request in this cycle. `ready` may be
//            combinational (a function of `valid`/`addr` in the same cycle)
//            or registered; it may be held high permanently by always-
//            ready targets.
//   addr   : byte address. Word accesses are naturally aligned; the
//            decoder rebases it so each slave sees offsets from its base.
//   we     : 1 = write, 0 = read.
//   wstrb  : byte-lane enables for writes (ignored for reads).
//   wdata  : write data, byte lanes positioned according to `wstrb`.
//
// Response channel (slave → master), reads only:
//   rvalid : read data is on `rdata` for exactly one cycle. It is
//            asserted at least ONE cycle after the read handshake — never
//            in the same cycle — so the master's data path is always
//            registered inside the slave. Writes have no response; they
//            complete (are "posted") at the handshake.
//   rdata  : read data, valid only while `rvalid` is high.
//
// Ordering / outstanding rules:
//   • A master must not present a new request while it still has a read
//     outstanding (issued but `rvalid` not yet seen). Writes may be
//     issued back to back, one per handshake.
//   • Because at most one read is outstanding, a slave needs no
//     transaction ID — `rvalid` always answers the most recent read.
//   • A slave must not raise `rvalid` without a preceding read handshake.
pub interface BusIf {
    var valid : logic    ;
    var ready : logic    ;
    var addr  : logic<32>;
    var we    : logic    ;
    var wstrb : logic<4> ;
    var wdata : logic<32>;
    var rvalid: logic    ;
    var rdata : logic<32>;

    modport master {
        valid : output,
        addr  : output,
        we    : output,
        wstrb : output,
        wdata : output,
        ready : input ,
        rvalid: input ,
        rdata : input ,
    }

    modport slave {
        ..converse(master)
    }
}
