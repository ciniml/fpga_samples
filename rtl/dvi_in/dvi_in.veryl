/**
 * @file dvi_in.veryl
 * @brief DVI 1.0 TMDS receiver. Operates on 10-bit parallel words from
 *        external 1:10 deserializers (LSB-first per DVI 1.0 §3.2.3).
 *
 * Per DVI 1.0 §3.3 the receiver must:
 *  - recover the pixel clock (assumed external — this module runs in the
 *    word-rate domain),
 *  - establish data-stream synchronization (§3.3.2) — implemented as the
 *    spec's data-lane control-symbol detection: for each candidate word
 *    boundary, observe ALIGN_WINDOW words (sized to cover at least one
 *    horizontal blanking); if LOCK_THRESHOLD consecutive control symbols
 *    are seen on data lane 0, the boundary is correct, otherwise request
 *    a one-bit slip and try the next boundary. (An earlier revision
 *    aligned on a deserialized clock lane; that was dropped because the
 *    clock pad's input buffer must feed the recovery PLL, and a pad
 *    whose buffer output fans out to the PLL cannot also drive the
 *    vendor IODELAY/IDES10 chain.)
 *  - decode each 10-bit symbol per Figure 3-6,
 *  - hold recovered outputs constant while sync is lost (§3.3.2).
 *
 * Word alignment is requested via a 1-cycle pulse (o_align_shift_req); the
 * external 1:10 deserializer owns the bit shift register. IDELAY tap control
 * is exposed for an external bit-level delay primitive (vendor-specific
 * Gowin/Xilinx wrapper, instantiated in EDA projects).
 */

pub module dvi_in #(
    param LOCK_THRESHOLD       : u32 = 32'd16     , // consecutive lane-0 control symbols required to lock
    param LOSE_THRESHOLD       : u32 = 32'd16     , // unused (kept for interface compatibility)
    param SHIFT_SETTLE_CYCLES  : u32 = 32'd4      , // wait after a shift pulse before re-observing
    param TAP_MAX              : u32 = 32'd31     , // unused (kept for interface compatibility)
    param TAP_DWELL            : u32 = 32'd256    , // unused (kept for interface compatibility)
    param ALIGN_WINDOW         : u32 = 32'd4096   , // words observed per boundary; must span >= 1 hblank
    param LOSE_TIMEOUT         : u32 = 32'd2200000, // lock lost if no control symbol for this many words (~30ms at 74.25MHz > 1 frame)
    param DELAY_TAP_FIXED      : u32 = 32'd16     , // static IDELAY tap loaded at start-up
    param SIMULATION_FAST_LOCK : bit = 1'b0       , // unused (kept for interface compatibility)
) (
    r#clock: input clock_posedge,
    r#reset: input reset         ,

    // Deserialized 10-bit words, LSB-first (bit[0] = first transmitted bit).
    i_word_data : input logic<10> [3] ,
    i_word_valid: input logic         ,

    // Recovered video. Held at reset values while !o_locked.
    o_video_data : output logic<24>,
    o_video_de   : output logic    ,
    o_video_hsync: output logic    ,
    o_video_vsync: output logic    ,
    o_video_ctl  : output logic<4> , // {CTL3, CTL2, CTL1, CTL0}
    o_video_valid: output logic    ,

    // Per-lane decode error flag, registered alongside o_video_valid.
    o_decode_err: output logic<3>,

    // Word alignment status / control.
    o_locked         : output logic,
    o_align_shift_req: output logic,

    // External IDELAY control. o_delay_inc/dec reserved for closed-loop
    // refinement; current sweep uses load + tap only.
    o_delay_inc : output logic   ,
    o_delay_dec : output logic   ,
    o_delay_load: output logic   ,
    o_delay_tap : output logic<5>,
) {
    // -------------------------------------------------------------------
    // Constants and helper functions
    // -------------------------------------------------------------------

    type tap_t = logic<5>;

    // The four TMDS control symbols (transitionMaximized outputs in dvi_out)
    // as SV literals. In DVI §3.3.3 Figure 3-6 these correspond to:
    //   D[0..9] = 0010101011 -> C[1:0] = 00  ==  10'b1101010100
    //   D[0..9] = 1101010100 -> C[1:0] = 01  ==  10'b0010101011
    //   D[0..9] = 0010101010 -> C[1:0] = 10  ==  10'b0101010100
    //   D[0..9] = 1101010101 -> C[1:0] = 11  ==  10'b1010101011
    const CTRL_00: logic<10> = 10'b1101010100;
    const CTRL_01: logic<10> = 10'b0010101011;
    const CTRL_10: logic<10> = 10'b0101010100;
    const CTRL_11: logic<10> = 10'b1010101011;

    struct ctrl_decode_t {
        is_ctrl: logic   ,
        ctrl   : logic<2>,
    }

    function isControlSymbol (
        s: input logic<10>,
    ) -> ctrl_decode_t {
        var r: ctrl_decode_t;
        case s {
            CTRL_00: {
                r.is_ctrl = 1;
                r.ctrl    = 2'b00;
            }
            CTRL_01: {
                r.is_ctrl = 1;
                r.ctrl    = 2'b01;
            }
            CTRL_10: {
                r.is_ctrl = 1;
                r.ctrl    = 2'b10;
            }
            CTRL_11: {
                r.is_ctrl = 1;
                r.ctrl    = 2'b11;
            }
            default: {
                r.is_ctrl = 0;
                r.ctrl    = 2'b00;
            }
        }
        return r;
    }

    // Decode a 10-bit TMDS data symbol per DVI §3.3.3 Figure 3-6.
    function decodeTmdsData (
        d: input logic<10>,
    ) -> logic<8> {
        var inv: logic<8>;
        var q  : logic<8>;
        // Step 1: invert lower 8 bits if D[9] == 1.
        inv = if d[9] ? ~d[7:0] : d[7:0];
        // Step 2: q[0] := inv[0]; q[i] := inv[i] XOR/XNOR inv[i-1] depending on D[8].
        //   D[8] == 1 -> XOR (encoder used XOR transition minimization)
        //   D[8] == 0 -> XNOR
        q[0] = inv[0];
        for i in 1..8 {
            q[i] = if d[8] ? inv[i] ^ inv[i - 1] : ~(inv[i] ^ inv[i - 1]);
        }
        return q;
    }

    function decodeTmdsErr (
        d        : input logic<10>,
        expect_de: input logic    ,
    ) -> logic {
        var is_ctrl: logic;
        is_ctrl = (d == CTRL_00) || (d == CTRL_01) || (d == CTRL_10) || (d == CTRL_11);
        // Active video must not contain a control symbol; blanking must.
        return if expect_de ? is_ctrl : !is_ctrl;
    }

    // -------------------------------------------------------------------
    // FSM
    // -------------------------------------------------------------------

    enum State: logic<2> {
        INIT      ,
        WORD_ALIGN,
        LOCKED    ,
    }

    var state: State;

    // Counters shared across states.
    var match_count : logic<32>; // consecutive lane-0 control symbols in WORD_ALIGN
    var window_count: logic<32>; // words observed at the current boundary
    var timeout_count: logic<32>; // words since the last control symbol in LOCKED
    var settle_count : logic<32>; // post-shift quarantine cycles

    // Data lane 0 carries HSYNC/VSYNC control symbols during every
    // blanking interval — the alignment reference per DVI §3.3.2.
    var ctl_align_decode: ctrl_decode_t;
    var ctl_match       : logic;
    always_comb {
        ctl_align_decode = isControlSymbol(i_word_data[0]);
    }
    assign ctl_match = i_word_valid && ctl_align_decode.is_ctrl;

    always_ff (r#clock) {
        if r#reset {
            state         = State::INIT;
            match_count   = 0;
            window_count  = 0;
            timeout_count = 0;
            settle_count  = 0;
            o_locked          = 0;
            o_align_shift_req = 0;
            o_delay_inc       = 0;
            o_delay_dec       = 0;
            o_delay_load      = 0;
            o_delay_tap       = 0;
        } else {
            // Default deassertions; states override.
            o_align_shift_req = 0;
            o_delay_inc       = 0;
            o_delay_dec       = 0;
            o_delay_load      = 0;

            case state {
                State::INIT: {
                    // Load the fixed IDELAY tap and start the boundary
                    // search. (At 720p rates one static tap suffices; the
                    // old per-tap sweep needed the clock-lane reference.)
                    o_delay_load = 1;
                    o_delay_tap  = DELAY_TAP_FIXED as tap_t;
                    state        = State::WORD_ALIGN;
                    match_count  = 0;
                    window_count = 0;
                }
                State::WORD_ALIGN: {
                    if settle_count != 0 {
                        settle_count = settle_count - 1;
                    } else if i_word_valid {
                        if ctl_match {
                            match_count = match_count + 1;
                            if match_count >= LOCK_THRESHOLD - 1 {
                                state         = State::LOCKED;
                                o_locked      = 1;
                                timeout_count = 0;
                            }
                        } else {
                            match_count = 0;
                        }
                        window_count = window_count + 1;
                        if window_count >= ALIGN_WINDOW - 1 {
                            // No control-symbol run at this boundary within
                            // a window that spans at least one hblank —
                            // slip one bit and observe the next boundary.
                            o_align_shift_req = 1;
                            settle_count      = SHIFT_SETTLE_CYCLES;
                            match_count       = 0;
                            window_count      = 0;
                        }
                    }
                }
                State::LOCKED: {
                    if i_word_valid {
                        if ctl_match {
                            timeout_count = 0;
                        } else {
                            timeout_count = timeout_count + 1;
                            if timeout_count >= LOSE_TIMEOUT - 1 {
                                state        = State::WORD_ALIGN;
                                match_count  = 0;
                                window_count = 0;
                                o_locked     = 0;
                            }
                        }
                    }
                }
                default: {
                    state = State::INIT;
                }
            }
        }
    }

    // -------------------------------------------------------------------
    // Decode pipeline — depth 2 to mirror dvi_out.VIDEO_REGS_DEPTH = 2.
    // Stage 1 latches the input words; stage 2 emits decoded video.
    // While !o_locked all stage-2 outputs hold (per DVI §3.3.2).
    // -------------------------------------------------------------------

    var d0_q      : logic<10>;
    var d1_q      : logic<10>;
    var d2_q      : logic<10>;
    var d0_q2     : logic<10>;
    var valid_q   : logic    ;
    var locked_q  : logic    ;

    var de_next      : logic    ;
    var hsync_next   : logic    ;
    var vsync_next   : logic    ;
    var ctl_next     : logic<4> ;
    var data_next    : logic<24>;
    var err_next     : logic<3> ;
    var ctrl0_decode : ctrl_decode_t;
    var ctrl1_decode : ctrl_decode_t;
    var ctrl2_decode : ctrl_decode_t;
    var ctrl0_new    : ctrl_decode_t; // lane 0 look-ahead (word t)
    var ctrl0_old    : ctrl_decode_t; // lane 0 look-back  (word t-2)

    always_comb {
        ctrl0_decode = isControlSymbol(d0_q);
        ctrl1_decode = isControlSymbol(d1_q);
        ctrl2_decode = isControlSymbol(d2_q);
        ctrl0_new    = isControlSymbol(i_word_data[0]);
        ctrl0_old    = isControlSymbol(d0_q2);
        // DE for word t-1 is the 3-word majority over lane 0's
        // "not a control symbol" at t-2 / t-1 / t. An isolated corrupted
        // symbol inside a blanking run (unterminated-lane ISI, see the
        // PMOD wrapper notes) can neither fake DE nor punch a hole in
        // real active video; genuine DE edges are preserved because two
        // neighbours always agree on either side of the transition.
        de_next = (!ctrl0_new.is_ctrl && !ctrl0_decode.is_ctrl)
               || (!ctrl0_new.is_ctrl && !ctrl0_old.is_ctrl)
               || (!ctrl0_decode.is_ctrl && !ctrl0_old.is_ctrl);
        hsync_next   = ctrl0_decode.ctrl[0];
        vsync_next   = ctrl0_decode.ctrl[1];
        // Channel 1 carries {CTL1, CTL0}; channel 2 carries {CTL3, CTL2}.
        ctl_next[0] = ctrl1_decode.ctrl[0];
        ctl_next[1] = ctrl1_decode.ctrl[1];
        ctl_next[2] = ctrl2_decode.ctrl[0];
        ctl_next[3] = ctrl2_decode.ctrl[1];
        data_next   = {decodeTmdsData(d2_q), decodeTmdsData(d1_q), decodeTmdsData(d0_q)};
        err_next[0] = decodeTmdsErr(d0_q, de_next);
        err_next[1] = decodeTmdsErr(d1_q, de_next);
        err_next[2] = decodeTmdsErr(d2_q, de_next);
    }

    always_ff (r#clock) {
        if r#reset {
            d0_q     = 0;
            d1_q     = 0;
            d2_q     = 0;
            d0_q2    = 0;
            valid_q  = 0;
            locked_q = 0;

            o_video_data  = 0;
            o_video_de    = 0;
            o_video_hsync = 0;
            o_video_vsync = 0;
            o_video_ctl   = 0;
            o_video_valid = 0;
            o_decode_err  = 0;
        } else {
            // Stage 1: capture inputs.
            d0_q     = i_word_data[0];
            d1_q     = i_word_data[1];
            d2_q     = i_word_data[2];
            d0_q2    = d0_q;
            valid_q  = i_word_valid;
            locked_q = o_locked;

            // Stage 2: emit only while locked. While not locked, hold.
            if locked_q && valid_q {
                o_video_data  = data_next;
                o_video_de    = de_next;
                o_video_valid = 1;
                o_decode_err  = err_next;
                // hsync/vsync/ctl only update during blanking (de == 0),
                // and only from a word that decodes as a genuine control
                // symbol — a corrupted blanking word must not be allowed
                // to yank the sync outputs. Hold during active video per
                // DVI Fig 3-7.
                if !de_next && ctrl0_decode.is_ctrl {
                    o_video_hsync = hsync_next;
                    o_video_vsync = vsync_next;
                    o_video_ctl   = ctl_next;
                }
            } else {
                o_video_valid = 0;
                o_decode_err  = 0;
            }
        }
    }

}
