/**
 * @file trace_rx_decoder.veryl
 * @brief Re-frames the {K flag, byte} word stream from the EasyCDR receiver
 *        into trace records: [K28.1][ts LSB..MSB][data LSB..MSB].
 *
 * K28.5 commas and K28.3 fillers interleaved inside a record are ignored;
 * K28.1 restarts a record, K28.2 (overflow marker) is flagged, K28.7 (tick,
 * timestamp only) ends any record in flight and is otherwise ignored here.
 * K28.4 starts a descriptor ([VER][WIDTH][TS_BITS][flags] for VER 1, plus
 * [HASH0..3] for VER 2) which is latched to o_desc_* (quasi-static once the
 * link is up). o_desc_hash is 0 for VER 1 transmitters. K28.6 starts the
 * signal-map text [LEN][bytes], streamed out on o_map_*.
 *
 * The record layout is taken from the descriptor at run time (WIDTH and
 * TS_BITS in bits, multiples of 8, up to MAX_WIDTH / MAX_TS_BITS), so one
 * host bitstream serves any transmitter configuration. Until the first
 * descriptor arrives DEFAULT_WIDTH / DEFAULT_TS_BITS are assumed.
 * Reset is asynchronous active-high (25K receive domain convention).
 */
pub module trace_rx_decoder #(
    param MAX_WIDTH      : u32 = 64,
    param MAX_TS_BITS    : u32 = 32,
    param DEFAULT_WIDTH  : u32 = 16,
    param DEFAULT_TS_BITS: u32 = 24,
) (
    clk          : input  clock_posedge     ,
    rst          : input  reset_async_high  ,
    in_valid     : input  logic             , // aligned word strobe
    in_word      : input  logic<9>          , // {K flag, byte}
    rec_valid    : output logic             ,
    rec_ts       : output logic<MAX_TS_BITS>, // upper bits 0 when TS_BITS < MAX
    rec_data     : output logic<MAX_WIDTH>  , // upper bits 0 when WIDTH < MAX
    ovf_seen     : output logic             , // pulse on K28.2
    o_desc_ver   : output logic<8>          , // 0 until a descriptor is seen
    o_desc_width : output logic<8>          ,
    o_desc_tsbits: output logic<8>          ,
    o_desc_flags : output logic<8>          ,
    o_desc_hash  : output logic<32>         ,
    o_map_wr     : output logic             , // signal-map text bytes ([K28.6][LEN][bytes])
    o_map_addr   : output logic<8>          ,
    o_map_data   : output logic<8>          ,
    o_map_len    : output logic<8>          , // latched when the text is complete (0 = none yet)
    o_map_busy   : output logic             ,
    o_desc_busy  : output logic             , // descriptor bytes in flight
) {
    const MAX_TB    : u32      = MAX_TS_BITS / 8;
    const MAX_DB    : u32      = MAX_WIDTH / 8;
    const DEFAULT_TB: u32      = DEFAULT_TS_BITS / 8;
    const DEFAULT_DB: u32      = DEFAULT_WIDTH / 8;
    const K28_1     : logic<8> = 8'h3c;
    const K28_2     : logic<8> = 8'h5c;
    const K28_4     : logic<8> = 8'h9c;
    const K28_6     : logic<8> = 8'hdc;
    const K28_7     : logic<8> = 8'hfc; // tick [K28.7][ts]: timestamp only, not a record

    // record layout in bytes (from the descriptor, clamped to the maxima)
    let d_tb: logic<8> = if o_desc_ver == 8'd0 ? DEFAULT_TB as 8 : {3'b0, o_desc_tsbits[7:3]};
    let d_db: logic<8> = if o_desc_ver == 8'd0 ? DEFAULT_DB as 8 : {3'b0, o_desc_width[7:3]};
    var tb      : logic<8>;
    var db      : logic<8>;
    var rec_last: logic<8>;
    always_ff (clk) {
        tb       = if d_tb >: MAX_TB as 8 ? MAX_TB as 8 : d_tb;
        db       = if d_db >: MAX_DB as 8 ? MAX_DB as 8 : d_db;
        rec_last = tb + db - 1;
    }

    var active     : logic            ;
    var done       : logic            ;
    var idx        : logic<8>         ;
    var ts_acc     : logic<MAX_TB, 8> ; // byte i = ts bits [8i+7:8i]
    var data_acc   : logic<MAX_DB, 8> ;
    var desc_active: logic            ;
    var desc_idx   : logic<3>         ;
    var desc_acc   : logic<7, 8>      ; // bytes 0..6 (byte 7 arrives with the latch)
    var desc_last  : logic<3>         ; // 3 (VER 1) or 7 (VER 2)
    var map_active : logic            ;
    var map_lenbyte: logic            ;
    var map_cnt    : logic<8>         ;
    var map_n      : logic<8>         ;
    assign o_desc_busy = desc_active;
    assign o_map_busy  = map_active;

    let didx  : logic<8> = idx - tb;
    let in_k  : logic    = in_word[8];
    let in_b  : logic<8> = in_word[7:0];

    always_ff {
        if_reset {
            active        = 1'b0;
            done          = 1'b0;
            desc_active   = 1'b0;
            desc_idx      = 3'd0;
            desc_acc      = 0;
            desc_last     = 3'd3;
            o_desc_hash   = 32'd0;
            map_active    = 1'b0;
            map_lenbyte   = 1'b0;
            map_cnt       = 8'd0;
            map_n         = 8'd0;
            o_map_wr      = 1'b0;
            o_map_addr    = 8'd0;
            o_map_data    = 8'd0;
            o_map_len     = 8'd0;
            o_desc_ver    = 8'd0;
            o_desc_width  = 8'd0;
            o_desc_tsbits = 8'd0;
            o_desc_flags  = 8'd0;
            idx           = 8'd0;
            ts_acc        = 0;
            data_acc      = 0;
            rec_valid     = 1'b0;
            rec_ts        = 0;
            rec_data      = 0;
            ovf_seen      = 1'b0;
        } else {
            rec_valid = 1'b0;
            ovf_seen  = 1'b0;
            done      = 1'b0;
            o_map_wr  = 1'b0;
            if done { // one cycle after the last byte
                rec_valid = 1'b1;
                rec_ts    = ts_acc;
                rec_data  = data_acc;
            }
            if in_valid {
                if in_k {
                    if in_b == K28_1 {
                        active      = 1'b1;
                        desc_active = 1'b0;
                        idx         = 8'd0;
                        ts_acc      = 0;
                        data_acc    = 0;
                    } else if in_b == K28_2 {
                        ovf_seen = 1'b1;
                    } else if in_b == K28_4 {
                        active      = 1'b0;
                        desc_active = 1'b1;
                        desc_idx    = 3'd0;
                        desc_last   = 3'd3;
                    } else if in_b == K28_7 {
                        active      = 1'b0; // ts bytes follow; ignored here (raw buffer keeps them)
                        desc_active = 1'b0;
                    } else if in_b == K28_6 {
                        active      = 1'b0;
                        desc_active = 1'b0;
                        map_active  = 1'b1;
                        map_lenbyte = 1'b1;
                        map_cnt     = 8'd0;
                    }
                    // other K codes (comma / filler): ignore
                } else if map_active {
                    if map_lenbyte {
                        map_n       = in_b;
                        map_lenbyte = 1'b0;
                        if in_b == 8'd0 {
                            map_active = 1'b0;
                        }
                    } else {
                        o_map_wr   = 1'b1;
                        o_map_addr = map_cnt;
                        o_map_data = in_b;
                        map_cnt    = map_cnt + 1;
                        if map_cnt == map_n - 1 {
                            map_active = 1'b0;
                            o_map_len  = map_n;
                        }
                    }
                } else if desc_active {
                    if desc_idx == 3'd0 {
                        desc_last = if in_b >= 8'd2 ? 3'd7 : 3'd3;
                    }
                    if desc_idx == desc_last {
                        o_desc_ver    = desc_acc[0];
                        o_desc_width  = desc_acc[1];
                        o_desc_tsbits = desc_acc[2];
                        if desc_last == 3'd3 {
                            o_desc_flags = in_b;
                            o_desc_hash  = 32'd0;
                        } else {
                            o_desc_flags = desc_acc[3];
                            o_desc_hash  = {in_b, desc_acc[6], desc_acc[5], desc_acc[4]};
                        }
                        desc_active = 1'b0;
                    }
                    if desc_idx <: 3'd7 {
                        desc_acc[desc_idx] = in_b;
                    }
                    desc_idx = desc_idx + 1;
                } else if active {
                    if idx <: tb {
                        ts_acc[idx] = in_b;
                    } else {
                        data_acc[didx] = in_b;
                    }
                    if idx == rec_last {
                        active = 1'b0;
                        done   = 1'b1;
                    }
                    idx = idx + 1;
                }
            }
        }
    }
}
