/**
 * @file tx_link_core.veryl
 * @brief Family-independent EasyCDR-link transmitter core.
 *
 * Emits a continuous 10-bit 8b10b symbol stream at the parallel-word rate
 * (line rate / 10):
 *   - every FRAME_LEN-th word is a K28.5 comma (word alignment marker)
 *   - the remaining slots carry the input byte stream; when no byte is
 *     offered, a K28.3 idle filler is sent instead
 *
 * o_symbol bit 0 is the first bit on the wire (matches OSER10 D0).
 * Depends only on displayport_encoder_8b10b (rtl/displayport, referenced as
 * $sv:: so no Veryl dependency build is needed) - no device primitives.
 * Port names, parameter and the asynchronous active-low reset are kept
 * identical to the former src/common/tx_link_core.v.
 */
pub module easycdr_trace_tx_core #(
    param FRAME_LEN: u32 = 16, // words per frame incl. the K28.5 comma
) (
    clk : input clock_posedge  , // parallel clock = line rate / 10
    rstn: input reset_async_low,

    // byte stream to transmit (consumed one byte per non-comma slot)
    i_valid: input  logic   ,
    i_is_k : input  logic   ,
    i_data : input  logic<8>,
    o_ready: output logic   ,

    o_symbol: output logic<10>,
) {
    const K28_5    : logic<8> = 8'hbc; // comma / alignment
    const K28_3    : logic<8> = 8'h7c; // idle filler
    const SLOT_W   : u32      = $clog2(FRAME_LEN);
    const SLOT_LAST: u32      = FRAME_LEN - 1;

    var slot      : logic<SLOT_W>;
    let comma_slot: logic         = slot == SLOT_LAST as SLOT_W;
    assign o_ready = ~comma_slot;

    var enc_data: logic<8>;
    var enc_is_k: logic   ;

    always_ff {
        if_reset {
            slot     = 0;
            enc_data = K28_5;
            enc_is_k = 1'b1;
        } else {
            slot = if comma_slot ? 0 : slot + 1;
            if comma_slot {
                enc_data = K28_5;
                enc_is_k = 1'b1;
            } else if i_valid {
                enc_data = i_data;
                enc_is_k = i_is_k;
            } else {
                enc_data = K28_3;
                enc_is_k = 1'b1;
            }
        }
    }

    inst u_enc: $sv::displayport_encoder_8b10b (
        i_clk     : clk     ,
        i_rstn    : rstn    ,
        i_valid   : 1'b1    ,
        i_data    : enc_data,
        i_is_k    : enc_is_k,
        i_rd_reset: 1'b0    ,
        o_valid   : _       ,
        o_symbol            ,
    );
}
