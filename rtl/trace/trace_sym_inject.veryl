/**
 * @file trace_sym_inject.veryl
 * @brief Symbol injector for the loopback self-test transmitter: replaces the
 *        trace core's 10-bit symbol stream with a host-loaded list of raw
 *        symbols, so the receiver (EasyCDR IP) can be probed with arbitrary
 *        code groups (running disparity violations, invalid codes, every K
 *        code, shifted commas ...).
 *
 * Host side (clk_sys, async active-high reset): the list is written one
 * symbol at a time (i_wr_*), then i_set latches {mode, len}: mode 0 = pass
 * the core stream, 1 = play the list once then pass, 2 = loop the list.
 * TX side (txclk, async active-low reset). Symbol bit 0 is the first bit on
 * the wire (same convention as easycdr_trace_tx / OSER10 D0).
 */
pub module trace_sym_inject #(
    param AW: u32 = 6, // list depth 2^AW symbols
) (
    clk_sys   : input 'h clock_posedge   ,
    rst_sys   : input 'h reset_async_high,
    i_wr_valid: input 'h logic           ,
    i_wr_idx  : input 'h logic<AW>       ,
    i_wr_data : input 'h logic<10>       ,
    i_set     : input 'h logic           ,
    i_mode    : input 'h logic<2>        ,
    i_len     : input 'h logic<AW + 1>   , // 1..2^AW

    txclk     : input  't clock_posedge  ,
    txrstn    : input  't reset_async_low,
    i_core_sym: input  't logic<10>      ,
    o_sym     : output 't logic<10>      ,
    o_active  : output 't logic          , // 1 while list symbols are on the wire
) {
    var list   : 'h logic<10> [2 ** AW];
    var mode_s : 'h logic<2>           ;
    var len_s  : 'h logic<AW + 1>      ;
    var set_tgl: 'h logic              ;
    always_ff (clk_sys) {
        if i_wr_valid {
            list[i_wr_idx] = i_wr_data;
        }
    }
    always_ff (clk_sys, rst_sys) {
        if_reset {
            mode_s  = 2'd0;
            len_s   = 0;
            set_tgl = 1'b0;
        } else if i_set {
            mode_s  = i_mode;
            len_s   = i_len;
            set_tgl = ~set_tgl;
        }
    }

    // tx domain: mode/len are quasi-static (written before set), captured on the toggle
    var set_t  : 't logic<3>     ;
    var mode_t : 't logic<2>     ;
    var len_t  : 't logic<AW + 1>;
    var idx    : 't logic<AW + 1>;
    let set_evt: 't logic         = set_t[2] ^ set_t[1];
    let last   : 't logic         = idx == len_t - 1;
    unsafe (cdc) {
        always_ff (txclk, txrstn) {
            if_reset {
                set_t    = 3'b000;
                mode_t   = 2'd0;
                len_t    = 0;
                idx      = 0;
                o_active = 1'b0;
                o_sym    = 10'd0;
            } else {
                set_t = {set_t[1:0], set_tgl};
                if set_evt {
                    mode_t   = mode_s;
                    len_t    = len_s;
                    idx      = 0;
                    o_active = (mode_s != 2'd0) && (len_s != 0);
                } else if o_active {
                    if last {
                        idx = 0;
                        if mode_t == 2'd1 {
                            o_active = 1'b0; // one-shot done
                        }
                    } else {
                        idx = idx + 1;
                    }
                }
                o_sym = if o_active ? list[idx[AW - 1:0]] : i_core_sym;
            }
        }
    }
}
