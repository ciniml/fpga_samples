/**
 * @file tb_ctrl_frame.veryl
 * @brief Control-channel end-to-end test (body: test/ctrl_frame_body.sv):
 *        host frames -> ManchesterTx -> ManchesterRx -> CtrlFrameRx ->
 *        TraceCtrlRegs. Good frames, bad CRC, SOF inside payload, LEN out
 *        of range, byte loss + gap timeout recovery, back-to-back frames.
 */
module TbCtrlFrame {}

#[test(ctrl_frame_e2e)]
embed (inline) sv{{{
module ctrl_frame_e2e;
    ctrl_frame_body #(.RUN(1)) body();
endmodule
}}}
