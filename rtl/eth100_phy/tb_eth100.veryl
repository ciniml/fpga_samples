/**
 * @file tb_eth100.veryl
 * @brief Eth100Phy link tests (body: test/eth100_link_body.sv, line model
 *        test/eth100_chan.sv). Two PHYs on independent clocks, frames both ways.
 *  eth100_force_*  : forced 100BASE-TX (no FLP); ppm = +-100 (spec), +-300, +-1000;
 *                    isi = slow edges, 0.7 V, threshold 0.35 V, noise; offset = baseline shift
 *  eth100_an_*     : auto-negotiation (timers scaled), then frames
 *  eth100_pd       : only B negotiates, A is forced -> parallel detection (half duplex)
 */
module TbEth100 {}

#[test(eth100_force_0ppm)]
embed (inline) sv{{{
module eth100_force_0ppm; eth100_link_body #(.RUN(1)) body(); endmodule
}}}
#[test(eth100_force_ppm)]
embed (inline) sv{{{
module eth100_force_ppm; eth100_link_body #(.PPM_A(100), .PPM_B(-100), .RUN(1)) body(); endmodule
}}}
#[test(eth100_force_ppm_big)]
embed (inline) sv{{{
module eth100_force_ppm_big; eth100_link_body #(.PPM_A(-300), .PPM_B(300), .NFRAMES(10), .RUN(1)) body(); endmodule
}}}
#[test(eth100_force_ppm_huge)]
embed (inline) sv{{{
module eth100_force_ppm_huge; eth100_link_body #(.PPM_A(-1000), .PPM_B(1000), .NFRAMES(10), .RUN(1)) body(); endmodule
}}}
#[test(eth100_force_isi)]
embed (inline) sv{{{
module eth100_force_isi; eth100_link_body #(.PPM_A(80), .PPM_B(-50), .TAU(3.0), .ATT(0.7), .TH(0.35), .NOISE(0.08), .RUN(1)) body(); endmodule
}}}
#[test(eth100_force_offset)]
embed (inline) sv{{{
module eth100_force_offset; eth100_link_body #(.PPM_A(50), .OFFSET(0.15), .NOISE(0.05), .RUN(1)) body(); endmodule
}}}
#[test(eth100_an)]
embed (inline) sv{{{
module eth100_an; eth100_link_body #(.FORCE(0), .PPM_A(60), .PPM_B(-40), .NFRAMES(8), .RUN(1)) body(); endmodule
}}}
#[test(eth100_pd)]
embed (inline) sv{{{
module eth100_pd; eth100_link_body #(.FORCE(0), .ONE_AN(1), .NFRAMES(4), .RUN(1)) body(); endmodule
}}}
