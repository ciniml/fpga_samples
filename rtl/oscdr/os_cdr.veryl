/**
 * @file os_cdr.veryl
 * @brief Blind-oversampling clock/data recovery on a parallel sample word
 *        (EasyCDR-compatible datapath for the Gowin OSIDES32 primitive).
 *
 * Input: SAMPLES samples per clock, uniformly spaced, OSR samples per unit
 * interval, i_samples[0] = earliest. With OSIDES32 at 1 Gbps this is
 * 32 samples / 125 MHz clock, 4 per UI (4-phase 500 MHz x 2 IODELAY taps).
 *
 * Algorithm (per clock word):
 *  1. transitions t[i] = s[i] ^ s[i-1] (s[-1] = last sample of the
 *     previous word); count them per phase class i mod OSR
 *  2. accumulate over 2^WINDOW_LOG2 words; the class with most transitions
 *     is the eclass phase e, the data phase is e + OSR/2
 *  3. track: when the best class moves by +/-1 (and beats the current one
 *     by MARGIN) the sample pointer moves by one sample. A pointer pstep
 *     across the word boundary yields 7 or 9 bits in that word instead
 *     of 8 - that is the bit slip a plesiochronous link needs
 *     (+/-5000 ppm = one slip every ~200 UI).
 *  4. extract: bits at pointer, pointer+OSR, ... within the word.
 *     o_bits[0] is the earliest; o_nbits = 7, 8 or 9 (for OSR=4).
 *
 * i_freeze holds the phase (for eye scans: with the phase frozen, sweeping
 * the IODELAY taps moves the sample point across the eye while the BERT
 * counts errors). While i_reacq is high the phase is re-acquired on every
 * word that carries enough transitions (jump to the best class) instead of
 * tracked (burst links: hold it while the line is idle, and for as long as
 * the idle detector lags the line; the phase drifts arbitrarily between
 * packets and the smoothed histogram would otherwise keep the old phase).
 * DLY delays the extraction data path by DLY words behind the histogram, so
 * the acquisition made from the first active words is applied to those same
 * words: with DLY = 9 (the acquisition latency) the first word of a burst is
 * already extracted at the right phase and no bit is duplicated or lost
 * inside a preamble/SYNC. o_lock: the eclass histogram is concentrated
 * (>= half the transitions in one class) and the line is toggling.
 */
pub module OsCdr #(
    param SAMPLES: u32 = 32,
    param OSR    : u32 = 4 ,
    param IIR    : u32 = 1 , // smoothing: time constant 2^IIR words
    param HYST   : u32 = 2 , // step when the neighbour cost is lower by more than this
    param ACT_MIN: u32 = 2 , // minimum transitions per word (smoothed) for lock
    param DLY    : u32 = 0 , // extraction delay in words (9 = acquisition latency, burst links)
) (
    i_clk: input clock,
    i_rst: input reset,

    i_samples: input logic<SAMPLES>,
    i_freeze : input logic         ,
    i_reacq  : input logic         , // level: re-acquire the phase on every active word

    o_bits : output logic<SAMPLES / OSR + 1>,
    o_nbits: output logic<4>                ,
    o_phase: output logic<$clog2(OSR)>      , // current data sample class
    o_lock : output logic                   ,
    o_slip : output logic                   , // pulse: pointer moved
    o_acc_first: output logic<$clog2(SAMPLES / OSR + 1) + IIR + 1>, // smoothed transition count, class 0 (external phase loops)
    o_acc_last : output logic<$clog2(SAMPLES / OSR + 1) + IIR + 1>, // class OSR-1
) {
    const BPW: u32 = SAMPLES / OSR;             // bits per word, nominal (8)
    const CW : u32 = $clog2(BPW + 1);           // per-word class count (0..8)
    const AW : u32 = CW + IIR + 1;              // smoothed count (max BPW * 2^IIR)
    const CSW: u32 = AW + 1;                    // cost width
    const TW : u32 = AW + 2;                    // total width
    const ACT: u32 = ACT_MIN << IIR;
    const DW : u32 = $clog2(OSR);               // class index width

    // ---- transitions and per-class counts ----
    var prev_last: logic;          // s[-1]
    var trans    : logic<SAMPLES>;
    var cnt      : logic<OSR, CW>;
    always_comb {
        trans[0] = i_samples[0] ^ prev_last;
        for i in 1..SAMPLES {
            trans[i] = i_samples[i] ^ i_samples[i - 1];
        }
        for c in 0..OSR {
            cnt[c] = 0;
        }
        for i in 0..SAMPLES {
            cnt[i % OSR] = cnt[i % OSR] + trans[i];
        }
    }

    // stage 1: registered per-class counts (keeps the 32-sample XOR +
    // popcount tree out of the accumulator's cycle)
    var cnt_r: logic<OSR, CW>;
    always_ff (i_clk, i_rst) {
        if_reset {
            cnt_r = 0;
        } else {
            cnt_r = cnt;
        }
    }

    // ---- smoothed histogram and cost of the data-sample classes ----
    var acc  : logic<OSR, AW>;
    var acc_c: logic<OSR, AW>;   // IIR histogram update (whole-vector register below)
    var dsel : logic<DW>;        // data sample class (pointer mod OSR)
    var have : logic;            // acquired once
    var tot_a: logic<TW>;        // total delayed to line up with the registered argmin (best, 4 stages)
    var tot_b: logic<TW>;
    var tot_c: logic<TW>;
    var tot_d: logic<TW>;
    var lock : logic;
    var pstep: logic<2>;         // 0 none, 1 +1, 2 -1, 3 jump
    var jump : logic<DW>;
    var ldir : logic<2>;         // last step direction (1 = +1, 2 = -1): a
                                 // step in the same direction needs no
                                 // hysteresis (frequency offset tracking),
                                 // a reversal needs the full HYST (no dither)
    var badc : logic<4>;         // consecutive words with a bad eye

    always_comb {
        for c in 0..OSR {
            acc_c[c] = acc[c] - (acc[c] >> IIR) + (cnt_r[c] as AW);
        }
    }

    // cost/total: the combinational values feed the (registered) decision
    // flags directly; the registered copies feed the acquisition argmin and
    // the activity check (latency-insensitive users)
    var cost_c : logic<OSR, CSW>;
    var total_c: logic<TW>;
    var cost   : logic<OSR, CSW>;
    var total  : logic<TW>;
    // acquisition cost: the adjacent classes weighted 3, the next ring 2, the
    // next 1 (OSR >= 8), so that with all transitions in one class (a
    // preamble / USB SYNC) the argmin lands in the middle of the eye instead
    // of on the first zero-cost class next to the edge. Two register stages:
    // the three ring pair-sums, then the weighted sum.
    const CCW: u32 = CSW + 3;
    var best   : logic<DW>;
    var bestc  : logic<CCW>;
    // (packed: the Gowin synthesizer maps unpacked arrays of this shape to register "RAM")
    var ring1_c: logic<OSR, CSW>;   // acc[d-1] + acc[d+2]
    var ring2_c: logic<OSR, CSW>;   // acc[d-2] + acc[d+3]
    var ring1  : logic<OSR, CSW>;
    var ring2  : logic<OSR, CSW>;
    var ccost_c: logic<OSR, CCW>;
    var ccost  : logic<OSR, CCW>;
    always_comb {
        total_c = 0;
        for d in 0..OSR {
            cost_c[d]  = acc[d] + acc[(d + 1) % OSR];
            total_c    = total_c + acc[d];
            ring1_c[d] = acc[(d + OSR - 1) % OSR] + acc[(d + 2) % OSR];
            ring2_c[d] = acc[(d + OSR - 2) % OSR] + acc[(d + 3) % OSR];
            ccost_c[d] = cost[d] as CCW;
            if OSR >= 8 {
                ccost_c[d] = (cost[d] as CCW) * 3 + (ring1[d] as CCW) * 2 + (ring2[d] as CCW);
            } else if OSR >= 4 {
                ccost_c[d] = (cost[d] as CCW) * 2 + (ring1[d] as CCW);
            }
        }
    }
    always_ff (i_clk, i_rst) {
        if_reset {
            cost  = 0;
            ring1 = 0;
            ring2 = 0;
            ccost = 0;
            total = 0;
        } else {
            cost  = cost_c;
            ring1 = ring1_c;
            ring2 = ring2_c;
            ccost = ccost_c;
            total = total_c;
        }
    }
    // best (argmin ccost) is only used for acquisition: three-stage minimum
    // (pairs, pairs of winners, final), all registered, any OSR;
    // best lags total by four clocks (ccost, mp, mq, best)
    const NP: u32 = (OSR + 1) / 2;
    var mp_i: logic<NP, DW>;
    var mp_v: logic<NP, CCW>;
    var mp_i_c: logic<NP, DW>;
    var mp_v_c: logic<NP, CCW>;
    // second stage: pairs of pair winners (registered), third: final (registered)
    const NQ: u32 = (NP + 1) / 2;
    var mq_i: logic<NQ, DW>;
    var mq_v: logic<NQ, CCW>;
    var mq_i_c: logic<NQ, DW>;
    var mq_v_c: logic<NQ, CCW>;
    var best_c : logic<DW>;
    var bestc_c: logic<CCW>;
    always_comb {
        for p in 0..NP {
            if (2 * p + 1 <: OSR) && (ccost[(2 * p + 1) % OSR] <: ccost[2 * p]) {
                mp_i_c[p] = (2 * p + 1) as DW;
                mp_v_c[p] = ccost[(2 * p + 1) % OSR];
            } else {
                mp_i_c[p] = (2 * p) as DW;
                mp_v_c[p] = ccost[2 * p];
            }
        }
        for q in 0..NQ {
            if (2 * q + 1 <: NP) && (mp_v[(2 * q + 1) % NP] <: mp_v[2 * q]) {
                mq_i_c[q] = mp_i[(2 * q + 1) % NP];
                mq_v_c[q] = mp_v[(2 * q + 1) % NP];
            } else {
                mq_i_c[q] = mp_i[2 * q];
                mq_v_c[q] = mp_v[2 * q];
            }
        }
        best_c  = mq_i[0];
        bestc_c = mq_v[0];
        for q in 1..NQ {
            if mq_v[q] <: bestc_c {
                best_c  = mq_i[q];
                bestc_c = mq_v[q];
            }
        }
    }
    always_ff (i_clk, i_rst) {
        if_reset {
            mp_i  = 0;
            mp_v  = 0;
            mq_i  = 0;
            mq_v  = 0;
            best  = 0;
            bestc = 0;
        } else {
            mp_i  = mp_i_c;
            mp_v  = mp_v_c;
            mq_i  = mq_i_c;
            mq_v  = mq_v_c;
            best  = best_c;
            bestc = bestc_c;
        }
    }
    // Decision flags computed for every candidate class in parallel (constant
    // indices), then selected by dsel: keeps the dsel -> mux -> compare ->
    // dsel loop to a single 1-bit mux.
    var up_h : logic<OSR>;   // cost[d+1] + HYST < cost[d]
    var up_0 : logic<OSR>;   // cost[d+1]        < cost[d]
    var dn_h : logic<OSR>;
    var dn_0 : logic<OSR>;
    var bad  : logic<OSR>;   // cost[d]*2 > total
    var good : logic<OSR>;   // cost[d]*4 <= total
    var up_h_c: logic<OSR>;
    var up_0_c: logic<OSR>;
    var dn_h_c: logic<OSR>;
    var dn_0_c: logic<OSR>;
    var bad_c : logic<OSR>;
    var good_c: logic<OSR>;
    always_comb {
        for d in 0..OSR {
            // cost[d+1] + H < cost[d]  <=>  acc[d+2] + H < acc[d]   (acc[d+1] cancels)
            // cost[d-1] + H < cost[d]  <=>  acc[d-1] + H < acc[d+1] (acc[d] cancels)
            up_h_c[d] = acc[(d + 2) % OSR] + HYST as AW <: acc[d];
            up_0_c[d] = acc[(d + 2) % OSR] <: acc[d];
            dn_h_c[d] = acc[(d + OSR - 1) % OSR] + HYST as AW <: acc[(d + 1) % OSR];
            dn_0_c[d] = acc[(d + OSR - 1) % OSR] <: acc[(d + 1) % OSR];
            // lock quality from the registered cost/total (latency-insensitive)
            bad_c[d]  = (cost[d] as TW) * 2 >: total;
            good_c[d] = (cost[d] as TW) * 4 <= total;
        }
    }
    // registered: the comparators (adder + compare) get their own cycle
    always_ff (i_clk, i_rst) {
        if_reset {
            up_h = 0;
            up_0 = 0;
            dn_h = 0;
            dn_0 = 0;
            bad  = 0;
            good = 0;
        } else {
            up_h = up_h_c;
            up_0 = up_0_c;
            dn_h = dn_h_c;
            dn_0 = dn_0_c;
            bad  = bad_c;
            good = good_c;
        }
    }
    let go_up  : logic = if ldir == 2'd1 ? up_0[dsel] : up_h[dsel];
    let go_dn  : logic = if ldir == 2'd2 ? dn_0[dsel] : dn_h[dsel];
    let eye_bad: logic = bad[dsel];
    let eye_ok : logic = good[dsel];

    // ---- delayed data path (see DLY) ----
    var s_x: logic<SAMPLES>;
    if DLY == 0 :g_nodly {
        assign s_x = i_samples;
    } else :g_dly {
        var s_d: logic<SAMPLES> [DLY];
        always_ff (i_clk, i_rst) {
            if_reset {
                for k in 0..DLY {
                    s_d[k] = 0;
                }
            } else {
                s_d[0] = i_samples;
                for k in 1..DLY {
                    s_d[k] = s_d[k - 1];
                }
            }
        }
        assign s_x = s_d[DLY - 1];
    }

    // ---- sample pointer and extraction ----
    // posu = (index of the first data sample of this word) + 1, range 0..OSR+1
    // (0 means sample -1 = the previous word's last sample).
    var posu     : logic<4>;
    var prev_tail: logic;        // sample [-1]
    var bits     : logic<BPW + 1>;
    var nbits    : logic<4>;
    var posu_next: logic<4>;
    // Extraction: posu takes only OSR+2 values, so select with a case of
    // constant slices instead of a dynamic index (much shallower logic).
    function extract(p: input u32, s: input logic<SAMPLES>, tail: input logic) -> logic<BPW + 1> {
        var o: logic<BPW + 1>;
        o = 0;
        for j in 0..(BPW + 1) {
            if p + OSR * j <: SAMPLES + 1 {
                // index 0 = the tail sample; the select below is kept
                // non-negative so elaboration never sees s[-1]
                o[j] = if p + OSR * j == 0 ? tail : s[(if p + OSR * j == 0 ? 1 : p + OSR * j) - 1];
            }
        }
        return o;
    }
    function nbits_of(p: input u32) -> logic<4> {
        var n: logic<4>;
        n = 0;
        for j in 0..(BPW + 1) {
            if p + OSR * j <: SAMPLES + 1 {
                n = n + 1;
            }
        }
        return n;
    }
    always_comb {
        bits  = 0;
        nbits = 0;
        for p in 0..(OSR + 2) {
            if posu == p as 4 {
                bits  = extract(p, s_x, prev_tail);
                nbits = nbits_of(p);
            }
        }
        // (posu-1) + OSR*nbits - SAMPLES + 1
        posu_next = posu + (OSR as 4 * nbits) - SAMPLES as 4;
    }

    assign o_phase     = dsel;
    assign o_lock      = lock;
    assign o_acc_first = acc[0];
    assign o_acc_last  = acc[OSR - 1];

    always_ff (i_clk, i_rst) {
        if_reset {
            prev_last = 1'b0;
            prev_tail = 1'b0;
            acc     = 0;
            dsel    = 0;
            have    = 1'b0;
            tot_a   = 0;
            tot_b   = 0;
            tot_c   = 0;
            tot_d   = 0;
            lock    = 1'b0;
            pstep   = 0;
            jump    = 0;
            ldir    = 0;
            badc    = 0;
            posu    = 1;
            o_bits  = 0;
            o_nbits = 0;
            o_slip  = 1'b0;
        } else {
            prev_last = i_samples[SAMPLES - 1];
            prev_tail = s_x[SAMPLES - 1];

            // output this word's bits
            o_bits  = bits;
            o_nbits = nbits;
            o_slip  = 1'b0;

            // pointer for the next word (+ pending phase step decided last word)
            case pstep {
                2'd1: {
                    posu   = posu_next + 1;
                    o_slip = 1'b1;
                }
                2'd2: {
                    posu   = posu_next - 1;
                    o_slip = 1'b1;
                }
                2'd3: {
                    // classes 0 and OSR-1 have two pointer representations
                    // (OSR+1 / 0 = the tail sample): take the one nearest the
                    // natural continuation, so a jump by one class is a one
                    // sample step and does not duplicate or drop a bit
                    if jump == (OSR - 1) as DW && posu_next <= (OSR / 2) as 4 {
                        posu = 0;
                    } else if jump == 0 && posu_next >= (OSR / 2 + 1) as 4 {
                        posu = (OSR + 1) as 4;
                    } else {
                        posu = (jump as 4) + 1;
                    }
                    o_slip = 1'b1;
                }
                default: posu = posu_next;
            }
            pstep = 0;

            // IIR histogram
            acc = acc_c;
            // lock (Schmitt): set when transitions are present and few of
            // them sit next to the chosen data sample (<= 1/4 in the two
            // adjacent classes); clear when more than half do (random
            // data / no eye) or the line is idle
            // adjacent classes); clear when more than half do (random data /
            // no eye) for 8 consecutive words, or immediately when idle.
            // The persistence rides through the brief imbalance right
            // before a tracking step at large frequency offsets.
            if !have || total <: ACT as TW {
                lock = 1'b0;
                badc = 0;
            } else if eye_bad {
                if badc == 4'd8 {
                    lock = 1'b0;
                } else {
                    badc = badc + 1;
                }
            } else {
                badc = 0;
                if eye_ok {
                    lock = 1'b1;
                }
            }

            // best lags total by four clocks: qualify the acquisition with
            // the delayed total so the jump uses a histogram that already
            // contains the transitions it was triggered by
            tot_a = total;
            tot_b = tot_a;
            tot_c = tot_b;
            tot_d = tot_c;
            if i_reacq {
                have = 1'b0;
            }
            if !i_freeze {
                if !have || i_reacq {
                    // acquisition (a jump to the current class leaves the pointer alone)
                    if tot_d >= ACT as TW {
                        have  = !i_reacq;
                        dsel  = best;
                        jump  = best;
                        pstep = 2'd3;
                    }
                } else if go_up {
                    pstep = 2'd1;
                    ldir  = 2'd1;
                    dsel  = if dsel == (OSR - 1) as DW ? 0 : dsel + 1;   // mod OSR
                } else if go_dn {
                    pstep = 2'd2;
                    ldir  = 2'd2;
                    dsel  = if dsel == 0 ? (OSR - 1) as DW : dsel - 1;
                }
            }
        }
    }
}
