/**
 * @file probe_width_converter.veryl
 * @brief Embedded debug probe width converter.
 */

pub module probe_width_converter #(
    param WIDTH: u32 = 32'd8,
    param DEBUG_OUT: bit = 1'b0,
) (
    r#clock:     input clock,
    aresetn: input reset,

    data_in: modport axi4s::axi4s_if::<8, true, 0>::slave,
    data_out: modport axi4s::axi4s_if::<8, true, 0>::master,
) {
    const NUMBER_OF_PHASES: u32 = (WIDTH + 6) / 7;
    const INPUT_WIDTH_WITH_PADDING: u32 = NUMBER_OF_PHASES * 7;
    const PADDING_WIDTH: u32 = INPUT_WIDTH_WITH_PADDING - WIDTH;

    type data_t = logic<WIDTH>;
    type out_data_t = logic<7>;
    type padded_input_t = logic<INPUT_WIDTH_WITH_PADDING>;
    type phase_t = logic<$clog2(NUMBER_OF_PHASES + 1)>;

    if NUMBER_OF_PHASES == 1: blk_single_phase {
        assign data_out.tvalid = data_in.tvalid;
        assign data_out.tdata = data_in.tdata;
        assign data_out.tlast = data_in.tlast;
        assign data_in.tready = data_out.tready;
    } else: blk_multi_phase {
        var phase_counter: phase_t;
        var in_data: logic<INPUT_WIDTH_WITH_PADDING>;
        var in_last: logic;
        
        assign data_in.tready = phase_counter == 0;

        always_ff(r#clock, aresetn) {
            if_reset {
                data_out.tvalid = 0;
                data_out.tdata = '0;
                data_out.tlast = 0;
                data_out.tuser = 0;
                in_data = '0;
                in_last = 0;
                phase_counter = 0;
            }
            else {
                if data_out.tvalid && data_out.tready {
                    data_out.tvalid = 0;
                }
                if data_in.tvalid && data_in.tready {
                    if DEBUG_OUT {
                        $info("WC: in=%h, last=%d\n", data_in.tdata, data_in.tlast);
                    }
                    in_data = data_in.tdata as padded_input_t;
                    in_last = data_in.tlast;
                    phase_counter = NUMBER_OF_PHASES as phase_t;
                }
                if phase_counter >: 0 && (!data_out.tvalid || data_out.tready) {
                    phase_counter = phase_counter - 1;
                    data_out.tvalid = 1;
                    for phase in 1..=NUMBER_OF_PHASES {
                        if phase_counter == phase as phase_t {
                            let new_out_data: out_data_t = in_data[(NUMBER_OF_PHASES - phase) * 7 +: 7] as out_data_t;
                            if DEBUG_OUT {
                                $info("WC: out(%d)=%h\n", phase_counter, new_out_data);
                            }
                            // Zero-extend to the 8-bit stream (Chisel:
                            // Cat(0.U(1.W), outData)).
                            data_out.tdata = {1'b0, new_out_data};
                        }
                    }
                    data_out.tlast = phase_counter == 1 && in_last;
                }
            }
        }
    }
}