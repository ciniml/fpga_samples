// ModRetro Chromatic (GW5A-EV25UG256CC1/I0) - pin assignment
//
// Source of the pin facts: ModRetro/oss-chromatic-console-fpga v18.14
// (commit a01aa37), esp32t/src/board/evt1_x2/evt1_x2.cst, GPL-3.0.
// Only the ball assignments, I/O standards and pulls of the physical board
// are taken from there; this file was written independently (own naming
// groups and comments). Names follow the upstream net names so that the
// two can be compared.
//
// Notes
//  - Every cartridge signal goes through level shifters on the board
//    (FPGA side LVCMOS33, slot side 5 V).
//  - Unused pins of the device default to "input with weak pull-up".
//    Designs should declare at least the safety pins (marked [S]) and drive
//    them to a defined state, see eda/targets/chromatic/README.md.
//  - A port listed here that a design does not have only produces a
//    Gowin warning.

// ---- clocks ----
IO_LOC  "CLK_FPGA" M2;        // 33.554432 MHz (2^25 Hz), 1.8 V bank
IO_PORT "CLK_FPGA" IO_TYPE=LVCMOS18;
IO_LOC  "CLK_24MHz" D12;      // 24 MHz (upstream: USB PHY PLL reference)
IO_PORT "CLK_24MHz" IO_TYPE=LVCMOS33;
IO_LOC  "CLK_27MHz" T2;
IO_PORT "CLK_27MHz" IO_TYPE=LVCMOS33;

// ---- power / board straps ----
IO_LOC  "POWER_ON_FPGA" N8;   // 1 = power switch OFF while USB powered (charging only)
IO_PORT "POWER_ON_FPGA" IO_TYPE=LVCMOS33;
IO_LOC  "POWER_DOWN_IO" P11;  // [S] upstream leaves it Hi-Z
IO_PORT "POWER_DOWN_IO" IO_TYPE=LVCMOS33;
IO_LOC  "SDIO_LS" N5;         // [S] upstream drives 1
IO_PORT "SDIO_LS" IO_TYPE=LVCMOS33;
IO_LOC  "CHG_EN_FPGA" K11;    // [S] charger enable, upstream drives 1
IO_PORT "CHG_EN_FPGA" IO_TYPE=LVCMOS33;
IO_LOC  "VERSION_DET" M8;     // 0 = newer board (cartridge power switchable), 1 = legacy
IO_PORT "VERSION_DET" IO_TYPE=LVCMOS33 PULL_MODE=UP PULL_STRENGTH=WEAK;
IO_LOC  "VERSION_DET2" K6;
IO_PORT "VERSION_DET2" IO_TYPE=LVCMOS18 PULL_MODE=UP PULL_STRENGTH=WEAK;
IO_LOC  "DISPLAY_ID" J11;
IO_PORT "DISPLAY_ID" IO_TYPE=LVCMOS33 PULL_MODE=UP PULL_STRENGTH=WEAK;
IO_LOC  "ADC_SEL" N13;        // [S] battery ADC input mux select
IO_PORT "ADC_SEL" IO_TYPE=LVCMOS33;
IO_LOC  "VBAT_ADC_P" P14;
IO_LOC  "VBAT_ADC_N" L11;
IO_LOC  "SCL" A15;            // I2C: charger (BQ24296), codec, temperature sensor
IO_LOC  "SDA" B14;

// ---- status LED (active Low, FPGA_LED_EN High enables) ----
IO_LOC  "FPGA_LED_EN" B5;
IO_PORT "FPGA_LED_EN" IO_TYPE=LVCMOS33;
IO_LOC  "FPGA_LED_R" A6;
IO_PORT "FPGA_LED_R" IO_TYPE=LVCMOS33 DRIVE=16;
IO_LOC  "FPGA_LED_G" A7;
IO_PORT "FPGA_LED_G" IO_TYPE=LVCMOS33 DRIVE=16;
IO_LOC  "FPGA_LED_B" B6;
IO_PORT "FPGA_LED_B" IO_TYPE=LVCMOS33 DRIVE=16;

// ---- buttons (Menu active Low, the others active High) ----
IO_LOC  "BTN_A" B8;
IO_PORT "BTN_A" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "BTN_B" A8;
IO_PORT "BTN_B" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "BTN_START" D9;
IO_PORT "BTN_START" IO_TYPE=LVCMOS33;
IO_LOC  "BTN_SEL" C14;
IO_PORT "BTN_SEL" IO_TYPE=LVCMOS33;
IO_LOC  "BTN_DPAD_UP" L12;
IO_PORT "BTN_DPAD_UP" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "BTN_DPAD_DOWN" D11;
IO_PORT "BTN_DPAD_DOWN" IO_TYPE=LVCMOS33;
IO_LOC  "BTN_DPAD_LEFT" D14;
IO_PORT "BTN_DPAD_LEFT" IO_TYPE=LVCMOS33;
IO_LOC  "BTN_DPAD_RIGHT" B16;
IO_PORT "BTN_DPAD_RIGHT" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "BTN_MENU" A5;
IO_PORT "BTN_MENU" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// ---- cartridge slot ----
IO_LOC  "CART_A[0]" K15;
IO_LOC  "CART_A[1]" L16;
IO_LOC  "CART_A[2]" L15;
IO_LOC  "CART_A[3]" M16;
IO_LOC  "CART_A[4]" M15;
IO_LOC  "CART_A[5]" N16;
IO_LOC  "CART_A[6]" N15;
IO_LOC  "CART_A[7]" P16;
IO_LOC  "CART_A[8]" P15;
IO_LOC  "CART_A[9]" R16;
IO_LOC  "CART_A[10]" T15;
IO_LOC  "CART_A[11]" R14;
IO_LOC  "CART_A[12]" T14;
IO_LOC  "CART_A[13]" R13;
IO_LOC  "CART_A[14]" T13;
IO_LOC  "CART_A[15]" R12;
IO_PORT "CART_A[0]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "CART_A[1]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "CART_A[2]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "CART_A[3]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "CART_A[4]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "CART_A[5]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "CART_A[6]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "CART_A[7]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "CART_A[8]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "CART_A[9]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "CART_A[10]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "CART_A[11]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "CART_A[12]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "CART_A[13]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "CART_A[14]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "CART_A[15]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_LOC  "CART_D[0]" T12;
IO_LOC  "CART_D[1]" R11;
IO_LOC  "CART_D[2]" T11;
IO_LOC  "CART_D[3]" R10;
IO_LOC  "CART_D[4]" T10;
IO_LOC  "CART_D[5]" R9;
IO_LOC  "CART_D[6]" T9;
IO_LOC  "CART_D[7]" R8;
IO_PORT "CART_D[0]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_PORT "CART_D[1]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_PORT "CART_D[2]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_PORT "CART_D[3]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_PORT "CART_D[4]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_PORT "CART_D[5]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_PORT "CART_D[6]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_PORT "CART_D[7]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_LOC  "CART_CLK" J15;       // PHI
IO_PORT "CART_CLK" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=UP;
IO_LOC  "CART_RD" J13;        // /RD
IO_PORT "CART_RD" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=UP;
IO_LOC  "CART_WR" K16;        // /WR
IO_PORT "CART_WR" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=UP;
IO_LOC  "CART_CS" K12;        // /CS (/MREQ, cartridge RAM select)
IO_PORT "CART_CS" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_LOC  "CART_RST" J16;       // /RST, open drain (the cartridge may pull it Low too)
IO_PORT "CART_RST" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "CART_DATA_DIR_E" L7; // [S] data shifter direction: 0 = FPGA -> cartridge
IO_PORT "CART_DATA_DIR_E" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_LOC  "CART_CTRL_OE" C11;   // [S] control shifter enable, active High (newer boards)
IO_PORT "CART_CTRL_OE" IO_TYPE=LVCMOS33;
IO_LOC  "CART_PWR_EN" M12;    // [S] slot 5 V enable (newer boards)
IO_PORT "CART_PWR_EN" IO_TYPE=LVCMOS33;
IO_LOC  "CART_DET" N3;        // 1 = cartridge inserted
IO_PORT "CART_DET" IO_TYPE=LVCMOS33 PULL_MODE=UP PULL_STRENGTH=WEAK;
IO_LOC  "CART_AUDIN" N14;     // VIN (pin 31)

// ---- ESP32 (menu MCU) ----
IO_LOC  "ESP32_EN" J3;        // [S] ESP32 enable (Low = held in reset)
IO_PORT "ESP32_EN" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "ESP32_IO0" E1;       // [S] ESP32 boot strap (Low at EN release = download mode)
IO_PORT "ESP32_IO0" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "ESP32_MCU_D3" B4;    // ESP32 UART TXD (USB CDC bridge upstream)
IO_LOC  "ESP32_MCU_D4" A4;    // ESP32 UART RXD
IO_PORT "ESP32_MCU_D4" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "ESP32_MCU_D11" D1;   // management UART FPGA -> ESP32 (GPIO10)
IO_LOC  "ESP32_MCU_D12" F3;   // management UART ESP32 -> FPGA (GPIO9)
IO_LOC  "QSPI_CS" C2;         // ESP32 is the QSPI master (OSD writes)
IO_LOC  "QSPI_CLK" B1;
IO_LOC  "QSPI_MOSI" A2;
IO_LOC  "QSPI_MISO" C3;
IO_LOC  "QSPI_WP" A3;
IO_LOC  "QSPI_HD" B3;
IO_PORT "QSPI_CS" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "QSPI_CLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "QSPI_MOSI" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "QSPI_MISO" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "QSPI_WP" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "QSPI_HD" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "I2S_BCLK" G1;
IO_LOC  "I2S_WS" G2;
IO_LOC  "I2S_DIN" F1;
IO_LOC  "I2S_DOUT" F2;

// ---- LCD (ST7785, RGB666 over 6 data lines + 3-wire SPI) ----
IO_LOC  "LCD_PWM" P3;         // [S] backlight
IO_PORT "LCD_PWM" IO_TYPE=LVCMOS33;
IO_LOC  "LCD_RESET" M6;       // [S]
IO_PORT "LCD_RESET" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "LCD_DB[0]" M9;
IO_LOC  "LCD_DB[1]" R5;
IO_LOC  "LCD_DB[2]" M11;
IO_LOC  "LCD_DB[3]" T5;
IO_LOC  "LCD_DB[4]" N12;
IO_LOC  "LCD_DB[5]" T6;
IO_PORT "LCD_DB[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "LCD_DB[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "LCD_DB[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "LCD_DB[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "LCD_DB[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "LCD_DB[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "LCD_DOTCLK" P9;
IO_PORT "LCD_DOTCLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "LCD_ENABLE" R4;
IO_PORT "LCD_ENABLE" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "LCD_HSYNC" P8;
IO_PORT "LCD_HSYNC" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "LCD_VSYNC" T3;
IO_PORT "LCD_VSYNC" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "LCD_TE" T7;
IO_PORT "LCD_TE" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "LCD_SPI_CSX" R3;
IO_PORT "LCD_SPI_CSX" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "LCD_SPI_SCLK" M7;
IO_PORT "LCD_SPI_SCLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "LCD_SPI_SDA" T4;
IO_PORT "LCD_SPI_SDA" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// ---- audio codec (TLV320, I2S) ----
IO_LOC  "AUD_RESET" B9;       // [S] Low = codec in reset
IO_PORT "AUD_RESET" IO_TYPE=LVCMOS33;
IO_LOC  "AUD_MCLK" C8;
IO_PORT "AUD_MCLK" IO_TYPE=LVCMOS33 DRIVE=16 PULL_MODE=NONE;
IO_LOC  "AUD_BCLK" B7;
IO_PORT "AUD_BCLK" IO_TYPE=LVCMOS33 DRIVE=16;
IO_LOC  "AUD_WCLK" D6;
IO_PORT "AUD_WCLK" IO_TYPE=LVCMOS33 DRIVE=16 PULL_MODE=NONE;
IO_LOC  "AUD_DIN" C6;
IO_PORT "AUD_DIN" IO_TYPE=LVCMOS33 DRIVE=16;

// ---- PSRAM (APS6404L-class OPI x8, 1.8 V) ----
IO_LOC  "PS_CE_N" R1;
IO_LOC  "PS_CLK" P2;
IO_LOC  "PS_DQS" K1;
IO_LOC  "PS_DQ[0]" L2;
IO_LOC  "PS_DQ[1]" N2;
IO_LOC  "PS_DQ[2]" J1;
IO_LOC  "PS_DQ[3]" L1;
IO_LOC  "PS_DQ[4]" K2;
IO_LOC  "PS_DQ[5]" M1;
IO_LOC  "PS_DQ[6]" N1;
IO_LOC  "PS_DQ[7]" P1;
IO_PORT "PS_CE_N" IO_TYPE=SSTL18_I;
IO_PORT "PS_CLK" IO_TYPE=SSTL18_I;
IO_PORT "PS_DQS" IO_TYPE=SSTL18_I;
IO_PORT "PS_DQ[0]" IO_TYPE=SSTL18_I;
IO_PORT "PS_DQ[1]" IO_TYPE=SSTL18_I;
IO_PORT "PS_DQ[2]" IO_TYPE=SSTL18_I;
IO_PORT "PS_DQ[3]" IO_TYPE=SSTL18_I;
IO_PORT "PS_DQ[4]" IO_TYPE=SSTL18_I;
IO_PORT "PS_DQ[5]" IO_TYPE=SSTL18_I;
IO_PORT "PS_DQ[6]" IO_TYPE=SSTL18_I;
IO_PORT "PS_DQ[7]" IO_TYPE=SSTL18_I;

// ---- link port / IR ----
IO_LOC  "LINK_CLK" R6;
IO_PORT "LINK_CLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "LINK_IN" T8;
IO_PORT "LINK_IN" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "LINK_OUT" P6;
IO_PORT "LINK_OUT" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "LINK_SD" R7;
IO_PORT "LINK_SD" IO_TYPE=LVCMOS33;
IO_LOC  "LINK_CLK_DIR_LV" N6; // [S] link CLK shifter direction: 0 = connector -> FPGA
IO_PORT "LINK_CLK_DIR_LV" IO_TYPE=LVCMOS33;
IO_LOC  "LINK_SD_DIR_LV" L8;  // [S] link SD shifter direction: 0 = connector -> FPGA
IO_PORT "LINK_SD_DIR_LV" IO_TYPE=LVCMOS33;
IO_LOC  "IR_LED" D4;          // [S]
IO_PORT "IR_LED" IO_TYPE=LVCMOS33 DRIVE=16 PULL_MODE=NONE;
IO_LOC  "IR_RX" D3;
IO_PORT "IR_RX" IO_TYPE=LVCMOS33;

// ---- USB 2.0 (Gowin SoftPHY "single LVDS" wiring, behind the on-board hub) ----
// D+/D- comparators (P = line, N = reference), dx pair (LVCMOS33D emulated
// differential), HS termination pair and the 1.5k pull-up enable.
IO_LOC  "usb_rxdp_i" B12;
IO_PORT "usb_rxdp_i" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=OFF;
IO_LOC  "usb_rxdn_i" B10;
IO_PORT "usb_rxdn_i" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "usb_dxp_io" B11;     // a HS design replaces these 4 lines (one LVCMOS33D port on B11,A11)
IO_PORT "usb_dxp_io" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "usb_dxn_io" A11;
IO_PORT "usb_dxn_io" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "usb_term_dp_io" A13;
IO_PORT "usb_term_dp_io" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC  "usb_term_dn_io" A9;
IO_PORT "usb_term_dn_io" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC  "usb_pullup_en_o" B13; // [S] High = 1.5k pull-up on D+
IO_PORT "usb_pullup_en_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
