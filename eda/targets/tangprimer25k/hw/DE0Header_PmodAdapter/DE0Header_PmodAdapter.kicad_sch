	(text "Tang Primer 25K Dock 40-pin header (J3 on the Dock, DE0 compatible) -> 4 Pmod host sockets (pmod3..pmod6)."
		(exclude_from_sim no)
		(at 30.48 190.50 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid aebe53d2-97a6-5db0-9958-c72ea3ba7721)
	)
	(text "Header pins 11 = +5V, 12 = GND; no 3.3 V pin: U1 makes the Pmods 3.3 V from +5V."
		(exclude_from_sim no)
		(at 30.48 194.31 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid 5fbdec65-9bc4-511d-9c58-c20aac2f6f54)
	)
	(text "Pins (2k-1, 2k) are GW5A true LVDS pairs (even = P, odd = N), except 17/18 (A1/E1) and 19/20 (D1/E3)."
		(exclude_from_sim no)
		(at 30.48 198.12 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid e95c40ae-2c20-5801-ba25-0e59f068a6c3)
	)
	(text "Each pair lands on a Pmod column: P = Pmod pin n, N = pin n+6. LVDS_* nets are routed as 100 ohm pairs."
		(exclude_from_sim no)
		(at 30.48 201.93 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid 3fdb7e80-17dc-5578-b80c-a418fac6bd78)
	)
	(text "Pmod B column 4 carries A1 / E1 (single-ended); EXT1 = D1, E3; EXT2 = F7/F6 and J11/J10 pairs."
		(exclude_from_sim no)
		(at 30.48 205.74 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid 54ee1fc4-b5d7-509e-9242-744afe1c2d26)
	)
	(text "Bank 2 pairs (A, B1, C1) have no on-chip differential termination on GW5A (use external 100 ohm for LVDS inputs)."
		(exclude_from_sim no)
		(at 30.48 209.55 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid 44c6785f-0daa-579c-8c95-240b26bdd019)
	)
