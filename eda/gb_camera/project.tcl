set SRC_DIR       [lindex $argv 0]
set RTL_DIR       [lindex $argv 1]
set TARGET        [lindex $argv 2]
set DEVICE_FAMILY [lindex $argv 3]
set DEVICE_PART   [lindex $argv 4]
set PROJECT_NAME  [lindex $argv 5]
set EDA_DIR       [file normalize ${SRC_DIR}/../../..]
set CART_SRC      ${EDA_DIR}/cart_game/src/${TARGET}
set CSI_DIR       ${EDA_DIR}/csi_capture/src/${TARGET}

set_device -name $DEVICE_FAMILY $DEVICE_PART
set_option -output_base_name ${PROJECT_NAME}
set_option -top_module top
set_option -verilog_std sysv2017
set_option -print_all_synthesis_warning 1
# placement: eda/camera_dvi missed pclk (125 MHz) with the default algorithm (PLACE_OPTION / ROUTE_OPTION
# from the environment to try others)
# route_option 2 closed every clock (2026-11-26; the defaults missed clk / clk2 / pclk by ~0.2 ns)
proc env_or {name dflt} { expr {[info exists ::env($name)] && $::env($name) ne "" ? $::env($name) : $dflt} }
set_option -place_option [env_or PLACE_OPTION 1]
set_option -route_option [env_or ROUTE_OPTION 2]
set_option -use_cpu_as_gpio 1
set_option -use_i2c_as_gpio 1
set_option -use_sspi_as_gpio 1
set_option -use_ready_as_gpio 1
set_option -use_done_as_gpio 1
set_option -use_mspi_as_gpio 1

# HOST_UART=1: the Dock USB-UART goes to GameCart
set HOST_UART [expr {[info exists ::env(HOST_UART)] ? $::env(HOST_UART) : "0"}]
set fh [open defines_gen.v w]
puts $fh "// generated by project.tcl"
if {${HOST_UART} == "1"} { puts $fh "`define GB_CAMERA_HOST_UART" }
close $fh
add_file -type verilog [file normalize defines_gen.v]

add_file -type verilog [file normalize ${SRC_DIR}/top.sv]
add_file -type verilog ${CART_SRC}/pll_100m_200m_50.v
# USB (Pmod USB HS Single), as eda/cart_game
set USB_SRC ${EDA_DIR}/usb_device/src/${TARGET}
add_file -type verilog ${USB_SRC}/pll_usb/pll_usb.v
add_file -type verilog ${USB_SRC}/pll_hs960/pll_hs960.v
add_file -type verilog [file normalize ${RTL_DIR}/usb/gowin/usb_phy_gowin_sl.v]
foreach f {usb_pkg usb_phy_rx usb_phy_tx usb_phy usb_phy_bridge usb_sie usb_descriptor_rom usb_device} {
    add_file -type verilog [file normalize ${RTL_DIR}/usb/${f}.sv]
}
add_file -type verilog [file normalize ${RTL_DIR}/oscdr/os_cdr.sv]
add_file -type verilog [file normalize ${RTL_DIR}/oscdr/bit_gearbox.sv]
foreach f {game_cart qspi_rom byte_afifo gb_camera gb_color_quant} {
    add_file -type verilog [file normalize ${RTL_DIR}/chromatic/${f}.sv]
}
add_file -type verilog [file normalize ${RTL_DIR}/uart/uart_rx.sv]
add_file -type verilog [file normalize ${RTL_DIR}/uart/uart_tx.sv]
# camera, as eda/csi_capture
foreach f {csi2_pkg csi2_edge_sampler csi2_lane_aligner csi2_lane_merge csi2_packet csi2_rx} {
    add_file -type verilog [file normalize ${RTL_DIR}/csi2/${f}.sv]
}
foreach f {isp_raw10_unpack isp_gb_scale} {
    add_file -type verilog [file normalize ${RTL_DIR}/camera_isp/${f}.sv]
}
add_file -type verilog ${EDA_DIR}/easycdr_bert/src/${TARGET}/pll_rx_500m_4ph/pll_rx_500m_4ph.v
foreach f {i2c_reg16 imx219_init_rom ov5640_init_rom ov5640_720p30_init_rom csi_ctrl csi_phy_gw5a} {
    add_file -type verilog ${CSI_DIR}/${f}.sv
}

# pins: the adapter (cart_game pins.cst) + the camera (pins_cam.cst) + the USB Pmod in slot USB_PMOD
set PMOD [expr {[info exists ::env(USB_PMOD)] ? $::env(USB_PMOD) : "pmod2"}]
if {${PMOD} == "pmod0"} { error "pmod0 is the camera" }
set fh [open ${EDA_DIR}/targets/${TARGET}/pmod_ports.csv r]
array set BALL {}
foreach line [split [read $fh] "\n"] {
    if {[regexp {^(pmod[0-2]_[0-9]+),([A-Z][0-9]+)} $line -> k v]} { set BALL($k) $v }
}
close $fh
proc ball {pin} { global BALL PMOD; return $BALL(${PMOD}_${pin}) }
set fh [open ${CART_SRC}/pins.cst r]; set cst [read $fh]; close $fh
set fh [open ${SRC_DIR}/pins_cam.cst r]; append cst "\n" [read $fh]; close $fh
set fh [open ${CART_SRC}/pins_usb.cst r]; set usb [read $fh]; close $fh
append cst "\n" [string map [list \
    @DX_P@    [ball 1]  @DX_N@    [ball 7] \
    @CMP_P@   [ball 2]  @CMP_N@   [ball 8] \
    @TERM_DP@ [ball 3]  @TERM_DN@ [ball 9] \
    @PULLUP@  [ball 4]  @VBUS@    [ball 10]] $usb]
set fh [open pins_gen.cst w]; puts -nonewline $fh $cst; close $fh
puts "gb_camera: Pmod USB HS Single on ${PMOD}, HOST_UART ${HOST_UART}"
add_file -type cst [file normalize pins_gen.cst]
add_file -type sdc [file normalize ${SRC_DIR}/timing.sdc]
run all
