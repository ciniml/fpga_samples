	(text "Pmod 100BASE-TX direct-attach PHY front end (transformerless) - see ../README.md"
		(exclude_from_sim no)
		(at 25.4 22.86 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "ee1b0d08-044a-5e24-95ba-e840d4a5cc4a")
	)
	(text "Pmod J1: plugs into Tang Primer 25K pmod0 (3.3 V bank). 1-4 top row = P, 7-10 bottom row = N.\nA: 1/7 (F5/G5)  B: 2/8 (G7/G8)  PWM_A/B: 3/9 (H8/H7)  TX_P/N: 4/10 (H5/J5)  - verify by ball name."
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5efd5fee-62bf-5d98-a6a0-4c27fadc2119")
	)
	(text "TX: LVCMOS33 x2 -> Rs 62R / Rp 120R (Thevenin 2V/50R each side) -> Cr 47pF -> [L1 CMC | R5/R6 0R]\n-> 0.1uF/100V series -> RJ45 1/2. Tune Rs for 0.95-1.05 V diff, Cr for 3-5 ns rise."
		(exclude_from_sim no)
		(at 25.4 127 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ebc41ef7-f316-504c-aa1c-fd42c52b761d")
	)
	(text "RX: RJ45 3/6 -> 2x49.9R termination, midpoint Ct to GND.\nTap caps Ca 0.1uF/100V make 4 DC-isolated comparator inputs.\nA = (v > VTH_A-VB), B = (v > -(VTH_B-VB)), c = A^B = NRZI."
		(exclude_from_sim no)
		(at 152.4 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "301461a8-2168-56a6-ad3b-a3f34a9e400c")
	)
	(text "Bias: VB = 1.32 V. VTH = VB + (D*3.3-VB)*1k/4.3k  (-0.31 .. +0.46 V vs VB)"
		(exclude_from_sim no)
		(at 152.4 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b45cdf25-8b88-5f2c-9428-4111d0d26f50")
	)
	(text "U1: flow-through ESD array, NC pads 10/9/7/6 carry the same line as IO 1/2/4/5.\nLine side caps rated 100 V. Bob Smith R19-R22/C17 optional."
		(exclude_from_sim no)
		(at 256.54 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ff06ecf2-85f5-5a59-abeb-ebf18d87889a")
	)
	(text "3.3 V decoupling at J1"
		(exclude_from_sim no)
		(at 25.4 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0c95790f-80a2-5d9a-825a-221d672c500f")
	)
