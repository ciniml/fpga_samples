// Tang Primer 25K + Pmod 100BASE-TX direct PHY (../../README.md §4), board in the csv `pmod0` slot.
// The slot numbering of the user and of eda/targets/tangprimer25k/pmod_ports.csv differ
// (dvi_loopback): check by ball name. Pmod pins 1..4 = differential P, 7..10 = N.
IO_LOC "clk_in" E2;
IO_PORT "clk_in" PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "reset_in" H11;
IO_PORT "reset_in" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;

// Comparators: LVDS25 inputs, no on-die termination (the board terminates the
// line with 2 x 49.9 ohm and biases each input through 2.2k: README §3.2).
// CTLE off: 125 Mbaud needs no peaking and a comparator should not amplify noise.
IO_LOC "cmp_a_p" F5,G5;
IO_PORT "cmp_a_p" IO_TYPE=LVDS25 PULL_MODE=NONE DIFF_RESISTOR=OFF BANK_VCCIO=3.3;
IO_LOC "cmp_b_p" G7,G8;
IO_PORT "cmp_b_p" IO_TYPE=LVDS25 PULL_MODE=NONE DIFF_RESISTOR=OFF BANK_VCCIO=3.3;

// Threshold PWMs (RC filtered on the board)
IO_LOC "pwm_a" H8;
IO_PORT "pwm_a" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "pwm_b" H7;
IO_PORT "pwm_b" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Line driver: Rs 62 ohm / Rp 120 ohm on the board assume DRIVE=16 (README §3.3)
IO_LOC "tx_p" H5;
IO_PORT "tx_p" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16 BANK_VCCIO=3.3;
IO_LOC "tx_n" J5;
IO_PORT "tx_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16 BANK_VCCIO=3.3;

IO_LOC "uart_txd" C3;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "uart_rxd" B3;
IO_PORT "uart_rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "led_link" B2;
IO_PORT "led_link" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_rx" C2;
IO_PORT "led_rx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
