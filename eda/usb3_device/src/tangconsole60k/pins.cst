// Tang Console 60K (GW5AT-LV60PG484AC1/I0) - see eda/targets/tangconsole60k/README.md
// JTAG (tck/tms/tdi/tdo) are the dedicated configuration pins (no IO_LOC).
IO_LOC  "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "uart_tx" U15;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "uart_rx" V14;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
