set SRC_DIR       [lindex $argv 0]
set RTL_DIR       [lindex $argv 1]
set TARGET        [lindex $argv 2]
set DEVICE_FAMILY [lindex $argv 3]
set DEVICE_PART   [lindex $argv 4]
set PROJECT_NAME  [lindex $argv 5]

# The SerDes quad takes its static configuration from the IP's CSR file, which gw_sh can only pass
# to PnR as the "RES.serdes.csr" result file of a saved project: create the project here, write
# .gprj.user, and run the flow in a child gw_sh that opens it (as eda/slogic16u3_usb3).
create_project -name ${PROJECT_NAME} -dir gprj -pn $DEVICE_PART -device_version B -force
set gdir [pwd]

set_option -output_base_name ${PROJECT_NAME}
set_option -verilog_std sysv2017
set_option -print_all_synthesis_warning 1
set_option -top_module top
# PLACE_OPT / ROUTE_OPT: PnR effort (default 3 / 2, the combination that closed 125 MHz for rtl/usb3 on the SLogic16U3)
set_option -place_option [expr {[info exists ::env(PLACE_OPT)] && $::env(PLACE_OPT) ne "" ? $::env(PLACE_OPT) : 3}]
set_option -route_option [expr {[info exists ::env(ROUTE_OPT)] && $::env(ROUTE_OPT) ne "" ? $::env(ROUTE_OPT) : 2}]
# PNR_EXTRA: more PnR options as "name=value ..." (e.g. "serdesRetiming=1")
if {[info exists ::env(PNR_EXTRA)]} {
    foreach kv $::env(PNR_EXTRA) { lassign [split $kv =] k v; set_option -$k $v }
}
set_device -name $DEVICE_FAMILY $DEVICE_PART

# LANE=3: the Lane 3 IP set (ip_ln3, Console USB-A port 2P) instead of Lane 2 (ip, port 1P)
set LANE [expr {[info exists ::env(LANE)] ? $::env(LANE) : "2"}]
set IPDIR [file normalize ${SRC_DIR}/[expr {$LANE eq "3" ? "ip_ln3" : ($LANE eq "2ln" ? "ip_2ln" : "ip")}]]
# REF=1: Gowin's reference device controller (eda/targets/tangconsole60k/doc/gowin_usb3_ref) on the same PHY (top_ref.v)
set REF [expr {[info exists ::env(REF)] && $::env(REF) eq "1"}]
set REF_DIR [file normalize ${SRC_DIR}/../../../targets/tangconsole60k/doc/gowin_usb3_ref/Gowin_USB30_CDC_BULK_RefDeign/prj/src]
set defs "// generated by project.tcl\n"
if {[info exists ::env(FORCE_TX)] && $::env(FORCE_TX) eq "1"} { append defs "`define FORCE_TX\n" }
if {$LANE eq "2ln"} { append defs "`define TWO_LANES\n" }
if {[info exists ::env(FORCE_DET)] && $::env(FORCE_DET) eq "1"} { append defs "`define FORCE_DET\n" }
if {[info exists ::env(LTSSM_LOW_PD)] && $::env(LTSSM_LOW_PD) ne ""} { append defs "`define LTSSM_LOW_PD 2'd$::env(LTSSM_LOW_PD)\n`define LTSSM_RXDET_PD 2'd$::env(LTSSM_RXDET_PD)\n`define RXDET_ASSUME_US $::env(RXDET_ASSUME_US)\n`define POLL_LFPS_P2 $::env(POLL_LFPS_P2)\n`define POLL_LFPS_BLIND_US $::env(POLL_LFPS_BLIND_US)\n" }
if {[info exists ::env(LFPS_DIAG)] && $::env(LFPS_DIAG) eq "1"} { append defs "`define LFPS_DIAG\n" }
if {[info exists ::env(EI_RAW)] && $::env(EI_RAW) ne ""} { append defs "`define EI_RAW\n`define EI_RAW_INV [expr {$::env(EI_RAW) eq "2"}]\n" }
if {[info exists ::env(FORCE_LFPS)] && $::env(FORCE_LFPS) eq "1"} { append defs "`define FORCE_LFPS\n" }
if {[info exists ::env(LFPS_BURST)] && $::env(LFPS_BURST) eq "1"} { append defs "`define LFPS_BURST\n" }
if {[info exists ::env(FD_PD)] && $::env(FD_PD) ne ""} { append defs "`define FD_PD 2'd$::env(FD_PD)\n" }
set fh [open defines_gen.v w]; puts -nonewline $fh $defs; close $fh
add_file -type verilog [file normalize defines_gen.v]
add_file -type verilog [file normalize ${SRC_DIR}/jtag_status.v]
if {$REF} {
    add_file -type verilog [file normalize ${SRC_DIR}/top_ref.v]
    # the reference sources are copied into the build directory (`include finds files next to the
    # including one; the macro file and usb3_const.vh go in first as in the reference project)
    set RS [file normalize ref_src]
    file delete -force $RS; file mkdir $RS
    foreach d {usb30_device_controller usb30_user_layer} { file copy ${REF_DIR}/$d $RS/$d }
    add_file -type verilog $RS/usb30_device_controller/usb3_macro_define.v
    add_file -type verilog $RS/usb30_device_controller/usb3_const.vh
    foreach f [concat [glob $RS/usb30_device_controller/*.v $RS/usb30_device_controller/*.sv] \
                      [glob $RS/usb30_user_layer/*.v $RS/usb30_user_layer/*.sv]] {
        if {[string match *usb3_macro_define.v $f] || [string match *usb_descrip_define.v $f]} continue
        add_file -type verilog $f
    }
    set_option -include_path "$RS/usb30_device_controller;$RS/usb30_user_layer"
} else {
    add_file -type verilog [file normalize ${SRC_DIR}/top.v]
    add_file -type verilog [file normalize ${RTL_DIR}/uart/uart_tx.sv]
    # USB 3.0 core (rtl/usb3, Veryl output - run `veryl build` there after edits)
    foreach f {usb3_pkg usb3_crc_pkg usb3_scrambler usb3_rx_fifo usb3_rx_parser usb3_tx_framer usb3_ltssm usb3_link usb3_top usb3_descriptor_rom usb3_device} {
        add_file -type verilog [file normalize ${RTL_DIR}/usb3/${f}.sv]
    }
}
add_file -type verilog ${IPDIR}/serdes.v
foreach f [glob -nocomplain ${IPDIR}/*/*.v] { if {![string match *_tmp.v $f]} { add_file -type verilog $f } }
set GW_JTAG_V [file normalize [file join [file dirname [info nameofexecutable]] .. data ipcores gw_jtag.v]]
add_file -type verilog $GW_JTAG_V
add_file -type cst [file normalize ${SRC_DIR}/pins.cst]
add_file -type sdc [file normalize ${SRC_DIR}/[expr {$REF ? "timing_ref.sdc" : ($LANE eq "3" ? "timing_ln3.sdc" : ($LANE eq "2ln" ? "timing_2ln.sdc" : "timing.sdc"))}]]

set CSR [expr {[info exists ::env(CSR_FILE)] && $::env(CSR_FILE) ne "" ? [file normalize $::env(CSR_FILE)] : "${IPDIR}/serdes.csr"}]
set fh [open $gdir/${PROJECT_NAME}.gprj.user w]
puts $fh "<?xml version=\"1\" encoding=\"UTF-8\"?>\n<!DOCTYPE ProjectUserData>\n<UserConfig>\n    <Version>1.0</Version>"
if {[info exists ::env(NOCSR)] && $::env(NOCSR) eq "1"} { puts $fh "    <ResultFileList>\n    </ResultFileList>\n</UserConfig>" } else {
puts $fh "    <ResultFileList>\n        <ResultFile ResultFileType=\"RES.serdes.csr\" ResultFilePath=\"$CSR\"/>\n    </ResultFileList>\n</UserConfig>" }
close $fh
set fh [open $gdir/run_csr.tcl w]; puts $fh "open_project $gdir/${PROJECT_NAME}.gprj\nrun all"; close $fh
exec [info nameofexecutable] $gdir/run_csr.tcl >@ stdout 2>@ stderr
file mkdir $gdir/../../impl
file delete -force $gdir/../../impl/pnr
file copy -force $gdir/impl/pnr $gdir/../../impl/pnr
