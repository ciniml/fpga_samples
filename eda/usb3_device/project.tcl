set SRC_DIR       [lindex $argv 0]
set RTL_DIR       [lindex $argv 1]
set TARGET        [lindex $argv 2]
set DEVICE_FAMILY [lindex $argv 3]
set DEVICE_PART   [lindex $argv 4]
set PROJECT_NAME  [lindex $argv 5]

set_option -output_base_name ${PROJECT_NAME}
set_option -verilog_std sysv2017
set_option -print_all_synthesis_warning 1
set_option -top_module top
set_option -place_option 2
set_option -route_option 2
set_device -name $DEVICE_FAMILY $DEVICE_PART

set defs "// generated by project.tcl\n"
if {[info exists ::env(M1)] && $::env(M1) == "1"} { append defs "`define M1\n" }
set fh [open defines_gen.v w]; puts -nonewline $fh $defs; close $fh
add_file -type verilog [file normalize defines_gen.v]
add_file -type verilog [file normalize ${SRC_DIR}/top.v]
add_file -type verilog [file normalize ${RTL_DIR}/uart/uart_tx.sv]
if {!([info exists ::env(M1)] && $::env(M1) == "1")} {
    foreach f {usb3_pkg usb3_desc_pkg usb3_scrambler usb3_rx_fifo usb3_rx_parser usb3_tx_framer usb3_ltssm usb3_link usb3_top usb3_descriptor_rom usb3_device} {
        if {[file exists ${RTL_DIR}/usb3/${f}.sv]} { add_file -type verilog [file normalize ${RTL_DIR}/usb3/${f}.sv] }
    }
    foreach f [glob -nocomplain ${SRC_DIR}/ip/*.v ${SRC_DIR}/ip/*/*.v] { add_file -type verilog [file normalize $f] }
}
add_file -type cst [file normalize ${SRC_DIR}/pins.cst]
add_file -type sdc [file normalize ${SRC_DIR}/timing.sdc]
run all
