set SRC_DIR       [lindex $argv 0]
set RTL_DIR       [lindex $argv 1]
set TARGET        [lindex $argv 2]
set DEVICE_FAMILY [lindex $argv 3]
set DEVICE_PART   [lindex $argv 4]
set PROJECT_NAME  [lindex $argv 5]

# PULL=UP|DOWN|NONE selects the weak pull of every probe pin (one bitstream each).
set PULL UP
if {[info exists ::env(PULL)]} { set PULL [string toupper $::env(PULL)] }
array set PULL_CODE {NONE 0 UP 1 DOWN 2}
if {![info exists PULL_CODE($PULL)]} { error "PULL must be UP, DOWN or NONE (got $PULL)" }
# PINSET=main|cfg|la: the device takes at most 42 ports including the 4 JTAG pads, so the
# 'la' pins (main) and the configuration pins (cfg) cannot be in one build together with
# all 'probe' pins; 'la' = LA + UART + configuration pins without the probe pins.
set PINSET main
if {[info exists ::env(PINSET)]} { set PINSET [string tolower $::env(PINSET)] }
array set PINSET_CODE {main 0 cfg 1 la 2 mipi 3}
array set PINSET_SKIP {main {cfg mipi} cfg {la mipi} la {probe mipi} mipi {probe}}
if {![info exists PINSET_CODE($PINSET)]} { error "PINSET must be main, cfg, la or mipi (got $PINSET)" }

# LA_IO="<cst attributes>" replaces the LVCMOS33 attributes of the 'la' rows, e.g.
# LA_IO="IO_TYPE=SSTL15_I VREF=VREF1_LOAD" (front end without comparators: the input buffer
# itself may be the threshold comparator)
set LA_IO ""
if {[info exists ::env(LA_IO)]} { set LA_IO $::env(LA_IO) }

# LA_VREF=<ball> declares that ball as the bank's external VREF input ('vref_ext');
# use it with LA_IO="IO_TYPE=SSTL33_I VREF=vref_ext"
set LA_VREF ""
if {[info exists ::env(LA_VREF)]} { set LA_VREF $::env(LA_VREF) }

# LA_VREF2=<ball> / LA_IO2="<attrs>": second VREF ('vrefb') and attributes for CH8..CH15
# LA_EXTRA="<balls>": non-'la' balls that get the LA_IO attributes too (e.g. the CK inputs "H13 G13")
set LA_EXTRA ""
if {[info exists ::env(LA_EXTRA)]} { set LA_EXTRA $::env(LA_EXTRA) }
set LA_VREF2 ""
if {[info exists ::env(LA_VREF2)]} { set LA_VREF2 $::env(LA_VREF2) }
set LA_IO2 ""
if {[info exists ::env(LA_IO2)]} { set LA_IO2 $::env(LA_IO2) }

set_option -output_base_name ${PROJECT_NAME}
set_option -verilog_std v2001
set_option -print_all_synthesis_warning 1
set_option -top_module top
set_device -name $DEVICE_FAMILY $DEVICE_PART

# Dual-purpose pins become plain I/O so they can be observed. JTAG stays JTAG
# (no use_jtag_as_gpio): this design talks through it. MSPI is left alone too.
set_option -use_done_as_gpio 1
set_option -use_ready_as_gpio 1
set_option -use_cpu_as_gpio 1
set_option -use_i2c_as_gpio 1
set_option -use_sspi_as_gpio 1

# pins.csv -> pins.cst + defines_gen.v
set fh [open ${SRC_DIR}/pins.csv r]
set rows {}
foreach line [split [read $fh] "\n"] {
    set line [string trim $line]
    if {$line eq "" || [string index $line 0] eq "#"} continue
    set f [split $line ","]
    if {[lindex $f 0] eq "ball"} continue
    # probe pins tagged '@la' in the note are kept in the 'la' set (pins the factory app drives)
    if {[lsearch -exact $PINSET_SKIP($PINSET) [lindex $f 2]] >= 0 && !(($PINSET eq "la" || $PINSET eq "mipi") && [string first "@la" [lindex $f 3]] >= 0)} continue
    lappend rows $f
}
close $fh

set n [llength $rows]
set cst "// generated by project.tcl from pins.csv (PULL=$PULL PINSET=$PINSET)\n"
if {$LA_VREF ne ""} { append cst "USE_VREF_DRIVER vref_ext $LA_VREF;\n" }
if {$LA_VREF2 ne ""} { append cst "USE_VREF_DRIVER vrefb $LA_VREF2;\n" }
set mask 0
set i 0
set n_io 0
foreach r $rows {
    lassign $r ball name class
    if {$class ne "mipi"} {
        # mipi rows are the M0 D-PHY pads, placed by MIPI_DPHY itself (they must come last)
        append cst "IO_LOC \"io\[$i\]\" $ball;\n"
        lassign $r ball name
        if {$class eq "la" && $LA_IO2 ne "" && [scan $name "CH%d" chn] == 1 && $chn >= 8} {
            append cst "IO_PORT \"io\[$i\]\" $LA_IO2;\n"
        } elseif {($class eq "la" || [lsearch -exact $LA_EXTRA $ball] >= 0) && $LA_IO ne ""} {
            append cst "IO_PORT \"io\[$i\]\" $LA_IO;\n"
        } else {
            append cst "IO_PORT \"io\[$i\]\" IO_TYPE=LVCMOS33 PULL_MODE=$PULL DRIVE=4;\n"
        }
        incr n_io
    }
    if {$class eq "probe" || $class eq "uart_tx" || $class eq "cfg" || $class eq "mipi"} { set mask [expr {$mask | (1 << $i)}] }
    incr i
}
set fh [open pins.cst w]; puts -nonewline $fh $cst; close $fh

set defs "// generated by project.tcl from pins.csv\n"
append defs "`define PROBE_N $n\n"
append defs "`define PROBE_N_IO $n_io\n"
if {$n_io != $n} { append defs "`define PROBE_MIPI_DPHY\n" }
append defs "`define PROBE_CAN_DRIVE ${n}'h[format %llx $mask]\n"
append defs "`define PROBE_PULL 2'd$PULL_CODE($PULL)\n"
append defs "`define PROBE_PINSET 2'd$PINSET_CODE($PINSET)\n"
set fh [open defines_gen.v w]; puts -nonewline $fh $defs; close $fh

add_file -type verilog [file normalize defines_gen.v]
add_file -type verilog [file normalize ${SRC_DIR}/top.v]
# GW_JTAG is a black box whose stub ships with the IDE (GAO uses it).
set GW_JTAG_V [file normalize [file join [file dirname [info nameofexecutable]] .. data ipcores gw_jtag.v]]
if {[info exists ::env(GW_JTAG_V)]} { set GW_JTAG_V $::env(GW_JTAG_V) }
add_file -type verilog $GW_JTAG_V
add_file -type cst [file normalize pins.cst]
add_file -type sdc [file normalize ${SRC_DIR}/timing.sdc]
run all
