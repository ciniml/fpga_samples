set SRC_DIR       [lindex $argv 0]
set RTL_DIR       [lindex $argv 1]
set TARGET        [lindex $argv 2]
set DEVICE_FAMILY [lindex $argv 3]
set DEVICE_PART   [lindex $argv 4]
set PROJECT_NAME  [lindex $argv 5]
set CSI_DIR       [file normalize ${SRC_DIR}/../../../csi_capture/src/${TARGET}]
set LOOP_DIR      [file normalize ${SRC_DIR}/../../../dvi_loopback/src/${TARGET}]

set_option -output_base_name ${PROJECT_NAME}
set_device -name $DEVICE_FAMILY $DEVICE_PART

set_option -verilog_std sysv2017
set_option -print_all_synthesis_warning 1
# placement: the default algorithm missed pclk (125 MHz, Csi2Packet header check) by ~0.3 ns
set_option -place_option 1
set_option -top_module top

if {${TARGET} == "tangprimer25k"} {
    set_option -use_cpu_as_gpio 1
    # B2 / C2 (status LEDs) are dual-purpose configuration pins.
    set_option -use_i2c_as_gpio 1
    set_option -use_done_as_gpio 1
    set_option -use_ready_as_gpio 1
    set_option -use_sspi_as_gpio 1
}

# Build variant from the environment: RES=1080P (default 720p30)
set RES [expr {[info exists ::env(RES)] ? $::env(RES) : "720P"}]
set fh [open defines_gen.v w]
puts $fh "// generated by project.tcl"
if {${RES} == "1080P"} { puts $fh "`define CAMERA_DVI_1080P" }
close $fh
add_file -type verilog [file normalize defines_gen.v]

foreach f {csi2_pkg csi2_edge_sampler csi2_lane_aligner csi2_lane_merge csi2_packet csi2_rx} {
    add_file -type verilog [file normalize ${RTL_DIR}/csi2/${f}.sv]
}
foreach f {isp_video_timing isp_raw10_unpack isp_line_ring isp_gamma isp_display isp_genlock} {
    add_file -type verilog [file normalize ${RTL_DIR}/camera_isp/${f}.sv]
}
add_file -type verilog [file normalize ${RTL_DIR}/dvi_out/dvi_out.sv]
add_file -type verilog [file normalize ${RTL_DIR}/uart/uart_tx.sv]
add_file -type verilog [file normalize ${RTL_DIR}/uart/uart_rx.sv]
add_file -type verilog [file normalize ${SRC_DIR}/../../../easycdr_bert/src/${TARGET}/pll_rx_500m_4ph/pll_rx_500m_4ph.v]
add_file -type verilog ${LOOP_DIR}/ip/gowin_pll_27.v
add_file -type verilog ${LOOP_DIR}/ip/pll_tx_1080p/pll_tx_1080p.v
foreach f {reset_seq i2c_reg16 imx219_init_rom ov5640_init_rom ov5640_720p30_init_rom csi_ctrl csi_stats csi_phy_gw5a} {
    add_file -type verilog ${CSI_DIR}/${f}.sv
}
add_file -type verilog [file normalize ${SRC_DIR}/top.sv]
add_file -type cst [file normalize ${SRC_DIR}/pins.cst]
add_file -type sdc [file normalize ${SRC_DIR}/timing.sdc]

run all
