// Tang Primer 25K pattern source (pins from eda/targets/tangprimer25k/pmod_ports.csv)
// line k of a Pmod goes to its pins 1, 7, 2, 8, 3, 9, 4, 10 (the two rows alternately: CH0 <- pin 1, CH1 <- pin 7, ...)
IO_LOC "clock" E2;
IO_PORT "clock" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "pa[0]" F5;
IO_PORT "pa[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "pa[1]" G5;
IO_PORT "pa[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "pa[2]" G7;
IO_PORT "pa[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "pa[3]" G8;
IO_PORT "pa[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "pa[4]" H8;
IO_PORT "pa[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "pa[5]" H7;
IO_PORT "pa[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "pa[6]" H5;
IO_PORT "pa[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "pa[7]" J5;
IO_PORT "pa[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "pb[0]" G11;
IO_PORT "pb[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "pb[1]" G10;
IO_PORT "pb[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "pb[2]" D11;
IO_PORT "pb[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "pb[3]" D10;
IO_PORT "pb[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "pb[4]" B11;
IO_PORT "pb[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "pb[5]" B10;
IO_PORT "pb[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "pb[6]" C11;
IO_PORT "pb[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "pb[7]" C10;
IO_PORT "pb[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "ck" A11;
IO_PORT "ck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
