IO_PORT "CART_A[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "CART_A[7]" K7;   // J3-28
IO_PORT "CART_A[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "CART_A[8]" K10;   // J3-31
IO_PORT "CART_A[8]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "CART_A[9]" L10;   // J3-32
IO_PORT "CART_A[9]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
