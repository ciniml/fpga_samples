// Tang Primer 25K Dock J3 (40-pin, DE0 layout) on gb_fpga_cart_de0. Adapter pin numbers in the comments
// (modretro_chromatic/cartridge/README.md); J3 pin -> ball from the Dock schematic.
IO_LOC "clk_in" E2;
IO_PORT "clk_in" PULL_MODE=NONE BANK_VCCIO=3.3;
// USB-UART (FT2232 interface B)
IO_LOC "uart_txd" C3;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "uart_rxd" B3;
IO_PORT "uart_rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "CART_RST_N" K2;   // J3-1
IO_PORT "CART_RST_N" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "AUD_PWM" K1;   // J3-2
IO_PORT "AUD_PWM" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "CART_CLK" L1;   // J3-3
IO_PORT "CART_CLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "RST_DRV" L2;   // J3-4
IO_PORT "RST_DRV" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "CART_WR_N" K4;   // J3-5
IO_PORT "CART_WR_N" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "CART_RD_N" J4;   // J3-6
IO_PORT "CART_RD_N" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "CART_CS_N" G1;   // J3-7
IO_PORT "CART_CS_N" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "D_DIR" G2;   // J3-8
IO_PORT "D_DIR" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "D_OE_N" L3;   // J3-9
IO_PORT "D_OE_N" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "CART_D[0]" C2;   // J3-13
IO_PORT "CART_D[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "CART_D[1]" B2;   // J3-14
IO_PORT "CART_D[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "CART_D[2]" F1;   // J3-15
IO_PORT "CART_D[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
