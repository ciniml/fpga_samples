IO_PORT "CART_D[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "CART_D[6]" D1;   // J3-19
IO_PORT "CART_D[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "CART_D[7]" E3;   // J3-20
IO_PORT "CART_D[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "CART_A[0]" J2;   // J3-21
IO_PORT "CART_A[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "CART_A[1]" J1;   // J3-22
IO_PORT "CART_A[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "CART_A[2]" H4;   // J3-23
IO_PORT "CART_A[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "CART_A[3]" G4;   // J3-24
IO_PORT "CART_A[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
