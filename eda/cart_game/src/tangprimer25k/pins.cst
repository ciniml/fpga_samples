IO_PORT "CART_A[13]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "CART_A[14]" F6;   // J3-37
IO_PORT "CART_A[14]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "CART_A[15]" F7;   // J3-38
IO_PORT "CART_A[15]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
// on-board SPI flash W25Q64 (core board schematic: CS E6, CCLK E7, IO0 D6, IO1 E5, WP#/IO2 D5, HOLD#/IO3 E4)
IO_LOC "FL_CS_N" E6;
IO_PORT "FL_CS_N" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "FL_SCLK" E7;
IO_PORT "FL_SCLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "FL_IO[0]" D6;
IO_PORT "FL_IO[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "FL_IO[1]" E5;
IO_PORT "FL_IO[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "FL_IO[2]" D5;
IO_PORT "FL_IO[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "FL_IO[3]" E4;
IO_PORT "FL_IO[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
