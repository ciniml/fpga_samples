// DK_LED-RXCARD_GW3A-LV20UG324S_V2.1: ethernet_hub75 pins (DBUG1298-1.0).
// PHY1 = U43 (RGMII). HUB75 J4 / J6: O1..O12 = R1 G1 B1 R2 G2 B2 of each;
// group 1 control (J4..J11): A A7, B C7, C E6, D A8, E C8, CLK D6, LAT E7, OE B8.
// Group 2 OE (J12..J19): V8. All banks used here are 3.3 V.
IO_LOC "clk50" B16;
IO_PORT "clk50" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "key_n" J6;
IO_PORT "key_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
