// DDR2 U46 (table 3-5): banks 2 / 3 at 1.8 V, SSTL18 class I, internal VREF
// for the data inputs. CK / DQS are differential (true pin given, the
// complement follows: CK# H18, LDQS# K14, UDQS# D18). LDM / UDM are not
// wired to the FPGA. Appended to pins.cst by project.tcl for HUB75_IMPL = 2
// (pins_ddr2_idle.cst otherwise).
IO_LOC "ddr_a[0]" L12;
IO_PORT "ddr_a[0]" IO_TYPE=SSTL18_I PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.8;
IO_LOC "ddr_a[1]" H12;
