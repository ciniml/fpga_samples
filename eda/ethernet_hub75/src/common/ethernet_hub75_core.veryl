// SPDX-License-Identifier: BSL-1.0
// Copyright Kenta Ida 2026.
//
// EthernetHub75Core: Ethernet / UDP video in, HUB75 out. Board and PHY
// independent; the board top adds the PHY adapter (RmiiRx / RmiiTx, ...),
// clocks and resets.
//
//   PHY adapter ─ EthRxMac ─(PktFifo, rx clk → sys)─ EthService ─ UdpVideoWriter
//               ─ EthTxMac ─(PktFifo, sys → tx clk)─┘   ↑ ack     │ lane / addr / RGB
//                                                       │         ▼
//                                     Hub75Lanes (frame buffer: sys write, display read)
//
// HUB75_IMPL selects the frame buffer / output stage:
//   0: Hub75Lanes, pixels in the frame buffer, plane bit picked when
//      shifting (soft logic only)
//   1: GmtCornerTurn + Hub75Planes, pixels turned into bit-plane words by
//      the GW3A GMT hard block (GW3A only)
//   2: DdrFb + Hub75RowLanes: the frame buffer in external DRAM (the
//      burst port of Ddr2Ctrl, 'm), row buffers in block RAM
//
// Four clock domains: PHY receive ('p), PHY transmit ('t), system ('s:
// service and frame buffer writes) and display ('d: the HUB75 engine),
// plus the DRAM domain ('m) for HUB75_IMPL 2. They may be the same clock.
module EthernetHub75Core #(
    param MAC_ADDR      : bit<48> = 48'h11_22_33_44_55_66                    ,
    param IP_ADDR       : bit<32> = 32'hC0_A8_0A_02                          ,
    param VIDEO_PORT    : bit<16> = 16'd10004                                ,
    param LUT_PORT      : bit<16> = 16'd10005                                ,
    param STAT_PORT     : bit<16> = 16'd10006                                , // status replies (i_status), 0: off
    param CTRL_PORT     : bit<16> = 16'd10007                                , // control stream (o_ctrl_*), 0: off
    param WIDTH         : u32     = 128                                      , // display width (power of two)
    param HEIGHT        : u32     = 128                                      , // display height (multiple of SCAN_ROWS)
    param LANE_WIDTH    : u32     = WIDTH                                    , // chain length of a lane (power of two)
    param SCAN_ROWS     : u32     = 32                                       ,
    param COMPONENT_BITS: u32     = 6                                        ,
    param CLOCK_DIVIDER : u32     = 0                                        ,
    param CLK_LOW_EXTRA : u32     = 1                                        ,
    param BASE_OE_CYCLES: u32     = 16                                       ,
    param CHAIN_REVERSE : bit     = 0                                        ,
    param HUB75_IMPL    : u32     = 0                                        , // 0: soft (Hub75Lanes), 1: GMT (GW3A), 2: DRAM (DdrFb)
    param MEM_ADDR_BITS : u32     = 21                                       , // HUB75_IMPL 2: DRAM burst address width
    param BIST_BURSTS   : u32     = 1 << 21                                  , // HUB75_IMPL 2: start-up memory test size
    param RX_DEPTH_LOG2 : u32     = 13                                       ,
    param TX_DEPTH_LOG2 : u32     = 11                                       ,
    const NUM_LANES     : u32     = HEIGHT / SCAN_ROWS * (WIDTH / LANE_WIDTH),
) (
    // ---- system ----
    i_clk: input 's clock,
    i_rst: input 's logic, // synchronous, active high

    // ---- PHY receive (from the adapter) ----
    i_rx_clk   : input 'p clock   ,
    i_rx_rst   : input 'p logic   ,
    i_rx_bvalid: input 'p logic   ,
    i_rx_bdata : input 'p logic<8>,
    i_rx_end   : input 'p logic   ,
    i_rx_err   : input 'p logic   ,

    // ---- PHY transmit (to the adapter) ----
    i_tx_clk  : input  't clock   ,
    i_tx_rst  : input  't logic   ,
    i_tx_ce   : input  't logic   ,
    o_tx_ben  : output 't logic   ,
    o_tx_bdata: output 't logic<8>,

    // ---- display ----
    i_dclk : input  'd clock           ,
    i_drst : input  'd logic           ,
    o_row  : output 'd logic<5>        ,
    o_r    : output 'd logic<NUM_LANES>,
    o_g    : output 'd logic<NUM_LANES>,
    o_b    : output 'd logic<NUM_LANES>,
    o_oe   : output 'd logic           ,
    o_lat  : output 'd logic           ,
    o_hclk : output 'd logic           ,
    o_frame: output 'd logic           , // panel frame boundary pulse

    // ---- activity pulses (system domain) ----
    o_ev_video: output 's logic,
    o_ev_net  : output 's logic, // ARP or ICMP answered
    o_ev_drop : output 's logic, // bad FCS
    o_ev_flip : output 's logic, // a new frame is on the panel

    // ---- status replies on STAT_PORT ----
    i_status    : input  's logic<384> = 384'd0,
    o_ctrl_start: output 's logic              ,
    o_ctrl_valid: output 's logic              ,
    o_ctrl_data : output 's logic<8>           ,

    // ---- DRAM burst port (HUB75_IMPL 2 only) ----
    i_mclk        : input  'm clock                = 1'b0  ,
    i_mrst        : input  'm logic                = 1'b1  ,
    i_mem_init    : input  'm logic                = 1'b0  , // controller initialised
    o_mreq_valid  : output 'm logic                        ,
    i_mreq_ready  : input  'm logic                = 1'b0  ,
    o_mreq_we     : output 'm logic                        ,
    o_mreq_addr   : output 'm logic<MEM_ADDR_BITS>         ,
    o_mreq_wdata  : output 'm logic<128>                   ,
    i_mrd_valid   : input  'm logic                = 1'b0  ,
    i_mrd_data    : input  'm logic<128>           = 128'd0,
    o_fb_ready    : output 'm logic                        , // memory test and clear done
    o_bist_errors : output 'm logic<16>                    ,
    o_bist_first  : output 'm logic<MEM_ADDR_BITS>         ,
    o_bist_pass   : output 'm logic<48>                    ,
    o_bist_mask   : output 'm logic<128>                   ,
    o_bist_parity : output 'm logic<32>                    ,
    i_bist_restart: input  'm logic                = 1'b0  ,
    o_overflow    : output 's logic                        , // pulse: a video word was dropped
) {
    const LANE_BITS: u32 = if NUM_LANES >: 1 ? $clog2(NUM_LANES) : 1;
    const ADDR_BITS: u32 = $clog2(SCAN_ROWS) + $clog2(LANE_WIDTH);
    const PX_BITS  : u32 = 3 * COMPONENT_BITS;
    // the RX filter takes the address byte 0 in [7:0]
    const MAC_FILT: bit<48> = {
        MAC_ADDR[7:0], MAC_ADDR[15:8], MAC_ADDR[23:16], MAC_ADDR[31:24], MAC_ADDR[39:32], MAC_ADDR[47:40]
    };

    // ---- MAC ----
    var rrec_valid: 's logic    ;
    var rlen      : 's logic<11>;
    var rflag     : 's logic    ;
    var rremain   : 's logic<11>;
    var rdata     : 's logic<32>;
    var rpop      : 's logic    ;
    var rpop_cnt  : 's logic<3> ;
    var rrelease  : 's logic    ;

    inst rx_mac: eth_mac::EthRxMac #(
        DEPTH_LOG2: RX_DEPTH_LOG2,
    ) (
        i_rx_clk    : i_rx_clk   ,
        i_rx_rst    : i_rx_rst   ,
        i_bvalid    : i_rx_bvalid,
        i_bdata     : i_rx_bdata ,
        i_end       : i_rx_end   ,
        i_err       : i_rx_err   ,
        o_rx_ok     : _          ,
        o_rx_bad    : _          ,
        i_mac       : MAC_FILT   ,
        i_filt_en   : 1'b1       ,
        i_clk       : i_clk      ,
        i_rst       : i_rst      ,
        o_rrec_valid: rrec_valid ,
        o_rlen      : rlen       ,
        o_rflag     : rflag      ,
        o_rremain   : rremain    ,
        o_rdata     : rdata      ,
        i_rpop      : rpop       ,
        i_rpop_n    : 3'd1       ,
        o_rpop_cnt  : rpop_cnt   ,
        i_rrelease  : rrelease   ,
    );

    var wvalid   : 's logic                   ;
    var wdata    : 's logic<8>                ;
    var wcommit  : 's logic                   ;
    var wlen     : 's logic<11>               ;
    var wspace   : 's logic<TX_DEPTH_LOG2 + 1>;
    var wrec_full: 's logic                   ;

    inst tx_mac: eth_mac::EthTxMac #(
        DEPTH_LOG2: TX_DEPTH_LOG2,
    ) (
        i_clk      : i_clk     ,
        i_rst      : i_rst     ,
        i_wvalid   : wvalid    ,
        i_wdata    : wdata     ,
        i_wcommit  : wcommit   ,
        i_wlen     : wlen      ,
        i_wabort   : 1'b0      ,
        o_wspace   : wspace    ,
        o_wrec_full: wrec_full ,
        i_tx_clk   : i_tx_clk  ,
        i_tx_rst   : i_tx_rst  ,
        i_ce       : i_tx_ce   ,
        o_ben      : o_tx_ben  ,
        o_bdata    : o_tx_bdata,
        o_tx_ok    : _         ,
    );

    // ---- service ----
    var vid_start : 's logic    ;
    var vid_offset: 's logic<16>;
    var vid_valid : 's logic    ;
    var vid_data  : 's logic<8> ;
    var lut_start : 's logic    ;
    var lut_valid : 's logic    ;
    var lut_data  : 's logic<8> ;
    var ack_req   : 's logic    ;
    var ev_arp    : 's logic    ;
    var ev_icmp   : 's logic    ;

    inst service: EthService #(
        MAC_ADDR  : MAC_ADDR         ,
        IP_ADDR   : IP_ADDR          ,
        VIDEO_PORT: VIDEO_PORT       ,
        LUT_PORT  : LUT_PORT         ,
        STAT_PORT : STAT_PORT        ,
        CTRL_PORT : CTRL_PORT        ,
        WSPACE_W  : TX_DEPTH_LOG2 + 1,
    ) (
        i_clk       : i_clk       ,
        i_rst       : i_rst       ,
        i_rrec_valid: rrec_valid  ,
        i_rlen      : rlen        ,
        i_rflag     : rflag       ,
        i_rremain   : rremain     ,
        i_rdata     : rdata       ,
        o_rpop      : rpop        ,
        o_rrelease  : rrelease    ,
        o_wvalid    : wvalid      ,
        o_wdata     : wdata       ,
        o_wcommit   : wcommit     ,
        o_wlen      : wlen        ,
        i_wspace    : wspace      ,
        i_wrec_full : wrec_full   ,
        o_vid_start : vid_start   ,
        o_vid_offset: vid_offset  ,
        o_vid_valid : vid_valid   ,
        o_vid_data  : vid_data    ,
        o_lut_start : lut_start   ,
        o_lut_valid : lut_valid   ,
        o_lut_data  : lut_data    ,
        o_ctrl_start: o_ctrl_start,
        o_ctrl_valid: o_ctrl_valid,
        i_ack_req   : ack_req     ,
        i_status    : i_status    ,
        o_ev_arp    : ev_arp      ,
        o_ev_icmp   : ev_icmp     ,
        o_ev_video  : o_ev_video  ,
        o_ev_drop   : o_ev_drop   ,
    );

    // ---- frame buffer writer (HUB75_IMPL 0 / 1) ----
    var fb_we    : 's logic           ;
    var fb_lane  : 's logic<LANE_BITS>;
    var fb_addr  : 's logic<ADDR_BITS>;
    var fb_rgb   : 's logic<PX_BITS>  ;
    var flip_req : 's logic           ;
    var flip_busy: 's logic           ; // seen by the writer: drop bytes, ack when it falls
    var busy_d   : 's logic           ;

    if HUB75_IMPL != 2 :g_writer {
        inst writer: UdpVideoWriter #(
            WIDTH         : WIDTH         ,
            HEIGHT        : HEIGHT        ,
            LANE_WIDTH    : LANE_WIDTH    ,
            SCAN_ROWS     : SCAN_ROWS     ,
            COMPONENT_BITS: COMPONENT_BITS,
            CHAIN_REVERSE : CHAIN_REVERSE ,
        ) (
            i_clk      : i_clk     ,
            i_rst      : i_rst     ,
            i_start    : vid_start ,
            i_offset   : vid_offset,
            i_valid    : vid_valid ,
            i_data     : vid_data  ,
            i_lut_start: lut_start ,
            i_lut_valid: lut_valid ,
            i_lut_data : lut_data  ,
            o_we       : fb_we     ,
            o_lane     : fb_lane   ,
            o_addr     : fb_addr   ,
            o_rgb      : fb_rgb    ,
            o_flip_req : flip_req  ,
            i_flip_busy: flip_busy ,
        );
    }

    // the flip is done when busy falls: ack the sender
    always_ff (i_clk) {
        if i_rst {
            busy_d = 1'b0;
        } else {
            busy_d = flip_busy;
        }
    }
    assign ack_req     = busy_d && !flip_busy;
    assign o_ev_flip   = ack_req;
    assign o_ev_net    = ev_arp || ev_icmp;
    assign o_ctrl_data = lut_data;

    if HUB75_IMPL != 2 :g_no_dram {
        assign o_mreq_valid  = 1'b0;
        assign o_mreq_we     = 1'b0;
        assign o_mreq_addr   = 0;
        assign o_mreq_wdata  = 128'd0;
        assign o_fb_ready    = 1'b0;
        assign o_bist_errors = 16'd0;
        assign o_bist_first  = 0;
        assign o_bist_pass   = 48'd0;
        assign o_bist_mask   = 128'd0;
        assign o_bist_parity = 32'd0;
        assign o_overflow    = 1'b0;
    }

    // ---- HUB75 ----
    if HUB75_IMPL == 0 :g_soft {
        inst panel: hub75::Hub75Lanes #(
            SCAN_ROWS     : SCAN_ROWS     ,
            CHAIN_LEN     : LANE_WIDTH    ,
            NUM_LANES     : NUM_LANES     ,
            CLOCK_DIVIDER : CLOCK_DIVIDER ,
            CLK_LOW_EXTRA : CLK_LOW_EXTRA ,
            COMPONENT_BITS: COMPONENT_BITS,
            BASE_OE_CYCLES: BASE_OE_CYCLES,
        ) (
            i_wclk     : i_clk    ,
            i_wrst     : i_rst    ,
            i_we       : fb_we    ,
            i_wlane    : fb_lane  ,
            i_waddr    : fb_addr  ,
            i_wdata    : fb_rgb   ,
            i_flip_req : flip_req ,
            o_flip_busy: flip_busy,
            i_clk      : i_dclk   ,
            i_rst      : i_drst   ,
            o_frame    : o_frame  ,
            o_row      : o_row    ,
            o_r        : o_r      ,
            o_g        : o_g      ,
            o_b        : o_b      ,
            o_oe       : o_oe     ,
            o_lat      : o_lat    ,
            o_clk      : o_hclk   ,
        );
    } else if HUB75_IMPL == 1 :g_gmt {
        const XW_BITS   : u32 = $clog2(LANE_WIDTH) - 5;
        const PLANE_BITS: u32 = if COMPONENT_BITS >: 1 ? $clog2(COMPONENT_BITS) : 1;

        var ct_busy   : 's logic                             ;
        var pw_we     : 's logic                             ;
        var pw_lane   : 's logic<LANE_BITS>                  ;
        var pw_colour : 's logic<2>                          ;
        var pw_plane  : 's logic<PLANE_BITS>                 ;
        var pw_addr   : 's logic<$clog2(SCAN_ROWS) + XW_BITS>;
        var pw_data   : 's logic<32>                         ;
        var pw_flip   : 's logic                             ;
        var panel_busy: 's logic                             ;

        inst turn: GmtCornerTurn #(
            SCAN_ROWS     : SCAN_ROWS     ,
            CHAIN_LEN     : LANE_WIDTH    ,
            NUM_LANES     : NUM_LANES     ,
            COMPONENT_BITS: COMPONENT_BITS,
            CHAIN_REVERSE : CHAIN_REVERSE ,
        ) (
            i_clk     : i_clk    ,
            i_rst     : i_rst    ,
            i_we      : fb_we    ,
            i_lane    : fb_lane  ,
            i_addr    : fb_addr  ,
            i_rgb     : fb_rgb   ,
            i_flip_req: flip_req ,
            o_busy    : ct_busy  ,
            o_we      : pw_we    ,
            o_lane    : pw_lane  ,
            o_colour  : pw_colour,
            o_plane   : pw_plane ,
            o_addr    : pw_addr  ,
            o_data    : pw_data  ,
            o_flip_req: pw_flip  ,
        );

        inst panel: hub75::Hub75Planes #(
            SCAN_ROWS     : SCAN_ROWS     ,
            CHAIN_LEN     : LANE_WIDTH    ,
            NUM_LANES     : NUM_LANES     ,
            CLOCK_DIVIDER : CLOCK_DIVIDER ,
            CLK_LOW_EXTRA : CLK_LOW_EXTRA ,
            COMPONENT_BITS: COMPONENT_BITS,
            BASE_OE_CYCLES: BASE_OE_CYCLES,
        ) (
            i_wclk     : i_clk     ,
            i_wrst     : i_rst     ,
            i_we       : pw_we     ,
            i_wlane    : pw_lane   ,
            i_wcolour  : pw_colour ,
            i_wplane   : pw_plane  ,
            i_waddr    : pw_addr   ,
            i_wdata    : pw_data   ,
            i_flip_req : pw_flip   ,
            o_flip_busy: panel_busy,
            i_clk      : i_dclk    ,
            i_rst      : i_drst    ,
            o_frame    : o_frame   ,
            o_row      : o_row     ,
            o_r        : o_r       ,
            o_g        : o_g       ,
            o_b        : o_b       ,
            o_oe       : o_oe      ,
            o_lat      : o_lat     ,
            o_clk      : o_hclk    ,
        );

        assign flip_busy = ct_busy || panel_busy;
    } else :g_ddr {
        const LX_BITS: u32 = $clog2(LANE_WIDTH);

        var fetch_req : 'm logic             ;
        var fetch_row : 'm logic<5>          ;
        var fetch_done: 'm logic             ;
        var fill_we   : 'm logic             ;
        var fill_lane : 'm logic<LANE_BITS>  ;
        var fill_addr : 'm logic<1 + LX_BITS>;
        var fill_rgb  : 'm logic<PX_BITS>    ;

        inst fb: DdrFb #(
            WIDTH         : WIDTH         ,
            HEIGHT        : HEIGHT        ,
            LANE_WIDTH    : LANE_WIDTH    ,
            SCAN_ROWS     : SCAN_ROWS     ,
            COMPONENT_BITS: COMPONENT_BITS,
            CHAIN_REVERSE : CHAIN_REVERSE ,
            MEM_ADDR_BITS : MEM_ADDR_BITS ,
            BIST_BURSTS   : BIST_BURSTS   ,
        ) (
            i_clk         : i_clk         ,
            i_rst         : i_rst         ,
            i_start       : vid_start     ,
            i_offset      : vid_offset    ,
            i_valid       : vid_valid     ,
            i_data        : vid_data      ,
            i_lut_start   : lut_start     ,
            i_lut_valid   : lut_valid     ,
            i_lut_data    : lut_data      ,
            o_flip_busy   : flip_busy     ,
            o_overflow    : o_overflow    ,
            i_mclk        : i_mclk        ,
            i_mrst        : i_mrst        ,
            i_mem_init    : i_mem_init    ,
            o_mreq_valid  : o_mreq_valid  ,
            i_mreq_ready  : i_mreq_ready  ,
            o_mreq_we     : o_mreq_we     ,
            o_mreq_addr   : o_mreq_addr   ,
            o_mreq_wdata  : o_mreq_wdata  ,
            i_mrd_valid   : i_mrd_valid   ,
            i_mrd_data    : i_mrd_data    ,
            i_fetch_req   : fetch_req     ,
            i_fetch_row   : fetch_row     ,
            o_fetch_done  : fetch_done    ,
            o_fill_we     : fill_we       ,
            o_fill_lane   : fill_lane     ,
            o_fill_addr   : fill_addr     ,
            o_fill_rgb    : fill_rgb      ,
            o_ready       : o_fb_ready    ,
            o_bist_errors : o_bist_errors ,
            o_bist_first  : o_bist_first  ,
            o_bist_pass   : o_bist_pass   ,
            o_bist_mask   : o_bist_mask   ,
            o_bist_parity : o_bist_parity ,
            i_bist_restart: i_bist_restart,
        );

        inst panel: hub75::Hub75RowLanes #(
            SCAN_ROWS     : SCAN_ROWS     ,
            CHAIN_LEN     : LANE_WIDTH    ,
            NUM_LANES     : NUM_LANES     ,
            CLOCK_DIVIDER : CLOCK_DIVIDER ,
            CLK_LOW_EXTRA : CLK_LOW_EXTRA ,
            COMPONENT_BITS: COMPONENT_BITS,
            BASE_OE_CYCLES: BASE_OE_CYCLES,
        ) (
            i_fclk      : i_mclk    ,
            i_frst      : i_mrst    ,
            i_we        : fill_we   ,
            i_wlane     : fill_lane ,
            i_waddr     : fill_addr ,
            i_wdata     : fill_rgb  ,
            o_fetch_req : fetch_req ,
            o_fetch_row : fetch_row ,
            i_fetch_done: fetch_done,
            i_clk       : i_dclk    ,
            i_rst       : i_drst    ,
            o_frame     : o_frame   ,
            o_row       : o_row     ,
            o_r         : o_r       ,
            o_g         : o_g       ,
            o_b         : o_b       ,
            o_oe        : o_oe      ,
            o_lat       : o_lat     ,
            o_clk       : o_hclk    ,
        );
    }

    let _unused: 's logic = |rpop_cnt;
}
