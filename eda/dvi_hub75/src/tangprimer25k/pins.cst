// Tang Primer 25K — DVI input (PMOD0) + HUB75 output (PMOD1+PMOD2).
//
// DVI side: identical to eda/dvi_capture (bit-perfect from a notebook PC
// with CTLE=HIGH, offset 0x3C):
// Sipeed Pmod DVI on PMOD0, all pairs with on-chip 100-ohm termination
// (bank 1 supports DIFF_RESISTOR; banks 2/6 do not).
//   dvi_clk = pmod0_4/10 = H5/J5  (GCLKT_2/TPLL_T_IN0)
//   dvi_d0  = pmod0_3/9  = H8/H7
//   dvi_d1  = pmod0_2/8  = G7/G8
//   dvi_d2  = pmod0_1/7  = F5/G5
IO_LOC "dvi_clk_p" H5;
IO_PORT "dvi_clk_p" PULL_MODE=NONE IO_TYPE=LVDS25 DIFF_RESISTOR=ON CTLE=HIGH;
IO_LOC "dvi_d0_p"  H8;
IO_PORT "dvi_d0_p" PULL_MODE=NONE IO_TYPE=LVDS25 DIFF_RESISTOR=ON CTLE=HIGH;
IO_LOC "dvi_d1_p"  G7;
IO_PORT "dvi_d1_p" PULL_MODE=NONE IO_TYPE=LVDS25 DIFF_RESISTOR=ON CTLE=HIGH;
IO_LOC "dvi_d2_p"  F5;
IO_PORT "dvi_d2_p" PULL_MODE=NONE IO_TYPE=LVDS25 DIFF_RESISTOR=ON CTLE=HIGH;

IO_LOC "clock" E2;
IO_PORT "clock" IO_TYPE=LVCMOS33;

IO_LOC "button_replug" H10;
IO_PORT "button_replug" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// HDMI/DVI side channel on the 40-pin (DE0-compatible) header J4:
//   pin 15 = F1 ddc_scl, pin 16 = F2 ddc_sda, pin 17 = A1 hpd,
//   (pin 18 = E1 reserved for CEC), pin 11 = +5V, pin 12 = GND.
// DDC is pulled up to 5 V by the source: level shifter / clamp required.
IO_LOC "ddc_scl" F1;
IO_PORT "ddc_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "ddc_sda" F2;
IO_PORT "ddc_sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "hpd" A1;
IO_PORT "hpd" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// USB-UART (USB Debugger, FT2232 if01), 115200 8N1
IO_LOC "uart_txd" C3;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "uart_rxd" B3;
IO_PORT "uart_rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "reset_button" H11;
IO_PORT "reset_button" PULL_MODE=DOWN IO_TYPE=LVCMOS33;

// ---------------------------------------------------------------------
// HUB75 Pmod baseboard on PMOD1 + PMOD2 (module port pmod0 → board
// PMOD2, module port pmod1 → board PMOD1: the same orientation as
// eda/ethernet_video on PMOD0 + PMOD1, shifted by one slot; confirmed on
// hardware), signal layout per
// mod/pmod_hub75/pmod_pins.csv:
//   module pmod0: 1=r[0] 2=b[0] 3=r[1] 4=b[1] 7=g[0] 8=g[1] 9=row_e 10=row_b
//   module pmod1: 1=row_d 2=lat 7=row_a 8=row_c 9=clk 10=oe
// Board pin lookup: eda/targets/tangprimer25k/pmod_ports.csv.
// ---------------------------------------------------------------------
IO_LOC "hub75_r[0]"  G11;
IO_PORT "hub75_r[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "hub75_b[0]"  D11;
IO_PORT "hub75_b[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "hub75_r[1]"  B11;
IO_PORT "hub75_r[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "hub75_b[1]"  C11;
IO_PORT "hub75_b[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "hub75_g[0]"  G10;
IO_PORT "hub75_g[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "hub75_g[1]"  D10;
IO_PORT "hub75_g[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "hub75_row_e" B10;
IO_PORT "hub75_row_e" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "hub75_row_b" C10;
IO_PORT "hub75_row_b" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

IO_LOC "hub75_row_d" A11;
IO_PORT "hub75_row_d" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "hub75_lat"   E11;
IO_PORT "hub75_lat" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "hub75_row_a" A10;
IO_PORT "hub75_row_a" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "hub75_row_c" E10;
IO_PORT "hub75_row_c" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "hub75_clk"   L11;
IO_PORT "hub75_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "hub75_oe"    K5;
IO_PORT "hub75_oe" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// Status outputs (same pads as dvi_capture / gowin_easycdr_sample).
IO_LOC "led_locked"     B2;
IO_PORT "led_locked"    IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led_decode_err" C2;
IO_PORT "led_decode_err" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
