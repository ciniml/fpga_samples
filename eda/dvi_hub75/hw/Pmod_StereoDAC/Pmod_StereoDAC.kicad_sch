	(text "Pmod Stereo DAC: the two 1-bit delta-sigma outputs of eda/dvi_hub75 (rtl/hdmi_rx, 6.19 MHz) to a 3.5 mm stereo jack."
		(exclude_from_sim no)
		(at 25.40 162.56 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid 06f4cea4-8602-5b7e-a932-d98ceabd7405)
	)
	(text "Per channel (eda/dvi_hub75/README.md): 1k / 3.3n and 10k / 330p RC (both ~48 kHz), 1 uF DC block, 100k bleeder."
		(exclude_from_sim no)
		(at 25.40 166.37 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid 7b73d481-b54c-5ba7-8687-6446f6cde1bc)
	)
	(text "-3 dB ~28.5 kHz, 20 kHz -1.6 dB, 6.19 MHz -85 dB (with ~30 ohm pin impedance). Flatter: C1 / C11 2.2n, C2 / C12 220p."
		(exclude_from_sim no)
		(at 25.40 170.18 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid d493ba4d-8543-5779-949d-d1972d656fcf)
	)
	(text "Line level (~1.1 Vrms full scale, ~10 kohm source): headphones need an amplifier. Pmod 3.3 V is not used."
		(exclude_from_sim no)
		(at 25.40 173.99 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid 8f208c71-12ed-5bfc-bad7-bb39c14804b4)
	)
	(text "J3 carries the same outputs as the jack (after the DC block): 1 = L, 2 = GND, 3 = R."
