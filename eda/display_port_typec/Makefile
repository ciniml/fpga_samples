PROJECT_NAME := dp_typec

TARGET ?= tangprimer25k
ROOT_DIR ?= $(abspath ../..)
RTL_DIR ?= $(ROOT_DIR)/rtl

PROJECT_ADDITIONAL_ARGS := $(ROOT_DIR)/external/learn-fpga/FemtoRV/RTL/PROCESSOR

FIRMWARE_HEX := $(ROOT_DIR)/rtl/displayport/test/sw-rs/bootrom-rs-typec.hex
SRCS := src/$(TARGET)/pins.cst $(wildcard src/$(TARGET)/*.cst) $(wildcard src/$(TARGET)/*.sdc) $(wildcard src/$(TARGET)/*.sv) project.tcl $(FIRMWARE_HEX)

PMOD_PORT_OFFSET ?= 0
PMOD_TARGETS := tangprimer25k

USE_PMOD := 0
ifneq (,$(filter $(TARGET),$(PMOD_TARGETS)))
USE_PMOD := 1
PROJECT_ADDITIONAL_CLEAN += src/$(TARGET)/pins.cst
endif

include ../build_gowin.mk

PMOD_MODULES += $(MOD_DIR)/pmod_dp_altmode/pmod_pins.csv

ifeq ($(USE_PMOD),1)
src/$(TARGET)/pins.cst: src/$(TARGET)/pins.cst.template $(TARGET_DEF_DIR)/pmod_ports.csv $(PMOD_MODULES) $(MAPPMOD)
	echo Generating pin definition from Pmod pin map.
	echo // This file is automatically generated by build script. DO NOT EDIT THIS FILE. > $@
	cat src/$(TARGET)/pins.cst.template >> $@
	$(MAPPMOD) --pmod-port-def $(TARGET_DEF_DIR)/pmod_ports.csv $(addprefix --pmod ,$(PMOD_MODULES)) --port-offset $(PMOD_PORT_OFFSET) --direction right-to-left >> $@
else
src/$(TARGET)/pins.cst:
	echo Use pre-generated pin definition.
endif

$(FIRMWARE_HEX): $(wildcard $(ROOT_DIR)/rtl/displayport/test/sw-rs/src/*.rs)
	$(MAKE) -C $(ROOT_DIR)/rtl/displayport/test/sw-rs bootrom-rs-typec.hex
