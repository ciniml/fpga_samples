// SLogic16U3 logic analyzer. The SerDes Q0 lanes / REFCLK0 are placed by the IP; only the fabric pins here.
// CH0..15 and CK0/1 (bank 1): SSTL33 inputs against the external VREF on M8 (J12's PWM through an RC);
// the CH inputs are divided by ~2 on the board (threshold ~6.7 V x duty), the CK inputs are not (~3.3 V x duty).
USE_VREF_DRIVER vref_ext M8;
IO_LOC "la_ch[0]" J14;
IO_LOC "la_ch[1]" J13;
IO_LOC "la_ch[2]" N14;
IO_LOC "la_ch[3]" P14;
IO_LOC "la_ch[4]" N13;
IO_LOC "la_ch[5]" P13;
IO_LOC "la_ch[6]" N12;
IO_LOC "la_ch[7]" P12;
IO_LOC "la_ch[8]" N11;
IO_LOC "la_ch[9]" P11;
IO_LOC "la_ch[10]" N10;
IO_LOC "la_ch[11]" P10;
IO_LOC "la_ch[12]" N9;
IO_LOC "la_ch[13]" P9;
IO_LOC "la_ch[14]" N8;
IO_LOC "la_ch[15]" P8;
IO_PORT "la_ch[0]" IO_TYPE=SSTL33_I VREF=vref_ext PULL_MODE=NONE;
IO_PORT "la_ch[1]" IO_TYPE=SSTL33_I VREF=vref_ext PULL_MODE=NONE;
IO_PORT "la_ch[2]" IO_TYPE=SSTL33_I VREF=vref_ext PULL_MODE=NONE;
IO_PORT "la_ch[3]" IO_TYPE=SSTL33_I VREF=vref_ext PULL_MODE=NONE;
IO_PORT "la_ch[4]" IO_TYPE=SSTL33_I VREF=vref_ext PULL_MODE=NONE;
IO_PORT "la_ch[5]" IO_TYPE=SSTL33_I VREF=vref_ext PULL_MODE=NONE;
IO_PORT "la_ch[6]" IO_TYPE=SSTL33_I VREF=vref_ext PULL_MODE=NONE;
IO_PORT "la_ch[7]" IO_TYPE=SSTL33_I VREF=vref_ext PULL_MODE=NONE;
IO_PORT "la_ch[8]" IO_TYPE=SSTL33_I VREF=vref_ext PULL_MODE=NONE;
IO_PORT "la_ch[9]" IO_TYPE=SSTL33_I VREF=vref_ext PULL_MODE=NONE;
IO_PORT "la_ch[10]" IO_TYPE=SSTL33_I VREF=vref_ext PULL_MODE=NONE;
IO_PORT "la_ch[11]" IO_TYPE=SSTL33_I VREF=vref_ext PULL_MODE=NONE;
IO_PORT "la_ch[12]" IO_TYPE=SSTL33_I VREF=vref_ext PULL_MODE=NONE;
IO_PORT "la_ch[13]" IO_TYPE=SSTL33_I VREF=vref_ext PULL_MODE=NONE;
IO_PORT "la_ch[14]" IO_TYPE=SSTL33_I VREF=vref_ext PULL_MODE=NONE;
IO_PORT "la_ch[15]" IO_TYPE=SSTL33_I VREF=vref_ext PULL_MODE=NONE;
IO_LOC "la_ck0" H13;
IO_PORT "la_ck0" IO_TYPE=SSTL33_I VREF=vref_ext PULL_MODE=DOWN;
IO_LOC "la_ck1" G13;
IO_PORT "la_ck1" IO_TYPE=SSTL33_I VREF=vref_ext PULL_MODE=DOWN;
IO_LOC "vref_pwm" J12;
IO_PORT "vref_pwm" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
// USB 2.0 pins kept quiet (see ../slogic16u3_usb3/src/slogic16u3/pins.cst)
IO_LOC "usb_cmp_dp" H3,H2;
IO_PORT "usb_cmp_dp" IO_TYPE=LVDS25 PULL_MODE=NONE DIFF_RESISTOR=OFF;
IO_LOC "usb_cmp_dn" M2,M1;
IO_PORT "usb_cmp_dn" IO_TYPE=LVDS25 PULL_MODE=NONE DIFF_RESISTOR=OFF;
IO_LOC "usb_pullup" C14;
IO_PORT "usb_pullup" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "xo_en" D14;
IO_PORT "xo_en" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led_r" G14;
IO_PORT "led_r" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "usb_dxp" K3;
IO_PORT "usb_dxp" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "usb_dxn" K2;
IO_PORT "usb_dxn" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "usb_tdp" P2;
IO_PORT "usb_tdp" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "usb_tdn" P1;
IO_PORT "usb_tdn" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
