embed (inline) sv{{{
`timescale 1ns/1ps
}}}
module top(
    r#clock: input clock,

    // Input button
    button_s2: input logic,

    // Tang Nano On Board LEDs
    led: output logic<6>,

    // DVI
    tmds_clk_p: output logic,
    tmds_data_p: output logic<3>,
) {
  var clock_dvi: logic ;
  var pll_lock: logic ;
  var clock_dvi_ser: logic ;
  var pll_lock_ser: logic ;

  var reset_button: logic<3>;

  function init_reset_signal::<W: u32 = 3>(reset_signal: output logic<W>) {
    reset_signal = '1;
  }

  initial {
    init_reset_signal::<3>(reset_button);
  }
  
  always_ff (r#clock) {
    reset_button = {!button_s2, reset_button[2:1]};
  }

  var reset_ext: logic;
  inst reset_seq_ext: $sv::reset_seq(
    r#clock: clock_dvi,
    reset_in: reset_button[0] || !pll_lock || !pll_lock_ser,
    reset_out: reset_ext,
  );

  inst rpll_dvi: $sv::gowin_rpll_dvi(
    clkout: clock_dvi,  //output clkout
    lock: pll_lock,  //output lock
    clkin: r#clock, //input clkin
  );
  inst rpll_dvi_ser: $sv::gowin_rpll_ser (
    clkout: clock_dvi_ser, //output clkout
    lock: pll_lock_ser, //output lock
    clkin: clock_dvi //input clkin
  );

  var reset_dvi: logic;
  inst reset_seq_dvi: $sv::reset_seq #( RESET_DELAY_CYCLES: 4, ) (
    r#clock: clock_dvi,
    reset_in: reset_ext,
    reset_out: reset_dvi
  );

  assign led = ~{4'b000, pll_lock, pll_lock_ser};

  var dvi_clock: logic<10>;
  var dvi_data0: logic<10>;
  var dvi_data1: logic<10>;
  var dvi_data2: logic<10>;
  var video_de: logic;
  var video_hsync: logic;
  var video_vsync: logic;
  var video_data: logic<24>;

  // inst tpg_inst: $sv::test_pattern_generator #(
  //   BOUNCE_LOGO: 1,
  //   LOGO_PATH: "../cq_logo.hex",
  //   LOGO_WIDTH: 250,
  //   LOGO_HEIGHT: 50,
  //   LOGO_COLOR: 24'h000000,
  // ) (
  //   r#clock: clock_dvi,
  //   r#reset: reset_dvi,
  //   video_de,
  //   video_hsync,
  //   video_vsync,
  //   video_data,
  // );
  
  // interfaces
  inst axis_data_in: axi4s::axi4s_if::<32, true, 1> ();
  inst video_out: display_controller::video_io_if #(
      PIXEL_BITS: 8,
  ) ();

  var clock_dvi_as_clock: '_ clock;
  var reset_dvi_as_reset: '_ reset;
  unsafe(cdc) {
    assign reset_dvi_as_reset = !reset_dvi;
    assign clock_dvi_as_clock = clock_dvi;
  }

  var axis_data_in_valid: logic;
  var axis_data_in_ready: logic;
  var axis_data_in_data: logic<8>;
  var axis_data_in_last: logic;
  var axis_data_in_sof: logic;

  var h_counter: u16;
  var v_counter: u16;
  always_ff (clock_dvi_as_clock, reset_dvi_as_reset) {
    if_reset {
      axis_data_in_valid = 0;
      axis_data_in_data = 0;
      axis_data_in_last = 0;
      axis_data_in_sof = 0;
      h_counter = 0;
      v_counter = 0;
    } else {
      if axis_data_in_valid && axis_data_in_ready {
        axis_data_in_valid = 0;
      }
      if !axis_data_in_valid || axis_data_in_ready {
        axis_data_in_valid = 1;
        axis_data_in_last = 0;
        axis_data_in_sof = h_counter == 0 && v_counter == 0;
        //axis_data_in_data = (h_counter ^ v_counter) & 8'hff;
        axis_data_in_data = h_counter[7:0];

        if h_counter == 320 - 1 {
          axis_data_in_last = 1;
          h_counter = 0;
          if v_counter == 180 - 1 {
            v_counter = 0;
          } else {
            v_counter = v_counter + 1;
          }
        } else {
          h_counter = h_counter + 1;
        }
      }
    }
  }

  always_comb {
    axis_data_in.tvalid = axis_data_in_valid;
    axis_data_in.tdata = axis_data_in_data;
    axis_data_in.tlast = axis_data_in_last;
    axis_data_in.tuser[0] = axis_data_in_sof;
    axis_data_in_ready = axis_data_in.tready;

    video_de = video_out.data_enable;
    video_hsync = video_out.hsync;
    video_vsync = video_out.vsync;
    video_data = video_out.pixel_data;
  }

  inst video_signal_generator_inst: display_controller::video_signal_generator #(
      SCREEN_WIDTH: 1280,
      SCREEN_HEIGHT: 720,
      PIXEL_BITS: 8,
      BACK_PORCH_H: 220,
      FRONT_PORCH_H: 110,
      PULSE_WIDTH_H: 40,
      BACK_PORCH_V: 20,
      FRONT_PORCH_V: 5,
      PULSE_WIDTH_V: 5,
      MULTIPLIER_H: 4,
      MULTIPLIER_V: 4
  ) (
    r#clock: clock_dvi_as_clock,
    r#reset: reset_dvi_as_reset,
    data: axis_data_in,
    video: video_out,
    data_in_sync: _,
  );
  
  inst dvi_out_inst: $sv::dvi_out (
    r#clock: clock_dvi,
    r#reset: reset_dvi,
    dvi_clock,
    dvi_data0,
    dvi_data1,
    dvi_data2,
    video_de,
    video_hsync,
    video_vsync,
    video_data,
  );

  inst oser_dvi_clock: $sv::OSER10 #(
    GSREN: "false",
    LSREN: "true",
  ) (
    Q: tmds_clk_p,
    D0: dvi_clock[0],
    D1: dvi_clock[1],
    D2: dvi_clock[2],
    D3: dvi_clock[3],
    D4: dvi_clock[4],
    D5: dvi_clock[5],
    D6: dvi_clock[6],
    D7: dvi_clock[7],
    D8: dvi_clock[8],
    D9: dvi_clock[9],
    FCLK: clock_dvi_ser,
    PCLK: clock_dvi,
    RESET: reset_dvi,
  );
  inst oser_dvi_data0: $sv::OSER10 #(
    GSREN: "false",
    LSREN: "true"
  ) (
    Q: tmds_data_p[0],
    D0: dvi_data0[0],
    D1: dvi_data0[1],
    D2: dvi_data0[2],
    D3: dvi_data0[3],
    D4: dvi_data0[4],
    D5: dvi_data0[5],
    D6: dvi_data0[6],
    D7: dvi_data0[7],
    D8: dvi_data0[8],
    D9: dvi_data0[9],
    FCLK: clock_dvi_ser,
    PCLK: clock_dvi,
    RESET: reset_dvi
  );
  inst oser_dvi_data1: $sv::OSER10 #(
    GSREN: "false",
    LSREN: "true"
  ) (
    Q: tmds_data_p[1],
    D0: dvi_data1[0],
    D1: dvi_data1[1],
    D2: dvi_data1[2],
    D3: dvi_data1[3],
    D4: dvi_data1[4],
    D5: dvi_data1[5],
    D6: dvi_data1[6],
    D7: dvi_data1[7],
    D8: dvi_data1[8],
    D9: dvi_data1[9],
    FCLK: clock_dvi_ser,
    PCLK: clock_dvi,
    RESET: reset_dvi
  );
  inst oser_dvi_data2: $sv::OSER10 #(
    GSREN: "false",
    LSREN: "true"
  ) (
    Q: tmds_data_p[2],
    D0: dvi_data2[0],
    D1: dvi_data2[1],
    D2: dvi_data2[2],
    D3: dvi_data2[3],
    D4: dvi_data2[4],
    D5: dvi_data2[5],
    D6: dvi_data2[6],
    D7: dvi_data2[7],
    D8: dvi_data2[8],
    D9: dvi_data2[9],
    FCLK: clock_dvi_ser,
    PCLK: clock_dvi,
    RESET: reset_dvi,
  );

}